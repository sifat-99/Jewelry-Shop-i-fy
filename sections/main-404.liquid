<!-- /sections/main-404.liquid -->
<div class="color-{{ section.settings.color_scheme | default: 'scheme-1' }}" style="padding: 60px 20px; text-align: center; min-height: 50vh; display: flex; align-items: center; justify-content: center;">
  <div style="max-width: 600px; margin: 0 auto;">
    <h1 style="font-family: 'Quicksand', sans-serif; font-size: 64px; font-weight: 300; letter-spacing: 0.1em; color: #ccc; margin: 0 0 10px 0;">404</h1>
    <h2 style="font-family: 'Quicksand', sans-serif; font-size: 18px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.15em; color: #000; margin: 0 0 16px 0;">
      Page Not Found
    </h2>
    <p style="font-family: 'Quicksand', sans-serif; font-size: 13px; color: #666; line-height: 1.6; margin-bottom: 28px;">
      The page you are looking for does not exist or has been moved. Discover our luxury collections:
    </p>

    <!-- Quick Collection Links -->
    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-bottom: 32px;">
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn-sliding-hover" style="padding: 10px 18px; font-family: 'Quicksand', sans-serif; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; text-decoration: none; border-radius: var(--btn-radius, 0px) !important;">
        All Jewelry
      </a>
      <a href="{{ routes.root_url }}" class="btn btn--outline btn-sliding-hover" style="padding: 10px 18px; font-family: 'Quicksand', sans-serif; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; text-decoration: none; border-radius: var(--btn-radius, 0px) !important;">
        Back to Home
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
