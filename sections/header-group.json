85); }\n    50% { opacity: 1; transform: scale(1.15); }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .lv-ship-sparkle,\n    .lv-ship-title,\n    .lv-ship-amount,\n    .lv-ship-amount::after {\n      animation: none;\n    }\n  }\n</style>\n\n<span class=\"lv-ann-ship\">\n  <span class=\"lv-ship-sparkle\" aria-hidden=\"true\">✦</span>\n  <span class=\"lv-ship-title\">FREE SHIPPING</span>\n  <span class=\"lv-ship-from\">FROM</span>\n  <span class=\"lv-ship-amount\">€39</span>\n  <span class=\"lv-ship-sparkle lv-ship-sparkle--delay\" aria-hidden=\"true\">✦</span>\n</span>",
