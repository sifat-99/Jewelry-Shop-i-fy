            "text": "",
            "custom_html": "<style>\n  .lv-ann-cyber {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    flex-wrap: nowrap;\n    gap: 8px;\n    font-family: var(--TYPE-STACK-NAV, sans-serif);\n    font-size: clamp(10.5px, 2.5vw, 12px);\n    font-weight: 600;\n    letter-spacing: 0.14em;\n    line-height: 1.2;\n    text-transform: uppercase;\n    color: var(--ann-text, #1a1a1a);\n  }\n\n  .lv-ann-sparkle {\n    display: inline-block;\n    color: #9a7b4f;\n    font-size: 10px;\n    animation: lvAnnSparkle 2.4s ease-in-out infinite;\n  }\n\n  .lv-ann-sparkle--delay {\n    animation-delay: 1.2s;\n  }\n\n  .lv-ann-offer {\n    display: inline-block;\n    font-weight: 700;\n    background: linear-gradient(\n      110deg,\n      #5f4318 0%,\n      #8b6b38 28%,\n      #d4af37 46%,\n      #f2dc9b 50%,\n      #d4af37 54%,\n      #8b6b38 72%,\n      #5f4318 100%\n    );\n    color: transparent;\n    -webkit-background-clip: text;\n    background-clip: text;\n  }\n\n  .lv-ann-sep {\n    color: #b59a72;\n    font-weight: 400;\n  }\n\n  .lv-ann-code-label {\n    opacity: 0.8;\n    font-weight: 500;\n  }\n\n  .lv-ann-code {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    padding: 3px 9px;\n    border-radius: 0;\n    background: #856d49;\n    border: 1px solid #6e5838;\n    color: #ffffff;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    overflow: hidden;\n    /* button reset: the code is now a click-to-copy button */\n    appearance: none;\n    -webkit-appearance: none;\n    margin: 0;\n    font: inherit;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    line-height: inherit;\n    text-transform: uppercase;\n    cursor: pointer;\n    -webkit-tap-highlight-color: transparent;\n    transition: background-color 0.2s ease, border-color 0.2s ease;\n  }\n\n  .lv-ann-code:hover {\n    background: #6e5838;\n  }\n\n  .lv-ann-code:focus-visible {\n    outline: 2px solid #ffffff;\n    outline-offset: 2px;\n  }\n\n  .lv-ann-code.is-copied {\n    background: #4f7a4a;\n    border-color: #3f6a3b;\n  }\n\n  .lv-ann-code::after {\n    pointer-events: none;\n  }\n\n  .lv-ann-code::after {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 75%;\n    height: 100%;\n    background: linear-gradient(\n      115deg,\n      transparent 0%,\n      rgba(255, 245, 214, 0.45) 50%,\n      transparent 100%\n    );\n    transform: translateX(-150%);\n    will-change: transform;\n    animation: lvBadgeSweep 3.2s ease-in-out infinite;\n  }\n\n  @keyframes lvBadgeSweep {\n    0%, 35% { transform: translateX(-150%); }\n    75%, 100% { transform: translateX(250%); }\n  }\n\n  @keyframes lvAnnSparkle {\n    0%, 100% { opacity: 0.45; transform: scale(0.85); }\n    50% { opacity: 1; transform: scale(1.15); }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .lv-ann-sparkle,\n    .lv-ann-offer,\n    .lv-ann-code,\n    .lv-ann-code::after {\n      animation: none;\n    }\n  }\n</style>\n\n<span class=\"lv-ann-cyber\">\n  <span class=\"lv-ann-sparkle\" aria-hidden=\"true\">✦</span>\n  <span>CYBER MONDAY WEEK SALE</span>\n  <span class=\"lv-ann-offer\">20% OFF</span>\n  <span class=\"lv-ann-sep\" aria-hidden=\"true\">~</span>\n  <span class=\"lv-ann-code-label\">CODE:</span>\n  <button type=\"button\" class=\"lv-ann-code\" data-lv-copy=\"CYBER20\" aria-label=\"Copy code CYBER20\" title=\"Click to copy\"><span class=\"lv-ann-code__label\">CYBER20</span></button>\n  <span class=\"lv-ann-sparkle lv-ann-sparkle--delay\" aria-hidden=\"true\">✦</span>\n</span>\n\n<script>\n  (function () {\n    // Runs once even if this announcement is rendered/cloned more than once\n    if (window.__lvAnnCopyReady) return;\n    window.__lvAnnCopyReady = true;\n\n    function fallbackCopy(text) {\n      var ta = document.createElement('textarea');\n      ta.value = text;\n      ta.setAttribute('readonly', '');\n      ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0;';\n      document.body.appendChild(ta);\n      ta.select();\n      try { document.execCommand('copy'); } catch (e) {}\n      document.body.removeChild(ta);\n    }\n\n    function copyText(text) {\n      if (navigator.clipboard && window.isSecureContext) {\n        return navigator.clipboard.writeText(text).catch(function () { fallbackCopy(text); });\n      }\n      fallbackCopy(text);\n      return Promise.resolve();\n    }\n\n    document.addEventListener('click', function (e) {\n      var btn = e.target.closest && e.target.closest('[data-lv-copy]');\n      if (!btn) return;\n      e.preventDefault();\n      e.stopPropagation();\n\n      var code = btn.getAttribute('data-lv-copy');\n      var label = btn.querySelector('.lv-ann-code__label');\n      copyText(code).then(function () {\n        if (!label) return;\n        if (btn.__lvTimer) clearTimeout(btn.__lvTimer);\n        // keep the badge width stable while the text changes\n        btn.style.minWidth = btn.offsetWidth + 'px';\n        btn.style.justifyContent = 'center';\n        label.textContent = 'COPIED \\u2713';\n        btn.classList.add('is-copied');\n        btn.__lvTimer = setTimeout(function () {\n          label.textContent = code;\n          btn.classList.remove('is-copied');\n          btn.style.minWidth = '';\n        }, 1600);\n      });\n    });\n  })();\n</script>",
