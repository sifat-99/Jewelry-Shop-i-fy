<!-- /sections/section-mosaic.liquid -->
{%- liquid
  assign tile_count = section.blocks.size
  assign chosen_layout = section.settings.layout_style | default: 'auto'

  if chosen_layout == 'auto'
    if tile_count == 2
      assign active_layout = 'cols_2'
    elsif tile_count == 3
      assign active_layout = 'mosaic_right'
    elsif tile_count == 4
      assign active_layout = 'grid_2x2'
    elsif tile_count == 1
      assign active_layout = 'single'
    else
      assign active_layout = 'cols_3'
    endif
  else
    assign active_layout = chosen_layout
  endif

  assign mobile_mode = section.settings.mobile_layout | default: 'stacked'
  assign heading_pos = section.settings.heading_position | default: 'above'
  assign heading_align = section.settings.heading_align | default: 'center'

  assign setting_aspect = section.settings.tile_aspect_ratio | default: '3_2'
  if setting_aspect == 'fixed'
    assign section_ratio = 'none'
  elsif setting_aspect == 'adapt'
    assign section_ratio = 'adapt'
  elsif setting_aspect == '16_9'
    assign section_ratio = '16 / 9'
  elsif setting_aspect == '1_1'
    assign section_ratio = '1 / 1'
  elsif setting_aspect == '4_5'
    assign section_ratio = '4 / 5'
  elsif setting_aspect == '2_3'
    assign section_ratio = '2 / 3'
  else
    assign section_ratio = '3 / 2'
  endif
-%}

{{ 'banner.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} {
    --mosaic-gap: {{ section.settings.grid_gap | default: 14 }}px;
    --mosaic-radius: {{ section.settings.tile_radius | default: 0 }}px;
    --section-mosaic-height: 520px;
  }
  {% case section.settings.grid_height %}
    {% when 'small' %}
      #shopify-section-{{ section.id }} { --section-mosaic-height: 420px; }
    {% when 'large' %}
      #shopify-section-{{ section.id }} { --section-mosaic-height: 640px; }
    {% when 'adapt' %}
      #shopify-section-{{ section.id }} { --section-mosaic-height: auto; }
  {% endcase %}

  #shopify-section-{{ section.id }} .lv-mosaic-wrap {
    width: 100%;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .lv-mosaic-header {
    margin-bottom: 24px;
  }
  #shopify-section-{{ section.id }} .lv-mosaic-header--below {
    margin-top: 26px;
    margin-bottom: 0;
  }
  #shopify-section-{{ section.id }} .lv-mosaic-header--left .kicker-flourished {
    text-align: left;
  }
  #shopify-section-{{ section.id }} .lv-mosaic-header--left .kicker-flourished:after {
    left: 0;
    right: auto;
  }
  #shopify-section-{{ section.id }} .lv-mosaic-header--right .kicker-flourished {
    text-align: right;
  }
  #shopify-section-{{ section.id }} .lv-mosaic-header--right .kicker-flourished:after {
    left: auto;
    right: 0;
  }
  #shopify-section-{{ section.id }} .lv-mosaic-header--center .kicker-flourished {
    text-align: center;
  }
  #shopify-section-{{ section.id }} .lv-mosaic-header--center .kicker-flourished:after {
    left: 0;
    right: 0;
    margin-left: auto;
    margin-right: auto;
  }
  #shopify-section-{{ section.id }} .lv-mosaic-header-sub {
    font-family: var(--FONT-STACK-SUBHEADING, sans-serif);
    font-size: calc(13.5px * var(--FONT-ADJUST-ACCENT, 1));
    font-weight: var(--FONT-WEIGHT-SUBHEADING, 500);
    color: var(--text, #2b2622);
    margin: -6px auto 0 auto;
    letter-spacing: var(--FONT-SUBHEADING-LETTER-SPACING, 0.05em);
    text-transform: var(--FONT-SUBHEADING-TRANSFORM, none);
    max-width: 600px;
    opacity: 1;
  }
  #shopify-section-{{ section.id }} .lv-mosaic-header--left .lv-mosaic-header-sub {
    margin-left: 0;
    margin-right: auto;
  }
  #shopify-section-{{ section.id }} .lv-mosaic-header--right .lv-mosaic-header-sub {
    margin-left: auto;
    margin-right: 0;
  }

  #shopify-section-{{ section.id }} .lv-mosaic-container {
    display: grid;
    width: 100%;
    gap: var(--mosaic-gap);
    box-sizing: border-box;
  }

  {%- if section_ratio != 'none' -%}
    #shopify-section-{{ section.id }} .lv-mosaic-container {
      height: auto !important;
    }
    #shopify-section-{{ section.id }} .lv-mosaic-layout--single,
    #shopify-section-{{ section.id }} .lv-mosaic-layout--cols_2,
    #shopify-section-{{ section.id }} .lv-mosaic-layout--cols_3,
    #shopify-section-{{ section.id }} .lv-mosaic-layout--cols_4,
    #shopify-section-{{ section.id }} .lv-mosaic-layout--grid_2x2 {
      height: auto !important;
    }
    #shopify-section-{{ section.id }} .lv-mosaic-tile {
      height: auto !important;
      aspect-ratio: var(--tile-aspect-ratio, 3 / 2) !important;
    }
    @media (min-width: 768px) {
      #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_right,
      #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_left,
      #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_4_featured {
        height: auto !important;
      }
      #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_right > .lv-mosaic-tile:nth-child(3),
      #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_left > .lv-mosaic-tile:nth-child(1),
      #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_4_featured > .lv-mosaic-tile:nth-child(1) {
        height: 100% !important;
        aspect-ratio: auto !important;
      }
    }
    @media (max-width: 767px) {
      #shopify-section-{{ section.id }} .lv-mosaic-tile,
      #shopify-section-{{ section.id }} .lv-mobile--stacked .lv-mosaic-tile,
      #shopify-section-{{ section.id }} .lv-mobile--grid_2 .lv-mosaic-tile {
        height: auto !important;
        aspect-ratio: var(--tile-aspect-ratio-mobile, var(--tile-aspect-ratio, 3 / 2)) !important;
      }
      #shopify-section-{{ section.id }} .lv-mobile--scroll .lv-mosaic-tile {
        height: auto !important;
        flex: 0 0 85vw !important;
        aspect-ratio: var(--tile-aspect-ratio-mobile, var(--tile-aspect-ratio, 3 / 2)) !important;
      }
    }
  {%- endif -%}

  /* -------------------------------------------------------------
     Desktop Grid Layout Styles
     ------------------------------------------------------------- */
  @media (min-width: 768px) {
    /* 1. Single Banner */
    #shopify-section-{{ section.id }} .lv-mosaic-layout--single {
      grid-template-columns: 1fr;
      height: var(--section-mosaic-height);
    }

    /* 2. Two Equal Columns (50/50 Side by Side) */
    #shopify-section-{{ section.id }} .lv-mosaic-layout--cols_2 {
      grid-template-columns: repeat(2, 1fr);
      height: var(--section-mosaic-height);
    }

    /* 3. Three Equal Columns (1/3 each) */
    #shopify-section-{{ section.id }} .lv-mosaic-layout--cols_3 {
      grid-template-columns: repeat(3, 1fr);
      height: var(--section-mosaic-height);
    }

    /* 4. Four Equal Columns in 1 Row */
    #shopify-section-{{ section.id }} .lv-mosaic-layout--cols_4 {
      grid-template-columns: repeat(4, 1fr);
      height: var(--section-mosaic-height);
    }

    /* 5. 4 Grid (2x2 Quad Grid) */
    #shopify-section-{{ section.id }} .lv-mosaic-layout--grid_2x2 {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: 1fr 1fr;
      height: calc(var(--section-mosaic-height) * 1.15);
    }

    /* 6. Mosaic Right (2 Short Left, 1 Tall Right) */
    #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_right {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr 1fr;
      height: var(--section-mosaic-height);
    }
    #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_right > .lv-mosaic-tile:nth-child(1) {
      grid-column: 1;
      grid-row: 1;
    }
    #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_right > .lv-mosaic-tile:nth-child(2) {
      grid-column: 1;
      grid-row: 2;
    }
    #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_right > .lv-mosaic-tile:nth-child(3) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    /* 7. Mosaic Left (1 Tall Left, 2 Short Right) */
    #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_left {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr 1fr;
      height: var(--section-mosaic-height);
    }
    #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_left > .lv-mosaic-tile:nth-child(1) {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
    #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_left > .lv-mosaic-tile:nth-child(2) {
      grid-column: 2;
      grid-row: 1;
    }
    #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_left > .lv-mosaic-tile:nth-child(3) {
      grid-column: 2;
      grid-row: 2;
    }

    /* 8. Mosaic 4 Featured (1 Large Featured + 3 Stacked) */
    #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_4_featured {
      grid-template-columns: 1.35fr 1fr;
      grid-template-rows: repeat(3, 1fr);
      height: calc(var(--section-mosaic-height) * 1.25);
    }
    #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_4_featured > .lv-mosaic-tile:nth-child(1) {
      grid-column: 1;
      grid-row: 1 / span 3;
    }
    #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_4_featured > .lv-mosaic-tile:nth-child(2) {
      grid-column: 2;
      grid-row: 1;
    }
    #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_4_featured > .lv-mosaic-tile:nth-child(3) {
      grid-column: 2;
      grid-row: 2;
    }
    #shopify-section-{{ section.id }} .lv-mosaic-layout--mosaic_4_featured > .lv-mosaic-tile:nth-child(4) {
      grid-column: 2;
      grid-row: 3;
    }
  }

  /* -------------------------------------------------------------
     Individual Tile Card Styles
     ------------------------------------------------------------- */
  #shopify-section-{{ section.id }} .lv-mosaic-tile {
    position: relative;
    overflow: hidden;
    border-radius: var(--mosaic-radius);
    background-color: #f7f5f2;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .lv-tile-media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .lv-tile-media .banner-media__img,
  #shopify-section-{{ section.id }} .lv-tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #shopify-section-{{ section.id }} .lv-mosaic-tile:hover .lv-tile-media .banner-media__img,
  #shopify-section-{{ section.id }} .lv-mosaic-tile:hover .lv-tile-img {
    transform: scale(1.04);
  }

  #shopify-section-{{ section.id }} .lv-mosaic-tile--clickable {
    cursor: pointer;
  }

  /* 9-point banner content placement inside tiles */
  #shopify-section-{{ section.id }} .lv-tile-content-wrap {
    position: absolute;
    inset: 0;
    padding: 24px;
    display: flex;
    box-sizing: border-box;
    pointer-events: none;
    z-index: 6;
  }

  #shopify-section-{{ section.id }} .lv-tile-content-wrap.lv-align-top-left {
    align-items: flex-start;
    justify-content: flex-start;
  }
  #shopify-section-{{ section.id }} .lv-tile-content-wrap.lv-align-top-center {
    align-items: flex-start;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .lv-tile-content-wrap.lv-align-top-right {
    align-items: flex-start;
    justify-content: flex-end;
  }
  #shopify-section-{{ section.id }} .lv-tile-content-wrap.lv-align-middle-left {
    align-items: center;
    justify-content: flex-start;
  }
  #shopify-section-{{ section.id }} .lv-tile-content-wrap.lv-align-middle-center {
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .lv-tile-content-wrap.lv-align-middle-right {
    align-items: center;
    justify-content: flex-end;
  }
  #shopify-section-{{ section.id }} .lv-tile-content-wrap.lv-align-bottom-left {
    align-items: flex-end;
    justify-content: flex-start;
    padding-bottom: 28px;
  }
  #shopify-section-{{ section.id }} .lv-tile-content-wrap.lv-align-bottom-center {
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 28px;
  }
  #shopify-section-{{ section.id }} .lv-tile-content-wrap.lv-align-bottom-right {
    align-items: flex-end;
    justify-content: flex-end;
    padding-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .lv-tile-content {
    pointer-events: none;
    max-width: 90%;
  }

  #shopify-section-{{ section.id }} .lv-tile-subheading {
    font-family: var(--FONT-STACK-SUBHEADING, sans-serif) !important;
    font-size: 11px !important;
    font-weight: var(--FONT-WEIGHT-SUBHEADING, 600) !important;
    letter-spacing: var(--FONT-SUBHEADING-LETTER-SPACING, 0.16em) !important;
    text-transform: var(--FONT-SUBHEADING-TRANSFORM, uppercase) !important;
    margin: 0 0 6px 0;
  }

  #shopify-section-{{ section.id }} .lv-tile-title {
    font-family: var(--FONT-STACK-HEADING, sans-serif) !important;
    font-size: calc(clamp(16px, 1.8vw, 24px) * var(--FONT-ADJUST-HEADING, 1)) !important;
    font-weight: var(--FONT-WEIGHT-HEADING, 600) !important;
    letter-spacing: var(--FONT-HEADING-LETTER-SPACING, 0.08em) !important;
    text-transform: var(--FONT-HEADING-TRANSFORM, uppercase) !important;
    margin: 0;
    line-height: 1.25 !important;
  }

  /* Tile text tone options matching banner presets */
  #shopify-section-{{ section.id }} .lv-mosaic-tile.lv-tile-tone-light .lv-tile-subheading,
  #shopify-section-{{ section.id }} .lv-mosaic-tile.lv-tile-tone-light .lv-tile-title {
    color: #ffffff !important;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
  }
  #shopify-section-{{ section.id }} .lv-mosaic-tile.lv-tile-tone-dark .lv-tile-subheading,
  #shopify-section-{{ section.id }} .lv-mosaic-tile.lv-tile-tone-dark .lv-tile-title {
    color: #111111 !important;
    text-shadow: none;
  }
  #shopify-section-{{ section.id }} .lv-mosaic-tile.lv-tile-tone-scheme .lv-tile-subheading,
  #shopify-section-{{ section.id }} .lv-mosaic-tile.lv-tile-tone-scheme .lv-tile-title {
    color: rgb(var(--color-foreground)) !important;
    text-shadow: none;
  }

  #shopify-section-{{ section.id }} .lv-tile-btn-wrap {
    margin-top: 14px;
    pointer-events: auto;
    position: relative;
    z-index: 7;
    display: flex;
    justify-content: var(--tile-btn-justify, center);
  }

  #shopify-section-{{ section.id }} .lv-tile-btn {
    display: inline-flex !important;
    padding: 8px 24px !important;
    font-family: var(--TYPE-STACK-BUTTON, sans-serif) !important;
    font-size: 11px !important;
    font-weight: var(--TYPE-WEIGHT-BUTTON, 600) !important;
    letter-spacing: var(--FONT-BUTTON-LETTER-SPACING, 0.15em) !important;
    text-transform: var(--FONT-BUTTON-TRANSFORM, uppercase) !important;
    text-decoration: none !important;
    pointer-events: auto;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .lv-tile-btn--link {
    display: inline-block !important;
    padding: 0 0 3px 0 !important;
    background: transparent !important;
    border: 0 !important;
    border-bottom: 1px solid currentColor !important;
    letter-spacing: 0.08em !important;
    font-size: 12px !important;
    text-transform: none !important;
    transition: opacity 0.22s ease;
  }
  #shopify-section-{{ section.id }} .lv-mosaic-tile.lv-tile-tone-light .lv-tile-btn--link {
    color: #ffffff !important;
  }
  #shopify-section-{{ section.id }} .lv-mosaic-tile.lv-tile-tone-dark .lv-tile-btn--link {
    color: #111111 !important;
  }
  #shopify-section-{{ section.id }} .lv-mosaic-tile.lv-tile-tone-scheme .lv-tile-btn--link {
    color: rgb(var(--color-foreground)) !important;
  }
  #shopify-section-{{ section.id }} .lv-tile-btn--link:hover {
    opacity: 0.72;
  }

  #shopify-section-{{ section.id }} .lv-tile-clickable-link {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
    display: block;
    cursor: pointer;
  }

  /* -------------------------------------------------------------
     Mobile Display Options
     ------------------------------------------------------------- */
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .lv-mosaic-container {
      height: auto !important;
    }
    #shopify-section-{{ section.id }} .lv-tile-content-wrap {
      padding: 16px;
    }
    #shopify-section-{{ section.id }} .lv-tile-content-wrap.lv-align-bottom-left,
    #shopify-section-{{ section.id }} .lv-tile-content-wrap.lv-align-bottom-center,
    #shopify-section-{{ section.id }} .lv-tile-content-wrap.lv-align-bottom-right {
      padding-bottom: 18px;
    }

    /* 1. Stacked Mode (1 tile per row) */
    #shopify-section-{{ section.id }} .lv-mobile--stacked {
      grid-template-columns: 1fr !important;
      grid-template-rows: auto !important;
      gap: 12px !important;
    }
    #shopify-section-{{ section.id }} .lv-mobile--stacked .lv-mosaic-tile {
      {%- if section_ratio != 'none' -%}
        height: auto !important;
        aspect-ratio: var(--tile-aspect-ratio-mobile, var(--tile-aspect-ratio, 1)) !important;
      {%- else -%}
        height: 260px !important;
      {%- endif -%}
      grid-column: auto !important;
      grid-row: auto !important;
    }

    /* 2. 2 Columns Mode on Mobile */
    #shopify-section-{{ section.id }} .lv-mobile--grid_2 {
      grid-template-columns: repeat(2, 1fr) !important;
      grid-template-rows: auto !important;
      gap: 8px !important;
    }
    #shopify-section-{{ section.id }} .lv-mobile--grid_2 .lv-mosaic-tile {
      {%- if section_ratio != 'none' -%}
        height: auto !important;
        aspect-ratio: var(--tile-aspect-ratio-mobile, var(--tile-aspect-ratio, 1)) !important;
      {%- else -%}
        height: 180px !important;
      {%- endif -%}
      grid-column: auto !important;
      grid-row: auto !important;
    }
    #shopify-section-{{ section.id }} .lv-mobile--grid_2 .lv-tile-content-wrap {
      padding: 12px;
    }
    #shopify-section-{{ section.id }} .lv-mobile--grid_2 .lv-tile-title {
      font-size: 13px !important;
      letter-spacing: 0.08em !important;
    }
    #shopify-section-{{ section.id }} .lv-mobile--grid_2 .lv-tile-btn:not(.lv-tile-btn--link) {
      padding: 5px 14px !important;
      font-size: 9.5px !important;
    }

    /* 3. Mobile Mosaic (For 3 tiles: 2 short + 1 tall) */
    #shopify-section-{{ section.id }} .lv-mobile--mosaic {
      grid-template-columns: 1fr 1fr !important;
      grid-template-rows: 140px 140px !important;
      gap: 8px !important;
    }
    #shopify-section-{{ section.id }} .lv-mobile--mosaic > .lv-mosaic-tile {
      aspect-ratio: auto !important;
    }
    #shopify-section-{{ section.id }} .lv-mobile--mosaic > .lv-mosaic-tile:nth-child(1) {
      grid-column: 1 !important;
      grid-row: 1 !important;
      height: 100% !important;
    }
    #shopify-section-{{ section.id }} .lv-mobile--mosaic > .lv-mosaic-tile:nth-child(2) {
      grid-column: 1 !important;
      grid-row: 2 !important;
      height: 100% !important;
    }
    #shopify-section-{{ section.id }} .lv-mobile--mosaic > .lv-mosaic-tile:nth-child(3) {
      grid-column: 2 !important;
      grid-row: 1 / span 2 !important;
      height: 100% !important;
    }
    #shopify-section-{{ section.id }} .lv-mobile--mosaic .lv-tile-content-wrap {
      padding: 12px;
    }
    #shopify-section-{{ section.id }} .lv-mobile--mosaic .lv-tile-title {
      font-size: 13px !important;
      letter-spacing: 0.08em !important;
    }
    #shopify-section-{{ section.id }} .lv-mobile--mosaic .lv-tile-btn:not(.lv-tile-btn--link) {
      padding: 5px 14px !important;
      font-size: 9.5px !important;
    }

    /* 4. Horizontal Scroll Mode */
    #shopify-section-{{ section.id }} .lv-mobile--scroll {
      display: flex !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory !important;
      -webkit-overflow-scrolling: touch !important;
      padding-bottom: 8px;
      gap: 10px !important;
    }
    #shopify-section-{{ section.id }} .lv-mobile--scroll .lv-mosaic-tile {
      flex: 0 0 78vw !important;
      {%- if section_ratio != 'none' -%}
        height: auto !important;
        aspect-ratio: var(--tile-aspect-ratio-mobile, var(--tile-aspect-ratio, 1)) !important;
      {%- else -%}
        height: 320px !important;
      {%- endif -%}
      scroll-snap-align: start !important;
    }
  }
</style>

{%- capture mosaic_section_header -%}
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="lv-mosaic-header lv-mosaic-header--{{ heading_align }}{% if heading_pos == 'below' %} lv-mosaic-header--below{% endif %} text-{{ heading_align }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="kicker-flourished mb-r11">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="lv-mosaic-header-sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<div class="section-mosaic color-{{ section.settings.color_scheme | default: 'scheme-1' }} section-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="mosaic"
  style="--PT: {{ section.settings.padding_top | default: 20 }}px; --PB: {{ section.settings.padding_bottom | default: 30 }}px;">

  <div class="wrapper--full section-padding">
    {%- if heading_pos == 'above' -%}
      {{ mosaic_section_header }}
    {%- endif -%}

    <div class="lv-mosaic-wrap">
      <div class="lv-mosaic-container lv-mosaic-layout--{{ active_layout }} lv-mobile--{{ mobile_mode }}">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign fb_num = forloop.index | minus: 1 | modulo: 3 | plus: 1
              assign fallback_asset = 'mosaic_' | append: fb_num | append: '.jpg'

              assign has_content = false
              if block.settings.title != blank or block.settings.subheading != blank or block.settings.button_label != blank
                assign has_content = true
              endif

              assign raw_pos = block.settings.text_position | default: 'middle-center' | replace: '_', '-'
              if raw_pos == 'center'
                assign norm_pos = 'middle-center'
              else
                assign norm_pos = raw_pos
              endif

              assign eff_align = 'center'
              if norm_pos contains 'left'
                assign eff_align = 'left'
              elsif norm_pos contains 'right'
                assign eff_align = 'right'
              endif
              assign text_align_pick = block.settings.text_align | default: 'auto'
              if text_align_pick != 'auto'
                assign eff_align = text_align_pick
              endif

              case eff_align
                when 'left'
                  assign btn_justify = 'flex-start'
                when 'right'
                  assign btn_justify = 'flex-end'
                else
                  assign btn_justify = 'center'
              endcase

              assign overlay_val = block.settings.overlay_opacity
              if overlay_val == blank
                if section.settings.overlay_opacity != blank and section.settings.overlay_opacity > 0
                  assign overlay_val = section.settings.overlay_opacity
                elsif has_content
                  assign overlay_val = 20
                else
                  assign overlay_val = 0
                endif
              endif

              assign tile_scheme = block.settings.color_scheme | default: section.settings.color_scheme | default: 'scheme-5'
              assign tile_tone = block.settings.text_tone | default: 'light'
              assign tile_btn_style = block.settings.button_style | default: 'outline_light'

              assign tile_banner_url = block.settings.banner_link
              if tile_banner_url == blank
                assign tile_banner_url = block.settings.link
              endif
              if tile_banner_url == blank
                assign tile_banner_url = block.settings.button_link
              endif

              assign tile_button_url = block.settings.button_link
              if tile_button_url == blank
                assign tile_button_url = tile_banner_url
              endif

              assign use_video = false
              if block.settings.media_type == 'video'
                if block.settings.video != blank or block.settings.video_mobile != blank
                  assign use_video = true
                endif
              endif

              if section_ratio == 'adapt'
                if use_video
                  assign tile_ratio = block.settings.video.aspect_ratio | default: block.settings.video_mobile.aspect_ratio | default: 1.5
                else
                  assign tile_ratio = block.settings.image.aspect_ratio | default: 1.5
                endif
              else
                assign tile_ratio = section_ratio
              endif

              if section_ratio == 'adapt'
                if use_video
                  assign tile_ratio_mobile = block.settings.video_mobile.aspect_ratio | default: block.settings.video.aspect_ratio | default: tile_ratio
                elsif block.settings.image_mobile != blank
                  assign tile_ratio_mobile = block.settings.image_mobile.aspect_ratio | default: tile_ratio
                else
                  assign tile_ratio_mobile = tile_ratio
                endif
              else
                assign tile_ratio_mobile = tile_ratio
              endif
            -%}

            <div class="lv-mosaic-tile lv-tile-{{ block.id }} lv-tile-tone-{{ tile_tone }} {% if has_content %}has-content{% else %}image-only{% endif %} color-{{ tile_scheme }}{% if tile_banner_url != blank %} lv-mosaic-tile--clickable{% endif %}"
              style="--tile-aspect-ratio: {{ tile_ratio }}; --tile-aspect-ratio-mobile: {{ tile_ratio_mobile }};"
              {{ block.shopify_attributes }}>

              <!-- Tile Media (Image or Video) -->
              <div class="lv-tile-media">
                {%- render 'banner-media',
                  settings: block.settings,
                  alt: block.settings.title,
                  eager: false,
                  fallback: fallback_asset
                -%}

                {%- if overlay_val > 0 -%}
                  {%- render 'banner-overlay',
                    opacity: overlay_val,
                    style: block.settings.overlay_style,
                    position: norm_pos
                  -%}
                {%- endif -%}
              </div>

              <!-- Full Tile Clickable Link -->
              {%- if tile_banner_url != blank -%}
                {%- assign mosaic_banner_fallback = 'sections.mosaic.banner_fallback' | t -%}
                <a href="{{ tile_banner_url }}" class="lv-tile-clickable-link" aria-label="{{ block.settings.title | default: mosaic_banner_fallback | escape }}"></a>
              {%- endif -%}

              <!-- Tile Text Content (Positioned via dropdown) -->
              {%- if has_content -%}
                <div class="lv-tile-content-wrap lv-align-{{ norm_pos }}">
                  <div class="lv-tile-content" style="text-align: {{ eff_align }};">
                    {%- if block.settings.subheading != blank -%}
                      <p class="lv-tile-subheading">{{ block.settings.subheading }}</p>
                    {%- endif -%}
                    {%- if block.settings.title != blank -%}
                      <h3 class="lv-tile-title">{{ block.settings.title }}</h3>
                    {%- endif -%}
                    {%- if block.settings.button_label != blank -%}
                      <div class="lv-tile-btn-wrap" style="--tile-btn-justify: {{ btn_justify }};">
                        {%- if tile_btn_style == 'link' -%}
                          {%- if tile_button_url != blank -%}
                            <a href="{{ tile_button_url }}" class="lv-tile-btn lv-tile-btn--link">{{ block.settings.button_label }}</a>
                          {%- else -%}
                            <span class="lv-tile-btn lv-tile-btn--link">{{ block.settings.button_label }}</span>
                          {%- endif -%}
                        {%- elsif tile_btn_style == 'outline_light' -%}
                          {%- if tile_button_url != blank -%}
                            <a href="{{ tile_button_url }}" class="btn btn--outline btn--white btn-sliding-hover lv-tile-btn">
                              <span class="btn__text-content">{{ block.settings.button_label }}</span>
                            </a>
                          {%- else -%}
                            <span class="btn btn--outline btn--white btn-sliding-hover lv-tile-btn">
                              <span class="btn__text-content">{{ block.settings.button_label }}</span>
                            </span>
                          {%- endif -%}
                        {%- else -%}
                          {%- if tile_button_url != blank -%}
                            <a href="{{ tile_button_url }}" class="banner__btn banner__btn--{{ tile_btn_style | replace: '_', '-' }} lv-tile-btn">{{ block.settings.button_label }}</a>
                          {%- else -%}
                            <span class="banner__btn banner__btn--{{ tile_btn_style | replace: '_', '-' }} lv-tile-btn">{{ block.settings.button_label }}</span>
                          {%- endif -%}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    {%- if heading_pos == 'below' -%}
      {{ mosaic_section_header }}
    {%- endif -%}
  </div>
</div>

<script src="{{ 'banner.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Mosaic & Grid Banner",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading"
    },
    {
      "type": "select",
      "id": "heading_position",
      "label": "Heading & subheading placement",
      "options": [
        { "value": "above", "label": "Above grid" },
        { "value": "below", "label": "Below grid" }
      ],
      "default": "above"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading & subheading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Grid layout style",
      "options": [
        { "value": "auto", "label": "Smart Auto (Adapts to number of tiles)" },
        { "value": "cols_2", "label": "2 Columns (Side by Side 50/50)" },
        { "value": "mosaic_right", "label": "Mosaic - 2 Left, 1 Tall Right (3 tiles)" },
        { "value": "mosaic_left", "label": "Mosaic - 1 Tall Left, 2 Right (3 tiles)" },
        { "value": "cols_3", "label": "3 Columns (Equal width)" },
        { "value": "grid_2x2", "label": "4 Grid (2x2 Quad Grid)" },
        { "value": "cols_4", "label": "4 Columns (Equal width in 1 row)" },
        { "value": "mosaic_4_featured", "label": "4 Mosaic (1 Large Featured + 3 Stacked)" }
      ],
      "default": "auto",
      "info": "Choose a preset layout or keep 'Smart Auto' to format automatically."
    },
    {
      "type": "select",
      "id": "grid_height",
      "label": "Desktop grid height",
      "options": [
        { "value": "small", "label": "Small (420px)" },
        { "value": "medium", "label": "Medium (520px - Recommended)" },
        { "value": "large", "label": "Large (640px)" },
        { "value": "adapt", "label": "Adapt to media" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "tile_aspect_ratio",
      "label": "Aspect ratio (Desktop & Mobile)",
      "options": [
        { "value": "3_2", "label": "Landscape (3:2 - Recommended)" },
        { "value": "adapt", "label": "Adapt to media (Never crops)" },
        { "value": "16_9", "label": "Widescreen (16:9)" },
        { "value": "1_1", "label": "Square (1:1)" },
        { "value": "4_5", "label": "Portrait (4:5)" },
        { "value": "2_3", "label": "Tall Portrait (2:3)" },
        { "value": "fixed", "label": "Fixed height (Legacy)" }
      ],
      "default": "3_2",
      "info": "Preserves the exact aspect ratio on all desktop and mobile devices so images and videos never crop or distort."
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout style",
      "options": [
        { "value": "stacked", "label": "1 per row (Stacked)" },
        { "value": "grid_2", "label": "2 per row (Compact Grid)" },
        { "value": "mosaic", "label": "Mosaic (2 short + 1 tall)" },
        { "value": "scroll", "label": "Swipeable Carousel (Horizontal scroll)" }
      ],
      "default": "stacked"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Spacing between tiles",
      "default": 14
    },
    {
      "type": "range",
      "id": "tile_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Tile corner radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 30
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Default dark overlay opacity",
      "default": 0,
      "info": "Global dark overlay for all tiles (0% = pure bright media). Can also be customized per tile block."
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Color scheme",
          "default": "scheme-5"
        },
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image (Optional)",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Desktop video",
          "info": "Upload an MP4 (H.264), ideally under 10 MB. Plays muted and looped automatically.",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "video",
          "id": "video_mobile",
          "label": "Mobile video (Optional)",
          "info": "Optional. Falls back to the desktop video.",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "select",
          "id": "video_focus",
          "label": "Video focus",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center",
          "info": "Which part of the video stays visible when it is cropped to fit the tile.",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading / Tagline"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading / Title"
        },
        {
          "type": "url",
          "id": "banner_link",
          "label": "Tile link",
          "info": "Clicking anywhere on this tile will open this link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link",
          "info": "Link for button (Optional, defaults to tile link)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL (Legacy fallback)",
          "info": "Whole tile is clickable if link is provided"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Heading & subheading position",
          "options": [
            { "value": "top-left", "label": "Top left" },
            { "value": "top-center", "label": "Top center" },
            { "value": "top-right", "label": "Top right" },
            { "value": "middle-left", "label": "Middle left" },
            { "value": "middle-center", "label": "Middle center" },
            { "value": "middle-right", "label": "Middle right" },
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "bottom-center", "label": "Bottom center" },
            { "value": "bottom-right", "label": "Bottom right" }
          ],
          "default": "middle-center"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text alignment",
          "info": "Auto follows the selected position.",
          "options": [
            { "value": "auto", "label": "Auto (follow position)" },
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "auto"
        },
        {
          "type": "select",
          "id": "text_tone",
          "label": "Text color",
          "options": [
            { "value": "light", "label": "Light text (for dark images / video)" },
            { "value": "dark", "label": "Dark text" },
            { "value": "scheme", "label": "Use color scheme text color" }
          ],
          "default": "light"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "outline_light", "label": "Outline light" },
            { "value": "outline_dark", "label": "Outline dark" },
            { "value": "solid_light", "label": "Solid light" },
            { "value": "solid_dark", "label": "Solid dark" },
            { "value": "link", "label": "Underlined text link" }
          ],
          "default": "outline_light"
        },
        {
          "type": "header",
          "content": "Overlay"
        },
        {
          "type": "select",
          "id": "overlay_style",
          "label": "Overlay style",
          "options": [
            { "value": "full", "label": "Full tile" },
            { "value": "gradient", "label": "Smooth gradient behind text only" }
          ],
          "default": "full"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "Dark overlay opacity",
          "default": 25,
          "info": "0% = pure bright media. Gradient fades from the chosen text position."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mosaic & Grid Banner",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
