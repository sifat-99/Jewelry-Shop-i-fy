{%- comment -%}
  Reviews of the current product (from the "review" metaobject) + "Write a review" button.
  Place it on the product template. Reviews are written through the reviews API (Theme settings > Reviews).
{%- endcomment -%}
{%- liquid
  capture rs
    render 'product-review-stats', product_id: product.id
  endcapture
  assign st = rs | split: '~~'
  assign avg = st[0]
  assign cnt = st[1] | plus: 0
  assign endpoint = section.settings.form_endpoint | default: settings.reviews_api_url | default: 'https://le-velair-reviews-api.vercel.app/api/review'
  assign initial = section.settings.initial_count | default: 6
-%}
<section id="product-reviews" class="pr color-{{ section.settings.color_scheme | default: 'scheme-1' }}" style="--PT: {{ section.settings.padding_top | default: 48 }}px; --PB: {{ section.settings.padding_bottom | default: 48 }}px;">
  <div class="pr__inner wrapper--full section-padding">
    <h2 class="pr__title kicker-flourished">{{ section.settings.heading | default: 'Customer reviews' | escape }}</h2>

    <div class="pr__top">
      {%- if cnt > 0 -%}
        <div class="pr__sum">
          <p class="pr__avg">{{ avg }}</p>
          <span class="lv-stars pr__sumstars" style="--r: {{ avg }}" aria-hidden="true">★★★★★</span>
          <p class="pr__count">Based on {{ cnt }} {% if cnt == 1 %}review{% else %}reviews{% endif %}</p>
        </div>
        <div class="pr__bars">
          {%- for i in (0..4) -%}
            {%- assign star = 5 | minus: i -%}
            {%- assign idx = i | plus: 2 -%}
            {%- assign n = st[idx] | plus: 0 -%}
            <div class="pr__bar"><span>{{ star }} ★</span><div class="pr__track"><i style="width: {{ n | times: 100.0 | divided_by: cnt }}%"></i></div><span>{{ n }}</span></div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="pr__none">No reviews yet. Be the first to share your experience.</p>
      {%- endif -%}
      {%- if endpoint != blank -%}
        <div class="pr__cta">{%- render 'review-form', endpoint: endpoint, sid: section.id, product_id: product.id, product_title: product.title, button_label: 'Write a review' -%}</div>
      {%- endif -%}
    </div>

    {%- if cnt > 0 -%}
      <div class="pr__list" data-pr-list>
        {%- assign shown = 0 -%}
        {%- for e in shop.metaobjects.review.values -%}
          {%- if e.product.value.id == product.id and e.approved != false -%}
            {%- assign shown = shown | plus: 1 -%}
            <div class="pr__item{% if shown > initial %} pr__item--extra{% endif %}"{% if shown > initial %} hidden{% endif %}>
              {%- render 'feedback-card', name: e.name, rating: e.rating.value, title: e.title, body: e.body, photo: e.photo.value, product_title: '', verified: e.verified.value, date: e.date.value -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if cnt > initial -%}
        <div class="pr__more"><button type="button" class="btn btn--outline" data-pr-more>Show more reviews</button></div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<style>
  #product-reviews { padding: var(--PT) 0 var(--PB); background: var(--bg, #fff); color: var(--text, #111); --cf-accent: var(--lv-accent, #9b7c53); --cf-line: var(--hairline, rgba(0, 0, 0, 0.14)); scroll-margin-top: 90px; }
  #product-reviews .pr__title { margin: 0 0 clamp(22px, 3vw, 34px); text-align: center; font-size: clamp(20px, 2.6vw, 28px); font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  #product-reviews .pr__top { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: clamp(20px, 4vw, 56px); align-items: center; max-width: 980px; margin: 0 auto clamp(26px, 4vw, 44px); padding: 26px clamp(18px, 3vw, 36px); border: 1px solid var(--cf-line); background: color-mix(in srgb, var(--text, #111) 3%, var(--bg, #fff)); }
  #product-reviews .pr__sum { text-align: center; }
  #product-reviews .pr__avg { margin: 0; font-size: 46px; font-weight: 600; line-height: 1; letter-spacing: .02em; }
  #product-reviews .pr__sumstars { font-size: 20px; margin: 8px 0 6px; }
  #product-reviews .pr__count { margin: 0; font-size: 12.5px; opacity: .65; }
  #product-reviews .pr__bars { display: grid; gap: 6px; min-width: 0; }
  #product-reviews .pr__bar { display: grid; grid-template-columns: 34px minmax(0, 1fr) 24px; gap: 10px; align-items: center; font-size: 12px; }
  #product-reviews .pr__bar span:last-child { text-align: right; opacity: .65; }
  #product-reviews .pr__track { height: 6px; background: color-mix(in srgb, var(--text, #111) 12%, transparent); }
  #product-reviews .pr__track i { display: block; height: 100%; background: var(--cf-accent); }
  #product-reviews .pr__none { margin: 0; grid-column: 1 / 3; font-size: 14.5px; opacity: .75; }
  #product-reviews .pr__cta .rf { margin-top: 0; }
  #product-reviews .pr__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; max-width: 980px; margin: 0 auto; }
  #product-reviews .pr__item { display: flex; min-width: 0; }
  #product-reviews .pr__item[hidden] { display: none; }
  #product-reviews .pr__more { text-align: center; margin-top: 28px; }
  #product-reviews .cf-card { display: flex; flex-direction: column; gap: 12px; width: 100%; box-sizing: border-box; padding: 24px 22px 20px; background: color-mix(in srgb, var(--text, #111) 3%, var(--bg, #fff)); border: 1px solid var(--cf-line); border-radius: var(--card-radius, 0); }
  #product-reviews .cf-stars { display: inline-block; font-size: 17px; letter-spacing: 2px; line-height: 1; color: transparent; background: linear-gradient(90deg, var(--cf-accent) calc(var(--r, 5) / 5 * 100%), color-mix(in srgb, var(--text, #111) 18%, transparent) 0); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  #product-reviews .cf-card__title { margin: 0; font-size: 14px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; line-height: 1.4; }
  #product-reviews .cf-card__text { margin: 0; font-size: 14.5px; line-height: 1.75; flex: 1 1 auto; }
  #product-reviews .cf-card__by { display: flex; align-items: center; gap: 12px; margin-top: 6px; padding-top: 16px; border-top: 1px solid var(--cf-line); }
  #product-reviews .cf-card__avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex: none; }
  #product-reviews .cf-card__avatar--initial { display: inline-flex; align-items: center; justify-content: center; background: var(--text, #111); color: var(--bg, #fff); font-size: 16px; font-weight: 700; }
  #product-reviews .cf-card__who { min-width: 0; }
  #product-reviews .cf-card__name { margin: 0; font-size: 13.5px; font-weight: 700; letter-spacing: .04em; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; }
  #product-reviews .cf-card__verified { display: inline-flex; align-items: center; color: var(--cf-accent); cursor: help; }
  #product-reviews .cf-card__verified svg { width: 20px; height: 20px; }
  #product-reviews .cf-card__meta { margin: 2px 0 0; font-size: 12px; opacity: .65; }
  @media (max-width: 820px) {
    #product-reviews .pr__top { grid-template-columns: minmax(0, 1fr); text-align: center; }
    #product-reviews .pr__none { grid-column: auto; }
    #product-reviews .pr__list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
<script>
  (function () {
    var btn = document.querySelector('#product-reviews [data-pr-more]');
    if (!btn) return;
    btn.addEventListener('click', function () {
      document.querySelectorAll('#product-reviews .pr__item--extra').forEach(function (el) { el.hidden = false; });
      btn.parentNode.hidden = true;
    });
  })();
</script>

{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "class": "section-product-reviews",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer reviews" },
    { "type": "range", "id": "initial_count", "min": 2, "max": 20, "step": 2, "label": "Reviews shown at first", "default": 6 },
    { "type": "url", "id": "form_endpoint", "label": "Reviews API URL (optional)", "info": "Leave empty to use Theme settings > Reviews." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ]
}
{% endschema %}
