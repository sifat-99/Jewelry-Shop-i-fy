<!-- /sections/size-guide.liquid  (Size guide page: tabs per jewelry type, size chart, how-to-measure, ring size calculator) -->
{%- liquid
  assign page_heading = section.settings.heading | default: page.title | default: 'Size guide'
-%}

<div class="sg color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  data-sg-root
  data-section-id="{{ section.id }}"
  style="--sg-pt: {{ section.settings.padding_top | default: 40 }}px; --sg-pb: {{ section.settings.padding_bottom | default: 65 }}px;">

  <style>
    .sg {
      padding-top: var(--sg-pt, 40px);
      padding-bottom: var(--sg-pb, 65px);
      --sg-muted: rgba(var(--color-foreground, 17, 17, 17), 0.62);
      --sg-line: var(--lv-border);
      --sg-soft: rgba(var(--color-foreground, 17, 17, 17), 0.035);
    }
    .sg__inner {
      width: 100%;
      max-width: none;
      margin: 0 auto;
      padding: 0 var(--outer, 24px);
      box-sizing: border-box;
    }
    .sg__head { text-align: center; max-width: 720px; margin: 0 auto 32px; }
    .sg__title {
      margin: 0 0 12px;
      font-size: clamp(26px, 3.4vw, 42px);
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      line-height: 1.15;
    }
    .sg__intro { margin: 0; font-size: 14.5px; line-height: 1.7; color: var(--sg-muted); }

    /* Tabs: same border / radius / hover colors as the universal buttons */
    .sg__tabs {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin: 0 0 32px;
      padding: 2px;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .sg__tabs::-webkit-scrollbar { display: none; }
    .sg__tab {
      flex: 0 0 auto;
      min-height: var(--ctl-h, 44px);
      padding: 0 24px;
      cursor: pointer;
      background: transparent;
      color: inherit;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      border: var(--btn-border-thickness, 1px) solid var(--btn-regular-border, var(--sg-line));
      border-radius: var(--btn-radius, 0px);
      transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    }
    .sg__tab:hover { border-color: var(--btn-regular-hover-border, currentColor); }
    .sg__tab[aria-selected="true"] {
      background: var(--btn-regular-hover-bg, #111);
      color: var(--btn-regular-hover-text, #fff);
      border-color: var(--btn-regular-hover-border, #111);
    }
    .sg__tab:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }

    /* Panel */
    .sg__panel[hidden] { display: none; }
    .sg__panel-intro { max-width: 720px; margin: 0 auto 28px; text-align: center; font-size: 14.5px; line-height: 1.7; color: var(--sg-muted); }
    .sg__grid {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: clamp(28px, 4vw, 64px);
      align-items: start;
    }
    @media (max-width: 900px) { .sg__grid { grid-template-columns: minmax(0, 1fr); } }
    .sg__h {
      margin: 0 0 14px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .sg__col > * + .sg__h { margin-top: 36px; }

    /* Table */
    .sg__table-wrap {
      overflow-x: auto;
      border: 1px solid var(--sg-line);
      border-radius: var(--card-radius, 0px);
      -webkit-overflow-scrolling: touch;
    }
    .sg__table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 420px; }
    .sg__table th, .sg__table td { padding: 13px 16px; text-align: left; white-space: nowrap; }
    .sg__table th {
      font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      background: var(--sg-soft); border-bottom: 1px solid var(--sg-line);
    }
    .sg__table td { border-bottom: 1px solid var(--sg-line); }
    .sg__table tr:last-child td { border-bottom: 0; }
    .sg__table tbody tr { transition: background-color 0.2s ease; }
    .sg__table tbody tr:hover { background: var(--sg-soft); }
    .sg__table tbody td:first-child { font-weight: 700; }
    .sg__table tbody tr.is-match { background: var(--btn-regular-hover-bg, #111); color: var(--btn-regular-hover-text, #fff); }
    .sg__table tbody tr.is-match td { border-color: transparent; }

    /* Steps + tips */
    .sg__steps { margin: 0; padding: 0; list-style: none; counter-reset: sg; }
    .sg__steps li {
      position: relative; counter-increment: sg; padding: 0 0 16px 44px; font-size: 14px; line-height: 1.65;
    }
    .sg__steps li::before {
      content: counter(sg);
      position: absolute; left: 0; top: -2px; width: 30px; height: 30px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 12px; font-weight: 700; border: 1px solid var(--sg-line); background: var(--sg-soft);
    }
    .sg__tips {
      margin: 20px 0 0; padding: 16px 18px; list-style: none;
      background: var(--sg-soft); border: 1px solid var(--sg-line); border-radius: var(--card-radius, 0px);
      font-size: 13.5px; line-height: 1.6;
    }
    .sg__tips li { display: flex; gap: 10px; }
    .sg__tips li + li { margin-top: 8px; }
    .sg__tips li::before { content: "\2726"; flex: 0 0 auto; font-size: 11px; margin-top: 3px; }
    .sg__media { margin-top: 24px; }
    .sg__media img { width: 100%; height: auto; display: block; border-radius: var(--card-radius, 0px); }

    /* Ring calculator */
    .sg__calc { margin-top: 28px; padding: 20px; border: 1px solid var(--sg-line); border-radius: var(--card-radius, 0px); background: var(--sg-soft); }
    .sg__calc-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: stretch; }
    .sg__calc select, .sg__calc input {
      min-height: var(--ctl-h, 44px); padding: 0 14px; font-size: 14px; color: inherit; background: var(--bg, #fff);
      border: var(--btn-border-thickness, 1px) solid var(--btn-regular-border, var(--sg-line));
      border-radius: var(--input-radius, 0px); box-sizing: border-box;
    }
    .sg__calc select { flex: 1 1 170px; }
    .sg__calc input { flex: 1 1 110px; min-width: 0; }
    .sg__calc-result { margin: 14px 0 0; font-size: 14px; line-height: 1.6; min-height: 22px; }
    .sg__calc-result strong { font-size: 18px; }

    /* Contact CTA */
    .sg__cta { margin-top: 56px; padding: 32px 20px; text-align: center; border: 1px solid var(--sg-line); border-radius: var(--card-radius, 0px); background: var(--sg-soft); }
    .sg__cta h2 { margin: 0 0 8px; font-size: 18px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
    .sg__cta p { margin: 0 0 18px; font-size: 14px; color: var(--sg-muted); }
    @media (prefers-reduced-motion: reduce) { .sg__tab, .sg__table tbody tr { transition: none; } }
  </style>

  <div class="sg__inner">
    {% render 'breadcrumb', current: page_heading %}
    <header class="sg__head">
      <h1 class="sg__title">{{ page_heading }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="sg__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="sg__tabs" role="tablist" aria-label="Jewelry type" data-sg-tabs>
        {%- for block in section.blocks -%}
          {%- assign tab_key = block.settings.key | default: block.settings.title | handleize -%}
          <button type="button" class="sg__tab" role="tab" id="sg-tab-{{ block.id }}" aria-controls="sg-panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" data-sg-tab data-key="{{ tab_key | downcase }}" {{ block.shopify_attributes }}>
            {{ block.settings.title | default: 'Guide' }}
          </button>
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        {%- liquid
          assign head_cells = block.settings.table_head | split: '|'
          assign row_lines = block.settings.table_rows | newline_to_br | split: '<br />'
          assign step_lines = block.settings.steps | newline_to_br | split: '<br />'
          assign tip_lines = block.settings.tips | newline_to_br | split: '<br />'
        -%}
        <section class="sg__panel" role="tabpanel" id="sg-panel-{{ block.id }}" aria-labelledby="sg-tab-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %} data-sg-panel>
          {%- if block.settings.intro != blank -%}
            <p class="sg__panel-intro">{{ block.settings.intro }}</p>
          {%- endif -%}

          <div class="sg__grid">
            <div class="sg__col">
              {%- if block.settings.table_rows != blank -%}
                <h2 class="sg__h">{{ block.settings.table_title | default: 'Size chart' }}</h2>
                <div class="sg__table-wrap">
                  <table class="sg__table" data-sg-table>
                    {%- if block.settings.table_head != blank -%}
                      <thead>
                        <tr>
                          {%- for cell in head_cells -%}<th scope="col">{{ cell | strip }}</th>{%- endfor -%}
                        </tr>
                      </thead>
                    {%- endif -%}
                    <tbody>
                      {%- for line in row_lines -%}
                        {%- assign line_clean = line | strip -%}
                        {%- if line_clean != blank -%}
                          {%- assign cells = line_clean | split: '|' -%}
                          <tr>
                            {%- for cell in cells -%}<td>{{ cell | strip }}</td>{%- endfor -%}
                          </tr>
                        {%- endif -%}
                      {%- endfor -%}
                    </tbody>
                  </table>
                </div>
              {%- endif -%}

              {%- if block.settings.calculator == 'ring' -%}
                <div class="sg__calc" data-sg-calc>
                  <h2 class="sg__h">Find your ring size</h2>
                  <div class="sg__calc-row">
                    <select data-sg-calc-mode aria-label="What did you measure?">
                      <option value="circ">Finger circumference (mm)</option>
                      <option value="diam">Ring inner diameter (mm)</option>
                    </select>
                    <input type="number" inputmode="decimal" min="30" max="90" step="0.1" placeholder="e.g. 54" data-sg-calc-value aria-label="Measurement in millimetres">
                  </div>
                  <p class="sg__calc-result" data-sg-calc-result aria-live="polite">Enter your measurement to see your size.</p>
                </div>
              {%- endif -%}
            </div>

            <div class="sg__col">
              {%- if block.settings.steps != blank -%}
                <h2 class="sg__h">{{ block.settings.steps_title | default: 'How to measure' }}</h2>
                <ol class="sg__steps">
                  {%- for line in step_lines -%}
                    {%- assign step_clean = line | strip -%}
                    {%- if step_clean != blank -%}<li>{{ step_clean }}</li>{%- endif -%}
                  {%- endfor -%}
                </ol>
              {%- endif -%}

              {%- if block.settings.tips != blank -%}
                <ul class="sg__tips">
                  {%- for line in tip_lines -%}
                    {%- assign tip_clean = line | strip -%}
                    {%- if tip_clean != blank -%}<li>{{ tip_clean }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if block.settings.image != blank -%}
                <div class="sg__media">
                  <img src="{{ block.settings.image | image_url: width: 900 }}"
                    srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1400 }} 1400w"
                    sizes="(min-width: 901px) 40vw, 92vw"
                    alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                    width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
                </div>
              {%- endif -%}
            </div>
          </div>
        </section>
      {%- endfor -%}
    {%- else -%}
      <p style="text-align: center;">Add guides (Rings, Bracelets, Necklaces...) in the theme editor.</p>
    {%- endif -%}

    {%- if section.settings.cta_title != blank -%}
      <div class="sg__cta">
        <h2>{{ section.settings.cta_title }}</h2>
        {%- if section.settings.cta_text != blank -%}<p>{{ section.settings.cta_text }}</p>{%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: routes.root_url }}" class="btn btn--primary btn-sliding-hover">
            <span class="btn__text-content">{{ section.settings.cta_label }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {% raw %}
  <script>
    (function () {
      var root = document.currentScript.closest('[data-sg-root]');
      if (!root || root.dataset.sgReady) return;
      root.dataset.sgReady = '1';
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-sg-tab]'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('[data-sg-panel]'));

      function select(i, focus) {
        tabs.forEach(function (t, n) {
          var on = n === i;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.tabIndex = on ? 0 : -1;
          if (panels[n]) panels[n].hidden = !on;
        });
        if (focus) tabs[i].focus();
        if (tabs[i] && tabs[i].scrollIntoView) tabs[i].scrollIntoView({ block: 'nearest', inline: 'center' });
      }
      tabs.forEach(function (t, i) {
        t.addEventListener('click', function () {
          select(i);
          if (window.history && window.history.replaceState) {
            try { window.history.replaceState(null, '', '#' + t.dataset.key); } catch (e) {}
          }
        });
        t.addEventListener('keydown', function (e) {
          var n = null;
          if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
          else if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
          else if (e.key === 'Home') n = 0;
          else if (e.key === 'End') n = tabs.length - 1;
          if (n !== null) { e.preventDefault(); select(n, true); }
        });
      });

      /* Open the tab named in the URL hash, e.g. /pages/size-guide#ring (product pages link here) */
      function fromHash() {
        var h = (window.location.hash || '').replace('#', '').toLowerCase();
        if (!h) return;
        var idx = tabs.findIndex(function (t) { return t.dataset.key === h; });
        if (idx > -1) select(idx);
      }
      fromHash();
      window.addEventListener('hashchange', fromHash);

      /* Ring size calculator */
      root.querySelectorAll('[data-sg-calc]').forEach(function (calc) {
        var mode = calc.querySelector('[data-sg-calc-mode]');
        var input = calc.querySelector('[data-sg-calc-value]');
        var out = calc.querySelector('[data-sg-calc-result]');
        var panel = calc.closest('[data-sg-panel]');
        var rows = panel ? Array.prototype.slice.call(panel.querySelectorAll('[data-sg-table] tbody tr')) : [];
        function run() {
          rows.forEach(function (r) { r.classList.remove('is-match'); });
          var v = parseFloat(String(input.value).replace(',', '.'));
          if (!v || v <= 0) { out.textContent = 'Enter your measurement to see your size.'; return; }
          var d = mode.value === 'circ' ? v / Math.PI : v;
          if (d < 12 || d > 26) { out.textContent = 'That looks unusual - please measure again (finger circumference is usually 45-70 mm).'; return; }
          var size = Math.round(d);
          var between = Math.abs(d - Math.round(d)) > 0.3;
          var text = 'Your size: ';
          out.innerHTML = '';
          var strong = document.createElement('strong');
          strong.textContent = size;
          out.appendChild(document.createTextNode(text));
          out.appendChild(strong);
          out.appendChild(document.createTextNode(' (inner diameter ' + d.toFixed(1) + ' mm)' + (between ? ' - you are between sizes, we recommend the larger one.' : '')));
          var target = between ? Math.ceil(d) : size;
          rows.forEach(function (r) {
            var first = r.cells[0] ? parseFloat(r.cells[0].textContent) : NaN;
            if (first === target) r.classList.add('is-match');
          });
        }
        input.addEventListener('input', run);
        mode.addEventListener('change', run);
      });
    })();
  </script>
  {% endraw %}
</div>

{% schema %}
{
  "name": "Size guide",
  "tag": "section",
  "class": "section-size-guide",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the page title."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Find the perfect fit. Pick your jewelry type, measure at home and use the chart below."
    },
    {
      "type": "header",
      "content": "Help box"
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "Title",
      "default": "Still not sure?"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Text",
      "default": "Send us a message and we will help you find your size."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 65
    }
  ],
  "blocks": [
    {
      "type": "guide",
      "name": "Guide (tab)",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab title",
          "default": "Rings"
        },
        {
          "type": "text",
          "id": "key",
          "label": "Link key",
          "default": "ring",
          "info": "Used in links: /pages/size-guide#ring opens this tab. Product pages use ring, bracelet or necklace."
        },
        {
          "type": "textarea",
          "id": "intro",
          "label": "Intro"
        },
        {
          "type": "header",
          "content": "Size chart"
        },
        {
          "type": "text",
          "id": "table_title",
          "label": "Chart title",
          "default": "Size chart"
        },
        {
          "type": "text",
          "id": "table_head",
          "label": "Column titles",
          "info": "Separate columns with | (pipe)",
          "default": "Size | Inner diameter (mm) | Circumference (mm)"
        },
        {
          "type": "textarea",
          "id": "table_rows",
          "label": "Rows",
          "info": "One row per line, separate columns with | (pipe). For the ring calculator the first column must be the size number."
        },
        {
          "type": "select",
          "id": "calculator",
          "label": "Calculator",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "ring", "label": "Ring size calculator" }
          ],
          "default": "none"
        },
        {
          "type": "header",
          "content": "How to measure"
        },
        {
          "type": "text",
          "id": "steps_title",
          "label": "Title",
          "default": "How to measure"
        },
        {
          "type": "textarea",
          "id": "steps",
          "label": "Steps",
          "info": "One step per line."
        },
        {
          "type": "textarea",
          "id": "tips",
          "label": "Tips",
          "info": "One tip per line."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Illustration"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Size guide",
      "blocks": [
        { "type": "guide" }
      ]
    }
  ]
}
{% endschema %}
