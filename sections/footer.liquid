<!-- /sections/footer.liquid -->
<footer class="footer color-{{ section.settings.color_scheme | default: 'scheme-2' }}"
  data-section-id="{{ section.id }}"
  data-section-type="footer"
  style="--PT: {{ section.settings.padding_top | default: 50 }}px; --PB: {{ section.settings.padding_bottom | default: 40 }}px;">
  <div class="footer__holder">
    <div class="wrapper--full section-padding-custom">
      {%- if section.settings.show_newsletter -%}{%- render 'footer-newsletter', s: section.settings -%}{%- endif -%}
      <div class="footer__container footer__container--reversed">
        <div class="footer__content">
          <div class="footer__content__inner">
            
            <!-- Footer Logo -->
            <div class="footer__logo__wrapper">
              {%- liquid
                if settings.use_brand_logo and shop.brand.logo != blank
                  assign global_logo = shop.brand.logo
                elsif settings.logo != blank
                  assign global_logo = settings.logo
                else
                  assign global_logo = shop.brand.logo
                endif
                assign footer_logo = section.settings.logo | default: global_logo
                assign footer_logo_width = settings.footer_logo_width | default: section.settings.logo_width | default: 170
                assign footer_logo_ratio = footer_logo.aspect_ratio | default: 2.2
              -%}
              <a href="{{ routes.root_url }}"
                class="footer__logo"
                style="width: {{ footer_logo_width }}px; display: inline-block;"
                data-footer-logo
                aria-label="{{ shop.name | escape }}">
                {%- if footer_logo != blank -%}
                  {%- assign footer_logo_width_2x = footer_logo_width | times: 2 -%}
                  {%- assign footer_logo_width_3x = footer_logo_width | times: 3 -%}
                  <img src="{{ footer_logo | image_url: width: footer_logo_width_2x }}"
                    srcset="{{ footer_logo | image_url: width: footer_logo_width }} 1x, {{ footer_logo | image_url: width: footer_logo_width_2x }} 2x, {{ footer_logo | image_url: width: footer_logo_width_3x }} 3x"
                    alt="{{ footer_logo.alt | default: shop.name | escape }}"
                    width="{{ footer_logo_width }}"
                    height="{{ footer_logo_width | divided_by: footer_logo_ratio | round }}"
                    loading="lazy"
                    style="max-width: {{ footer_logo_width }}px; height: auto; object-fit: contain; -webkit-backface-visibility: hidden; image-rendering: -webkit-optimize-contrast;">
                {%- else -%}
                  <img src="{{ 'aurelle_fine_jewelry_logo_transparent.png' | asset_url }}"
                    alt="{{ shop.name | escape }}"
                    width="{{ footer_logo_width }}"
                    height="{{ footer_logo_width | divided_by: 4.1 | round }}"
                    loading="lazy"
                    sizes="{{ footer_logo_width }}px"
                    style="max-width: {{ footer_logo_width }}px; height: auto; object-fit: contain;">
                {%- endif -%}
              </a>
            </div>

            <!-- Footer Columns Grid -->
            <div class="float-grid grid--uniform" data-accordion-group>
              
              {%- if section.blocks.size > 0 -%}
                {%- for block in section.blocks -%}
                  {%- case block.type -%}
                    {%- when 'link_list' -%}
                      {%- assign block_menu = linklists[block.settings.menu] -%}
                      <div class="grid__item medium-up--one-quarter footer__block" {{ block.shopify_attributes }}>
                        <p class="footer__title footer__accordion__head js"
                          data-accordion-trigger="accordion-block-{{ block.id }}"
                          aria-controls="accordion-block-{{ block.id }}"
                          role="button"
                          aria-haspopup="true"
                          aria-label="{{ block.settings.title | default: block_menu.title | escape }}"
                          aria-expanded="false">
                            {{ block.settings.title | default: block_menu.title }}
                            <svg xmlns="http://www.w3.org/2000/svg" stroke-linecap="square" stroke-linejoin="arcs" aria-hidden="true" class="icon-theme icon-theme-stroke icon-core-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
                        </p>

                        <input type="checkbox"
                          name="accordion-block-{{ block.id }}"
                          id="accordion-block-{{ block.id }}-checkbox"
                          class="no-js no-js-checkbox">

                        <label for="accordion-block-{{ block.id }}-checkbox"
                          class="footer__title footer__accordion__head no-js">
                          {{ block.settings.title | default: block_menu.title }}
                          <svg xmlns="http://www.w3.org/2000/svg" stroke-linecap="square" stroke-linejoin="arcs" aria-hidden="true" class="icon-theme icon-theme-stroke icon-core-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
                        </label>

                        <ul class="footer__quicklinks footer__accordion__body no-js-accordion" data-accordion-body data-accordion-body-mobile id="accordion-block-{{ block.id }}">
                          {%- if block_menu != blank -%}
                            {%- for link in block_menu.links -%}
                              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                            {%- endfor -%}
                          {%- endif -%}
                        </ul>
                      </div>

                    {%- when 'text' -%}
                      <div class="grid__item medium-up--one-quarter footer__block" {{ block.shopify_attributes }}>
                        <p class="footer__title">{{ block.settings.title }}</p>
                        <div class="rte text-xs" style="color: var(--text, #2b2622); font-weight: 500; line-height: 1.6;">
                          {{ block.settings.text }}
                        </div>
                      </div>

                    {%- when 'newsletter' -%}
                      <div class="grid__item medium-up--one-quarter footer__block" {{ block.shopify_attributes }}>
                        <p class="footer__title">{{ block.settings.title }}</p>
                        {%- if block.settings.text != blank -%}
                          <p class="text-xs" style="color: var(--text, #2b2622); font-weight: 500; margin-bottom: 16px;">{{ block.settings.text }}</p>
                        {%- endif -%}
                        {% form 'customer', class: 'footer-newsletter-form' %}
                          <input type="hidden" name="contact[tags]" value="newsletter">
                          <div style="display: flex; gap: 8px;">
                            <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.email_placeholder_short' | t }}" required style="flex: 1; padding: 10px 14px; border: 1px solid var(--border, var(--lv-border)); font-size: 12px; background: var(--bg, #fff); color: var(--text, #000);">
                            <button type="submit" class="btn btn--primary" style="padding: 10px 18px; font-size: 11px; font-weight: 600; text-transform: uppercase;"><span>{{ 'general.newsletter_form.join' | t }}</span></button>
                          </div>
                        {% endform %}
                      </div>
                  {%- endcase -%}
                {%- endfor -%}

              {%- else -%}
                <!-- Dynamic Footer Menu from Shopify Admin (Navigation > Footer menu) -->
                {%- assign footer_menu_handle = section.settings.footer_menu | default: 'footer' -%}
                {%- assign footer_linklist = linklists[footer_menu_handle] -%}

                {%- if footer_linklist != blank and footer_linklist.links.size > 0 -%}
                  {%- for column in footer_linklist.links -%}
                    <div class="grid__item medium-up--one-quarter footer__block">
                      <p class="footer__title footer__accordion__head js"
                        data-accordion-trigger="accordion-footer-{{ forloop.index }}"
                        aria-controls="accordion-footer-{{ forloop.index }}"
                        role="button"
                        aria-haspopup="true"
                        aria-label="{{ column.title | escape }}"
                        aria-expanded="false">
                          {{ column.title }}
                          <svg xmlns="http://www.w3.org/2000/svg" stroke-linecap="square" stroke-linejoin="arcs" aria-hidden="true" class="icon-theme icon-theme-stroke icon-core-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
                      </p>

                      <input type="checkbox"
                        name="accordion-footer-{{ forloop.index }}"
                        id="accordion-footer-{{ forloop.index }}-checkbox"
                        class="no-js no-js-checkbox">

                      <label for="accordion-footer-{{ forloop.index }}-checkbox"
                        class="footer__title footer__accordion__head no-js">
                        {{ column.title }}
                        <svg xmlns="http://www.w3.org/2000/svg" stroke-linecap="square" stroke-linejoin="arcs" aria-hidden="true" class="icon-theme icon-theme-stroke icon-core-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
                      </label>

                      <ul class="footer__quicklinks footer__accordion__body no-js-accordion" data-accordion-body data-accordion-body-mobile id="accordion-footer-{{ forloop.index }}">
                        {%- if column.links.size > 0 -%}
                          {%- for link in column.links -%}
                            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                          {%- endfor -%}
                        {%- else -%}
                          <li><a href="{{ column.url }}">{{ column.title }}</a></li>
                        {%- endif -%}
                      </ul>
                    </div>
                  {%- endfor -%}
                {%- endif -%}

                <!-- Social Column -->
                {%- if section.settings.show_social_column -%}
                  {%- assign social_title_default = 'sections.footer.social_title' | t -%}
                  <div class="grid__item medium-up--one-quarter footer__block">
                    <p class="footer__title footer__accordion__head js"
                      data-accordion-trigger="accordion-footer-social"
                      aria-controls="accordion-footer-social"
                      role="button"
                      aria-haspopup="true"
                      aria-label="{{ section.settings.social_column_title | default: social_title_default | escape }}"
                      aria-expanded="false">
                        {{ section.settings.social_column_title | default: social_title_default }}
                        <svg xmlns="http://www.w3.org/2000/svg" stroke-linecap="square" stroke-linejoin="arcs" aria-hidden="true" class="icon-theme icon-theme-stroke icon-core-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
                    </p>

                    <input type="checkbox"
                      name="accordion-footer-social"
                      id="accordion-footer-social-checkbox"
                      class="no-js no-js-checkbox">

                    <label for="accordion-footer-social-checkbox"
                      class="footer__title footer__accordion__head no-js">
                      {{ section.settings.social_column_title | default: social_title_default }}
                      <svg xmlns="http://www.w3.org/2000/svg" stroke-linecap="square" stroke-linejoin="arcs" aria-hidden="true" class="icon-theme icon-theme-stroke icon-core-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
                    </label>

                    <ul class="footer__quicklinks footer__accordion__body no-js-accordion" data-accordion-body data-accordion-body-mobile id="accordion-footer-social">
                      {%- if settings.social_instagram_link != blank -%}
                        <li><a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">Instagram</a></li>
                      {%- endif -%}
                      {%- if settings.social_tiktok_link != blank -%}
                        <li><a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">TikTok</a></li>
                      {%- endif -%}
                    </ul>
                  </div>
                {%- endif -%}

              {%- endif -%}

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Leave blank to automatically use the universal logo from Theme Settings > Logo & Favicon."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Custom logo width",
      "default": 170
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Footer navigation menu",
      "default": "footer",
      "info": "Displays the menu selected from Online Store > Navigation. If it has submenus, each submenu appears as a separate column."
    },
    {
      "type": "checkbox",
      "id": "show_social_column",
      "label": "Show social links column",
      "default": true
    },
    {
      "type": "text",
      "id": "social_column_title",
      "label": "Social column heading",
      "default": "Social"
    },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "Join the Aurelle list" },
    { "type": "textarea", "id": "newsletter_text", "label": "Text", "default": "Be the first to hear about new collections, engraving offers and private sales." },
    { "type": "text", "id": "newsletter_placeholder", "label": "Email placeholder", "default": "Your email address" },
    { "type": "text", "id": "newsletter_button", "label": "Button label", "default": "Subscribe" },
    { "type": "select", "id": "newsletter_button_style", "label": "Subscribe button style", "options": [ { "value": "primary", "label": "Primary (theme style)" }, { "value": "secondary", "label": "Secondary (inverse)" }, { "value": "champagne", "label": "Champagne gold" }, { "value": "outline", "label": "Fine outline" }, { "value": "soft", "label": "Soft ivory" } ], "default": "secondary" },
    { "type": "text", "id": "newsletter_note", "label": "Small note under the form", "default": "No spam. Unsubscribe anytime." },
    { "type": "text", "id": "newsletter_success", "label": "Success message", "default": "Thank you for subscribing!" },
    { "type": "header", "content": "Newsletter discount" },
    { "type": "checkbox", "id": "newsletter_show_discount", "label": "Show discount offer", "default": true },
    { "type": "text", "id": "newsletter_discount_badge", "label": "Badge text", "default": "10% off your first order" },
    { "type": "text", "id": "newsletter_discount_code", "label": "Discount code", "default": "WELCOME10", "info": "Shown after signup. Create the same code in Shopify admin > Discounts." },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "About Us"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Discover our exquisite collection of personalized and timeless waterproof jewelry.</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Newsletter"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Subtext",
          "default": "Subscribe to our newsletter and receive 10% off your first order."
        }
      ]
    }
  ]
}
{% endschema %}
