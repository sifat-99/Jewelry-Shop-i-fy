<!-- /sections/main-password.liquid -->
<div class="password-content" data-section-id="{{ section.id }}" data-section-type="password">
  <div class="password-content__inner">
    
    {%- if section.settings.badge_text != blank -%}
      <div class="password-badge">
        <span class="password-badge__dot"></span>
        <span class="password-badge__text">{{ section.settings.badge_text }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="password-heading">
        {{ section.settings.heading }}
      </h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="password-subheading">
        <p>{{ section.settings.subheading }}</p>
      </div>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      <div class="password-newsletter">
        {% form 'customer', class: 'password-newsletter__form', id: 'PasswordCustomerForm' %}
          <input type="hidden" name="contact[tags]" value="prospect, password page">
          
          {%- if form.posted_successfully? -%}
            <div class="password-newsletter__success" role="status">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              <span>{{ 'general.newsletter_form.newsletter_confirmation' | t }}</span>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <div class="password-newsletter__error" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            {%- assign pw_placeholder_default = 'general.newsletter_form.email_placeholder' | t -%}
            {%- assign pw_btn_default = 'general.password_page.notify_me' | t -%}
            <div class="password-newsletter__input-group">
              <input type="email"
                name="contact[email]"
                id="PasswordCustomerEmail"
                class="password-newsletter__input"
                value="{{ form.email | escape }}"
                placeholder="{{ section.settings.newsletter_placeholder | default: pw_placeholder_default }}"
                aria-label="{{ section.settings.newsletter_placeholder | default: pw_placeholder_default }}"
                autocomplete="email"
                required>
              <button type="submit" name="commit" class="btn btn-sliding-hover password-newsletter__submit">
                <span>{{ section.settings.newsletter_button_text | default: pw_btn_default }}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </button>
            </div>
            <p class="password-newsletter__caption">
              {{ 'general.password_page.newsletter_caption' | t }}
            </p>
          {%- endif -%}
        {% endform %}
        <script>
          (function() {
            var form = document.getElementById('PasswordCustomerForm');
            if (!form) return;
            form.addEventListener('submit', function() {
              var input = document.getElementById('PasswordCustomerEmail');
              var email = input ? input.value : '';
              if (email && email.indexOf('@') > -1) {
                try {
                  fetch('https://le-velair-reviews-api.vercel.app/api/welcome-email', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email.trim() }),
                    keepalive: true
                  }).catch(function(){});
                } catch(e) {}
              }
            });
          })();
        </script>
      </div>
    {%- endif -%}

    {%- if section.settings.show_trust_badges -%}
      <div class="password-trust">
        {%- if section.settings.trust_badge_1 != blank -%}
          <div class="password-trust__item">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3h12l4 6-10 12L2 9z"/></svg>
            <span>{{ section.settings.trust_badge_1 }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.trust_badge_2 != blank -%}
          <div class="password-trust__item">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            <span>{{ section.settings.trust_badge_2 }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.trust_badge_3 != blank -%}
          <div class="password-trust__item">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <span>{{ section.settings.trust_badge_3 }}</span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  .password-content {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px 20px 40px;
    box-sizing: border-box;
  }
  .password-content__inner {
    max-width: 620px;
    width: 100%;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .password-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: #fbf9f6;
    border: 1px solid var(--lv-border);
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #4a3e35;
    margin-bottom: 22px;
  }
  .password-badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lv-accent, #b48a4c);
    display: inline-block;
  }
  .password-heading {
    font-family: var(--FONT-STACK-HEADING, sans-serif);
    font-size: calc(32px * var(--FONT-ADJUST-HEADING, 1));
    font-weight: var(--FONT-WEIGHT-HEADING, 500);
    line-height: 1.28;
    letter-spacing: var(--FONT-HEADING-LETTER-SPACING, 0.08em);
    color: var(--text, #111111);
    margin: 0 0 16px 0;
    text-transform: var(--FONT-HEADING-TRANSFORM, uppercase);
  }
  @media (max-width: 768px) {
    .password-heading {
      font-size: 24px;
      letter-spacing: var(--FONT-HEADING-LETTER-SPACING, 0.06em);
    }
  }
  .password-subheading {
    font-family: var(--FONT-STACK-SUBHEADING, inherit);
    font-size: 14px;
    line-height: 1.65;
    color: color-mix(in srgb, var(--text, #555555) 62%, transparent);
    margin-bottom: 32px;
    max-width: 520px;
  }
  .password-newsletter {
    width: 100%;
    max-width: 480px;
    margin-bottom: 36px;
  }
  .password-newsletter__input-group {
    display: flex;
    width: 100%;
    gap: 8px;
    align-items: center;
  }
  @media (max-width: 480px) {
    .password-newsletter__input-group {
      flex-direction: column;
    }
  }
  .password-newsletter__input {
    flex: 1;
    width: 100%;
    padding: 13px 18px;
    font-family: var(--FONT-STACK-BODY, sans-serif);
    font-size: 13px;
    color: var(--text, #111111);
    background: var(--bg, #ffffff);
    border: 1px solid var(--lv-border);
    border-radius: {{ settings.button_border_radius | default: 0 }}px;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .password-newsletter__input:focus {
    border-color: var(--text, #111111);
    box-shadow: 0 0 0 1px #111111;
  }
  .password-newsletter__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 24px;}}px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s, border-color 0.2s, transform 0.15s;
  }
  @media (max-width: 480px) {
    .password-newsletter__submit {
      width: 100%;
    }
  }
  .password-newsletter__caption {
    font-size: 11px;
    color: color-mix(in srgb, var(--text, #888888) 62%, transparent);
    margin: 10px 0 0 0;
    letter-spacing: 0.02em;
  }
  .password-newsletter__success {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    background: #f0f7f2;
    border: 1px solid #b6dec0;
    color: #1d6a36;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 500;
  }
  .password-trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding-top: 10px;
    border-top: 1px solid var(--lv-border);
    width: 100%;
  }
  .password-trust__item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: color-mix(in srgb, var(--text, #666666) 62%, transparent);
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .password-trust__item svg {
    color: var(--lv-accent, #b48a4c);
    flex-shrink: 0;
  }
</style>

{% schema %}
{
  "name": "Password Page",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "VIP EARLY ACCESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SOMETHING TIMELESS IS IN THE MAKING"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Crafted with elegance and personal meaning. Join our private VIP circle to receive early access, exclusive collection previews, and private launch privileges."
    },
    {
      "type": "header",
      "content": "Newsletter Signup"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "newsletter_button_text",
      "label": "Button text",
      "default": "JOIN THE VIP LIST"
    },
    {
      "type": "header",
      "content": "Trust Badges"
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Show trust badges",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_badge_1",
      "label": "Trust badge 1",
      "default": "18K Gold Plated Fine Jewelry"
    },
    {
      "type": "text",
      "id": "trust_badge_2",
      "label": "Trust badge 2",
      "default": "Handcrafted & Personalized"
    },
    {
      "type": "text",
      "id": "trust_badge_3",
      "label": "Trust badge 3",
      "default": "Insured Worldwide Shipping"
    }
  ]
}
{% endschema %}
