<!-- /sections/predictive-search.liquid -->
{%- if predictive_search.performed -%}
  {%- liquid
    assign total_results = 0
    if predictive_search.resources.products.size > 0
      assign total_results = total_results | plus: predictive_search.resources.products.size
    endif
    if predictive_search.resources.collections.size > 0
      assign total_results = total_results | plus: predictive_search.resources.collections.size
    endif
    if predictive_search.resources.pages.size > 0
      assign total_results = total_results | plus: predictive_search.resources.pages.size
    endif
    if predictive_search.resources.articles.size > 0
      assign total_results = total_results | plus: predictive_search.resources.articles.size
    endif

    assign has_side_col = false
    if predictive_search.resources.collections.size > 0
      assign has_side_col = true
    elsif predictive_search.resources.articles.size > 0
      assign has_side_col = true
    elsif predictive_search.resources.pages.size > 0
      assign has_side_col = true
    endif

    assign has_products = false
    if predictive_search.resources.products.size > 0
      assign has_products = true
    endif
  -%}
  {%- assign escaped_terms = predictive_search.terms | escape -%}

  <style>
    .lv-ps-outer {
      padding: 24px var(--outer, 24px) 28px;
      font-family: var(--FONT-STACK-BODY, sans-serif);
    }
    .lv-ps-wrap {
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
    }
    .lv-ps-wrap * {
      box-sizing: border-box;
    }
    .lv-ps-wrap .search__results__wrapper {
      padding-bottom: 0;
    }
    .lv-ps-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      align-items: start;
    }
    .lv-ps-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding-bottom: 10px;
      margin: 0 0 16px;
      border-bottom: 1px solid var(--lv-border, #e6e2d8);
    }
    .lv-ps-head__title {
      margin: 0;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--text, #1a1a1a);
    }
    .lv-ps-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 24px;
      height: 22px;
      padding: 0 7px;
      font-size: 11px;
      font-weight: 700;
      color: var(--text, #1a1a1a);
      background: #f3efe7;
      border: 1px solid var(--lv-border, #e6e2d8);
    }
    .lv-ps-products-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    .lv-ps-card {
      margin: 0;
      opacity: 1;
    }
    .lv-ps-card__link {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 10px 12px;
      background: var(--bg, #ffffff);
      border: 1px solid var(--lv-border, #e6e2d8);
      border-radius: var(--card-radius, 0px);
      text-decoration: none;
      color: var(--text, #1a1a1a);
      transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }
    .lv-ps-card__link:hover {
      border-color: var(--text, #1a1a1a);
      transform: translateY(-1px);
      box-shadow: 0 10px 24px -18px rgba(0, 0, 0, 0.28);
    }
    .lv-ps-card__img {
      flex: none;
      width: 78px;
      height: 78px;
      background: #f7f5f0;
      border: 1px solid color-mix(in srgb, var(--lv-border, #e6e2d8) 65%, transparent);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .lv-ps-card__img img {
      width: 100% !important;
      height: 100% !important;
      max-width: none !important;
      object-fit: cover;
      display: block;
    }
    .lv-ps-card__info {
      flex: 1 1 auto;
      min-width: 0;
    }
    .lv-ps-card__title {
      margin: 0 0 5px;
      font-family: var(--FONT-STACK-HEADING, serif);
      font-size: 14.5px;
      font-weight: 600;
      line-height: 1.32;
      color: var(--text, #1a1a1a);
    }
    .lv-ps-card__price {
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 8px;
      font-size: 13px;
      font-weight: 600;
      color: var(--lv-accent, #9b7c53);
    }
    .lv-ps-card__price .compare-at {
      font-size: 12px;
      font-weight: 400;
      color: rgba(var(--color-foreground, 26, 26, 26), 0.48);
      text-decoration: line-through;
    }
    .lv-ps-card__arrow {
      flex: none;
      font-size: 14px;
      opacity: 0.35;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .lv-ps-card__link:hover .lv-ps-card__arrow {
      opacity: 1;
      transform: translateX(3px);
    }

    /* Right Sidebar */
    .lv-ps-side {
      display: grid;
      gap: 20px;
      padding: 18px 20px;
      background: #faf8f4;
      border: 1px solid var(--lv-border, #e6e2d8);
      border-radius: var(--card-radius, 0px);
    }
    .lv-ps-links {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 8px;
    }
    .lv-ps-link-item a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 9px 12px;
      background: var(--bg, #ffffff);
      border: 1px solid var(--lv-border, #e6e2d8);
      font-size: 13px;
      font-weight: 600;
      color: var(--text, #1a1a1a);
      text-decoration: none;
      transition: border-color 0.2s ease, background-color 0.2s ease;
    }
    .lv-ps-link-item a:hover {
      border-color: var(--text, #1a1a1a);
      background: #f3efe7;
    }
    .lv-ps-link-item__arrow {
      font-size: 13px;
      opacity: 0.5;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .lv-ps-link-item a:hover .lv-ps-link-item__arrow {
      opacity: 1;
      transform: translateX(3px);
    }
    .lv-ps-cta {
      margin: 4px 0 0;
    }
    .lv-ps-cta__btn {
      width: 100%;
      min-height: 46px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      border-radius: var(--btn-radius, 0px);
    }
    .lv-ps-empty {
      padding: 28px 20px;
      text-align: center;
      background: #faf8f4;
      border: 1px solid var(--lv-border, #e6e2d8);
    }
    .lv-ps-empty p {
      margin: 0 0 16px;
      font-size: 14px;
      color: rgba(var(--color-foreground, 26, 26, 26), 0.72);
    }

    @media (min-width: 720px) {
      #search-popdown .lv-ps-products-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (min-width: 1024px) {
      #search-popdown .lv-ps-grid--split {
        grid-template-columns: minmax(0, 1fr) 330px;
        gap: 32px;
      }
    }
    @media (max-width: 640px) {
      .lv-ps-outer {
        padding: 18px var(--outer, 16px) 22px;
      }
      .lv-ps-card__img {
        width: 64px;
        height: 64px;
      }
    }
  </style>

  <div class="lv-ps-outer">
    <div class="lv-ps-wrap">
      <span class="predictive-search-status visually-hidden" data-predictive-search-live-region-count-value role="status">
        {%- if total_results > 0 -%}
          {{ 'general.search.predictive_live_region' | t: total: total_results, products: predictive_search.resources.products.size }}
        {%- else -%}
          {{ 'general.search.no_results_check' | t: terms: escaped_terms }}
        {%- endif -%}
      </span>

      <div class="search__results__wrapper" id="predictive-search-results" role="listbox" aria-label="{{ 'general.search.search_for_terms' | t: terms: escaped_terms }}">
        {%- if total_results > 0 -%}
          {%- assign split_class = '' -%}
          {%- if has_products -%}
            {%- if has_side_col -%}
              {%- assign split_class = ' lv-ps-grid--split' -%}
            {%- endif -%}
          {%- endif -%}

          <div class="lv-ps-grid{{ split_class }}">
            {%- if has_products -%}
              <div class="lv-ps-main">
                <div id="search_product_results_heading" class="lv-ps-head">
                  <p class="lv-ps-head__title">{{ 'general.search.products' | t }}</p>
                  <span class="lv-ps-badge">{{ predictive_search.resources.products.size }}</span>
                </div>

                <ul aria-label="{{ 'general.search.products' | t }}" class="lv-ps-products-list">
                  {%- for product in predictive_search.resources.products -%}
                    <li class="lv-ps-card" role="option" aria-selected="false">
                      <a href="{{ product.url }}" class="lv-ps-card__link">
                        <div role="presentation" class="lv-ps-card__img">
                          {%- if product.featured_media -%}
                            <img src="{{ product.featured_media | image_url: width: 352 }}"
                                 srcset="{{ product.featured_media | image_url: width: 200 }} 200w, {{ product.featured_media | image_url: width: 352 }} 352w"
                                 sizes="90px"
                                 width="{{ product.featured_media.width | default: 352 }}"
                                 height="{{ product.featured_media.height | default: 352 }}"
                                 alt="{{ product.featured_media.alt | default: product.title | escape }}"
                                 loading="lazy">
                          {%- endif -%}
                        </div>
                        <div class="lv-ps-card__info">
                          <p class="lv-ps-card__title">{{ product.title | escape }}</p>
                          <p class="lv-ps-card__price">
                            <span class="price">{{ product.price | money }}</span>
                            {%- if product.compare_at_price > product.price -%}
                              <span class="compare-at">{{ product.compare_at_price | money }}</span>
                            {%- endif -%}
                          </p>
                        </div>
                        <span class="lv-ps-card__arrow" aria-hidden="true">&rarr;</span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>

                {%- unless has_side_col -%}
                  <div class="lv-ps-cta" style="margin-top: 20px; max-width: 340px;">
                    <button
                      class="btn btn--primary lv-ps-cta__btn btn-sliding-hover"
                      tabindex="-1"
                      role="option"
                      aria-selected="false"
                      type="button"
                      onclick="this.closest('form').submit();"
                    >
                      <span class="btn__text-content" data-predictive-search-search-for-text>{{ 'general.search.search_for_terms' | t: terms: escaped_terms }} &rarr;</span>
                    </button>
                  </div>
                {%- endunless -%}
              </div>
            {%- endif -%}

            {%- if has_side_col -%}
              <div class="lv-ps-side">
                {%- if predictive_search.resources.collections.size > 0 -%}
                  <div>
                    <div id="search_collection_results_heading" class="lv-ps-head">
                      <p class="lv-ps-head__title">{{ 'general.search.collections' | t }}</p>
                      <span class="lv-ps-badge">{{ predictive_search.resources.collections.size }}</span>
                    </div>

                    <ul aria-label="{{ 'general.search.collections' | t }}" role="group" class="lv-ps-links">
                      {%- for collection in predictive_search.resources.collections -%}
                        <li class="lv-ps-link-item" id="predictive-search-option-collection-{{ forloop.index }}" role="option" aria-selected="false">
                          <a href="{{ collection.url }}">
                            <span>{{ collection.title | escape }}</span>
                            <span class="lv-ps-link-item__arrow" aria-hidden="true">&rarr;</span>
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}

                {%- if predictive_search.resources.articles.size > 0 -%}
                  <div>
                    <div class="lv-ps-head">
                      <p class="lv-ps-head__title">{{ 'general.search.articles' | t }}</p>
                      <span class="lv-ps-badge">{{ predictive_search.resources.articles.size }}</span>
                    </div>
                    <ul class="lv-ps-links" role="group">
                      {%- for art in predictive_search.resources.articles limit: 3 -%}
                        <li class="lv-ps-link-item" role="option" aria-selected="false">
                          <a href="{{ art.url }}">
                            <span>{{ art.title | escape }}</span>
                            <span class="lv-ps-link-item__arrow" aria-hidden="true">&rarr;</span>
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}

                {%- if predictive_search.resources.pages.size > 0 -%}
                  <div>
                    <div class="lv-ps-head">
                      <p class="lv-ps-head__title">{{ 'general.search.pages' | t }}</p>
                      <span class="lv-ps-badge">{{ predictive_search.resources.pages.size }}</span>
                    </div>
                    <ul class="lv-ps-links" role="group">
                      {%- for pg in predictive_search.resources.pages limit: 3 -%}
                        <li class="lv-ps-link-item" role="option" aria-selected="false">
                          <a href="{{ pg.url }}">
                            <span>{{ pg.title | escape }}</span>
                            <span class="lv-ps-link-item__arrow" aria-hidden="true">&rarr;</span>
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}

                <div class="lv-ps-cta">
                  <button
                    class="btn btn--primary lv-ps-cta__btn btn-sliding-hover"
                    tabindex="-1"
                    role="option"
                    aria-selected="false"
                    type="button"
                    onclick="this.closest('form').submit();"
                  >
                    <span class="btn__text-content" data-predictive-search-search-for-text>{{ 'general.search.search_for_terms' | t: terms: escaped_terms }} &rarr;</span>
                  </button>
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="lv-ps-empty">
            <div aria-live="polite">
              <p>
                {{ 'general.search.no_results_for' | t }}
                <strong>&ldquo;{{ escaped_terms }}&rdquo;</strong>
              </p>
              <button
                class="btn btn--primary lv-ps-cta__btn btn-sliding-hover"
                style="max-width: 320px;"
                tabindex="-1"
                role="option"
                aria-selected="false"
                type="button"
                onclick="this.closest('form').submit();"
              >
                <span class="btn__text-content" data-predictive-search-search-for-text>{{ 'general.search.search_for_terms' | t: terms: escaped_terms }} &rarr;</span>
              </button>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Predictive Search",
  "settings": []
}
{% endschema %}
