<!-- /sections/main-cart.liquid -->
{%- liquid
  assign cart_img_radius = section.settings.cart_image_border_radius
  if cart_img_radius == nil or cart_img_radius == ''
    assign cart_img_radius = settings.media_border_radius | default: settings.card_border_radius | default: 0
  endif

  assign box_radius = section.settings.box_border_radius
  if box_radius == nil or box_radius == ''
    assign box_radius = 4
  endif

  # Free shipping goal (same threshold as the cart drawer)
  assign free_limit = 39
  if shop.currency == 'BDT'
    assign free_limit = 4000
  endif
  assign threshold = free_limit | times: 100
  assign left_spend = threshold | minus: cart.total_price
  assign progress = 0
  if cart.total_price > 0
    assign progress = cart.total_price | times: 100.0 | divided_by: threshold | round
  endif
  if progress > 100
    assign progress = 100
  endif
-%}

<style>
  .cp { --cp-line: rgba(var(--color-foreground, 17, 17, 17), 0.12); --cp-muted: rgba(var(--color-foreground, 17, 17, 17), 0.62); --cp-soft: color-mix(in srgb, var(--text, #111) 4%, var(--bg, #fff)); font-family: 'Quicksand', -apple-system, sans-serif; }
  .cp__inner { width: 100%; max-width: none; margin: 0 auto; padding-left: var(--outer, 24px); padding-right: var(--outer, 24px); box-sizing: border-box; }
  .cp__head { text-align: center; margin: 0 0 28px; }
  .cp__title { margin: 0 0 8px; font-size: clamp(24px, 3.4vw, 36px); font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; line-height: 1.15; }
  .cp__sub { margin: 0; font-size: 13px; color: var(--cp-muted); }
  .cp .lv-crumbs { justify-content: center; }

  /* Free shipping goal */
  .cp-goal { max-width: 640px; margin: 0 auto 34px; padding: 14px 18px 16px; background: var(--cp-soft); border: 1px solid var(--cp-line); border-radius: {{ box_radius }}px; text-align: center; font-size: 13px; }
  .cp-goal p { margin: 0 0 10px; }
  .cp-goal__bar { height: 6px; background: rgba(var(--color-foreground, 17, 17, 17), 0.1); border-radius: 99px; overflow: hidden; }
  .cp-goal__fill { height: 100%; width: var(--p, 0%); background: var(--text, #111); border-radius: inherit; transition: width .6s cubic-bezier(.22, .8, .3, 1); }
  .cp-goal.is-done .cp-goal__fill { background: #2e7d32; }

  /* Layout */
  .cp__grid { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 40px; align-items: start; }
  @media (max-width: 960px) { .cp__grid { grid-template-columns: minmax(0, 1fr); gap: 28px; } }

  /* Items */
  .cp-items__head { display: grid; grid-template-columns: minmax(0, 1fr) 120px 110px; gap: 16px; padding: 0 0 12px; border-bottom: 1px solid var(--cp-line); font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--cp-muted); }
  .cp-items__head span:nth-child(2) { text-align: center; }
  .cp-items__head span:last-child { text-align: right; }
  .cp-item { display: grid; grid-template-columns: minmax(0, 1fr) 120px 110px; gap: 16px; align-items: center; padding: 20px 0; border-bottom: 1px solid var(--cp-line); }
  .cp-item__main { display: flex; gap: 16px; min-width: 0; }
  .cp-item__img { flex: none; width: 96px; height: 96px; border-radius: {{ cart_img_radius }}px; overflow: hidden; background: var(--cp-soft); display: block; }
  .cp-item__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cp-item__info { min-width: 0; }
  .cp-item__title { display: block; margin: 0 0 4px; font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; line-height: 1.4; color: inherit; text-decoration: none; }
  .cp-item__title:hover { text-decoration: underline; }
  .cp-item__meta { margin: 0 0 3px; font-size: 12px; color: var(--cp-muted); }
  .cp-item__meta strong { font-weight: 600; color: inherit; }
  .cp-item__price { margin: 6px 0 8px; font-size: 13px; font-weight: 600; }
  .cp-item__price s { margin-left: 6px; font-weight: 500; opacity: .5; }
  .cp-item__remove { font-size: 12px; color: var(--cp-muted); text-decoration: underline; text-underline-offset: 3px; }
  .cp-item__remove:hover { color: var(--text, #111); }
  .cp-item__total { text-align: right; font-size: 14px; font-weight: 700; }
  .cp-item__total s { display: block; font-size: 12px; font-weight: 500; opacity: .5; }
  .cp-item__disc { display: block; font-size: 11px; font-weight: 600; color: #8c2b3f; }

  .cp-qty { display: inline-flex; align-items: center; height: 40px; border: var(--btn-border-thickness, 1px) solid var(--btn-regular-border, rgba(0,0,0,.2)); border-radius: var(--btn-radius, 0px); box-sizing: border-box; overflow: hidden; }
  .cp-qty__btn { width: 36px; height: 100%; display: flex; align-items: center; justify-content: center; color: inherit; text-decoration: none; transition: background-color var(--btn-animation-duration, 350ms) ease, color var(--btn-animation-duration, 350ms) ease; }
  .cp-qty__btn:hover { background: var(--btn-regular-hover-bg, #111); color: var(--btn-regular-hover-text, #fff); }
  .cp-qty__val { min-width: 34px; text-align: center; font-size: 14px; font-weight: 600; }
  .cp-item__qty { text-align: center; }

  /* Summary card */
  .cp-sum { position: sticky; top: 24px; padding: 24px; background: var(--cp-soft); border: 1px solid var(--cp-line); border-radius: {{ box_radius }}px; }
  .cp-sum__title { margin: 0 0 18px; font-size: 13px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .cp-sum__row { display: flex; justify-content: space-between; gap: 12px; margin: 0 0 10px; font-size: 13px; }
  .cp-sum__row--total { margin: 14px 0 6px; padding-top: 14px; border-top: 1px solid var(--cp-line); font-size: 16px; font-weight: 700; }
  .cp-sum__row .is-discount { color: #8c2b3f; font-weight: 600; }
  .cp-sum__note { margin: 0 0 18px; font-size: 12px; color: var(--cp-muted); line-height: 1.5; }
  .cp-sum__label { display: block; margin: 16px 0 8px; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .cp-sum__textarea { width: 100%; box-sizing: border-box; min-height: 74px; padding: 12px 14px; margin: 0 0 18px; resize: vertical; font: inherit; font-size: 14px; color: inherit; background: var(--bg, #fff); border: 1px solid var(--cp-line); border-radius: var(--input-radius, var(--btn-radius, 0px)); outline: none; }
  .cp-sum__textarea:focus { border-color: var(--text, #111); }
  .cp-sum__btn { width: 100%; display: flex; align-items: center; justify-content: center; min-height: var(--ctl-h-lg, 52px); }
  .cp-sum__continue { display: block; margin: 14px 0 0; text-align: center; font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: inherit; text-decoration: underline; text-underline-offset: 4px; }
  .cp-sum__secure { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 18px 0 0; font-size: 12px; color: var(--cp-muted); }
  .cp-pay { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-top: 14px; }
  .cp-pay svg { width: 38px; height: 24px; }

  /* Trust strip (cart page footer) */
  .cp-trust { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin-top: 56px; padding: 26px 0; border-top: 1px solid var(--cp-line); border-bottom: 1px solid var(--cp-line); }
  .cp-trust__item { display: flex; align-items: center; gap: 14px; }
  .cp-trust__icon { flex: none; width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--cp-line); border-radius: 50%; }
  .cp-trust__icon svg { width: 20px; height: 20px; }
  .cp-trust__title { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .cp-trust__text { margin: 2px 0 0; font-size: 12px; color: var(--cp-muted); line-height: 1.4; }
  @media (max-width: 960px) { .cp-trust { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .cp-trust { grid-template-columns: minmax(0, 1fr); gap: 16px; margin-top: 40px; } }

  /* Empty state */
  .cp-empty { max-width: 520px; margin: 10px auto 0; padding: 48px 24px; text-align: center; background: var(--cp-soft); border: 1px solid var(--cp-line); border-radius: {{ box_radius }}px; }
  .cp-empty__icon { width: 72px; height: 72px; margin: 0 auto 20px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--cp-line); border-radius: 50%; background: var(--bg, #fff); }
  .cp-empty__icon svg { width: 30px; height: 30px; opacity: .7; }
  .cp-empty__title { margin: 0 0 8px; font-size: 16px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .cp-empty__text { margin: 0 0 24px; font-size: 13px; color: var(--cp-muted); }

  /* Mobile items: stack */
  @media (max-width: 640px) {
    .cp-items__head { display: none; }
    .cp-item { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "main main" "qty total"; gap: 14px 12px; padding: 18px 0; }
    .cp-item__main { grid-area: main; }
    .cp-item__qty { grid-area: qty; text-align: left; }
    .cp-item__total { grid-area: total; align-self: center; }
    .cp-item__img { width: 80px; height: 80px; }
    .cp-sum { position: static; padding: 20px; }
  }
</style>

<div class="cp color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  data-section-id="{{ section.id }}"
  data-section-type="cart"
  style="padding-top: {{ section.settings.padding_top | default: 40 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;">
  <div class="cp__inner">

    {% render 'breadcrumb', current: 'Shopping cart' %}

    <div class="cp__head">
      <h1 class="cp__title">Shopping Cart</h1>
      <p class="cp__sub">
        {%- if cart.item_count > 0 -%}
          {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %} in your cart
        {%- else -%}
          Review your chosen jewelry before proceeding to checkout.
        {%- endif -%}
      </p>
    </div>

    <div class="cp-goal{% if cart.total_price >= threshold and cart.item_count > 0 %} is-done{% endif %}">
      {%- if cart.total_price >= threshold and cart.item_count > 0 -%}
        <p><strong>Congratulations!</strong> Your order qualifies for free shipping.</p>
      {%- else -%}
        <p>Add <strong>{{ left_spend | money }}</strong> more to qualify for <strong>free shipping</strong></p>
      {%- endif -%}
      <div class="cp-goal__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}"><div class="cp-goal__fill" style="--p: {{ progress }}%;"></div></div>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart-page-form">
        <div class="cp__grid">

          <div class="cp-items">
            <div class="cp-items__head"><span>Product</span><span>Quantity</span><span>Total</span></div>
            {%- for item in cart.items -%}
              <div class="cp-item" data-cart-item>
                <div class="cp-item__main">
                  <a href="{{ item.url }}" class="cp-item__img" aria-label="{{ item.product.title | escape }}">
                    {%- if item.image -%}
                      <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" width="96" height="96" loading="lazy">
                    {%- endif -%}
                  </a>
                  <div class="cp-item__info">
                    <a href="{{ item.url }}" class="cp-item__title">{{ item.product.title }}</a>
                    {%- unless item.product.has_only_default_variant -%}
                      <p class="cp-item__meta">{{ item.variant.title }}</p>
                    {%- endunless -%}
                    {%- for prop in item.properties -%}
                      {%- assign first_char = prop.first | slice: 0 -%}
                      {%- if prop.last != blank and first_char != '_' -%}
                        <p class="cp-item__meta"><strong>{{ prop.first }}:</strong> {{ prop.last }}</p>
                      {%- endif -%}
                    {%- endfor -%}
                    <p class="cp-item__price">
                      {{ item.final_price | money }}
                      {%- if item.original_price > item.final_price -%}<s>{{ item.original_price | money }}</s>{%- endif -%}
                    </p>
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="cp-item__remove">Remove</a>
                  </div>
                </div>

                <div class="cp-item__qty">
                  <div class="cp-qty">
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="cp-qty__btn" aria-label="Decrease quantity">
                      <svg width="10" height="2" viewBox="0 0 10 2" fill="none" aria-hidden="true"><path d="M0.75 1H9.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </a>
                    <span class="cp-qty__val">{{ item.quantity }}</span>
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="cp-qty__btn" aria-label="Increase quantity">
                      <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M5 0.75V9.25M0.75 5H9.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </a>
                  </div>
                </div>

                <div class="cp-item__total">
                  {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                  {{ item.final_line_price | money }}
                  {%- for discount in item.line_level_discount_allocations -%}
                    <span class="cp-item__disc">{{ discount.discount_application.title }}: -{{ discount.amount | money }}</span>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>

          <aside class="cp-sum" aria-label="Order summary">
            <h2 class="cp-sum__title">Order summary</h2>
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="cp-sum__row"><span>{{ discount.title }}</span><span class="is-discount">-{{ discount.total_allocated_amount | money }}</span></div>
            {%- endfor -%}
            <div class="cp-sum__row"><span>Subtotal</span><span>{{ cart.items_subtotal_price | money }}</span></div>
            <div class="cp-sum__row cp-sum__row--total"><span>Total</span><span>{{ cart.total_price | money }}</span></div>
            <p class="cp-sum__note">Taxes and shipping calculated at checkout.</p>

            {%- if section.settings.show_order_note -%}
              <label class="cp-sum__label" for="cart-note">Order note</label>
              <textarea class="cp-sum__textarea" id="cart-note" name="note" placeholder="Anything we should know? (optional)">{{ cart.note }}</textarea>
            {%- endif -%}

            <button type="submit" name="checkout" class="btn btn--primary btn-sliding-hover cp-sum__btn checkout__button">
              <span>Proceed to checkout</span>
            </button>
            <a href="{{ routes.all_products_collection_url }}" class="cp-sum__continue">Continue shopping</a>

            <p class="cp-sum__secure">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
              Secure checkout
            </p>
            {%- if section.settings.show_payment_icons -%}
              <div class="cp-pay">
                {%- for type in shop.enabled_payment_types -%}
                  {{ type | payment_type_svg_tag: class: 'cp-pay__icon' }}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </aside>

        </div>
      </form>
    {%- else -%}
      <div class="cp-empty">
        <div class="cp-empty__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        </div>
        <h2 class="cp-empty__title">Your cart is empty</h2>
        <p class="cp-empty__text">Looks like you have not added any jewelry yet.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn-sliding-hover" style="display: inline-flex; align-items: center; justify-content: center; min-height: var(--ctl-h-lg, 52px); padding: 0 34px;">
          <span>Start shopping</span>
        </a>
      </div>
    {%- endif -%}

    {%- if section.settings.show_trust_strip -%}
      <div class="cp-trust">
        <div class="cp-trust__item">
          <span class="cp-trust__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7.5" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg></span>
          <div><p class="cp-trust__title">Free shipping</p><p class="cp-trust__text">On qualifying orders</p></div>
        </div>
        <div class="cp-trust__item">
          <span class="cp-trust__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg></span>
          <div><p class="cp-trust__title">Easy returns</p><p class="cp-trust__text">14 days to change your mind</p></div>
        </div>
        <div class="cp-trust__item">
          <span class="cp-trust__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div><p class="cp-trust__title">Secure payment</p><p class="cp-trust__text">Encrypted and protected</p></div>
        </div>
        <div class="cp-trust__item">
          <span class="cp-trust__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12v9H4v-9M2 7h20v5H2zM12 21V7M12 7H8a2.5 2.5 0 0 1 0-5c2.5 0 4 5 4 5Zm0 0h4a2.5 2.5 0 0 0 0-5c-2.5 0-4 5-4 5Z"/></svg></span>
          <div><p class="cp-trust__title">Gift ready</p><p class="cp-trust__text">Beautifully packaged</p></div>
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Cart Page",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_order_note",
      "label": "Show order note field",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons under checkout button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_strip",
      "label": "Show trust strip at the bottom (shipping, returns, secure payment)",
      "default": true
    },
    {
      "type": "header",
      "content": "Corner Radius"
    },
    {
      "type": "range",
      "id": "cart_image_border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Cart item image corner radius",
      "default": 0,
      "info": "Corner radius of product images in cart (0 = square)"
    },
    {
      "type": "range",
      "id": "box_border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Box corner radius",
      "default": 4,
      "info": "Corner radius for the shipping banner, order summary and empty state"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ]
}
{% endschema %}
