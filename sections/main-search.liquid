<!-- /sections/main-search.liquid -->
{%- liquid
  assign products_per_page = section.settings.products_per_page | default: 24
  assign popular_default = 'general.search.popular_terms' | t
  assign popular_raw = section.settings.popular_terms | default: popular_default
  assign popular_terms = popular_raw | split: ','
  assign search_title_text = 'general.search.title' | t
  assign search_eyebrow_default = 'general.search.page_eyebrow' | t
  assign search_lead_default = 'general.search.page_lead' | t
  assign search_collections_default = 'general.search.browse_collections' | t
-%}

<div class="search-page-section color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  data-section-id="{{ section.id }}"
  data-section-type="search"
  style="--PT: {{ section.settings.padding_top | default: 30 }}px; --PB: {{ section.settings.padding_bottom | default: 60 }}px; --card-radius: {{ section.settings.card_border_radius | default: settings.card_border_radius | default: 4 }}px;">

  {{ 'product-grid.css' | asset_url | stylesheet_tag }}
  <style>
    .search-page-section { padding-top: var(--PT); padding-bottom: var(--PB); width: 100%; font-family: var(--FONT-STACK-BODY, sans-serif); --sp-line: var(--lv-border); --sp-muted: rgba(var(--color-foreground, 17, 17, 17), 0.62); --sp-soft: color-mix(in srgb, var(--text, #111) 4%, var(--bg, #fff)); }
    .search-page-container { width: 100%; max-width: none; margin: 0 auto; padding-left: var(--outer, 24px); padding-right: var(--outer, 24px); box-sizing: border-box; }

    /* ---------- Hero ---------- */
    .search-header { text-align: center; max-width: 720px; margin: 0 auto 44px; }
    .search-header .lv-crumbs { justify-content: center; }
    .search-eyebrow { margin: 0 0 10px; font-family: var(--TYPE-STACK-KICKER, var(--FONT-STACK-SUBHEADING, sans-serif)); font-size: 11px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; color: var(--sp-muted); }
    .search-title { margin: 0 0 10px; font-family: var(--FONT-STACK-HEADING, sans-serif); font-size: calc(clamp(28px, 4vw, 42px) * var(--FONT-ADJUST-HEADING, 1)); font-weight: var(--FONT-WEIGHT-HEADING, 600); letter-spacing: var(--FONT-HEADING-LETTER-SPACING, .14em); text-transform: var(--FONT-HEADING-TRANSFORM, uppercase); line-height: 1.15; color: currentColor; }
    .search-lead { margin: 0 0 28px; font-family: var(--FONT-STACK-SUBHEADING, var(--FONT-STACK-BODY, sans-serif)); font-size: 14px; color: var(--sp-muted); }

    .search-form-wrap { position: relative; display: flex; align-items: stretch; width: 100%; box-shadow: 0 10px 30px -18px rgba(0, 0, 0, .3); border-radius: var(--input-radius, var(--btn-radius, 0px)); }
    .search-input-field {
      flex: 1; min-width: 0; height: 58px; margin: 0 !important; padding: 0 20px; box-sizing: border-box;
      border: 1px solid var(--sp-line); border-right: 0; border-radius: var(--input-radius, var(--btn-radius, 0px)) 0 0 var(--input-radius, var(--btn-radius, 0px));
      background: var(--bg, #fff); color: var(--text, #111); font: inherit; font-size: 15px; letter-spacing: .02em; outline: none;
      transition: border-color .25s ease;
    }
    .search-input-field::placeholder { color: color-mix(in srgb, var(--text, #111) 42%, transparent); }
    .search-input-field:focus { border-color: var(--text, #111); }
    .search-submit-btn {
      flex: none; width: 64px; height: 58px; padding: 0; margin: 0; display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
      background: var(--btn-regular-bg, #111); color: var(--btn-regular-text, #fff); border: 1px solid var(--btn-regular-border, #111);
      border-radius: 0 var(--input-radius, var(--btn-radius, 0px)) var(--input-radius, var(--btn-radius, 0px)) 0;
      transition: background-color .25s ease, color .25s ease, border-color .25s ease;
    }
    .search-submit-btn:hover { background: var(--btn-regular-hover-bg, #111); color: var(--btn-regular-hover-text, #fff); border-color: var(--btn-regular-hover-border, #111); }
    .search-submit-btn svg { width: 20px; height: 20px; display: block; flex: none; }
    @media (max-width: 520px) { .search-input-field, .search-submit-btn { height: 52px; } .search-submit-btn { width: 56px; } }

    /* Chips */
    .search-chips { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px; margin: 18px 0 0; }
    .search-chips__label { font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--sp-muted); margin-right: 4px; }
    .search-chip {
      display: inline-flex; align-items: center; height: 34px; padding: 0 16px; font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: capitalize;
      color: inherit; text-decoration: none; border: 1px solid var(--sp-line); border-radius: 99px; background: var(--bg, #fff);
      transition: background-color .25s ease, color .25s ease, border-color .25s ease;
    }
    .search-chip:hover { background: var(--btn-selected-bg, #111); color: var(--btn-selected-text, #fff); border-color: var(--btn-selected-border, #111); }

    /* ---------- Results ---------- */
    .search-results-summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 0; margin-bottom: 28px; border-top: 1px solid var(--sp-line); border-bottom: 1px solid var(--sp-line); font-size: 13px; color: var(--sp-muted); }
    .search-results-summary strong { color: var(--text, #111); font-weight: 700; }
    .search-results-summary a { color: inherit; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; text-decoration: underline; text-underline-offset: 4px; white-space: nowrap; }
    .search-results-summary a:hover { color: var(--text, #111); }

    .search-article-item { padding: 22px; border: 1px solid var(--sp-line); background: var(--sp-soft); display: flex; flex-direction: column; justify-content: center; border-radius: var(--card-radius, 0px); }
    .search-article-title { font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: inherit; margin-bottom: 8px; text-decoration: none; }
    .search-article-title:hover { text-decoration: underline; }
    .search-article-snippet { margin: 0; font-size: 13px; color: var(--sp-muted); line-height: 1.55; }

    /* ---------- Empty / suggestions ---------- */
    .search-empty-state { text-align: center; max-width: 560px; margin: 0 auto 8px; padding: 12px 0 8px; }
    .search-empty-icon { width: 72px; height: 72px; margin: 0 auto 20px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--sp-line); border-radius: 50%; background: var(--sp-soft); }
    .search-empty-icon svg { width: 28px; height: 28px; opacity: .7; }
    .search-empty-title { margin: 0 0 8px; font-size: 16px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
    .search-empty-desc { margin: 0 0 22px; font-size: 14px; color: var(--sp-muted); line-height: 1.6; }
    .search-empty-btn { display: inline-flex; align-items: center; justify-content: center; min-height: var(--ctl-h-lg, 52px); padding: 0 34px; }

    .search-collections { margin-top: 52px; }
    .search-collections__title { margin: 0 0 20px; text-align: center; font-size: 13px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
    .search-collections__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
    @media (max-width: 960px) { .search-collections__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .search-coll { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; color: #fff; text-decoration: none; border-radius: var(--card-radius, 0px); background: var(--sp-soft); }
    .search-coll img, .search-coll__ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .9s cubic-bezier(.22, .8, .3, 1); }
    .search-coll__ph { background: linear-gradient(135deg, #e9e2d8, #d8cdbd); }
    .search-coll:hover img, .search-coll:hover .search-coll__ph { transform: scale(1.06); }
    .search-coll::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.6) 0%, rgba(0,0,0,.15) 45%, rgba(0,0,0,0) 70%); }
    .search-coll__label { position: absolute; left: 18px; right: 18px; bottom: 16px; z-index: 2; display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; text-shadow: 0 1px 8px rgba(0,0,0,.4); }
    .search-coll__label svg { width: 16px; height: 16px; flex: none; transition: transform .3s ease; }
    .search-coll:hover .search-coll__label svg { transform: translateX(4px); }
  </style>

  <div class="search-page-container">
    {% render 'breadcrumb', current: search_title_text %}

    <div class="search-header">
      <p class="search-eyebrow">{{ section.settings.eyebrow | default: search_eyebrow_default }}</p>
      <h1 class="search-title">{{ 'general.search.title' | t }}</h1>
      <p class="search-lead">{{ section.settings.lead | default: search_lead_default }}</p>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form-wrap">
        <input type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.page_placeholder' | t }}"
          class="search-input-field"
          aria-label="{{ 'general.search.title' | t }}"
          autocomplete="off">
        <button type="submit" class="search-submit-btn" aria-label="{{ 'general.search.title' | t }}">
          {% render 'icon', icon: 'search' %}
        </button>
      </form>

      {%- if section.settings.show_popular and popular_raw != blank -%}
        <div class="search-chips">
          <span class="search-chips__label">{{ 'general.search.popular_label' | t }}</span>
          {%- for term in popular_terms -%}
            {%- assign t = term | strip -%}
            {%- if t != blank -%}
              <a class="search-chip" href="{{ routes.search_url }}?q={{ t | url_encode }}">{{ t }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if search.performed -%}
      {%- paginate search.results by products_per_page -%}
        {%- if search.results_count > 0 -%}
          {%- assign escaped_search_terms = search.terms | escape -%}
          <div class="search-results-summary">
            <p style="margin: 0;">{{ 'general.search.results_with_count_html' | t: count: search.results_count, terms: escaped_search_terms }}</p>
            <a href="{{ routes.search_url }}">{{ 'general.search.clear_search' | t }}</a>
          </div>

          <div class="search-products-grid lv-product-grid" style="{% render 'product-grid-vars', settings: section.settings %}">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-grid-item', product: item, fallback_index: forloop.index, card_border_radius: section.settings.card_border_radius %}
              {%- else -%}
                <div class="search-article-item">
                  <a href="{{ item.url }}" class="search-article-title">{{ item.title }}</a>
                  <p class="search-article-snippet">{{ item.content | strip_html | truncate: 120 }}</p>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate %}
          {%- endif -%}
        {%- else -%}
          {%- assign escaped_search_terms = search.terms | escape -%}
          <div class="search-empty-state">
            <div class="search-empty-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M8.5 11h5"/></svg>
            </div>
            <h2 class="search-empty-title">{{ 'general.search.empty_title' | t }}</h2>
            <p class="search-empty-desc">{{ 'general.search.empty_desc_html' | t: terms: escaped_search_terms }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary search-empty-btn btn-sliding-hover">
              <span class="btn__text-content">{{ 'general.search.explore_all' | t }}</span>
            </a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}

    {%- assign show_collections_block = false -%}
    {%- if section.settings.show_collections -%}
      {%- if search.results_count == 0 or search.performed == false -%}
        {%- assign show_collections_block = true -%}
      {%- endif -%}
    {%- endif -%}
    {%- if show_collections_block -%}
      <div class="search-collections">
        <h2 class="search-collections__title">{{ section.settings.collections_heading | default: search_collections_default }}</h2>
        <div class="search-collections__grid">
          {%- assign shown = 0 -%}
          {%- for c in collections -%}
            {%- if shown < 4 and c.handle != 'frontpage' -%}
              {%- assign shown = shown | plus: 1 -%}
              {%- assign c_img = c.image | default: c.products.first.featured_image -%}
              <a class="search-coll" href="{{ c.url }}">
                {%- if c_img != blank -%}
                  <img src="{{ c_img | image_url: width: 700 }}" alt="{{ c.title | escape }}" width="700" height="875" loading="lazy">
                {%- else -%}
                  <span class="search-coll__ph" aria-hidden="true"></span>
                {%- endif -%}
                <span class="search-coll__label">{{ c.title }}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search Results",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Search header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text above title",
      "info": "Leave blank to use the theme translation."
    },
    {
      "type": "text",
      "id": "lead",
      "label": "Intro text",
      "info": "Leave blank to use the theme translation."
    },
    {
      "type": "checkbox",
      "id": "show_popular",
      "label": "Show popular search chips",
      "default": true
    },
    {
      "type": "text",
      "id": "popular_terms",
      "label": "Popular searches",
      "info": "Comma separated. Leave blank to use the theme translation.",
      "visible_if": "{{ section.settings.show_popular }}"
    },
    {
      "type": "header",
      "content": "Collections suggestions"
    },
    {
      "type": "checkbox",
      "id": "show_collections",
      "label": "Show collection cards (before searching and when nothing is found)",
      "default": true
    },
    {
      "type": "text",
      "id": "collections_heading",
      "label": "Heading",
      "info": "Leave blank to use the theme translation.",
      "visible_if": "{{ section.settings.show_collections }}"
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 24
    },
    {
      "type": "header",
      "content": "Product grid columns"
    },
    {
      "type": "range",
      "id": "grid_columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns: above 1024px",
      "default": 4
    },
    {
      "type": "range",
      "id": "grid_columns_1024",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns: 1024px and below",
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_columns_960",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns: 960px and below",
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_columns_768",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns: 768px and below",
      "default": 2
    },
    {
      "type": "select",
      "id": "grid_columns_650",
      "label": "Columns: 650px and below",
      "options": [
        { "value": "1", "label": "1 product per row" },
        { "value": "2", "label": "2 products per row" },
        { "value": "3", "label": "3 products per row" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "grid_columns_mobile",
      "label": "Columns: 450px and below",
      "options": [
        {
          "value": "1",
          "label": "1 product per row"
        },
        {
          "value": "2",
          "label": "2 products per row"
        },
        {
          "value": "3",
          "label": "3 products per row"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Card border radius",
      "default": 4,
      "info": "Controls corner roundness of product card images in search results"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ]
}
{% endschema %}
