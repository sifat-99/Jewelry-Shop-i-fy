<!-- /sections/instagram-feed.liquid -->
<style>
  .instagram-feed-wrap {
    padding-top: var(--PT, 40px);
    padding-bottom: var(--PB, 40px);
    background-color: var(--bg);
    color: var(--text);
    text-align: center;
    box-sizing: border-box;
  }
  .instagram-feed-wrap h2 {
    font-family: 'Quicksand', sans-serif;
    font-size: 14px;
    letter-spacing: 0.2em;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .instagram-feed-wrap h2 a {
    color: var(--text);
    transition: opacity 0.2s;
    text-decoration: none;
  }
  .instagram-feed-wrap h2 a:hover {
    opacity: 0.7;
  }
  .insta-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 16px;
    box-sizing: border-box;
  }
  @media (min-width: 640px) {
    .insta-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
  }
  @media (min-width: 1024px) {
    .insta-grid {
      grid-template-columns: repeat(6, 1fr);
      gap: 12px;
    }
  }
  .insta-item {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    display: block;
    background: #f7f5f4;
    border-radius: var(--insta-radius, 0px);
  }
  .insta-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
    display: block;
  }
  .insta-item:hover img {
    transform: scale(1.05);
  }
  .insta-item-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | default: 25 | divided_by: 100.0 }});
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    pointer-events: none;
  }
  .insta-item:hover .insta-item-overlay {
    opacity: 1;
  }
</style>

<div class="instagram-feed-wrap color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  data-section-id="{{ section.id }}"
  style="--PT: {{ section.settings.padding_top | default: 40 }}px; --PB: {{ section.settings.padding_bottom | default: 40 }}px; --insta-radius: {{ section.settings.image_border_radius | default: 0 }}px;">

  {%- if section.settings.title != blank -%}
    <h2>
      <a href="{{ section.settings.link | default: 'https://www.instagram.com/le.velair' }}" target="_blank" rel="noopener">
        {{ section.settings.title }}
      </a>
    </h2>
  {%- endif -%}
  
  <div class="insta-grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign fallback_img = 'product_' | append: forloop.index | append: '_1.jpg' | asset_url -%}
        <a href="{{ block.settings.link | default: section.settings.link | default: 'https://www.instagram.com/le.velair' }}"
          target="_blank" rel="noopener" class="insta-item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.alt_text | default: 'Instagram post' | escape }}"
              width="300" height="300" loading="lazy">
          {%- else -%}
            <img src="{{ fallback_img }}"
              alt="{{ block.settings.alt_text | default: 'Instagram Lifestyle' | escape }}"
              width="300" height="300" loading="lazy">
          {%- endif -%}
          <div class="insta-item-overlay">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..6) -%}
        {%- assign img_name = 'product_' | append: i | append: '_1.jpg' -%}
        <a href="{{ section.settings.link | default: 'https://www.instagram.com/le.velair' }}" target="_blank" rel="noopener" class="insta-item">
          <img src="{{ img_name | asset_url }}" alt="Instagram Lifestyle" width="300" height="300" loading="lazy">
          <div class="insta-item-overlay">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Instagram Feed",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Follow us - Jewelry Shop"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Instagram profile link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Hover dark overlay opacity",
      "default": 25,
      "info": "Opacity of dark hover overlay on photos (0% = no overlay)"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Image corner radius",
      "default": 0,
      "info": "Corner radius for Instagram photos (0 = square)"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Instagram photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post link (optional)"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text / caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Feed",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
