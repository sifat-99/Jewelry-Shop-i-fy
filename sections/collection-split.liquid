<!-- /sections/collection-split.liquid -->
{%- liquid
  assign target_collection = collections[section.settings.collection]
  if target_collection == blank or target_collection.products_count == 0
    assign target_collection = collections.all
  endif
-%}

{%- if section.settings.design_style == 'new' -%}
  {%- liquid
    assign new_image_pos = 'left'
    if section.settings.layout == 'image_right'
      assign new_image_pos = 'right'
    endif

    assign new_media_link = section.settings.banner_link
    if new_media_link == blank
      assign new_media_link = section.settings.button_link
    endif

    assign new_btn_1_link = section.settings.button_link
    if new_btn_1_link == blank
      assign new_btn_1_link = section.settings.banner_link
    endif
    if new_btn_1_link == blank and target_collection != blank
      assign new_btn_1_link = target_collection.url
    endif

    assign new_btn_1_style = 'primary'
    if section.settings.showcase_content_type == 'image'
      if section.settings.banner_button_style == 'button'
        assign new_btn_1_style = 'button'
      else
        assign new_btn_1_style = 'link'
      endif
    endif
  -%}
  {% render 'product-showcase-render',
    section_id: section.id,
    section_index: section.index,
    color_scheme: section.settings.color_scheme,
    content_type: section.settings.showcase_content_type,
    media_type: section.settings.banner_type,
    image: section.settings.image,
    video: section.settings.video,
    image_link: new_media_link,
    image_position: new_image_pos,
    image_heading: section.settings.title,
    image_subtitle: section.settings.subtitle,
    heading: section.settings.title,
    text: section.settings.showcase_text,
    text_alignment: section.settings.showcase_text_alignment,
    button_1_label: section.settings.button_label,
    button_1_link: new_btn_1_link,
    button_1_style: new_btn_1_style,
    button_2_label: section.settings.showcase_button_2_label,
    button_2_link: section.settings.showcase_button_2_link,
    button_2_style: 'secondary',
    collection: target_collection,
    max_products: section.settings.limit,
    columns: section.settings.showcase_columns,
    mobile_columns: '2',
    columns_gap: 20,
    rows_gap: 24,
    card_border_radius: section.settings.card_border_radius,
    padding_top: section.settings.padding_top,
    padding_bottom: section.settings.padding_bottom,
    showcase_products: section.settings.showcase_products,
    showcase_effect: section.settings.showcase_effect,
    showcase_autoplay: section.settings.showcase_autoplay,
    showcase_speed: section.settings.showcase_speed,
    showcase_show_caption: section.settings.showcase_show_caption,
    showcase_show_dots: section.settings.showcase_show_dots
  %}
{%- else -%}
{%- liquid
  comment
    Banner / products column widths. For "image right" the visual order is reversed (products first), so the tracks are swapped.
  endcomment
  assign split_ratio = section.settings.split_ratio | default: 'equal'
  case split_ratio
    when 'wide'
      assign banner_fr = '1.22fr'
    when 'narrow'
      assign banner_fr = '0.67fr'
    else
      assign banner_fr = '1fr'
  endcase
  if section.settings.layout == 'image_right'
    assign split_template = 'minmax(0, 1fr) minmax(0, ' | append: banner_fr | append: ')'
  else
    assign split_template = 'minmax(0, ' | append: banner_fr | append: ') minmax(0, 1fr)'
  endif
  assign banner_ratio = section.settings.banner_ratio | default: '2 / 3'
  assign content_pad = section.settings.content_padding | default: 24

  assign use_showcase = false
  if section.settings.banner_type == 'products' and section.settings.showcase_products.size > 0
    assign use_showcase = true
  endif
  assign use_video = false
  if section.settings.banner_type == 'video' and section.settings.video != blank
    assign use_video = true
  endif
  assign banner_fill = true
  if section.settings.banner_height == 'ratio'
    assign banner_fill = false
  endif
  assign banner_pos = section.settings.banner_content_position | default: 'middle_center'
  assign effective_btn_style = section.settings.banner_button_style | default: 'auto'
  if effective_btn_style == 'auto'
    if banner_pos == 'bottom_left'
      assign effective_btn_style = 'link'
    else
      assign effective_btn_style = 'button'
    endif
  endif
-%}

<div
  class="collection-split{% if banner_fill %} collection-split--fill{% endif %} color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  data-section-id="{{ section.id }}"
  data-section-type="collection-row"
  style="--PT: {{ section.settings.padding_top | default: 36 }}px; --PB: {{ section.settings.padding_bottom | default: 36 }}px; --card-radius: {{ section.settings.card_border_radius | default: settings.card_border_radius | default: 0 }}px; --split-template: {{ split_template }}; --split-banner-ratio: {{ banner_ratio }}; --split-pad: {{ content_pad }}px;"
>
  {{ 'product-grid.css' | asset_url | stylesheet_tag }}
  <style>
    #shopify-section-{{ section.id }} .collection-split-container {
      width: 100%;
      padding-top: var(--PT);
      padding-bottom: var(--PB);
      box-sizing: border-box;
    }
    #shopify-section-{{ section.id }} .collection-split__grid {
      display: grid;
      grid-template-columns: 1fr;
      column-gap: var(--gutter, 30px);
      row-gap: 24px;
      width: 100%;
    }
    @media only screen and (min-width: 769px) {
      #shopify-section-{{ section.id }} .collection-split__grid {
        grid-template-columns: var(--split-template, minmax(0, 1fr) minmax(0, 1fr));
        row-gap: var(--gutter, 30px);
        align-items: stretch;
      }
      #shopify-section-{{ section.id }} .collection-split__item--last {
        order: 2;
      }
      #shopify-section-{{ section.id }} .collection-split__products {
        padding: 0 var(--split-pad, 24px);
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
      }
    }
    @media only screen and (min-width: 769px) and (max-width: 1024px) {
      #shopify-section-{{ section.id }} .collection-split__products {
        padding: 0 min(var(--split-pad, 24px), 14px);
      }
    }
    @media only screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .collection-split__products {
        padding: 24px 16px 36px 16px !important;
        box-sizing: border-box;
        width: 100%;
      }
      #shopify-section-{{ section.id }} .collection-split__item {
        margin: 0 !important;
        max-width: 100% !important;
      }
    }

    /* Products Grid inside split */
    #shopify-section-{{ section.id }} .collection-split-products-grid {
      width: 100%;
      box-sizing: border-box;
    }
    #shopify-section-{{ section.id }} .collection-split__product {
      margin-bottom: 0 !important;
      width: 100%;
    }
    #shopify-section-{{ section.id }} .hero__title {
      font-family: var(--FONT-STACK-HEADING, sans-serif) !important;
      font-size: calc(clamp(24px, 3.2vw, 38px) * var(--FONT-ADJUST-HEADING, 1)) !important;
      font-weight: var(--FONT-WEIGHT-HEADING, 600) !important;
      letter-spacing: var(--FONT-HEADING-LETTER-SPACING, 0.08em) !important;
      text-transform: var(--FONT-HEADING-TRANSFORM, uppercase) !important;
      color: #ffffff !important;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4) !important;
      line-height: 1.25 !important;
    }
    #shopify-section-{{ section.id }} .hero__subtitle {
      font-family: var(--FONT-STACK-SUBHEADING, sans-serif) !important;
      font-size: calc(13.5px * var(--FONT-ADJUST-ACCENT, 1)) !important;
      font-weight: var(--FONT-WEIGHT-SUBHEADING, 500) !important;
      letter-spacing: var(--FONT-SUBHEADING-LETTER-SPACING, 0.06em) !important;
      text-transform: var(--FONT-SUBHEADING-TRANSFORM, none) !important;
      color: #ffffff !important;
      opacity: 1 !important;
      text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4) !important;
    }
    #shopify-section-{{ section.id }} .collection-split__block {
      position: relative;
      width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      box-sizing: border-box;
    }
    #shopify-section-{{ section.id }} .collection-split__media-wrapper {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .collection-split__img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: center !important;
      display: block !important;
      opacity: 1 !important;
      visibility: visible !important;
      image-rendering: -webkit-optimize-contrast;
      image-rendering: auto;
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    #shopify-section-{{ section.id }} .collection-split__block--clickable {
      cursor: pointer;
    }
    #shopify-section-{{ section.id }} .collection-split__block--clickable:hover .collection-split__img {
      transform: scale(1.03);
    }
    #shopify-section-{{ section.id }} .split-banner-full-link {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 5;
      display: block;
      cursor: pointer;
    }
    #shopify-section-{{ section.id }} .hero__btn__wrap {
      margin-top: 16px;
      pointer-events: auto;
      position: relative;
      z-index: 7;
      display: inline-block;
    }

    /* Mobile: 1:1 aspect ratio square banner */
    @media only screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .collection-split__item {
        width: 100% !important;
        aspect-ratio: 1 / 1 !important;
        height: auto !important;
        min-height: auto !important;
        max-height: none !important;
        position: relative !important;
        margin: 0 !important;
        overflow: hidden !important;
        border-radius: var(--card-radius, 0px);
      }
      #shopify-section-{{ section.id }} .collection-split__block {
        position: relative !important;
        width: 100% !important;
        height: 100% !important;
        aspect-ratio: 1 / 1 !important;
        min-height: auto !important;
        max-height: none !important;
      }
      #shopify-section-{{ section.id }} .collection-split__img--desktop {
        display: none !important;
      }
      #shopify-section-{{ section.id }} .collection-split__img--mobile {
        display: block !important;
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        object-position: center !important;
      }
    }

    @media only screen and (min-width: 769px) {
      #shopify-section-{{ section.id }} .collection-split__grid {
        align-items: stretch !important;
      }
      #shopify-section-{{ section.id }} .collection-split__item {
        position: relative !important;
        overflow: visible !important;
      }
      #shopify-section-{{ section.id }} .collection-split__block--banner {
        position: -webkit-sticky !important;
        position: sticky !important;
        top: var(--split-sticky-top, var(--menu-height-sticky, var(--menu-height, 0px))) !important;
        width: 100% !important;
        aspect-ratio: var(--split-banner-ratio, 2 / 3) !important;
        height: auto !important;
        min-height: auto !important;
        max-height: calc(100svh - var(--split-sticky-top, var(--menu-height-sticky, var(--menu-height, 0px))) - 24px) !important;
        overflow: hidden !important;
        z-index: 3 !important;
        border-radius: var(--card-radius, 0px);
        display: flex !important;
        flex-direction: column !important;
        justify-content: center !important;
      }
      /* Fill the screen: pinned banner is exactly as tall as the visible area, so no gap appears below it */
      #shopify-section-{{ section.id }} .collection-split--fill .collection-split__block--banner {
        aspect-ratio: auto !important;
        height: calc(100vh - var(--split-sticky-top, 0px)) !important;
        height: calc(100svh - var(--split-sticky-top, 0px)) !important;
        min-height: 420px !important;
        max-height: none !important;
      }
      #shopify-section-{{ section.id }} .collection-split__img--mobile {
        display: none !important;
      }
      #shopify-section-{{ section.id }} .collection-split__img--desktop {
        display: block !important;
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        object-position: center !important;
      }
    }
    /* Tablet portrait (iPad upright): a half-width column cannot hold a tall pinned banner, so stack it: banner on top, products in 2 columns below */
    @media only screen and (min-width: 769px) and (max-width: 1100px) and (orientation: portrait) {
      #shopify-section-{{ section.id }} .collection-split__grid { grid-template-columns: minmax(0, 1fr) !important; row-gap: 24px; }
      #shopify-section-{{ section.id }} .collection-split__item:has(.collection-split__block--banner) { order: -1 !important; }
      #shopify-section-{{ section.id }} .collection-split__block--banner,
      #shopify-section-{{ section.id }} .collection-split--fill .collection-split__block--banner {
        position: relative !important;
        top: auto !important;
        aspect-ratio: 4 / 3 !important;
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
      }
      #shopify-section-{{ section.id }} .collection-split__products { padding: 0 var(--outer, 24px) !important; }
      #shopify-section-{{ section.id }} .collection-split-products-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 24px 16px !important; }
    }

    /* ---------- Product showcase & video overlays ---------- */
    #shopify-section-{{ section.id }} .collection-split__block--showcase .image-overlay,
    #shopify-section-{{ section.id }} .collection-split__block--video .image-overlay {
      pointer-events: none;
    }

    /* ---------- Classic Bottom-Left Editorial Position & Underline Link ---------- */
    #shopify-section-{{ section.id }} .collection-split__block--bottom-left.collection-split__block--has-scrim .collection-split__media-wrapper::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      background: linear-gradient(
        to top,
        rgba(17, 17, 17, 0.56) 0%,
        rgba(17, 17, 17, 0.22) 28%,
        rgba(17, 17, 17, 0) 54%
      );
    }
    #shopify-section-{{ section.id }} .collection-split__block--bottom-left .hero__content__wrapper.align--bottom-left {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      margin: 0 !important;
      display: flex !important;
      align-items: flex-end !important;
      justify-content: flex-start !important;
      text-align: left !important;
      padding: clamp(22px, 3vw, 40px) clamp(20px, 3.2vw, 38px) !important;
      box-sizing: border-box !important;
      z-index: 6 !important;
      pointer-events: none !important;
    }
    #shopify-section-{{ section.id }} .collection-split__block--bottom-left.collection-split__block--showcase .hero__content__wrapper.align--bottom-left,
    #shopify-section-{{ section.id }} .collection-split__block--bottom-left.collection-split__block--video .hero__content__wrapper.align--bottom-left {
      padding-inline-end: 84px !important;
    }
    #shopify-section-{{ section.id }} .collection-split__block--bottom-left .hero__content__inner {
      max-width: min(520px, 100%);
      text-align: left;
    }
    #shopify-section-{{ section.id }} .collection-split__block--bottom-left .hero__title {
      margin: 0 !important;
      font-family: var(--FONT-STACK-HEADING, sans-serif) !important;
      font-size: calc(clamp(22px, 2.5vw, 36px) * var(--FONT-ADJUST-HEADING, 1)) !important;
      font-weight: var(--FONT-WEIGHT-HEADING, 600) !important;
      letter-spacing: var(--FONT-HEADING-LETTER-SPACING, 0.025em) !important;
      line-height: 1.08 !important;
      text-transform: var(--FONT-HEADING-TRANSFORM, uppercase) !important;
      color: #ffffff !important;
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.28) !important;
    }
    #shopify-section-{{ section.id }} .collection-split__block--bottom-left .hero__subtitle {
      margin: 8px 0 0 0 !important;
      text-align: left !important;
      font-size: 13.5px !important;
      letter-spacing: 0.02em !important;
      line-height: 1.48 !important;
      color: rgba(255, 255, 255, 0.92) !important;
      text-shadow: 0 1px 6px rgba(0, 0, 0, 0.32) !important;
    }
    #shopify-section-{{ section.id }} .hero__btn__wrap--link {
      margin-top: 10px;
    }
    #shopify-section-{{ section.id }} .hero__text-link {
      display: inline-block;
      position: relative;
      font-family: var(--TYPE-STACK-BUTTON, var(--FONT-STACK-BODY, sans-serif));
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 0.015em;
      line-height: 1.35;
      color: #ffffff !important;
      text-decoration: none;
      padding: 0 0 3px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.88);
      pointer-events: auto;
      transition: opacity 0.25s ease, border-color 0.25s ease;
    }
    #shopify-section-{{ section.id }} .hero__text-link:hover {
      opacity: 0.78;
      border-bottom-color: #ffffff;
    }
    #shopify-section-{{ section.id }} .hero__text-link:focus-visible {
      outline: 2px solid #ffffff;
      outline-offset: 4px;
    }
    @media only screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .collection-split__block--bottom-left .hero__content__wrapper.align--bottom-left {
        padding: 20px 18px !important;
      }
      #shopify-section-{{ section.id }} .collection-split__block--bottom-left .hero__title {
        font-size: clamp(20px, 5.4vw, 28px) !important;
      }
    }
  </style>

  <script>
    (() => {
      const section = document.querySelector('#shopify-section-{{ section.id }} .collection-split');
      if (!section) return;

      const header = document.querySelector('[data-header-height]');
      const updateStickyOffset = () => {
        section.style.setProperty('--split-sticky-top', `${header?.getBoundingClientRect().height || 0}px`);
      };
      updateStickyOffset();
      window.addEventListener('resize', updateStickyOffset, { passive: true });
    })();
  </script>

  {%- if use_showcase or use_video -%}
    <script src="{{ 'product-showcase.js' | asset_url }}" type="module" fetchpriority="low"></script>
  {%- endif -%}

  <div class="collection-split-container">
    <div class="collection-split__grid">
      <div class="collection-split__item {% if section.settings.layout == 'image_right' %}collection-split__item--last{% endif %}">
        {%- liquid
          assign banner_url = section.settings.banner_link
          if banner_url == blank
            assign banner_url = section.settings.button_link
          endif
          if banner_url == blank
            assign banner_url = target_collection.url
          endif

          assign button_url = section.settings.button_link
          if button_url == blank
            assign button_url = banner_url
          endif
          if button_url == blank
            assign button_url = routes.all_products_collection_url
          endif
          assign has_banner_content = false
          if section.settings.title != blank
            assign has_banner_content = true
          elsif section.settings.subtitle != blank
            assign has_banner_content = true
          elsif section.settings.button_label != blank
            assign has_banner_content = true
          endif
        -%}
        {%- assign cs_default_collection_label = 'collections.general.collection_label' | t -%}
        {%- assign cs_default_banner_alt = 'sections.collection_split.banner_alt' | t -%}
        {%- assign cs_default_video_alt = 'sections.collection_split.showcase_video' | t -%}
        <div class="collection-split__block collection-split__block--banner text--white{% if banner_pos == 'bottom_left' %} collection-split__block--bottom-left{% if has_banner_content %} collection-split__block--has-scrim{% endif %}{% endif %}{% if use_showcase %} collection-split__block--showcase{% elsif use_video %} collection-split__block--video{% elsif banner_url != blank %} collection-split__block--clickable{% endif %}">
          {%- if banner_url != blank and use_showcase == false and use_video == false -%}
            <a
              href="{{ banner_url }}"
              class="split-banner-full-link"
              aria-label="{{ section.settings.title | default: target_collection.title | default: cs_default_collection_label | escape }}"
            ></a>
          {%- endif -%}

          {%- if has_banner_content -%}
            <div
              class="hero__content__wrapper {% if banner_pos == 'bottom_left' %}align--bottom-left{% else %}align--middle-center{% endif %}"
              style="position: relative; z-index: 6; pointer-events: none;"
            >
              <div class="hero__content__inner">
                {%- if section.settings.title != blank -%}
                  <h2 class="hero__title" data-aos="hero" data-aos-order="2">{{ section.settings.title }}</h2>
                {%- endif -%}
                {%- if section.settings.subtitle != blank -%}
                  <p
                    class="hero__subtitle"
                    data-aos="hero"
                    data-aos-order="2"
                    style="font-family: var(--FONT-STACK-SUBHEADING, sans-serif); font-size: 13.5px; font-weight: var(--FONT-WEIGHT-SUBHEADING, 500); letter-spacing: var(--FONT-SUBHEADING-LETTER-SPACING, 0.06em); text-transform: var(--FONT-SUBHEADING-TRANSFORM, none); line-height: 1.5; margin: {% if banner_pos == 'bottom_left' %}8px 0 0 0{% else %}10px auto 0 auto{% endif %}; max-width: 420px; opacity: 1;"
                  >
                    {{ section.settings.subtitle }}
                  </p>
                {%- endif -%}
                {%- if section.settings.button_label != blank -%}
                  <div class="hero__btn__wrap{% if effective_btn_style == 'link' %} hero__btn__wrap--link{% endif %}">
                    {%- if effective_btn_style == 'link' -%}
                      <a
                        class="hero__text-link"
                        href="{{ button_url }}"
                        data-aos="hero"
                        data-aos-order="3"
                      >
                        {{ section.settings.button_label }}
                      </a>
                    {%- else -%}
                      <a
                        class="hero__btn btn btn--white btn-sliding-hover"
                        href="{{ button_url }}"
                        data-aos="hero"
                        data-aos-order="3"
                      >
                        <span class="btn__text-content">{{ section.settings.button_label }}</span>
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          {%- assign overlay_val = section.settings.overlay_opacity | default: 0 -%}
          {%- if overlay_val > 0 -%}
            <div
              class="image-overlay"
              style="--bg: #000000; opacity: {{ overlay_val | divided_by: 100.0 }}; z-index: 2;"
            ></div>
          {%- endif -%}
          <div class="collection-split__media-wrapper">
            {%- if use_showcase -%}
              {% render 'split-showcase-banner',
                products: section.settings.showcase_products,
                effect: section.settings.showcase_effect,
                autoplay: section.settings.showcase_autoplay,
                speed: section.settings.showcase_speed,
                show_caption: section.settings.showcase_show_caption,
                show_dots: section.settings.showcase_show_dots,
                loading: 'eager'
              %}
            {%- elsif use_video -%}
              {%- assign classic_video_alt = section.settings.title | default: target_collection.title | default: cs_default_video_alt -%}
              {% render 'showcase-video',
                video: section.settings.video,
                link: banner_url,
                alt_label: classic_video_alt
              %}
            {%- else -%}
              {%- liquid
                if section.settings.layout == 'image_right'
                  assign default_banner = 'split_banner_2.jpg' | asset_url
                else
                  assign default_banner = 'split_banner_1.jpg' | asset_url
                endif

                if section.settings.image != blank
                  assign desktop_img_url = section.settings.image | image_url: width: 1956
                else
                  assign desktop_img_url = default_banner
                endif
              -%}

              {%- if section.settings.image_mobile != blank -%}
                <img
                  src="{{ section.settings.image_mobile | image_url: width: 1200 }}"
                  srcset="{{ section.settings.image_mobile | image_url: width: 600 }} 600w, {{ section.settings.image_mobile | image_url: width: 900 }} 900w, {{ section.settings.image_mobile | image_url: width: 1200 }} 1200w, {{ section.settings.image_mobile | image_url: width: 1600 }} 1600w"
                  sizes="100vw"
                  alt="{{ section.settings.title | default: cs_default_banner_alt | escape }}"
                  width="{{ section.settings.image_mobile.width | default: 1200 }}"
                  height="{{ section.settings.image_mobile.height | default: 1200 }}"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="collection-split__img collection-split__img--mobile"
                >
                <img
                  src="{{ desktop_img_url }}"
                  srcset="{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2000 }} 2000w, {{ section.settings.image | image_url: width: 2400 }} 2400w{% else %}{{ desktop_img_url }} 1956w{% endif %}"
                  sizes="(min-width: 769px) 50vw, 100vw"
                  alt="{{ section.settings.title | default: cs_default_banner_alt | escape }}"
                  width="{{ section.settings.image.width | default: 1956 }}"
                  height="{{ section.settings.image.height | default: 1956 }}"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="collection-split__img collection-split__img--desktop"
                >
              {%- else -%}
                <img
                  src="{{ desktop_img_url }}"
                  srcset="{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2000 }} 2000w, {{ section.settings.image | image_url: width: 2400 }} 2400w{% else %}{{ desktop_img_url }} 1956w{% endif %}"
                  sizes="(min-width: 769px) 50vw, 100vw"
                  alt="{{ section.settings.title | default: cs_default_banner_alt | escape }}"
                  width="{{ section.settings.image.width | default: 1956 }}"
                  height="{{ section.settings.image.height | default: 1956 }}"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="collection-split__img"
                >
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="collection-split__products">
        <div
          class="collection-split-products-grid lv-product-grid"
          style="{% render 'product-grid-vars', settings: section.settings, d_xl: 2, d_1024: 1, d_960: 1, d_768: 2, d_650: 1, d_mobile: 1 %}"
        >
          {%- if target_collection.products.size > 0 -%}
            {%- for product in target_collection.products limit: section.settings.limit -%}
              <div class="collection-split__product" data-item>
                {% render 'product-grid-item',
                  product: product,
                  fallback_index: forloop.index,
                  card_border_radius: section.settings.card_border_radius
                %}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..section.settings.limit) -%}
              <div class="collection-split__product" data-item>
                {% render 'product-grid-item',
                  fallback_index: i,
                  card_border_radius: section.settings.card_border_radius
                %}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Collection split",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "design_style",
      "label": "Design style",
      "options": [
        {
          "value": "classic",
          "label": "Classic (Split banner)"
        },
        {
          "value": "new",
          "label": "New (Product showcase)"
        }
      ],
      "default": "classic",
      "info": "Switch between the Classic Le Velair split layout and the Zorelle-inspired Product Showcase layout."
    },
    {
      "type": "select",
      "id": "showcase_content_type",
      "label": "Showcase layout",
      "options": [
        {
          "value": "image",
          "label": "Sticky media & grid"
        },
        {
          "value": "text",
          "label": "Editorial header & carousel"
        }
      ],
      "default": "image",
      "visible_if": "{{ section.settings.design_style == 'new' }}"
    },
    {
      "type": "header",
      "content": "Banner / Sticky media",
      "visible_if": "{{ section.settings.design_style == 'classic' or section.settings.showcase_content_type == 'image' }}"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "info": "Used on the Classic banner, the New sticky media caption, and the New carousel header."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "visible_if": "{{ section.settings.design_style == 'classic' or section.settings.showcase_content_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "banner_content_position",
      "label": "Heading & button position",
      "options": [
        {
          "value": "middle_center",
          "label": "Middle center (Classic)"
        },
        {
          "value": "bottom_left",
          "label": "Bottom left (Editorial)"
        }
      ],
      "default": "middle_center",
      "info": "Bottom left places bold heading, subheading and underlined link at the lower-left with a soft bottom gradient.",
      "visible_if": "{{ section.settings.design_style == 'classic' }}"
    },
    {
      "type": "select",
      "id": "banner_button_style",
      "label": "Banner button design",
      "options": [
        {
          "value": "auto",
          "label": "Auto (Button in center / Underline at bottom left)"
        },
        {
          "value": "button",
          "label": "Solid button (Classic)"
        },
        {
          "value": "link",
          "label": "Underlined text link"
        }
      ],
      "default": "auto",
      "visible_if": "{{ section.settings.design_style == 'classic' or section.settings.showcase_content_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "banner_type",
      "label": "Media / Banner content",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        },
        {
          "value": "products",
          "label": "Selected products (moving showcase)"
        }
      ],
      "default": "image",
      "info": "Works in both Classic and New (sticky media) styles.",
      "visible_if": "{{ section.settings.design_style == 'classic' or section.settings.showcase_content_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Feature banner image (Desktop)",
      "info": "Recommended 1600 × 2400 px (2:3 portrait). Cropped automatically to fill the column.",
      "visible_if": "{{ section.settings.banner_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Feature banner image (Mobile)",
      "info": "Recommended: square 1:1 (e.g. 1200 × 1200 px). Use a separate mobile crop to keep important content visible.",
      "visible_if": "{{ section.settings.design_style == 'classic' and section.settings.banner_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Feature video",
      "info": "Recommended: 2:3 portrait MP4/MOV video. Autoplays muted on loop with an accessible pause/play toggle.",
      "visible_if": "{{ section.settings.banner_type == 'video' }}"
    },
    {
      "type": "product_list",
      "id": "showcase_products",
      "label": "Showcase products",
      "limit": 8,
      "info": "Used when Media / Banner content = Selected products (if none are picked, the fallback image is used)."
    },
    {
      "type": "select",
      "id": "showcase_effect",
      "label": "Animation",
      "options": [
        {
          "value": "fade_zoom",
          "label": "Soft fade + slow zoom"
        },
        {
          "value": "slide",
          "label": "Slide"
        }
      ],
      "default": "fade_zoom",
      "visible_if": "{{ section.settings.banner_type == 'products' }}"
    },
    {
      "type": "checkbox",
      "id": "showcase_autoplay",
      "label": "Auto-rotate products",
      "default": true,
      "visible_if": "{{ section.settings.banner_type == 'products' }}"
    },
    {
      "type": "range",
      "id": "showcase_speed",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "unit": "ms",
      "label": "Change product every",
      "default": 4500,
      "visible_if": "{{ section.settings.banner_type == 'products' and section.settings.showcase_autoplay }}"
    },
    {
      "type": "checkbox",
      "id": "showcase_show_caption",
      "label": "Show product name and price",
      "default": true,
      "visible_if": "{{ section.settings.banner_type == 'products' }}"
    },
    {
      "type": "checkbox",
      "id": "showcase_show_dots",
      "label": "Show navigation dots",
      "default": true,
      "visible_if": "{{ section.settings.banner_type == 'products' }}"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Media / Banner link",
      "info": "Image/Video only: clicking the media opens this link. Defaults to button link or collection.",
      "visible_if": "{{ section.settings.banner_type != 'products' }}"
    },
    {
      "type": "header",
      "content": "Editorial header (New carousel mode)",
      "visible_if": "{{ section.settings.design_style == 'new' and section.settings.showcase_content_type == 'text' }}"
    },
    {
      "type": "richtext",
      "id": "showcase_text",
      "label": "Showcase description",
      "default": "<p>Explore signature silhouettes crafted for everyday ritual and lasting luminescence.</p>",
      "visible_if": "{{ section.settings.design_style == 'new' and section.settings.showcase_content_type == 'text' }}"
    },
    {
      "type": "select",
      "id": "showcase_text_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.design_style == 'new' and section.settings.showcase_content_type == 'text' }}"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Link for the button. Defaults to banner link or collection if left blank."
    },
    {
      "type": "text",
      "id": "showcase_button_2_label",
      "label": "Second button label",
      "visible_if": "{{ section.settings.design_style == 'new' and section.settings.showcase_content_type == 'text' }}"
    },
    {
      "type": "url",
      "id": "showcase_button_2_link",
      "label": "Second button link",
      "visible_if": "{{ section.settings.design_style == 'new' and section.settings.showcase_content_type == 'text' }}"
    },
    {
      "type": "header",
      "content": "Collection & layout"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "options": [
        {
          "value": "image_left",
          "label": "Image left"
        },
        {
          "value": "image_right",
          "label": "Image right"
        }
      ],
      "default": "image_left",
      "visible_if": "{{ section.settings.design_style == 'classic' or section.settings.showcase_content_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "split_ratio",
      "label": "Banner width",
      "options": [
        {
          "value": "equal",
          "label": "Equal (50 / 50)"
        },
        {
          "value": "wide",
          "label": "Wider banner (55 / 45)"
        },
        {
          "value": "narrow",
          "label": "Narrower banner (40 / 60)"
        }
      ],
      "default": "equal",
      "info": "Narrower banner gives the product cards more room.",
      "visible_if": "{{ section.settings.design_style == 'classic' }}"
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Banner height (desktop)",
      "options": [
        {
          "value": "fill",
          "label": "Fill the screen (no gap below)"
        },
        {
          "value": "ratio",
          "label": "Follow the ratio below"
        }
      ],
      "default": "fill",
      "info": "Fill keeps the pinned banner as tall as the visible screen so nothing shows underneath it.",
      "visible_if": "{{ section.settings.design_style == 'classic' }}"
    },
    {
      "type": "select",
      "id": "banner_ratio",
      "label": "Banner ratio (desktop)",
      "options": [
        {
          "value": "2 / 3",
          "label": "2:3 Tall portrait"
        },
        {
          "value": "3 / 4",
          "label": "3:4 Portrait"
        },
        {
          "value": "4 / 5",
          "label": "4:5 Soft portrait"
        },
        {
          "value": "1 / 1",
          "label": "1:1 Square"
        }
      ],
      "default": "2 / 3",
      "info": "The banner stays pinned while the cards scroll beside it.",
      "visible_if": "{{ section.settings.design_style == 'classic' and section.settings.banner_height == 'ratio' }}"
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Space beside product cards",
      "default": 24,
      "visible_if": "{{ section.settings.design_style == 'classic' }}"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "header",
      "content": "Showcase grid (New style)",
      "visible_if": "{{ section.settings.design_style == 'new' }}"
    },
    {
      "type": "range",
      "id": "showcase_columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop columns",
      "default": 4,
      "visible_if": "{{ section.settings.design_style == 'new' }}"
    },
    {
      "type": "header",
      "content": "Product grid columns (Classic style)",
      "visible_if": "{{ section.settings.design_style == 'classic' }}"
    },
    {
      "type": "range",
      "id": "grid_columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns beside banner: above 1024px",
      "default": 2,
      "info": "Banner and products sit side by side above 768px; below that the banner is stacked on top.",
      "visible_if": "{{ section.settings.design_style == 'classic' }}"
    },
    {
      "type": "range",
      "id": "grid_columns_1024",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns beside banner: 1024px and below",
      "default": 1,
      "visible_if": "{{ section.settings.design_style == 'classic' }}"
    },
    {
      "type": "range",
      "id": "grid_columns_960",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns beside banner: 960px and below",
      "default": 1,
      "visible_if": "{{ section.settings.design_style == 'classic' }}"
    },
    {
      "type": "range",
      "id": "grid_columns_768",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns when stacked: 768px and below",
      "default": 2,
      "visible_if": "{{ section.settings.design_style == 'classic' }}"
    },
    {
      "type": "select",
      "id": "grid_columns_650",
      "label": "Columns when stacked: 650px and below",
      "options": [
        { "value": "1", "label": "1 product per row" },
        { "value": "2", "label": "2 products per row" },
        { "value": "3", "label": "3 products per row" }
      ],
      "default": "1",
      "visible_if": "{{ section.settings.design_style == 'classic' }}"
    },
    {
      "type": "select",
      "id": "grid_columns_mobile",
      "label": "Columns when stacked: 450px and below",
      "options": [
        {
          "value": "1",
          "label": "1 product per row"
        },
        {
          "value": "2",
          "label": "2 products per row"
        },
        {
          "value": "3",
          "label": "3 products per row"
        }
      ],
      "default": "1",
      "visible_if": "{{ section.settings.design_style == 'classic' }}"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Card border radius",
      "default": 0,
      "info": "Controls corner roundness of product card images in this section"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Banner dark overlay opacity",
      "default": 0,
      "info": "Controls dark overlay percentage on the banner image (0% = pure bright original image)",
      "visible_if": "{{ section.settings.design_style == 'classic' }}"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 35
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 35
    }
  ],
  "presets": [
    {
      "name": "Collection split"
    }
  ]
}
{% endschema %}
