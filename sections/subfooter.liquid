<style>
  .subfooter {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    padding-top: var(--PT, 24px);
    padding-bottom: var(--PB, 24px);
  }
  .subfooter--border-top {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  /* Same horizontal alignment as the header and footer (.wrapper--full) */
  .subfooter__wrapper {
    max-width: none;
    width: 100%;
    margin: 0 auto;
    padding-left: var(--outer);
    padding-right: var(--outer);
    box-sizing: border-box;
  }
  .subfooter__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .subfooter__inner--align-center {
    justify-content: center !important;
    text-align: center;
    flex-direction: column;
  }
  .subfooter__inner--align-center .subfooter__left,
  .subfooter__inner--align-center .subfooter__right {
    justify-content: center !important;
    text-align: center;
  }
  .subfooter__inner--align-reverse {
    flex-direction: row-reverse !important;
  }
  .subfooter__left {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .subfooter__logo-wrap {
    display: inline-flex;
    align-items: center;
  }
  .subfooter__logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .subfooter__logo-img {
    display: block;
    height: auto;
    object-fit: contain;
  }
  .subfooter__copyright-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .subfooter__copyright {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.03em;
    opacity: 0.85;
    font-family: inherit;
  }
  .subfooter__copyright a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .subfooter__copyright a:hover {
    text-decoration: underline;
    opacity: 1;
  }
  .subfooter__powered-by {
    font-size: 11px;
    opacity: 0.7;
  }
  .subfooter__powered-by a {
    color: inherit;
  }
  .subfooter__additional-text {
    font-size: 11px;
    opacity: 0.7;
    line-height: 1.4;
  }
  .subfooter__right {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .subfooter__trust-badges {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .subfooter__trust-img {
    display: block;
    height: var(--badge-h, 24px);
    width: auto;
    object-fit: contain;
  }
  .subfooter__payment-wrapper {
    display: inline-flex;
    align-items: center;
  }
  .subfooter__payment-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .subfooter__payment-item {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    transition: transform 0.15s ease;
  }
  .subfooter__payment-item:hover {
    transform: translateY(-1px);
  }
  .subfooter__payment-item svg {
    width: 38px;
    height: 24px;
    border-radius: 3px;
    overflow: hidden;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
    display: block;
  }
  .subfooter__payment-item img,
  .subfooter__payment-icon-img {
    width: auto;
    max-width: 48px;
    height: 24px;
    object-fit: contain;
    border-radius: 3px;
    background: #ffffff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(0, 0, 0, 0.08);
    display: block;
  }
  .subfooter__payment-banner-img {
    display: block;
    border-radius: 4px;
  }

  @media (max-width: 768px) {
    .subfooter__inner {
      flex-direction: column !important;
      justify-content: center !important;
      text-align: center !important;
      gap: 16px;
    }
    .subfooter__left {
      flex-direction: column;
      justify-content: center !important;
      text-align: center !important;
      gap: 10px;
      width: 100%;
    }
    .subfooter__right {
      justify-content: center !important;
      width: 100%;
    }
    .subfooter__payment-list {
      justify-content: center !important;
    }
    .subfooter__trust-badges {
      justify-content: center !important;
    }
  }
</style>

