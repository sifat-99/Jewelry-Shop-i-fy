                    {%- endif -%}
                  </li>
                {%- endif -%}

                {%- if section.settings.payment_amex -%}
                  <li class="subfooter__payment-item" title="American Express">
                    {%- if section.settings.payment_amex_icon != blank -%}
                      <img
                        src="{{ section.settings.payment_amex_icon | image_url: height: 48 }}"
                        alt="{{ section.settings.payment_amex_icon.alt | default: 'American Express' | escape }}"
                        width="38"
                        height="24"
                        class="subfooter__payment-icon-img"
                        loading="lazy"
                      >
                    {%- else -%}
                      <svg xmlns="http://www.w3.org/2000/svg" role="img" viewBox="0 0 38 24" width="38" height="24" aria-label="American Express"><path fill="#000" opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"/><path fill="#007BC1" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32z"/><path fill="#FFF" d="M20.2 12l2.3-5.3h3.5v10.6h-2.2v-6.9L21.5 15h-2.5l-2.3-4.6v6.9h-2.2V6.7H18L20.2 12zm8.5-5.3h5.8v2.1h-3.6v2h3.4v2.1h-3.4v2.3h3.7v2.1h-5.9V6.7zm-18.4 0H7.5L4 17.3h2.3l.8-2h3.8l.8 2h2.4L10.3 6.7zm-2.4 6.6l1.2-3.3 1.2 3.3H7.9z"/></svg>
                    {%- endif -%}
                  </li>
                {%- endif -%}

                {%- if section.settings.payment_apple_pay -%}
                  <li class="subfooter__payment-item" title="Apple Pay">
                    {%- if section.settings.payment_apple_pay_icon != blank -%}
                      <img
                        src="{{ section.settings.payment_apple_pay_icon | image_url: height: 48 }}"
                        alt="{{ section.settings.payment_apple_pay_icon.alt | default: 'Apple Pay' | escape }}"
                        width="38"
                        height="24"
                        class="subfooter__payment-icon-img"
                        loading="lazy"
                      >
                    {%- else -%}
                      <svg xmlns="http://www.w3.org/2000/svg" role="img" viewBox="0 0 38 24" width="38" height="24" aria-label="Apple Pay"><path fill="#000" opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"/><path fill="#000" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32z"/><path fill="#FFF" d="M12.7 10.6c-.1 1-.9 1.7-1.7 1.8-.1 0-.3 0-.4-.1 0-.1 0-.2.1-.3.3-.9 1.2-1.4 2-1.4m.1.9c-.3.4-.7.6-1.1.6-.4 0-.8-.2-1.1-.2-.4 0-.8.2-1.2.2-.6 0-1.2-.4-1.5-1-.7-1.2-.2-3 .5-4 .4-.5.8-.8 1.4-.8.4 0 .7.2 1 .2.3 0 .6-.2 1.1-.2.5 0 1 .3 1.3.7-.8.5-1 1.6-.7 2.5.3.7.8 1.4 1.3 1.4-.1.3-.4.6-.7.6m-1.2-4.8c.3-.4.5-.9.4-1.4-.5 0-1 .4-1.3.8-.3.3-.5.8-.4 1.3.5 0 1-.3 1.3-.7m5 4.5h-1.6V6.6h2.7c1.3 0 2.2.8 2.2 2.2 0 1.4-.9 2.4-2.3 2.4h-1v2.5zm0-2.3h1.1c.7 0 1.1-.4 1.1-1.1 0-.7-.4-1.1-1.1-1.1h-1.1v2.2zm7.1 2.3v-.8c-.3.5-.8.9-1.5.9-.9 0-1.6-.6-1.6-1.5 0-1 .8-1.5 2.1-1.5v-.1c0-.4-.3-.7-.9-.7-.5 0-.9.2-1.1.4l-.4-.7c.4-.3 1-.5 1.7-.5 1.2 0 1.9.6 1.9 1.8v2.4h-.2zm-1.8-1.4c-.6 0-1 .3-1 .8 0 .5.3.8.9.8.5 0 1-.3 1.1-.7v-.9h-1zm4.9 3.2l.4-.9c.4.3.8.4 1.1.4.5 0 .8-.3.9-.7l.2-.5-2.2-5.4h1.3l1.5 4.1 1.4-4.1h1.3l-2.4 6c-.4 1-1 1.5-1.9 1.5-.6 0-1.1-.2-1.5-.4z"/></svg>
                    {%- endif -%}
                  </li>
                {%- endif -%}

                {%- if section.settings.payment_google_pay -%}
                  <li class="subfooter__payment-item" title="Google Pay">
                    {%- if section.settings.payment_google_pay_icon != blank -%}
                      <img
                        src="{{ section.settings.payment_google_pay_icon | image_url: height: 48 }}"
                        alt="{{ section.settings.payment_google_pay_icon.alt | default: 'Google Pay' | escape }}"
                        width="38"
                        height="24"
                        class="subfooter__payment-icon-img"
                        loading="lazy"
                      >
                    {%- else -%}
                      <svg xmlns="http://www.w3.org/2000/svg" role="img" viewBox="0 0 38 24" width="38" height="24" aria-label="Google Pay"><path fill="#000" opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"/><path fill="#FFF" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32z"/><path fill="#4285F4" d="M16.5 12.2c0-.3 0-.6-.1-.8H12v1.6h2.5c-.1.6-.4 1.1-.9 1.4v1.2h1.5c.8-.8 1.4-2 1.4-3.4z"/><path fill="#34A853" d="M12 16.8c1.3 0 2.4-.4 3.2-1.2l-1.5-1.2c-.4.3-1 .5-1.7.5-1.3 0-2.4-.9-2.8-2.1H7.7v1.2c.8 1.7 2.5 2.8 4.3 2.8z"/><path fill="#FBBC04" d="M9.2 12.8c-.1-.3-.2-.7-.2-1.1 0-.4.1-.7.2-1.1V9.4H7.7C7.4 10.1 7.2 10.9 7.2 11.7s.2 1.6.5 2.3l1.5-1.2z"/><path fill="#EA4335" d="M12 8.6c.7 0 1.4.2 1.9.7l1.4-1.4C14.4 7.1 13.3 6.6 12 6.6c-1.8 0-3.5 1.1-4.3 2.8l1.5 1.2c.4-1.2 1.5-2 2.8-2z"/><path fill="#5F6368" d="M21.5 10.5v4.5h-1v-6.3h2.6c.9 0 1.6.3 2.1.8.5.5.8 1.2.8 2s-.3 1.5-.8 2c-.5.5-1.2.8-2.1.8h-1.6zm0-3.6v2.7h1.6c.6 0 1.1-.2 1.4-.5.4-.4.5-.8.5-1.3s-.2-.9-.5-1.3c-.3-.4-.8-.5-1.4-.5h-1.6zm7.2 6.4c-.6 0-1.1-.2-1.5-.6-.4-.4-.6-.9-.6-1.6 0-.7.2-1.2.6-1.6.4-.4.9-.6 1.5-.6.6 0 1.1.2 1.5.6.4.4.6.9.6 1.6 0 .7-.2 1.2-.6 1.6-.4.4-.9.6-1.5.6zm0-.8c.4 0 .7-.1.9-.4.2-.3.4-.7.4-1.2s-.1-.9-.4-1.2c-.2-.3-.5-.4-.9-.4-.4 0-.7.1-.9.4-.2.3-.4.7-.4 1.2s.1.9.4 1.2c.2.3.5.4.9.4zm5.5.8c-.3 0-.6-.1-.8-.2-.2-.1-.4-.3-.5-.5l-.1.6h-.9v-8.1h1v2.5c.2-.2.4-.4.6-.5.2-.1.5-.2.8-.2.7 0 1.2.3 1.6.8.4.5.6 1.2.6 2s-.2 1.5-.6 2c-.4.5-.9.8-1.7.8zm0-.8c.4 0 .7-.1.9-.4.2-.3.4-.7.4-1.2s-.1-.9-.4-1.2c-.2-.3-.5-.4-.9-.4-.4 0-.7.1-.9.4-.2.3-.4.7-.4 1.2s.1.9.4 1.2c.2.3.5.4.9.4z"/></svg>
                    {%- endif -%}
                  </li>
                {%- endif -%}

                {%- if section.settings.payment_paypal -%}
                  <li class="subfooter__payment-item" title="PayPal">
                    {%- if section.settings.payment_paypal_icon != blank -%}
                      <img
                        src="{{ section.settings.payment_paypal_icon | image_url: height: 48 }}"
                        alt="{{ section.settings.payment_paypal_icon.alt | default: 'PayPal' | escape }}"
                        width="38"
                        height="24"
                        class="subfooter__payment-icon-img"
                        loading="lazy"
