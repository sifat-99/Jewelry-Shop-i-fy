<!-- /sections/subfooter.liquid -->
{%- liquid
  assign current_year = 'now' | date: '%Y'
  assign default_copyright = '© {year} {shop_name}. All rights reserved.'
  assign copyright_raw = section.settings.copyright_text
  if copyright_raw == blank
    assign copyright_raw = default_copyright
  endif
  assign copyright_rendered = copyright_raw | replace: '{year}', current_year | replace: '{shop_name}', shop.name

  if settings.use_brand_logo and shop.brand.logo != blank
    assign fallback_logo = shop.brand.logo
  elsif settings.logo != blank
    assign fallback_logo = settings.logo
  else
    assign fallback_logo = shop.brand.logo
  endif

  assign subfooter_logo = section.settings.logo | default: fallback_logo
  assign subfooter_logo_w = section.settings.logo_width | default: 90
-%}

<section class="subfooter color-{{ section.settings.color_scheme | default: 'scheme-2' }}{% if section.settings.show_border_top %} subfooter--border-top{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="subfooter"
  style="--PT: {{ section.settings.padding_top | default: 24 }}px; --PB: {{ section.settings.padding_bottom | default: 24 }}px;">
  
  <div class="subfooter__wrapper">
    <div class="subfooter__inner subfooter__inner--align-{{ section.settings.layout_align | default: 'between' }}">
      
      <!-- Left Area: Logo & Copyright -->
      <div class="subfooter__left">
        {%- if section.settings.show_logo and subfooter_logo != blank -%}
          <div class="subfooter__logo-wrap">
            <a href="{{ section.settings.logo_link | default: routes.root_url }}" class="subfooter__logo-link" aria-label="{{ shop.name | escape }}">
              <img
                src="{{ subfooter_logo | image_url: width: subfooter_logo_w }}"
                alt="{{ subfooter_logo.alt | default: shop.name | escape }}"
                width="{{ subfooter_logo_w }}"
                height="{{ subfooter_logo_w | divided_by: subfooter_logo.aspect_ratio | default: 2.2 | round }}"
                loading="lazy"
                class="subfooter__logo-img"
                style="max-width: {{ subfooter_logo_w }}px;"
              >
            </a>
          </div>
        {%- endif -%}

        <div class="subfooter__copyright-group">
          <p class="subfooter__copyright">
            {%- if section.settings.copyright_link != blank -%}
              <a href="{{ section.settings.copyright_link }}">{{ copyright_rendered }}</a>
            {%- else -%}
              <span>{{ copyright_rendered }}</span>
            {%- endif -%}

            {%- if section.settings.show_powered_by -%}
              <span class="subfooter__powered-by"> | {{ powered_by_link }}</span>
            {%- endif -%}
          </p>

          {%- if section.settings.additional_text != blank -%}
            <div class="subfooter__additional-text">
              {{ section.settings.additional_text }}
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- Right Area: Payment Icons & Trust Badges -->
      <div class="subfooter__right">
        
        <!-- Custom Trust Badges / Extra Logos (if enabled) -->
        {%- if section.settings.show_trust_badges -%}
          {%- assign tb_h = section.settings.trust_badges_height | default: 24 -%}
          <div class="subfooter__trust-badges" style="--badge-h: {{ tb_h }}px;">
            {%- if section.settings.trust_badge_1 != blank -%}
              {%- assign tb1_ratio = section.settings.trust_badge_1.aspect_ratio | default: 3.0 -%}
              {%- assign tb1_w = tb_h | times: tb1_ratio | round -%}
              {%- if section.settings.trust_badge_1_link != blank -%}<a href="{{ section.settings.trust_badge_1_link }}" class="subfooter__trust-badge-link" target="_blank" rel="noopener">{%- endif -%}
                <img src="{{ section.settings.trust_badge_1 | image_url: height: 60 }}" alt="{{ section.settings.trust_badge_1.alt | default: 'Trust Badge 1' | escape }}" width="{{ tb1_w }}" height="{{ tb_h }}" class="subfooter__trust-img" loading="lazy">
              {%- if section.settings.trust_badge_1_link != blank -%}</a>{%- endif -%}
            {%- endif -%}

            {%- if section.settings.trust_badge_2 != blank -%}
              {%- assign tb2_ratio = section.settings.trust_badge_2.aspect_ratio | default: 3.0 -%}
              {%- assign tb2_w = tb_h | times: tb2_ratio | round -%}
              {%- if section.settings.trust_badge_2_link != blank -%}<a href="{{ section.settings.trust_badge_2_link }}" class="subfooter__trust-badge-link" target="_blank" rel="noopener">{%- endif -%}
                <img src="{{ section.settings.trust_badge_2 | image_url: height: 60 }}" alt="{{ section.settings.trust_badge_2.alt | default: 'Trust Badge 2' | escape }}" width="{{ tb2_w }}" height="{{ tb_h }}" class="subfooter__trust-img" loading="lazy">
              {%- if section.settings.trust_badge_2_link != blank -%}</a>{%- endif -%}
            {%- endif -%}

            {%- if section.settings.trust_badge_3 != blank -%}
              {%- assign tb3_ratio = section.settings.trust_badge_3.aspect_ratio | default: 3.0 -%}
              {%- assign tb3_w = tb_h | times: tb3_ratio | round -%}
              {%- if section.settings.trust_badge_3_link != blank -%}<a href="{{ section.settings.trust_badge_3_link }}" class="subfooter__trust-badge-link" target="_blank" rel="noopener">{%- endif -%}
                <img src="{{ section.settings.trust_badge_3 | image_url: height: 60 }}" alt="{{ section.settings.trust_badge_3.alt | default: 'Trust Badge 3' | escape }}" width="{{ tb3_w }}" height="{{ tb_h }}" class="subfooter__trust-img" loading="lazy">
              {%- if section.settings.trust_badge_3_link != blank -%}</a>{%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- Payment Icons Section -->
        {%- if section.settings.show_payment_icons -%}
          <div class="subfooter__payment-wrapper">
            
            {%- if section.settings.payment_icons_mode == 'image' and section.settings.custom_payment_image != blank -%}
              <!-- Mode: Single Custom Image Banner -->
              {%- assign cpi_w = section.settings.custom_payment_image_width | default: 240 -%}
              {%- assign cpi_ratio = section.settings.custom_payment_image.aspect_ratio | default: 4.0 -%}
              {%- assign cpi_h = cpi_w | divided_by: cpi_ratio | round -%}
              <img
                src="{{ section.settings.custom_payment_image | image_url: width: cpi_w }}"
                alt="{{ section.settings.custom_payment_image.alt | default: 'Supported Payment Methods' | escape }}"
                width="{{ cpi_w }}"
                height="{{ cpi_h }}"
                loading="lazy"
                class="subfooter__payment-banner-img"
                style="max-width: {{ cpi_w }}px; height: auto;"
              >
            {%- elsif section.settings.payment_icons_mode == 'shopify' -%}
              <!-- Mode: Automatic from Shopify Enabled Gateways -->
              <ul class="subfooter__payment-list" role="list">
                {%- for type in shop.enabled_payment_types -%}
                  <li class="subfooter__payment-item">
                    {{ type | payment_type_svg_tag: class: 'footer__icon footer__icon--payment' }}
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <!-- Mode: Custom Checkbox Selection (Default) -->
              <ul class="subfooter__payment-list" role="list">
                
                {%- if section.settings.payment_visa -%}
                  <li class="subfooter__payment-item" title="Visa">
                    {%- if section.settings.payment_visa_icon != blank -%}
                      <img
                        src="{{ section.settings.payment_visa_icon | image_url: height: 48 }}"
                        alt="{{ section.settings.payment_visa_icon.alt | default: 'Visa' | escape }}"
                        width="38"
                        height="24"
                        class="subfooter__payment-icon-img"
                        loading="lazy"
                      >
                    {%- else -%}
