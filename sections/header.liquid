<!-- /sections/header.liquid -->
{%- liquid
  if settings.use_brand_logo and shop.brand.logo != blank
    assign global_logo = shop.brand.logo
  elsif settings.logo != blank
    assign global_logo = settings.logo
  else
    assign global_logo = shop.brand.logo
  endif
  assign header_logo = section.settings.logo | default: global_logo
  assign header_logo_width = section.settings.logo_width | default: settings.logo_width | default: 140
  assign header_padding = section.settings.padding_vertical | default: 8
  assign logo_ratio = header_logo.aspect_ratio | default: 2.5
  assign mobile_logo_align = section.settings.mobile_logo_alignment | default: settings.mobile_logo_alignment | default: 'center'
  assign mobile_logo_w = settings.logo_width_mobile | default: 110
  assign sticky_mode = section.settings.sticky_header_type
  if sticky_mode == blank
    if section.settings.sticky_header == false or section.settings.sticky_header == 'none'
      assign sticky_mode = 'none'
    elsif section.settings.sticky_header == 'scroll_up'
      assign sticky_mode = 'scroll_up'
    else
      assign sticky_mode = 'always'
    endif
  endif
-%}
<style data-shopify>
  :root {
    --COLOR-NAV-TEXT-TRANSPARENT: #ffffff;
    --COLOR-HEADER-TRANSPARENT-GRADIENT: rgba(0, 0, 0, 0.2);
    --LOGO-PADDING: {{ header_padding }}px;
    --menu-backfill-height: 0px;
  }
  {%- if sticky_mode == 'always' -%}
    #shopify-section-{{ section.id }} {
      position: -webkit-sticky !important;
      position: sticky !important;
      top: 0 !important;
      z-index: 6000 !important;
      width: 100% !important;
      background-color: var(--bg, #ffffff) !important;
    }
    #shopify-section-{{ section.id }} .header__wrapper {
      position: relative !important;
      top: auto !important;
      background-color: var(--bg, #ffffff) !important;
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06) !important;
    }
    #shopify-section-{{ section.id }} .theme__header,
    #shopify-section-{{ section.id }} .js__header__stuck--animated .theme__header {
      transform: none !important;
      transition: none !important;
    }
  {%- elsif sticky_mode == 'scroll_up' -%}
    #shopify-section-{{ section.id }} {
      position: -webkit-sticky !important;
      position: sticky !important;
      top: 0 !important;
      z-index: 6000 !important;
      width: 100% !important;
      background-color: var(--bg, #ffffff) !important;
      transition: transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1) !important;
    }
    #shopify-section-{{ section.id }}.lv-header--hidden {
      transform: translateY(-100%) !important;
    }
    #shopify-section-{{ section.id }} .header__wrapper {
      position: relative !important;
      top: auto !important;
      background-color: var(--bg, #ffffff) !important;
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06) !important;
    }
    #shopify-section-{{ section.id }} .theme__header,
    #shopify-section-{{ section.id }} .js__header__stuck--animated .theme__header {
      transform: none !important;
    }
  {%- else -%}
    #shopify-section-{{ section.id }} {
      position: static !important;
    }
    #shopify-section-{{ section.id }} .header__wrapper {
      position: relative !important;
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06) !important;
    }
  {%- endif -%}
  .theme__header {
    position: relative !important;
    border-bottom: 1px solid var(--border, #f0f0f0);
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    transform: none !important;
  }
  /* Desktop Header vs Mobile Header visibility */
  @media only screen and (min-width: 990px) {
    .header__mobile {
      display: none !important;
    }
    .header__desktop {
      display: flex !important;
      padding-top: {{ header_padding }}px !important;
      padding-bottom: {{ header_padding }}px !important;
      min-height: auto !important;
    }
  }

  @media only screen and (max-width: 989px) {
    .header__desktop {
      display: none !important;
    }
    .header__mobile {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      position: relative !important;
      width: 100% !important;
      padding-top: {{ header_padding }}px !important;
      padding-bottom: {{ header_padding }}px !important;
      padding-left: 16px !important;
      padding-right: 16px !important;
      min-height: auto !important;
      box-sizing: border-box !important;
    }
  }

  .js__show__mobile .header__desktop,
  [data-header-style="drawer"] .header__desktop {
    display: none !important;
  }
  .js__show__mobile .header__mobile,
  [data-header-style="drawer"] .header__mobile {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    position: relative !important;
    width: 100% !important;
    padding-top: {{ header_padding }}px !important;
    padding-bottom: {{ header_padding }}px !important;
    padding-left: 16px !important;
    padding-right: 16px !important;
    min-height: auto !important;
    box-sizing: border-box !important;
  }

  .header__mobile__left,
  .header__mobile__right {
    display: flex !important;
    align-items: center !important;
    min-width: 44px !important;
    z-index: 5 !important;
  }
  .header__mobile__left {
    justify-content: flex-start !important;
  }
  .header__mobile__right {
    justify-content: flex-end !important;
  }
  .header__mobile .header__logo {
    display: flex !important;
    align-items: center !important;
    padding: 0 !important;
    margin: 0 !important;
    z-index: 4 !important;
  }
  .header__mobile .header__logo__link {
    display: inline-flex !important;
    align-items: center !important;
    width: auto !important;
    max-width: 100% !important;
  }
  .header__mobile .header__logo__link img {
    max-width: {{ mobile_logo_w }}px !important;
    max-height: 44px !important;
    width: auto !important;
    height: auto !important;
    object-fit: contain !important;
  }
  {%- if mobile_logo_align == 'left' -%}
    .header__mobile {
      justify-content: flex-start !important;
      gap: 12px !important;
    }
    .header__mobile .header__logo {
      justify-content: flex-start !important;
      flex: 1 !important;
      position: static !important;
      transform: none !important;
    }
    .header__mobile .header__logo__link {
      justify-content: flex-start !important;
    }
    .header__mobile__right {
      margin-left: auto !important;
    }
  {%- else -%}
    .header__mobile .header__logo {
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%) !important;
      justify-content: center !important;
      max-width: calc(100% - 120px) !important;
      pointer-events: auto !important;
    }
    .header__mobile .header__logo__link {
      justify-content: center !important;
    }
  {%- endif -%}
  .header__desktop .header__logo {
    padding: 0 !important;
    margin: 0 !important;
  }
  .header__desktop .header__logo__link {
    display: flex !important;
    align-items: center;
  }
  .header__desktop .header__logo__link img {
    max-height: 52px;
    width: auto;
    object-fit: contain;
  }
  .header__drawer .drawer__top {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 14px 18px !important;
    border-bottom: 1px solid var(--border, #f0f0f0) !important;
  }
  .header__drawer .drawer__top__center {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex: 1 !important;
    text-align: center !important;
  }
  /* Drawer top bar: equal side columns so the logo is truly centred */
  .header__drawer .drawer__top {
    display: grid !important;
    grid-template-columns: 44px minmax(0, 1fr) 44px !important;
    gap: 8px;
    padding: 8px 12px !important;
    height: auto !important;
    min-height: 60px;
    box-sizing: border-box !important;
  }
  .header__drawer .drawer__top__left,
  .header__drawer .drawer__top .drawer__close {
    box-sizing: border-box !important;
    width: 44px !important;
    height: 44px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .header__drawer .drawer__top__left { justify-self: start; }
  .header__drawer .drawer__top .drawer__close { justify-self: end; }
  .header__drawer .drawer__account {
    box-sizing: border-box !important;
    width: 44px !important;
    height: 44px !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: inherit;
  }
  .header__drawer .drawer__account svg,
  .header__drawer .drawer__top .drawer__close svg {
    width: 24px !important;
    height: 24px !important;
  }
  .header__drawer .drawer__logo__link {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .header__backfill {
    display: none !important;
    height: 0 !important;
    min-height: 0 !important;
    max-height: 0 !important;
    overflow: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
    pointer-events: none !important;
    visibility: hidden !important;
  }
  /* High-Contrast Luxury Header Navigation */
  .navlink--toplevel {
    font-family: 'Quicksand', -apple-system, BlinkMacSystemFont, sans-serif !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    letter-spacing: 0.09em !important;
    color: #111111 !important;
    opacity: 1 !important;
    text-transform: uppercase !important;
  }
  .navlink--toplevel .navtext {
    font-family: 'Quicksand', -apple-system, BlinkMacSystemFont, sans-serif !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    letter-spacing: 0.09em !important;
    color: #111111 !important;
  }
  .header__menu__inner .menu__item .navlink--toplevel {
    opacity: 1 !important;
  }
  .header__menu__inner:hover .menu__item:not(:hover) .navlink--toplevel {
    opacity: 0.72 !important;
  }
  .header__menu__inner .menu__item:hover .navlink--toplevel {
    opacity: 1 !important;
    color: #000000 !important;
  }
  .header__desktop__button .navlink,
  .header__mobile__button {
    color: #111111 !important;
    opacity: 1 !important;
  }
  .header__desktop__button svg,
  .header__mobile__button svg {
    color: #111111 !important;
    stroke: #111111 !important;
  }

  /* Icon buttons (account / search / cart): the link itself is a 44px circle, so the hover background can never be clipped */
  .header__desktop__buttons--icons .header__desktop__button {
    display: flex;
    align-items: center;
    margin-right: 0 !important;
  }
  .header__desktop__buttons--icons .header__desktop__button .navlink {
    position: relative;
    box-sizing: border-box;
    min-width: 44px;
    height: 44px !important;
    padding: 0 !important;
    margin: 0 2px;
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    gap: 0;
    overflow: visible !important;
    border-radius: 999px;
    background-color: transparent;
    transition: background-color 0.25s ease;
  }
  .header__desktop__buttons--icons .header__desktop__button .navlink:after,
  .header__desktop__buttons--icons .header__desktop__button:last-child > a:after {
    display: none !important;
    content: none !important;
  }
  /* The (empty) cart status text must not take flex space, or the icon sits off-center */
  .header__desktop__buttons--icons .header__cart__status {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .header__desktop__buttons--icons .header__desktop__button .navlink svg {
    flex: 0 0 auto;
    margin: 0 !important;
  }
  .header__desktop__buttons--icons .header__desktop__button .navlink:hover,
  .header__desktop__buttons--icons .header__desktop__button .navlink:focus-visible {
    background-color: rgba(var(--color-foreground, 17, 17, 17), 0.08);
  }

  /* =============================================================
     Universal Header Dropdown Customization & Styling
     ============================================================= */
  :root {
    --lv-dd-global-bg: {{ section.settings.dropdown_global_bg | default: '#ffffff' }};
    --lv-dd-global-text: {{ section.settings.dropdown_global_text | default: '#111111' }};
    --lv-dd-global-hover: {{ section.settings.dropdown_global_hover | default: '#666666' }};
    --lv-dd-global-border: {{ section.settings.dropdown_global_border | default: '#e8e2d9' }};
    --lv-dd-global-radius: {{ section.settings.dropdown_global_radius | default: 0 }}px;
    --lv-dd-pad-y: {{ section.settings.dropdown_padding_y | default: 24 }}px;
    --lv-dd-link-size: {{ section.settings.dropdown_link_size | default: 12 }}px;
    --lv-dd-heading-size: {{ section.settings.dropdown_heading_size | default: 13 }}px;
    --lv-dd-font-weight: {{ section.settings.dropdown_font_weight | default: '500' }};
    --lv-dd-text-transform: {{ section.settings.dropdown_text_transform | default: 'uppercase' }};
    {%- case section.settings.dropdown_global_shadow -%}
      {%- when 'none' -%}
        --lv-dd-global-shadow: none;
      {%- when 'subtle' -%}
        --lv-dd-global-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
      {%- when 'medium' -%}
        --lv-dd-global-shadow: 0 12px 36px rgba(0, 0, 0, 0.1);
      {%- when 'deep' -%}
        --lv-dd-global-shadow: 0 20px 50px rgba(0, 0, 0, 0.16);
      {%- else -%}
        --lv-dd-global-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    {%- endcase -%}
  }

  .header__dropdown {
    background-color: var(--lv-dd-bg, var(--lv-dd-global-bg, #ffffff)) !important;
    color: var(--lv-dd-text, var(--lv-dd-global-text, #111111)) !important;
    border: 1px solid var(--lv-dd-border, var(--lv-dd-global-border, #e8e2d9)) !important;
    box-shadow: var(--lv-dd-global-shadow, 0 10px 30px rgba(0, 0, 0, 0.05)) !important;
    border-radius: var(--lv-dd-radius, var(--lv-dd-global-radius, 0px)) !important;
    padding-top: var(--lv-dd-pad-y, 24px) !important;
    padding-bottom: var(--lv-dd-pad-y, 24px) !important;
    box-sizing: border-box !important;
  }
  .header__dropdown .navlink,
  .header__dropdown .navlink--child,
  .header__dropdown .navlink--grandchild {
    color: var(--lv-dd-text, var(--lv-dd-global-text, #111111)) !important;
    font-size: var(--lv-dd-link-size, 12px) !important;
    font-weight: var(--lv-dd-font-weight, 500) !important;
    text-transform: var(--lv-dd-text-transform, uppercase) !important;
    letter-spacing: 0.08em !important;
    transition: color 0.2s ease, opacity 0.2s ease !important;
  }
  .header__dropdown .navlink:hover,
  .header__dropdown .navlink--child:hover,
  .header__dropdown .navlink--grandchild:hover,
  .header__dropdown .navlink:hover .navtext,
  .header__dropdown .navlink--child:hover .navtext,
  .header__dropdown .navlink--grandchild:hover .navtext {
    color: var(--lv-dd-global-hover, #666666) !important;
  }
  .header__dropdown .dropdown__family--grandchild .navlink--child {
    font-size: var(--lv-dd-heading-size, 13px) !important;
    font-weight: 700 !important;
    letter-spacing: 0.12em !important;
    margin-bottom: 10px !important;
    padding-bottom: 6px !important;
    border-bottom: 1px solid var(--lv-dd-border, var(--lv-dd-global-border, #e8e2d9)) !important;
    display: inline-block !important;
  }
  .header__dropdown .dropdown__family--grandchild .navlink--grandchild {
    display: block !important;
    padding: 4px 0 !important;
    font-size: var(--lv-dd-link-size, 12px) !important;
    font-weight: 500 !important;
  }
  .menu__item.parent .header__dropdown {
    width: auto !important;
    min-width: 220px !important;
    left: auto !important;
    border: 1px solid var(--lv-dd-border, var(--lv-dd-global-border, #e8e2d9)) !important;
    border-radius: var(--lv-dd-radius, var(--lv-dd-global-radius, 0px)) !important;
    box-shadow: var(--lv-dd-global-shadow, 0 10px 30px rgba(0, 0, 0, 0.08)) !important;
    padding: var(--lv-dd-pad-y, 24px) 0 !important;
  }
  .menu__item.parent .header__dropdown .header__dropdown__wrapper {
    max-width: none !important;
    padding: 0 16px !important;
  }
  .menu__item.parent .header__dropdown .header__dropdown__inner {
    display: flex !important;
    flex-direction: column !important;
    gap: 8px !important;
    padding: 0 !important;
    max-width: none !important;
  }
  .menu__item.parent .header__dropdown .navlink--child {
    padding: 6px 12px !important;
    border-radius: var(--btn-radius, 0px) !important;
    display: block !important;
  }
  .menu__item.parent .header__dropdown .navlink--child:hover {
    background-color: color-mix(in srgb, var(--lv-dd-text, #111111) 8%, transparent) !important;
  }

  /* Split Layout */
  .lv-split-dropdown__inner {
    display: grid !important;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) !important;
    gap: var(--lv-dd-gap, 24px) !important;
    max-width: none !important;
    margin: 0 auto !important;
    padding: 0 !important;
    align-items: start !important;
  }
  .lv-split-links-grid {
    display: grid !important;
    grid-template-columns: repeat(var(--lv-split-cols, 3), minmax(0, 1fr)) !important;
    gap: var(--lv-dd-gap, 24px) !important;
  }
  .lv-split-promo-wrap {
    width: 100% !important;
    max-width: 320px !important;
    margin: 0 auto !important;
  }

  /* =============================================================
     Bestsellers & Promotional Mega Dropdown Cards & Buttons
     ============================================================= */
  .lv-header-dropdown {
    background-color: var(--lv-dd-bg, var(--lv-dd-global-bg, #ffffff)) !important;
    color: var(--lv-dd-text, var(--lv-dd-global-text, #111111)) !important;
    border: 1px solid var(--lv-dd-border, var(--lv-dd-global-border, #e8e2d9)) !important;
    border-radius: var(--lv-dd-radius, var(--lv-dd-global-radius, 0px)) !important;
    padding: var(--lv-dd-pad-y, 24px) 0 !important;
    box-shadow: var(--lv-dd-global-shadow, 0 8px 24px rgba(0, 0, 0, 0.06)) !important;
    width: 100% !important;
    left: 0 !important;
    box-sizing: border-box !important;
  }
  .lv-header-dropdown > .header__dropdown__wrapper {
    width: 100% !important;
    max-width: 1240px !important;
    margin: 0 auto !important;
    padding: 0 20px !important;
    box-sizing: border-box !important;
  }
  .lv-header-dropdown__inner {
    display: grid !important;
    grid-template-columns: repeat(var(--lv-dd-cols, 4), minmax(0, 1fr)) !important;
    gap: var(--lv-dd-gap, 24px) !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    box-sizing: border-box !important;
  }
  .lv-header-dropdown.lv-dropdown--columns .header__dropdown__inner {
    grid-template-columns: repeat(var(--lv-dd-cols, 4), minmax(0, 1fr)) !important;
    gap: var(--lv-dd-gap, 24px) !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .lv-header-dropdown.lv-dropdown--simple .header__dropdown__inner {
    display: grid !important;
    grid-template-columns: 1fr !important;
    gap: 8px !important;
    max-width: 320px !important;
    margin: 0 auto !important;
    padding: 0 !important;
  }
  .lv-header-dropdown__inner--carousel {
    display: grid !important;
    grid-auto-flow: column !important;
    grid-auto-columns: minmax(220px, 1fr) !important;
    grid-template-columns: none !important;
    overflow-x: auto !important;
    overscroll-behavior-x: contain !important;
    scroll-snap-type: x mandatory !important;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 8px !important;
  }
  .lv-header-dropdown__inner--carousel::-webkit-scrollbar {
    display: none;
  }
  .lv-header-dropdown__inner--carousel > .lv-dropdown-col {
    scroll-snap-align: start;
  }
  .lv-dropdown-editorial {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: center;
    width: 100%;
  }
  .lv-dropdown-editorial__copy {
    max-width: 420px;
    padding: 8px 0;
  }
  .lv-dropdown-editorial__copy h3 {
    margin: 0 0 14px;
    color: var(--lv-dd-text, #111111);
    font-family: 'Quicksand', sans-serif;
    font-size: clamp(22px, 2vw, 32px);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.15;
  }
  .lv-dropdown-editorial__description,
  .lv-dropdown-promo-description {
    margin: 0 0 18px;
    color: var(--lv-dd-text, #111111);
    font-size: 13px;
    line-height: 1.65;
    opacity: 0.78;
  }
  .lv-dropdown-editorial__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin: 18px 0 22px;
    padding: 0;
    list-style: none;
  }
  .lv-dropdown-editorial__links a {
    color: var(--lv-dd-text, #111111);
    font-size: 12px;
    text-decoration: none;
  }
  .lv-dropdown-editorial__links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .lv-dropdown-editorial__image {
    display: block;
    width: 100%;
    max-height: min(48vh, 440px);
    overflow: hidden;
    border-radius: var(--lv-dd-card-radius, 0px);
    background: transparent;
  }
  .lv-dropdown-editorial__image img,
  .lv-dropdown-editorial__image svg {
    display: block;
    width: 100%;
    height: 100%;
    max-height: min(48vh, 440px);
    object-fit: cover;
  }
  .lv-dropdown-products {
    display: grid;
    grid-template-columns: repeat(var(--lv-dd-cols, 4), minmax(0, 1fr));
    gap: var(--lv-dd-gap, 24px);
  }
  .lv-dropdown-product {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    color: var(--lv-dd-text, #111111);
    text-decoration: none;
  }
  .lv-dropdown-product__image {
    display: block;
    width: 100%;
    aspect-ratio: var(--lv-dd-product-ratio, 4 / 5);
    overflow: hidden;
    border-radius: var(--lv-dd-card-radius, 0px);
    background: transparent;
  }
  .lv-dropdown-product__image img,
  .lv-dropdown-product__image svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }
  .lv-dropdown-product:hover .lv-dropdown-product__image img {
    transform: scale(1.035);
  }
  .lv-dropdown-product__title,
  .lv-dropdown-product__price {
    font-size: 12px;
    line-height: 1.4;
  }
