<script>
  (function() {
    // Header dropdown hover enhancement
    var menuItems = document.querySelectorAll('.header__menu .menu__item');
    menuItems.forEach(function(item) {
      item.addEventListener('mouseenter', function() {
        var dropdown = item.querySelector('.header__dropdown');
        if (dropdown) {
          dropdown.style.display = 'block';
          dropdown.style.opacity = '1';
          dropdown.style.pointerEvents = 'auto';
        }
      });
      item.addEventListener('mouseleave', function() {
        var dropdown = item.querySelector('.header__dropdown');
        if (dropdown) {
          dropdown.style.display = '';
          dropdown.style.opacity = '';
          dropdown.style.pointerEvents = '';
        }
      });
    });

    // Mobile menu toggle
    var mobileTrigger = document.querySelector('[data-drawer-toggle="hamburger"]');
    var mobileDrawer = document.getElementById('header-menu');
    var closeButtons = document.querySelectorAll('#header-menu [data-drawer-toggle="hamburger"], #header-menu .drawer__close');

    if (mobileTrigger && mobileDrawer) {
      mobileTrigger.addEventListener('click', function(e) {
        e.preventDefault();
        mobileDrawer.classList.toggle('is-open');
        document.body.classList.toggle('drawer-open');
      });
    }

    closeButtons.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        if (mobileDrawer) {
          mobileDrawer.classList.remove('is-open');
          document.body.classList.remove('drawer-open');
        }
      });
    });

    // Cart drawer toggle (Header buttons only)
    var cartTriggers = document.querySelectorAll('.header__mobile__button[data-drawer-toggle="drawer-cart"], .navlink--cart');
    cartTriggers.forEach(function(trigger) {
      trigger.addEventListener('click', function(e) {
        e.preventDefault();
        if (typeof window.openCartDrawer === 'function') {
          window.openCartDrawer();
        }
      });
    });

    // Search popdown toggle
    var searchTriggers = document.querySelectorAll('[data-popdown-toggle="search-popdown"]');
    searchTriggers.forEach(function(trigger) {
      trigger.addEventListener('click', function(e) {
        e.preventDefault();
        var popdown = document.getElementById('search-popdown');
        var underlay = document.querySelector('[data-search-underlay]');
        if (popdown) {
          popdown.classList.add('is-visible');
          if (underlay) underlay.classList.add('underlay--visible');
          var searchInput = popdown.querySelector('input[type="search"]');
          if (searchInput) {
            setTimeout(function() { searchInput.focus(); }, 100);
          }
        }
      });
    });

    var searchCloseButtons = document.querySelectorAll('#search-popdown [data-close-popdown], [data-search-underlay]');
    searchCloseButtons.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var popdown = document.getElementById('search-popdown');
        var underlay = document.querySelector('[data-search-underlay]');
        if (popdown) popdown.classList.remove('is-visible');
        if (underlay) underlay.classList.remove('underlay--visible');
      });
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' || e.keyCode === 27) {
        var popdown = document.getElementById('search-popdown');
        var underlay = document.querySelector('[data-search-underlay]');
        if (popdown && popdown.classList.contains('is-visible')) {
          popdown.classList.remove('is-visible');
          if (underlay) underlay.classList.remove('underlay--visible');
        }
      }
    });

    // Header language switcher (Translate & Adapt / Shopify localization form)
    if (!document.documentElement.dataset.lvLangBound) {
      document.documentElement.dataset.lvLangBound = '1';

      function closeAllLangMenus(exceptWrap) {
        document.querySelectorAll('[data-lv-lang]').forEach(function(wrap) {
          if (exceptWrap && wrap === exceptWrap) return;
          var btn = wrap.querySelector('[data-lv-lang-toggle]');
          var menu = wrap.querySelector('[data-lv-lang-menu]');
          if (btn) btn.setAttribute('aria-expanded', 'false');
          if (menu) menu.hidden = true;
        });
      }

      document.addEventListener('click', function(e) {
        var toggle = e.target.closest ? e.target.closest('[data-lv-lang-toggle]') : null;
        if (toggle) {
          e.preventDefault();
          var wrap = toggle.closest('[data-lv-lang]');
          var menu = wrap ? wrap.querySelector('[data-lv-lang-menu]') : null;
          if (!wrap || !menu) return;
          var wasOpen = toggle.getAttribute('aria-expanded') === 'true';
          closeAllLangMenus(wrap);
          if (wasOpen) {
            toggle.setAttribute('aria-expanded', 'false');
            menu.hidden = true;
          } else {
            toggle.setAttribute('aria-expanded', 'true');
            menu.hidden = false;
          }
          return;
        }

        var option = e.target.closest ? e.target.closest('[data-lv-lang-option]') : null;
        if (option) {
          e.preventDefault();
          var optWrap = option.closest('[data-lv-lang]');
          var form = optWrap ? optWrap.querySelector('form') : null;
          var input = optWrap ? optWrap.querySelector('[data-lv-lang-input]') : null;
          var localeVal = option.getAttribute('data-value');
          if (!localeVal || !form || !input) return;
          if (input.value === localeVal && option.classList.contains('is-active')) {
            closeAllLangMenus();
            return;
          }
          input.value = localeVal;
          closeAllLangMenus();
          form.submit();
          return;
        }

        if (!e.target.closest || !e.target.closest('[data-lv-lang]')) {
          closeAllLangMenus();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' || e.keyCode === 27) {
          var openBtn = document.querySelector('[data-lv-lang-toggle][aria-expanded="true"]');
          if (openBtn) {
            closeAllLangMenus();
            openBtn.focus();
          }
          return;
        }

        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        var wrap = e.target.closest ? e.target.closest('[data-lv-lang]') : null;
        if (!wrap) return;
        var menu = wrap.querySelector('[data-lv-lang-menu]');
        if (!menu || menu.hidden) return;
        var opts = Array.prototype.slice.call(menu.querySelectorAll('[data-lv-lang-option]'));
        if (!opts.length) return;
        e.preventDefault();
        var idx = opts.indexOf(document.activeElement);
        if (e.key === 'ArrowDown') {
          opts[idx < opts.length - 1 ? idx + 1 : 0].focus();
        } else {
          opts[idx > 0 ? idx - 1 : opts.length - 1].focus();
        }
      });
    }

    // Logged-in avatar image fallback: reveal initial letter if profile image fails to load
    if (!document.documentElement.dataset.lvAvatarBound) {
      document.documentElement.dataset.lvAvatarBound = '1';
      document.addEventListener('error', function(e) {
        var img = e.target;
        if (!img || img.tagName !== 'IMG') return;
        var wrap = img.closest ? img.closest('[data-lv-avatar]') : null;
        if (wrap) wrap.classList.add('is-avatar-error');
      }, true);
      function checkBrokenAvatars() {
        document.querySelectorAll('[data-lv-avatar] img').forEach(function(img) {
          if (img.complete && img.naturalWidth === 0) {
            var wrap = img.closest ? img.closest('[data-lv-avatar]') : null;
            if (wrap) wrap.classList.add('is-avatar-error');
          }
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', checkBrokenAvatars);
      } else {
        checkBrokenAvatars();
      }
    }
  })();
</script>

{%- if sticky_mode == 'scroll_up' -%}
  <script>
    (function() {
      var headerSec = document.getElementById('shopify-section-{{ section.id }}');
      if (!headerSec) return;
      var lastScroll = window.scrollY;
      var threshold = 90;
      window.addEventListener('scroll', function() {
        var current = window.scrollY;
        if (current > threshold && current > lastScroll) {
          headerSec.classList.add('lv-header--hidden');
        } else {
          headerSec.classList.remove('lv-header--hidden');
        }
        lastScroll = current;
      }, { passive: true });
    })();
  </script>
{%- endif -%}

{%- if transparent_header -%}
<script>
  /* Aurelle transparent header: flag the page as scrolled (header turns solid) and keep the hero pulled up by the real header height */
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    var root = document.documentElement;
    function onScroll() {
      if ((window.pageYOffset || document.documentElement.scrollTop || 0) > 8) root.setAttribute('data-lv-scrolled', '');
      else root.removeAttribute('data-lv-scrolled');
    }
    function measure() {
      var bar = section.querySelector('.theme__header') || section;
      root.style.setProperty('--lv-header-h', bar.offsetHeight + 'px');
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', measure);
    if (window.ResizeObserver) new ResizeObserver(measure).observe(section.querySelector('.theme__header') || section);
    onScroll();
    measure();
  })();
</script>
{%- endif -%}

