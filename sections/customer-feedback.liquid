    #cf-{{ section.id }}.cf--customer_photo .cf-card--with-product-image .cf-card__rating { margin-top: 0; }
    #cf-{{ section.id }}.cf--customer_photo .cf-card--with-product-image .cf-card__by { margin: 8px 16px 16px; }
