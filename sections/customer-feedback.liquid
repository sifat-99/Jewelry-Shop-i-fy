{%- comment -%}
  Customer feedback: testimonials / reviews with star ratings.
  Source: Shopify metaobject entries (type "review") or manual blocks in the theme editor.
{%- endcomment -%}
{%- liquid
  assign limit = section.settings.limit | default: 12
  assign mo_type = section.settings.metaobject_type | default: 'review'
  assign entries = shop.metaobjects[mo_type].values | sort_natural: 'date' | reverse
  assign src = section.settings.source | default: 'auto'
  assign use_meta = false
  if src == 'metaobject'
    assign use_meta = true
  elsif src == 'auto' and entries.size > 0
    assign use_meta = true
  endif
  assign stats = ''
  capture stats
    render 'feedback-stats', use_meta: use_meta, entries: entries, blocks: section.blocks, limit: limit
  endcapture
  assign stat_parts = stats | split: '~~'
  assign avg = stat_parts[0] | default: 0
  assign cnt = stat_parts[1] | plus: 0
  assign initial = section.settings.initial_count | default: 3
  assign cols = section.settings.columns | default: 3
  if cnt > 0 and cnt < cols
    assign cols = cnt
  endif
  assign layout = settings.review_design | default: 'luxury_minimal'
  case layout
    when 'editorial'
      assign layout = 'luxury_minimal'
    when 'spotlight'
      assign layout = 'editorial_magazine'
    when 'journal'
      assign layout = 'modern_grid'
  endcase
  assign is_bubble = false
  if layout == 'speech_bubble'
    assign is_bubble = true
  endif
-%}

{%- if cnt == 0 and request.design_mode == false -%}
  {%- comment -%}nothing to show{%- endcomment -%}
{%- else -%}
<div id="cf-{{ section.id }}" class="cf color-{{ section.settings.color_scheme | default: 'scheme-1' }} cf--{{ layout }}" style="--cf-cols-d: {{ cols }}; --PT: {{ section.settings.padding_top | default: 48 }}px; --PB: {{ section.settings.padding_bottom | default: 48 }}px;" data-cf data-cf-count="{{ cnt }}" data-cf-initial="{{ initial }}" data-cf-initial-mobile="2" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.autoplay_speed | default: 5 }}"{% if layout == 'parallax_wall' %} data-review-parallax{% endif %}>
  <div class="cf__inner wrapper--full section-padding">
    {%- if is_bubble -%}
      {%- if section.settings.bubble_title != blank or section.settings.bubble_title_bold != blank or section.settings.show_summary -%}
        <div class="cf__head cf__head--bubble">
          {%- if section.settings.bubble_title != blank or section.settings.bubble_title_bold != blank -%}
            <h2 class="cf__title cf__title--bubble">
              {%- if section.settings.bubble_title != blank -%}<span class="cf__title-light">{{ section.settings.bubble_title | escape }}</span>{%- endif -%}
              {%- if section.settings.bubble_title_bold != blank -%}<strong class="cf__title-bold">{{ section.settings.bubble_title_bold | escape }}</strong>{%- endif -%}
            </h2>
          {%- endif -%}
          {%- if section.settings.show_summary and cnt > 0 -%}
            <p class="cf__summary cf__summary--bubble">
              <span class="cf__summary-score"><strong>{{ avg }}</strong>/5</span>
              {%- render 'rating-stars', rating: avg, class_name: 'cf-stars' -%}
              {%- if section.settings.bubble_source_label != blank -%}<span class="cf__summary-source">{{ section.settings.bubble_source_label | escape }}</span>{%- endif -%}
              <span class="cf__summary-count">{{ 'products.reviews.based_on' | t: count: cnt }}</span>
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- elsif section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="cf__head">
        {%- if section.settings.heading != blank -%}<h2 class="cf__title kicker-flourished">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="cf__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
        {%- if section.settings.show_summary and cnt > 0 -%}
          <p class="cf__summary">
            {%- render 'rating-stars', rating: avg, class_name: 'cf-stars' -%}
            <span class="cf__summary-score"><strong>{{ avg }}</strong><span>/ 5</span></span>
            <span class="cf__summary-divider" aria-hidden="true"></span>
            <span class="cf__summary-count">{{ 'products.reviews.count' | t: count: cnt }}</span>
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if cnt == 0 -%}
      <p class="cf__empty">{{ 'products.reviews.empty_admin_hint' | t }}</p>
    {%- else -%}
      {%- if is_bubble -%}
      <div class="cf__bubble-layout">
        <div class="cf__side">
          {%- if section.settings.bubble_show_quote -%}
            <span class="cf__quote" aria-hidden="true"><svg viewBox="0 0 48 40" fill="currentColor"><path d="M0 40V22.4C0 9.6 7.2 1.6 20.8 0l1.6 6.4C14.4 8 11.2 12 10.4 17.6H20V40H0zm26.4 0V22.4C26.4 9.6 33.6 1.6 47.2 0l1.6 6.4C40.8 8 37.6 12 36.8 17.6h9.6V40H26.4z"/></svg></span>
          {%- endif -%}
          {%- if section.settings.bubble_side_title != blank -%}<h3 class="cf__side-title">{{ section.settings.bubble_side_title | escape }}</h3>{%- endif -%}
          <div class="cf__nav">
            <button type="button" class="cf__nav-btn" data-cf-prev aria-label="{{ 'products.reviews.previous' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"/></svg></button>
            {%- if section.settings.bubble_show_progress -%}<span class="cf__progress" aria-hidden="true"><span class="cf__progress-bar" data-cf-progress></span></span>{%- endif -%}
            <button type="button" class="cf__nav-btn" data-cf-next aria-label="{{ 'products.reviews.next' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
          </div>
        </div>
      {%- endif -%}
      <div class="cf__wrap">
        {%- if layout == 'carousel' -%}
          <button type="button" class="cf__arrow cf__arrow--prev" data-cf-prev aria-label="{{ 'products.reviews.previous' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button>
        {%- endif -%}
        <div id="cf-track-{{ section.id }}" class="cf__track" data-cf-track>
          {%- if use_meta -%}
            {%- assign shown = 0 -%}
            {%- for entry in entries limit: limit -%}
              {%- unless entry.approved == false -%}
                {%- assign shown = shown | plus: 1 -%}
                <div class="cf__item{% if shown > initial %} cf__item--extra{% endif %}{% if shown > 2 %} cf__item--mobile-extra{% endif %}" data-review-card data-rating="{{ entry.rating.value }}" data-review-date="{{ entry.date.value | date: '%s' }}"{% if shown > initial %} hidden{% endif %}>
                  {%- if is_bubble -%}
                    {%- render 'feedback-bubble', name: entry.name, rating: entry.rating.value, title: entry.title, body: entry.body, photo: entry.photo.value, reviewed_product: entry.product.value, product_title: entry.product.value.title, verified: entry.verified.value, date: entry.date.value -%}
                  {%- else -%}
                  {%- render 'feedback-card', name: entry.name, rating: entry.rating.value, title: entry.title, body: entry.body, photo: entry.photo.value, reviewed_product: entry.product.value, product_title: entry.product.value.title, verified: entry.verified.value, date: entry.date.value -%}
                  {%- endif -%}
                </div>
              {%- endunless -%}
            {%- endfor -%}
          {%- else -%}
            {%- assign shown = 0 -%}
            {%- for block in section.blocks -%}
              {%- assign shown = shown | plus: 1 -%}
              <div class="cf__item{% if shown > initial %} cf__item--extra{% endif %}{% if shown > 2 %} cf__item--mobile-extra{% endif %}" data-review-card data-rating="{{ block.settings.rating }}" data-review-date="{{ block.settings.date | date: '%s' }}"{% if shown > initial %} hidden{% endif %} {{ block.shopify_attributes }}>
                {%- if is_bubble -%}
                  {%- render 'feedback-bubble', name: block.settings.name, rating: block.settings.rating, title: block.settings.title, body: block.settings.text, photo: block.settings.photo, reviewed_product: block.settings.product_link, product_title: block.settings.product, verified: block.settings.verified, date: block.settings.date -%}
                {%- else -%}
                {%- render 'feedback-card', name: block.settings.name, rating: block.settings.rating, title: block.settings.title, body: block.settings.text, photo: block.settings.photo, reviewed_product: block.settings.product_link, product_title: block.settings.product, verified: block.settings.verified, date: block.settings.date -%}
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
        {%- if layout == 'carousel' -%}
          <button type="button" class="cf__arrow cf__arrow--next" data-cf-next aria-label="{{ 'products.reviews.next' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
        {%- endif -%}
      </div>
      {%- if is_bubble -%}</div>{%- endif -%}
      {%- unless is_bubble -%}{%- if cnt > initial or cnt > 2 -%}
        <div class="cf__more"><button type="button" class="btn btn--outline" data-cf-more aria-controls="cf-track-{{ section.id }}" aria-expanded="false" data-show-more-label="{{ 'products.reviews.show_more' | t | escape }}" data-show-less-label="{{ 'products.reviews.show_less' | t | escape }}">{{ 'products.reviews.show_more' | t }}</button></div>
      {%- endif -%}{%- endunless -%}
    {%- endif -%}
    {%- if section.settings.show_divider -%}<hr class="cf__divider">{%- endif -%}
  </div>
</div>

<style>
  #cf-{{ section.id }} .cf__inner { padding-top: 0 !important; padding-bottom: 0 !important; }
  #cf-{{ section.id }} .cf__divider { height: 1px; margin: calc(var(--PB) * .7) 0 0; border: 0; background: color-mix(in srgb, var(--text, #111) 28%, transparent); }
  {%- if section.settings.show_divider %}
  #cf-{{ section.id }} { padding-bottom: 0; }
  {%- endif %}
  #cf-{{ section.id }} { --cf-cols: var(--cf-cols-d); padding: var(--PT) 0 var(--PB); background: var(--bg, #fff); color: var(--text, #111); --cf-accent: var(--lv-accent, #9b7c53); --cf-gap: 20px; --cf-line: var(--lv-border); }
  #cf-{{ section.id }} .cf__head { text-align: center; max-width: 680px; margin: 0 auto clamp(26px, 4vw, 44px); }
  #cf-{{ section.id }} .cf__title { margin: 0 0 10px; font-family: var(--FONT-STACK-HEADING, sans-serif); font-size: calc(clamp(22px, 3vw, 32px) * var(--FONT-ADJUST-HEADING, 1)); font-weight: var(--FONT-WEIGHT-HEADING, 600); letter-spacing: var(--FONT-HEADING-LETTER-SPACING, .14em); text-transform: var(--FONT-HEADING-TRANSFORM, uppercase); line-height: 1.2; }
  #cf-{{ section.id }} .cf__sub { margin: 0 0 14px; font-family: var(--FONT-STACK-SUBHEADING, inherit); font-size: 14.5px; line-height: 1.7; opacity: .75; }
  #cf-{{ section.id }} .cf__summary { margin: 0; display: inline-flex; align-items: center; gap: 10px; font-size: 14px; white-space: nowrap; }
  #cf-{{ section.id }} .cf__summary-score { display: inline-flex; align-items: baseline; gap: 4px; }
  #cf-{{ section.id }} .cf__summary-score strong { font-weight: 700; }
  #cf-{{ section.id }} .cf__summary-divider { width: 1px; height: 14px; flex: none; background: var(--cf-line); }
  #cf-{{ section.id }} .cf__summary-count { opacity: .8; }
  #cf-{{ section.id }} .cf__summary .cf-stars { font-size: 21px; }
  #cf-{{ section.id }} .cf__empty { text-align: center; opacity: .6; font-size: 14px; margin: 0; }
  #cf-{{ section.id }} .cf-stars { font-size: 20px; }

  #cf-{{ section.id }} .cf__wrap { position: relative; }
  #cf-{{ section.id }} .cf__track { display: grid; grid-template-columns: repeat(var(--cf-cols), minmax(0, 1fr)); gap: var(--cf-gap); overflow: visible; padding: 2px 0; justify-content: center; }
  #cf-{{ section.id }} .cf__track::-webkit-scrollbar { display: none; }
  #cf-{{ section.id }} .cf__item { min-width: 0; max-width: 620px; display: flex; }
  #cf-{{ section.id }} .cf__item[hidden] { display: none; }
  #cf-{{ section.id }}.cf--parallax_wall .cf__inner { display: grid; grid-template-columns: minmax(220px, .72fr) minmax(0, 1.65fr); align-items: start; column-gap: clamp(32px, 6vw, 92px); }
  #cf-{{ section.id }}.cf--parallax_wall .cf__head { position: sticky; top: 116px; grid-column: 1; grid-row: 1; max-width: 420px; margin: 0; text-align: left; }
  #cf-{{ section.id }}.cf--parallax_wall .cf__title { max-width: 390px; }
  #cf-{{ section.id }}.cf--parallax_wall .cf__summary { flex-wrap: wrap; justify-content: flex-start; white-space: normal; }
  #cf-{{ section.id }}.cf--parallax_wall .cf__wrap { grid-column: 2; grid-row: 1; min-width: 0; }
  #cf-{{ section.id }}.cf--parallax_wall .cf__track { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: clamp(16px, 2vw, 28px); }
  #cf-{{ section.id }}.cf--parallax_wall .cf__item { max-width: none; transform: translate3d(0, var(--review-parallax-y, 0px), 0); will-change: transform; }
  #cf-{{ section.id }}.cf--parallax_wall .cf__item:nth-child(even) { margin-top: clamp(56px, 7vw, 96px); }
  #cf-{{ section.id }}.cf--parallax_wall .cf__item:nth-child(4n + 3) { margin-top: clamp(12px, 2vw, 26px); }
  #cf-{{ section.id }}.cf--parallax_wall .cf__more { grid-column: 2; margin-top: 28px; }
  #cf-{{ section.id }}.cf--parallax_wall .cf__divider { grid-column: 1 / -1; }
  /* ===== Speech bubble slider ===== */
  #cf-{{ section.id }}.cf--speech_bubble .cf__head { max-width: 820px; margin-bottom: clamp(32px, 5vw, 64px); }
  #cf-{{ section.id }}.cf--speech_bubble .cf__title--bubble { margin: 0 0 22px; display: flex; flex-direction: column; font-family: var(--FONT-STACK-HEADING, sans-serif); font-size: calc(clamp(26px, 3.6vw, 44px) * var(--FONT-ADJUST-HEADING, 1)); line-height: 1.15; letter-spacing: 0; text-transform: none; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__title-light { font-weight: 400; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__title-bold { font-weight: 700; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__summary--bubble { display: inline-flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px 16px; white-space: normal; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__summary--bubble .cf-stars { font-size: 20px; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__summary-score strong { font-weight: 700; margin-right: 1px; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__summary-source { font-weight: 600; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__bubble-layout { display: grid; grid-template-columns: minmax(200px, 280px) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__side { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; padding-top: 6px; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__quote { display: block; width: 52px; color: color-mix(in srgb, var(--text, #111) 30%, transparent); }
  #cf-{{ section.id }}.cf--speech_bubble .cf__quote svg { display: block; width: 100%; height: auto; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__side-title { margin: 0; font-family: var(--FONT-STACK-HEADING, sans-serif); font-size: calc(clamp(22px, 2.3vw, 30px) * var(--FONT-ADJUST-HEADING, 1)); font-weight: 500; line-height: 1.25; letter-spacing: 0; text-transform: none; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__nav { display: flex; align-items: center; gap: 14px; width: 100%; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__nav-btn { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 32px; height: 32px; padding: 0; border: 0; background: transparent; color: var(--text, #111); cursor: pointer; transition: color .2s ease, opacity .2s ease; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__nav-btn svg { width: 22px; height: 22px; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__nav-btn:hover { color: var(--cf-accent); }
  #cf-{{ section.id }}.cf--speech_bubble .cf__nav-btn[disabled] { opacity: .3; pointer-events: none; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__progress { position: relative; flex: 1 1 auto; max-width: 120px; height: 2px; background: color-mix(in srgb, var(--text, #111) 22%, transparent); }
  #cf-{{ section.id }}.cf--speech_bubble .cf__progress-bar { position: absolute; top: 0; left: 0; height: 100%; width: 30%; background: var(--text, #111); transition: left .25s ease, width .25s ease; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__wrap { min-width: 0; margin-right: calc(var(--outer, 20px) * -1); }
  #cf-{{ section.id }}.cf--speech_bubble .cf__track { display: flex; gap: 24px; overflow-x: auto; overflow-anchor: none; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; padding: 2px var(--outer, 20px) 24px 2px; justify-content: flex-start; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__track::-webkit-scrollbar { display: none; }
  #cf-{{ section.id }}.cf--speech_bubble .cf__item { flex: 0 0 min(340px, 82%); max-width: none; scroll-snap-align: start; }
  @media (max-width: 900px) {
    #cf-{{ section.id }}.cf--speech_bubble .cf__bubble-layout { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    #cf-{{ section.id }}.cf--speech_bubble .cf__side { gap: 14px; }
    #cf-{{ section.id }}.cf--speech_bubble .cf__quote { width: 40px; }
    #cf-{{ section.id }}.cf--speech_bubble .cf__wrap { margin-right: calc(var(--outer, 20px) * -1); }
  }
  @media (max-width: 650px) {
    #cf-{{ section.id }}.cf--speech_bubble .cf__item--mobile-extra { display: flex; }
    #cf-{{ section.id }}.cf--speech_bubble .cf__item { flex-basis: 84%; }
    #cf-{{ section.id }}.cf--speech_bubble .cf__track { gap: 16px; }
  }
  #cf-{{ section.id }}.cf--parallax_wall.cf--masonry-ready .cf__track { grid-auto-rows: 8px; row-gap: 0; }
  #cf-{{ section.id }}.cf--carousel .cf__track { overflow-anchor: none; display: flex; gap: var(--cf-gap); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; justify-content: safe center; }
  #cf-{{ section.id }}.cf--carousel .cf__item { flex: 0 0 calc((100% - var(--cf-gap) * (var(--cf-cols) - 1)) / var(--cf-cols)); max-width: 620px; scroll-snap-align: start; }
  #cf-{{ section.id }}.cf--carousel .cf__track::-webkit-scrollbar { display: none; }
  #cf-{{ section.id }}.cf--editorial_magazine .cf__track { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: minmax(180px, auto); }
  #cf-{{ section.id }}.cf--editorial_magazine .cf__item { max-width: none; }
  #cf-{{ section.id }}.cf--editorial_magazine .cf__item:first-child { grid-row: span 2; max-width: none; }
  #cf-{{ section.id }}.cf--editorial_magazine[data-cf-count="1"] .cf__item:first-child { grid-row: auto; }
  #cf-{{ section.id }}.cf--editorial_magazine[data-cf-count="2"] .cf__item:nth-child(2) { grid-row: span 2; }
  /* Masonry: grid with 8px rows; the script sets each card's row span from its height, so cards fill left -> right
     and short cards leave no gap below them (CSS columns left a column empty when only 3 cards were visible). */
  #cf-{{ section.id }}.cf--masonry .cf__track { display: grid; grid-template-columns: repeat(var(--cf-cols), minmax(0, 1fr)); column-gap: var(--cf-gap); row-gap: var(--cf-gap); align-items: start; }
  #cf-{{ section.id }}.cf--masonry.cf--masonry-ready .cf__track { grid-auto-rows: 8px; row-gap: 0; }
  #cf-{{ section.id }}.cf--masonry .cf__item { display: flex; width: 100%; max-width: none; margin: 0; align-self: start; }
  #cf-{{ section.id }}.cf--masonry .cf__item[hidden] { display: none; }
  #cf-{{ section.id }}.cf--masonry .cf-card { height: auto; }
  #cf-{{ section.id }}.cf--modern_grid .cf__track { max-width: 1180px; margin-inline: auto; }
  @media (max-width: 960px) { #cf-{{ section.id }} { --cf-cols: {% if cols > 2 %}2{% else %}{{ cols }}{% endif %}; } }
  @media (max-width: 650px) {
    #cf-{{ section.id }} { --cf-cols: 1; }
    #cf-{{ section.id }} .cf__item--mobile-extra { display: none; }
    #cf-{{ section.id }}.cf--mobile-expanded .cf__item--mobile-extra:not([hidden]) { display: flex; }
    #cf-{{ section.id }}.cf--editorial_magazine .cf__track { grid-template-columns: minmax(0, 1fr); grid-auto-rows: auto; }
    #cf-{{ section.id }}.cf--editorial_magazine .cf__item:first-child,
    #cf-{{ section.id }}.cf--editorial_magazine .cf__item:nth-child(2) { grid-row: auto; }
    #cf-{{ section.id }}.cf--carousel .cf__track { display: grid; grid-template-columns: minmax(0, 1fr); overflow: visible; scroll-snap-type: none; }
    #cf-{{ section.id }}.cf--carousel .cf__item { flex: none; width: 100%; max-width: none; }
    #cf-{{ section.id }}.cf--carousel .cf__arrow { display: none; }
  }
  @media (max-width: 900px) {
    #cf-{{ section.id }}.cf--parallax_wall .cf__inner { display: block; }
    #cf-{{ section.id }}.cf--parallax_wall .cf__head { position: static; max-width: 680px; margin: 0 auto clamp(26px, 4vw, 44px); text-align: center; }
    #cf-{{ section.id }}.cf--parallax_wall .cf__title { max-width: none; }
    #cf-{{ section.id }}.cf--parallax_wall .cf__summary { justify-content: center; }
    #cf-{{ section.id }}.cf--parallax_wall .cf__track { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #cf-{{ section.id }}.cf--parallax_wall .cf__item { margin-top: 0 !important; transform: none !important; will-change: auto; }
  }
  @media (max-width: 650px) {
    #cf-{{ section.id }}.cf--parallax_wall .cf__track { grid-template-columns: minmax(0, 1fr); }
  }

  #cf-{{ section.id }} .cf-card { display: flex; flex-direction: column; gap: 12px; width: 100%; box-sizing: border-box; padding: 26px 24px 22px; background: #fff; border: 1px solid color-mix(in srgb, var(--cf-accent) 22%, var(--cf-line)); border-radius: var(--card-radius, 0); }
  #cf-{{ section.id }} .cf-card__rating { display: inline-flex; align-items: center; gap: 8px; }
