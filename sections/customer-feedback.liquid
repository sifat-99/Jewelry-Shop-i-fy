<script>
  (function () {
    var init = function () {
      var root = document.getElementById('cf-{{ section.id }}');
      if (!root || root.dataset.ready) return;
      root.dataset.ready = '1';
      var track = root.querySelector('[data-cf-track]');
      var more = root.querySelector('[data-cf-more]');
      var prev = root.querySelector('[data-cf-prev]');
      var next = root.querySelector('[data-cf-next]');
      var mobileQuery = window.matchMedia('(max-width: 650px)');
      var desktopInitialCount = Number(root.dataset.cfInitial) || 3;
      var mobileInitialCount = Number(root.dataset.cfInitialMobile) || 2;
      var reviewCards = [];
      var expanded = false;
      if (track) {
        reviewCards = Array.prototype.slice.call(track.querySelectorAll('[data-review-card]'));
        reviewCards.sort(function (a, b) {
          return (Number(b.dataset.reviewDate) || 0) - (Number(a.dataset.reviewDate) || 0);
        });
      }
      var applyVisibility = function () {
        var isMobile = mobileQuery.matches;
        var visibleCount = isMobile ? mobileInitialCount : desktopInitialCount;
        /* Carousel (desktop): every review is a slide, so nothing is hidden behind "Show more" */
        var allSlides = (root.classList.contains('cf--carousel') && !isMobile) || root.classList.contains('cf--speech_bubble');
        if (allSlides) visibleCount = reviewCards.length;
        root.classList.toggle('cf--mobile-expanded', isMobile && expanded);
        reviewCards.forEach(function (item, index) {
          /* always re-append: keeps the DOM in the same newest-first order as the visibility logic,
             so :first-child / :nth-child layouts (editorial, parallax) style the cards that are actually shown */
          if (track) track.appendChild(item);
          item.classList.toggle('cf__item--extra', index >= desktopInitialCount);
          item.classList.toggle('cf__item--mobile-extra', index >= mobileInitialCount);
          item.hidden = !expanded && index >= visibleCount;
        });
        if (more) {
          var canExpand = reviewCards.length > visibleCount;
          if (more.parentNode) more.parentNode.hidden = !canExpand;
          more.setAttribute('aria-expanded', String(expanded));
          more.textContent = expanded ? more.dataset.showLessLabel : more.dataset.showMoreLabel;
        }
      };
      /* Masonry: give every visible card a row span that matches its height */
      var usesRowSpans = root.classList.contains('cf--masonry') || root.classList.contains('cf--parallax_wall');
      var layoutMasonry = function () {
        if (!track || !usesRowSpans) return;
        var gap = parseFloat(getComputedStyle(track).columnGap) || 20;
        root.classList.add('cf--masonry-ready');
        reviewCards.forEach(function (item) {
          if (item.hidden) return;
          var mt = parseFloat(getComputedStyle(item).marginTop) || 0; /* parallax wall staggers cards with a top margin */
          item.style.gridRowEnd = 'span ' + Math.ceil((item.offsetHeight + mt + gap) / 8);
        });
      };
      var masonryQueued = false;
      var queueMasonry = function () {
        if (masonryQueued) return;
        masonryQueued = true;
        window.requestAnimationFrame(function () { masonryQueued = false; layoutMasonry(); });
      };
      if (usesRowSpans) {
        if ('ResizeObserver' in window) {
          var masonryRO = new ResizeObserver(queueMasonry);
          reviewCards.forEach(function (item) { masonryRO.observe(item); });
        }
        window.addEventListener('resize', queueMasonry);
        window.addEventListener('load', queueMasonry);
      }
      var applyVisibilityBase = applyVisibility;
      applyVisibility = function () { applyVisibilityBase(); queueMasonry(); };
      applyVisibility();
      /* re-ordering the cards can make the browser scroll-anchor the carousel to the end: start at the first card */
      if (track) track.scrollLeft = 0;
      if (more) {
        more.addEventListener('click', function () {
          expanded = !expanded;
          applyVisibility();
          if (!expanded && track && track.scrollLeft > 0) track.scrollTo({ left: 0, behavior: 'smooth' });
          if (track && prev && next) window.requestAnimationFrame(sync);
        });
      }
      var onBreakpointChange = function () {
        expanded = false;
        applyVisibility();
        if (track && prev && next) window.requestAnimationFrame(sync);
      };
      if (mobileQuery.addEventListener) mobileQuery.addEventListener('change', onBreakpointChange);
      else if (mobileQuery.addListener) mobileQuery.addListener(onBreakpointChange);
      if (!track || !prev || !next) return;
      var step = function () { var it = track.querySelector('.cf__item'); return it ? it.getBoundingClientRect().width + 20 : track.clientWidth; };
      var progress = root.querySelector('[data-cf-progress]');
      var sync = function () {
        prev.disabled = track.scrollLeft <= 4;
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
        if (progress && track.scrollWidth > 0) {
          /* progress bar = visible share of the track, moving along with the scroll position */
          var ratio = Math.min(1, track.clientWidth / track.scrollWidth);
          var maxScroll = track.scrollWidth - track.clientWidth;
          progress.style.width = (ratio * 100) + '%';
          progress.style.left = (maxScroll > 0 ? (track.scrollLeft / maxScroll) * (1 - ratio) * 100 : 0) + '%';
        }
      };
      prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
      next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      track.addEventListener('scroll', function () { window.requestAnimationFrame(sync); }, { passive: true });
      window.addEventListener('resize', sync);
      sync();
      if (root.dataset.autoplay === 'true' && !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
        var timer = null, paused = false;
        var tick = function () {
          if (paused || document.hidden) return;
          if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 4) track.scrollTo({ left: 0, behavior: 'smooth' });
          else track.scrollBy({ left: step(), behavior: 'smooth' });
        };
        var start = function () { stop(); timer = setInterval(tick, (parseFloat(root.dataset.speed) || 5) * 1000); };
        var stop = function () { if (timer) { clearInterval(timer); timer = null; } };
        root.addEventListener('mouseenter', function () { paused = true; });
        root.addEventListener('mouseleave', function () { paused = false; });
        root.addEventListener('touchstart', function () { paused = true; }, { passive: true });
        start();
      }
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
    document.addEventListener('shopify:section:load', function (e) { if (e.target && e.target.id === 'shopify-section-{{ section.id }}') { var r = document.getElementById('cf-{{ section.id }}'); if (r) delete r.dataset.ready; init(); } });
  })();
</script>
