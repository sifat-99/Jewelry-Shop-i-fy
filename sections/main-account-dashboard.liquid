</div>

<script>
  (function() {
    var closeMobileDrawerFn = null;
    var scheduleStickySyncFn = null;

    function initDashboardTabs() {
      var root = document.querySelector('[data-lv-acct-dashboard]');
      if (!root) return;

      var navBtns = root.querySelectorAll('[data-tab-target]');
      var panels = root.querySelectorAll('[data-tab-panel]');
      var quickSwitchers = root.querySelectorAll('[data-switch-to]');
      var mobileCurrentEl = root.querySelector('[data-lv-acct-mobile-current]');

      function syncMobileCurrentLabel(activeBtn) {
        if (!mobileCurrentEl || !activeBtn) return;
        var labelEl = activeBtn.querySelector('.lv-acct-nav__label');
        var pillEl = activeBtn.querySelector('.lv-acct-nav__pill');
        var text = labelEl ? labelEl.textContent.trim() : '';
        if (pillEl && pillEl.textContent.trim()) {
          text += ' (' + pillEl.textContent.trim() + ')';
        }
        mobileCurrentEl.textContent = text;
      }

      function switchTab(tabId) {
        if (!tabId) return;
        var activeBtn = null;
        navBtns.forEach(function(btn) {
          var target = btn.getAttribute('data-tab-target');
          var isActive = target === tabId;
          btn.classList.toggle('is-active', isActive);
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
          if (isActive) activeBtn = btn;
        });

        panels.forEach(function(panel) {
          var id = panel.getAttribute('data-tab-panel');
          panel.classList.toggle('is-active', id === tabId);
        });

        syncMobileCurrentLabel(activeBtn);

        if (typeof closeMobileDrawerFn === 'function') {
          closeMobileDrawerFn(false);
        }
        if (typeof scheduleStickySyncFn === 'function') {
          scheduleStickySyncFn(0);
        }

        // Update URL hash without jump
        if (history.replaceState) {
          history.replaceState(null, null, '#' + tabId);
        }

        if (tabId === 'orders') {
          refreshOrderStatuses(false);
        }
      }

      navBtns.forEach(function(btn) {
        if (btn.dataset.lvTabBound) return;
        btn.dataset.lvTabBound = '1';
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var target = this.getAttribute('data-tab-target');
          switchTab(target);
        });
      });

      quickSwitchers.forEach(function(switcher) {
        if (switcher.dataset.lvSwitchBound) return;
        switcher.dataset.lvSwitchBound = '1';
        switcher.addEventListener('click', function(e) {
          e.preventDefault();
          var target = this.getAttribute('data-switch-to');
          switchTab(target);
        });
      });

      // Handle initial hash in URL
      var hash = window.location.hash ? window.location.hash.substring(1) : '';
      if (hash && root.querySelector('[data-tab-panel="' + hash + '"]')) {
        switchTab(hash);
      } else {
        syncMobileCurrentLabel(root.querySelector('.lv-acct-nav__btn.is-active'));
      }
    }

    function showToast(message) {
      var toast = document.getElementById('LvAcctToast');
      if (!toast) return;
      toast.textContent = message;
      toast.classList.add('is-visible');
      setTimeout(function() {
        toast.classList.remove('is-visible');
      }, 3500);
    }

    var lastOrdersRefreshAt = Date.now();
    var ordersRefreshInFlight = null;

    function syncElementHtml(doc, selector) {
      var nextEl = doc.querySelector(selector);
      var currEl = document.querySelector(selector);
      if (nextEl && currEl) {
        currEl.innerHTML = nextEl.innerHTML;
      }
    }

    function refreshOrderStatuses(isManual) {
      var wrap = document.querySelector('.lv-acct-wrap[data-section-id]');
      if (!wrap) return Promise.resolve(false);
      var sectionId = wrap.getAttribute('data-section-id');
      if (!sectionId) return Promise.resolve(false);

      if (ordersRefreshInFlight) {
        return ordersRefreshInFlight;
      }

      var now = Date.now();
      if (!isManual && now - lastOrdersRefreshAt < 15000) {
        return Promise.resolve(false);
      }

      var refreshBtn = document.querySelector('[data-lv-acct-refresh-orders]');
      if (isManual && refreshBtn) {
        refreshBtn.disabled = true;
        refreshBtn.classList.add('is-loading');
      }

      var fetchUrl = new URL(window.location.href);
      fetchUrl.searchParams.set('section_id', sectionId);
      fetchUrl.searchParams.set('_ts', String(now));

      ordersRefreshInFlight = fetch(fetchUrl.toString(), {
        cache: 'no-store',
        credentials: 'same-origin',
        headers: {
          'Accept': 'text/html'
        }
      })
      .then(function(res) {
        if (!res.ok) throw new Error('HTTP ' + res.status);
        return res.text();
      })
      .then(function(html) {
        var parser = new DOMParser();
        var doc = parser.parseFromString(html, 'text/html');
        if (!doc.querySelector('[data-lv-acct-orders-list]')) {
          return false;
        }
        syncElementHtml(doc, '[data-lv-acct-latest-order]');
        syncElementHtml(doc, '[data-lv-acct-orders-list]');
        syncElementHtml(doc, '[data-lv-acct-orders-pill]');
        syncElementHtml(doc, '[data-lv-acct-stat-orders]');
        syncElementHtml(doc, '[data-lv-acct-stat-spent]');
        syncElementHtml(doc, '[data-lv-acct-orders-heading]');
        if (!document.querySelector('dialog.lv-acct-modal--order[open]')) {
          syncElementHtml(doc, '[data-lv-acct-order-modals]');
        }
        lastOrdersRefreshAt = Date.now();
        if (isManual) {
          var acctI18n = (window.theme && window.theme.i18n) || {};
          showToast(acctI18n.ordersRefreshed || {{ 'customer.orders.refreshed' | t | json }});
        }
        return true;
      })
      .catch(function(err) {
        console.error('Order refresh error:', err);
        if (isManual) {
          var acctI18n = (window.theme && window.theme.i18n) || {};
          showToast(acctI18n.ordersRefreshError || {{ 'customer.orders.refresh_error' | t | json }});
        }
        return false;
      })
      .finally(function() {
        ordersRefreshInFlight = null;
        if (isManual && refreshBtn) {
          refreshBtn.disabled = false;
          refreshBtn.classList.remove('is-loading');
        }
      });

      return ordersRefreshInFlight;
    }

    function initOrderRefresh() {
      var refreshBtn = document.querySelector('[data-lv-acct-refresh-orders]');
      if (refreshBtn && !refreshBtn.dataset.lvAcctBound) {
        refreshBtn.dataset.lvAcctBound = '1';
        refreshBtn.addEventListener('click', function() {
          refreshOrderStatuses(true);
        });
      }

      if (!window.__lvAcctPageshowBound) {
        window.__lvAcctPageshowBound = true;
        window.addEventListener('pageshow', function(e) {
          if (e.persisted) {
            lastOrdersRefreshAt = 0;
            refreshOrderStatuses(false);
          }
        });
      }
    }

    function initAddressModals() {
      if (!document.documentElement.dataset.lvAcctModalsBound) {
        document.documentElement.dataset.lvAcctModalsBound = '1';
        document.addEventListener('click', function(e) {
          var openTrigger = e.target.closest ? e.target.closest('[data-lv-acct-open-modal]') : null;
          if (openTrigger) {
            e.preventDefault();
            var modalId = openTrigger.getAttribute('data-lv-acct-open-modal');
            var modal = modalId ? document.getElementById(modalId) : null;
            if (modal && typeof modal.showModal === 'function') {
              modal.showModal();
              var countrySelect = modal.querySelector('[data-lv-acct-country]');
              if (countrySelect) {
                countrySelect.dispatchEvent(new Event('change'));
              }
            }
            return;
          }

          var closeTrigger = e.target.closest ? e.target.closest('[data-lv-acct-close-modal]') : null;
          if (closeTrigger) {
            e.preventDefault();
            var closeModal = closeTrigger.closest('dialog');
            if (closeModal && typeof closeModal.close === 'function') {
              closeModal.close();
            }
            return;
          }

          if (e.target && e.target.tagName === 'DIALOG' && e.target.classList.contains('lv-acct-modal') && e.target.open) {
            var rect = e.target.getBoundingClientRect();
            var isInDialog = rect.width > 0 &&
              rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
              rect.left <= e.clientX && e.clientX <= rect.left + rect.width;
            if (!isInDialog) {
              e.target.close();
            }
          }
        });
      }

      // Country & Province synchronization
      document.querySelectorAll('[data-lv-acct-country]').forEach(function(countrySelect) {
        var form = countrySelect.closest('form');
        if (!form) return;
        var provSelect = form.querySelector('[data-lv-acct-province]');
        var provContainer = provSelect ? provSelect.closest('.lv-acct-field') : null;

        var defaultCountry = countrySelect.getAttribute('data-default');
        if (defaultCountry) {
          for (var i = 0; i < countrySelect.options.length; i++) {
            if (countrySelect.options[i].value === defaultCountry) {
              countrySelect.selectedIndex = i;
              break;
            }
          }
        }

        function updateProvinces() {
          if (!provSelect || !provContainer) return;
          var selectedOption = countrySelect.options[countrySelect.selectedIndex];
          if (!selectedOption) return;

          var rawProvinces = selectedOption.getAttribute('data-provinces');
          var provinces = [];
          try {
            provinces = JSON.parse(rawProvinces || '[]');
          } catch(err) {
            provinces = [];
          }

          provSelect.innerHTML = '';
          if (provinces && provinces.length > 0) {
            var defaultProv = provSelect.getAttribute('data-default');
            provinces.forEach(function(p) {
              var opt = document.createElement('option');
              opt.value = p[0];
              opt.textContent = p[1] || p[0];
              if (defaultProv && (p[0] === defaultProv || p[1] === defaultProv)) {
                opt.selected = true;
              }
              provSelect.appendChild(opt);
            });
            provContainer.style.display = 'flex';
          } else {
            provContainer.style.display = 'none';
          }
        }

        countrySelect.addEventListener('change', updateProvinces);
        updateProvinces();
      });
    }

    function initAddressForms() {
      // AJAX Address Create & Update
      var acctI18n = (window.theme && window.theme.i18n) || {};
      var txtSaving = acctI18n.saving || {{ 'customer.addresses.saving' | t | json }};
      var txtSaved = acctI18n.addressSaved || {{ 'customer.addresses.saved' | t | json }};
      var txtSaveErr = acctI18n.addressSaveError || {{ 'customer.addresses.save_error' | t | json }};
      var txtConfirmDelete = acctI18n.confirmDeleteAddress || {{ 'customer.addresses.delete_confirm' | t | json }};
      var txtDeleted = acctI18n.addressDeleted || {{ 'customer.addresses.deleted' | t | json }};
      var txtDeleteErr = acctI18n.addressDeleteError || {{ 'customer.addresses.delete_error' | t | json }};

      document.querySelectorAll('form[data-lv-acct-address-form]').forEach(function(form) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          var submitBtn = form.querySelector('button[type="submit"]');
          var origBtnText = '';
          if (submitBtn) {
            submitBtn.disabled = true;
            origBtnText = submitBtn.innerHTML;
            var sp = document.createElement('span');
            sp.textContent = txtSaving;
            submitBtn.innerHTML = '';
            submitBtn.appendChild(sp);
          }

          var formData = new FormData(form);

          fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8'
            }
          })
          .then(function() {
            var modal = form.closest('dialog');
            if (modal) modal.close();
            showToast(txtSaved);
            setTimeout(function() {
              if (window.location.hash !== '#addresses') {
                window.location.hash = 'addresses';
              }
              window.location.reload();
            }, 600);
          })
          .catch(function(err) {
            console.error('Address form submit error:', err);
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = origBtnText;
            }
            showToast(txtSaveErr);
          });
        });
      });

      // AJAX Address Delete
      document.querySelectorAll('form[data-lv-acct-delete-form]').forEach(function(delForm) {
        delForm.addEventListener('submit', function(e) {
          e.preventDefault();
          if (!confirm(txtConfirmDelete)) {
            return;
          }
          var submitBtn = delForm.querySelector('button[type="submit"]');
          if (submitBtn) submitBtn.disabled = true;

          var formData = new FormData(delForm);

          fetch(delForm.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8'
            }
          })
          .then(function() {
            showToast(txtDeleted);
            setTimeout(function() {
              if (window.location.hash !== '#addresses') {
                window.location.hash = 'addresses';
              }
              window.location.reload();
            }, 600);
          })
          .catch(function(err) {
            console.error('Address delete error:', err);
            if (submitBtn) submitBtn.disabled = false;
            showToast(txtDeleteErr);
          });
        });
      });
    }

    function initAddressViewToggle() {
      var grid = document.querySelector('[data-lv-acct-addresses-grid]');
      var buttons = document.querySelectorAll('[data-lv-acct-addr-view]');
      if (!grid || !buttons.length) return;

      var storageKey = 'lv_acct_addr_view';

      function applyView(mode) {
        var view = mode === 'list' ? 'list' : 'grid';
        grid.setAttribute('data-view', view);
        buttons.forEach(function(btn) {
          var isMatch = btn.getAttribute('data-lv-acct-addr-view') === view;
          btn.classList.toggle('is-active', isMatch);
          btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
        });
        try {
          window.localStorage.setItem(storageKey, view);
        } catch (err) {}
      }

      var savedView = 'grid';
      try {
        var stored = window.localStorage.getItem(storageKey);
        if (stored === 'list' || stored === 'grid') {
          savedView = stored;
        }
      } catch (err) {}
      applyView(savedView);

      buttons.forEach(function(btn) {
        if (btn.dataset.lvAcctBound) return;
        btn.dataset.lvAcctBound = '1';
        btn.addEventListener('click', function() {
          applyView(btn.getAttribute('data-lv-acct-addr-view'));
        });
      });
    }

    function initMobileDrawer() {
      var nav = document.getElementById('LvAcctSidebarNav');
      var root = document.querySelector('[data-lv-acct-dashboard]');
      if (!nav || !root) return;

      var openBtn = root.querySelector('[data-lv-acct-drawer-open]');
      var closeBtns = root.querySelectorAll('[data-lv-acct-drawer-close]');
      var backdrop = root.querySelector('.lv-acct-drawer-backdrop');
      var closeTimer = null;

      function closeDrawer(restoreFocus) {
        var wasOpen = nav.classList.contains('is-open');
        var activeInsideNav = document.activeElement && nav.contains(document.activeElement);
        nav.classList.remove('is-open');
        if (backdrop) backdrop.classList.remove('is-open');
        document.body.classList.remove('lv-acct-drawer-lock');
        if (openBtn) openBtn.setAttribute('aria-expanded', 'false');

        clearTimeout(closeTimer);
        if (backdrop) {
          closeTimer = setTimeout(function() {
            if (!nav.classList.contains('is-open')) backdrop.hidden = true;
          }, 280);
        }

        if ((restoreFocus || activeInsideNav) && wasOpen && openBtn && window.innerWidth <= 860) {
          openBtn.focus({ preventScroll: true });
        }
      }

      function openDrawer() {
        if (window.innerWidth > 860) return;
        clearTimeout(closeTimer);
        if (backdrop) {
          backdrop.hidden = false;
          void backdrop.offsetWidth;
          backdrop.classList.add('is-open');
        }
        nav.classList.add('is-open');
        document.body.classList.add('lv-acct-drawer-lock');
        if (openBtn) openBtn.setAttribute('aria-expanded', 'true');
        var closeBtn = nav.querySelector('.lv-acct-nav__drawer-close');
        if (closeBtn) {
          requestAnimationFrame(function() { closeBtn.focus({ preventScroll: true }); });
        }
      }

      closeMobileDrawerFn = closeDrawer;

      if (nav.dataset.lvDrawerBound) return;
      nav.dataset.lvDrawerBound = '1';

      if (openBtn) {
        openBtn.addEventListener('click', openDrawer);
      }
      closeBtns.forEach(function(btn) {
        btn.addEventListener('click', function() { closeDrawer(true); });
      });

      if (!document.documentElement.dataset.lvAcctDrawerGlobal) {
        document.documentElement.dataset.lvAcctDrawerGlobal = '1';
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            var activeNav = document.getElementById('LvAcctSidebarNav');
            if (activeNav && activeNav.classList.contains('is-open') && typeof closeMobileDrawerFn === 'function') {
              closeMobileDrawerFn(true);
            }
          }
        });
        window.addEventListener('resize', function() {
          if (window.innerWidth > 860) {
            var activeNav = document.getElementById('LvAcctSidebarNav');
            if (activeNav && activeNav.classList.contains('is-open') && typeof closeMobileDrawerFn === 'function') {
              closeMobileDrawerFn(false);
            }
          }
        }, { passive: true });
      }
    }

    function initStickySync() {
      var followUntil = 0;
      var rafId = 0;

      function syncStickyOffsets() {
        var wrap = document.querySelector('.lv-acct-wrap[data-section-id]');
        if (!wrap) return;
        var hero = wrap.querySelector('.lv-acct-hero');
        var layout = wrap.querySelector('[data-lv-acct-dashboard]');
        var nav = wrap.querySelector('#LvAcctSidebarNav');

        var headerWrap = document.querySelector('[data-header-wrapper]');
        var headerStickyEl = headerWrap ? (headerWrap.closest('.shopify-section') || headerWrap) : null;
        var stickyTop = 0;

        if (headerStickyEl) {
          var hStyle = window.getComputedStyle(headerStickyEl);
          if (hStyle.position === 'sticky' || hStyle.position === 'fixed') {
            var hRect = headerStickyEl.getBoundingClientRect();
            if (hRect.top <= 4 && hRect.bottom > 2) {
              stickyTop = Math.max(0, Math.round(hRect.bottom));
            }
          }
        }

        var heroH = hero ? Math.round(hero.getBoundingClientRect().height) : 98;
        wrap.style.setProperty('--lv-acct-sticky-top', stickyTop + 'px');
        wrap.style.setProperty('--lv-acct-hero-h', heroH + 'px');

        if (window.innerWidth > 860 && hero && layout && nav) {
          var layoutRect = layout.getBoundingClientRect();
          var navStickyTop = stickyTop + heroH + 20;
          var visualNavTop = Math.max(navStickyTop, Math.round(layoutRect.top));
          var navMaxH = Math.max(360, window.innerHeight - visualNavTop - 24);
          wrap.style.setProperty('--lv-acct-nav-max-h', navMaxH + 'px');

          var navH = Math.round(nav.getBoundingClientRect().height);
          var maxHeroTop = layoutRect.bottom - navH - 20 - heroH;
          var heroTop = Math.round(Math.min(stickyTop, maxHeroTop));
          wrap.style.setProperty('--lv-acct-hero-top', heroTop + 'px');
          var heroRect = hero.getBoundingClientRect();
          var isStuck = window.scrollY > 2 && heroRect.top <= heroTop + 1.5 && layoutRect.bottom > heroTop + heroH + 20;
          hero.classList.toggle('is-stuck', isStuck);
        } else {
          wrap.style.removeProperty('--lv-acct-nav-max-h');
          wrap.style.setProperty('--lv-acct-hero-top', stickyTop + 'px');
          if (hero) hero.classList.remove('is-stuck');
        }
      }

      function tickStickySync() {
        syncStickyOffsets();
        if (performance.now() < followUntil) {
          rafId = requestAnimationFrame(tickStickySync);
        } else {
          rafId = 0;
        }
      }

      function scheduleStickySync(durationMs) {
        var until = performance.now() + (durationMs || 0);
        if (until > followUntil) followUntil = until;
        if (!rafId) {
          rafId = requestAnimationFrame(tickStickySync);
        }
      }

      scheduleStickySyncFn = scheduleStickySync;
      syncStickyOffsets();

      if (!document.documentElement.dataset.lvAcctStickyGlobal) {
        document.documentElement.dataset.lvAcctStickyGlobal = '1';
        window.addEventListener('scroll', function() { scheduleStickySync(340); }, { passive: true });
        window.addEventListener('resize', function() { scheduleStickySync(120); }, { passive: true });
        window.addEventListener('load', function() { scheduleStickySync(120); }, { passive: true });

        var headerEl = document.querySelector('[data-header-wrapper]');
        var headerSec = headerEl ? (headerEl.closest('.shopify-section') || headerEl) : null;
        if (headerSec && window.MutationObserver) {
          new MutationObserver(function() {
            scheduleStickySync(340);
          }).observe(headerSec, { attributes: true, attributeFilter: ['class', 'style'] });
        }
      }

      var wrap = document.querySelector('.lv-acct-wrap[data-section-id]');
      if (wrap && !wrap.dataset.lvStickyObserved && window.ResizeObserver) {
        wrap.dataset.lvStickyObserved = '1';
        var ro = new ResizeObserver(function() { scheduleStickySync(0); });
        var heroEl = wrap.querySelector('.lv-acct-hero');
        var layoutEl = wrap.querySelector('[data-lv-acct-dashboard]');
        if (heroEl) ro.observe(heroEl);
        if (layoutEl) ro.observe(layoutEl);
      }
    }

    function initAll() {
      initStickySync();
      initMobileDrawer();
      initDashboardTabs();
      initAddressViewToggle();
      initAddressModals();
      initAddressForms();
      initOrderRefresh();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.target && e.target.querySelector && e.target.querySelector('[data-lv-acct-dashboard]')) {
        initAll();
      }
    });
  })();
</script>

