              <div class="lv-acct-ptitle"><div><span class="lv-acct-eyebrow">{{ 'customer.account.saved_eyebrow' | t }}</span><h2>{{ 'customer.account.saved_title' | t }}</h2></div></div>
              <div class="lv-acct-empty">
                <svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                <p class="lv-acct-empty__title">{{ 'customer.account.saved_empty_title' | t }}</p>
                <p class="lv-acct-empty__text">{{ 'customer.account.saved_empty_text' | t }}</p>
                <div class="lv-acct-actions">
                  <a href="{{ wishlist_url }}" class="btn btn-sliding-hover lv-acct-btn">{{ 'customer.account.view_wishlist' | t }}</a>
                  <a href="{{ routes.collections_url }}/bestsellers" class="btn btn-sliding-hover lv-acct-btn lv-acct-btn--ghost">{{ 'customer.account.bestsellers' | t }}</a>
