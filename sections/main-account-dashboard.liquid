                        <input type="hidden" name="_method" value="delete">
                        <button type="submit" class="btn btn-sliding-hover lv-acct-btn lv-acct-btn--sm lv-acct-btn--ghost">{{ 'customer.addresses.delete' | t }}</button>
                      </form>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% else %}
              <div class="lv-acct-empty">
                <svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <p class="lv-acct-empty__title">{{ 'customer.addresses.none_title' | t }}</p>
                <p class="lv-acct-empty__text">{{ 'customer.addresses.none_text' | t }}</p>
                <button type="button" class="btn btn-sliding-hover lv-acct-btn" data-lv-acct-open-modal="LvAcctAddAddressModal">{{ 'customer.addresses.add_new' | t }}</button>
              </div>
            {% endif %}
