        </div>
        <div class="lv-acct-guest__perks">
          <div class="lv-acct-guest-perk">{{ 'customer.account.guest_perk1_title' | t }}<span>{{ 'customer.account.guest_perk1_sub' | t }}</span></div>
          <div class="lv-acct-guest-perk">{{ 'customer.account.guest_perk2_title' | t }}<span>{{ 'customer.account.guest_perk2_sub' | t }}</span></div>
          <div class="lv-acct-guest-perk">{{ 'customer.account.guest_perk3_title' | t }}<span>{{ 'customer.account.guest_perk3_sub' | t }}</span></div>
        </div>
      </div>
    {% endif %}
