      function normalizeCountryKey(str) {
        return (str || '').toLowerCase().trim().replace(/\s+/g, ' ');
      }

      function findCountryMeta(nameOrIso) {
        var key = normalizeCountryKey(nameOrIso);
        if (LV_COUNTRY_ALIASES[key]) key = normalizeCountryKey(LV_COUNTRY_ALIASES[key]);
        for (var i = 0; i < LV_COUNTRY_LIST.length; i++) {
          var c = LV_COUNTRY_LIST[i];
          if (c[0].toLowerCase() === key || normalizeCountryKey(c[1]) === key) {
            return {
              iso: c[0], name: c[1], dial: c[2], flag: c[3], trunkZero: c[4],
              zipMode: c[5], zipMin: c[6], zipMax: c[7], zipEx: c[8], zipRegexStr: c[9], phoneEx: c[10]
            };
          }
        }
        return {
          iso: 'INT', name: nameOrIso || 'International', dial: '31', flag: '🌐', trunkZero: true,
          zipMode: 'alnum', zipMin: 3, zipMax: 12, zipEx: '', zipRegexStr: '', phoneEx: '6 12345678'
        };
      }

      var LV_SORTED_BY_DIAL = LV_COUNTRY_LIST.slice().sort(function(a, b) {
        return b[2].length - a[2].length;
      });

      function detectDialFromInternational(raw) {
        var cleaned = (raw || '').trim();
        if (!cleaned) return null;
        var hasIntl = cleaned.charAt(0) === '+' || cleaned.indexOf('00') === 0;
        if (!hasIntl) return null;
        var digits = cleaned.replace(/^(\+|00)/, '').replace(/\D/g, '');
        if (!digits) return null;
        for (var i = 0; i < LV_SORTED_BY_DIAL.length; i++) {
          var entry = LV_SORTED_BY_DIAL[i];
          var dial = entry[2];
          if (digits.indexOf(dial) === 0 && digits.length > dial.length + 3) {
            return {
              meta: {
                iso: entry[0], name: entry[1], dial: entry[2], flag: entry[3], trunkZero: entry[4],
                zipMode: entry[5], zipMin: entry[6], zipMax: entry[7], zipEx: entry[8], zipRegexStr: entry[9], phoneEx: entry[10]
              },
              national: digits.slice(dial.length)
            };
          }
        }
        return null;
      }

      function populateDialOptions(dialSelect) {
        if (!dialSelect || dialSelect.options.length > 0) return;
        LV_COUNTRY_LIST.forEach(function(c) {
          var opt = document.createElement('option');
          opt.value = c[0];
          opt.setAttribute('data-dial', c[2]);
          opt.setAttribute('data-flag', c[3]);
          opt.setAttribute('data-trunk-zero', c[4] ? '1' : '0');
          opt.setAttribute('data-phone-ex', c[10]);
          opt.textContent = c[3] + ' ' + c[1] + ' (+' + c[2] + ')';
          dialSelect.appendChild(opt);
        });
      }

      function getSelectedDialInfo(dialSelect) {
        if (!dialSelect || dialSelect.selectedIndex < 0) {
          return { iso: 'NL', dial: '31', flag: '🇳🇱', trunkZero: true, phoneEx: '6 12345678' };
        }
        var opt = dialSelect.options[dialSelect.selectedIndex];
        return {
          iso: opt.value,
          dial: opt.getAttribute('data-dial') || '31',
          flag: opt.getAttribute('data-flag') || '🌐',
          trunkZero: opt.getAttribute('data-trunk-zero') === '1',
          phoneEx: opt.getAttribute('data-phone-ex') || ''
        };
      }

      function setDialByIso(dialSelect, labelEl, phoneInput, iso) {
        if (!dialSelect) return;
        for (var i = 0; i < dialSelect.options.length; i++) {
          if (dialSelect.options[i].value === iso) {
            dialSelect.selectedIndex = i;
            break;
          }
        }
        var info = getSelectedDialInfo(dialSelect);
        if (labelEl) labelEl.textContent = info.flag + ' +' + info.dial;
        if (phoneInput && info.phoneEx) phoneInput.placeholder = info.phoneEx;
      }

      function buildE164Phone(rawInput, dialInfo) {
        var digits = (rawInput || '').replace(/\D/g, '');
        if (!digits) return '';
        if (dialInfo.trunkZero && digits.charAt(0) === '0') {
          digits = digits.slice(1);
        }
        if (digits.indexOf(dialInfo.dial) === 0 && digits.length >= dialInfo.dial.length + 7) {
          return '+' + digits;
        }
        return '+' + dialInfo.dial + digits;
      }

      function getFieldContainer(inputEl) {
        return inputEl ? inputEl.closest('.lv-acct-field') : null;
      }

      function setFieldError(inputEl, message) {
        var field = getFieldContainer(inputEl);
        if (!field) return;
        field.classList.add('has-error');
        if (inputEl) inputEl.setAttribute('aria-invalid', 'true');
        var errEl = field.querySelector('[data-lv-acct-field-err]');
        if (!errEl) {
          errEl = document.createElement('span');
          errEl.className = 'lv-acct-field__err';
          errEl.setAttribute('data-lv-acct-field-err', '');
          field.appendChild(errEl);
        }
        errEl.textContent = message;
        errEl.hidden = false;
      }

      function clearFieldError(inputEl) {
        var field = getFieldContainer(inputEl);
        if (!field) return;
        field.classList.remove('has-error');
        if (inputEl) inputEl.removeAttribute('aria-invalid');
        var errEl = field.querySelector('[data-lv-acct-field-err]');
        if (errEl) {
          errEl.textContent = '';
          errEl.hidden = true;
        }
      }

      function containsLetters(val) {
        return /[A-Za-z\u00C0-\u024F\u0400-\u04FF\u0600-\u06FF\u0980-\u09FF\u4E00-\u9FFF]/.test(val);
      }

      function isDigitsOnly(val) {
        return /^[\d\s\-+.()]+$/.test(val);
      }

      function updatePhoneLiveHint(form, phoneInput, dialSelect) {
        if (!phoneInput || !dialSelect) return;
        var field = getFieldContainer(phoneInput);
        if (!field) return;
        var hintEl = field.querySelector('[data-lv-acct-phone-hint]');
        if (!hintEl) {
          hintEl = document.createElement('span');
          hintEl.className = 'lv-acct-field__hint';
          hintEl.setAttribute('data-lv-acct-phone-hint', '');
          field.appendChild(hintEl);
        }
        var digits = phoneInput.value.replace(/\D/g, '');
        if (!digits) {
          hintEl.textContent = '';
          hintEl.hidden = true;
          return;
        }
        var info = getSelectedDialInfo(dialSelect);
        var full = buildE164Phone(phoneInput.value, info);
        hintEl.textContent = LV_VAL_TXT.phoneHintPrefix + ' ' + full;
        hintEl.hidden = false;
      }

      // Country, Province, Postal & Phone synchronization
      document.querySelectorAll('[data-lv-acct-country]').forEach(function(countrySelect) {
        if (countrySelect.dataset.lvCountryBound) return;
        countrySelect.dataset.lvCountryBound = '1';
        var form = countrySelect.closest('form');
        if (!form) return;
        form.noValidate = true;

        var provSelect = form.querySelector('[data-lv-acct-province]');
        var provContainer = provSelect ? provSelect.closest('.lv-acct-field') : null;
        var zipInput = form.querySelector('[data-lv-acct-zip]');
        var zipHint = form.querySelector('[data-lv-acct-zip-hint]');
        var phoneInput = form.querySelector('[data-lv-acct-phone]');
        var dialSelect = form.querySelector('[data-lv-acct-dial]');
        var dialLabel = form.querySelector('[data-lv-acct-dial-label]');

        if (dialSelect) {
          populateDialOptions(dialSelect);
        }

        var defaultCountry = countrySelect.getAttribute('data-default');
        var matchedDefault = false;
        if (defaultCountry) {
          for (var i = 0; i < countrySelect.options.length; i++) {
            if (countrySelect.options[i].value === defaultCountry) {
              countrySelect.selectedIndex = i;
              matchedDefault = true;
              break;
            }
          }
        }
        if (!matchedDefault && (!countrySelect.value || countrySelect.value === '---')) {
          var fallbackMeta = findCountryMeta(LV_STORE_ISO);
          for (var j = 0; j < countrySelect.options.length; j++) {
            var optVal = countrySelect.options[j].value;
            if (optVal && optVal !== '---' && normalizeCountryKey(optVal) === normalizeCountryKey(fallbackMeta.name)) {
              countrySelect.selectedIndex = j;
              break;
            }
          }
          if (!countrySelect.value || countrySelect.value === '---') {
            for (var k = 0; k < countrySelect.options.length; k++) {
              if (countrySelect.options[k].value && countrySelect.options[k].value !== '---') {
                countrySelect.selectedIndex = k;
                break;
              }
            }
          }
        }

        // Parse initial E.164 value in Edit modal so prefix and local number stay clean
        var initialPhoneDetected = null;
        if (phoneInput && phoneInput.value) {
          initialPhoneDetected = detectDialFromInternational(phoneInput.value);
          if (initialPhoneDetected) {
            phoneInput.value = initialPhoneDetected.national;
            if (dialSelect) {
              dialSelect.dataset.lvManual = '1';
              setDialByIso(dialSelect, dialLabel, phoneInput, initialPhoneDetected.meta.iso);
            }
          } else {
            phoneInput.value = phoneInput.value.replace(/[^\d\s]/g, '');
          }
        }

        function updateZipRule() {
          if (!zipInput) return;
          var meta = findCountryMeta(countrySelect.value);
          zipInput.dataset.lvZipMode = meta.zipMode;
          zipInput.dataset.lvZipRe = meta.zipRegexStr || '';
          zipInput.dataset.lvZipEx = meta.zipEx || '';
          if (meta.zipMode === 'none') {
            zipInput.required = false;
            zipInput.inputMode = 'text';
            zipInput.removeAttribute('maxlength');
            if (zipHint) {
              zipHint.textContent = LV_VAL_TXT.zipOptional;
              zipHint.hidden = false;
            }
            clearFieldError(zipInput);
          } else {
            zipInput.required = true;
            zipInput.maxLength = meta.zipMax || 12;
            if (meta.zipMode === 'num' || meta.zipMode === 'num-dash') {
              zipInput.inputMode = 'numeric';
              zipInput.value = meta.zipMode === 'num' ? zipInput.value.replace(/\D/g, '') : zipInput.value.replace(/[^\d-]/g, '');
            } else {
              zipInput.inputMode = 'text';
              zipInput.autocapitalize = 'characters';
              zipInput.value = zipInput.value.toUpperCase().replace(/[^A-Z0-9\s-]/g, '');
            }
            if (zipHint) {
              if (meta.zipEx) {
                zipHint.textContent = meta.zipMode === 'num'
                  ? (LV_IS_NL ? 'Bijv. ' : 'e.g. ') + meta.zipEx + (LV_IS_NL ? ' (alleen cijfers)' : ' (digits only)')
                  : (LV_IS_NL ? 'Bijv. ' : 'e.g. ') + meta.zipEx;
                zipHint.hidden = false;
              } else {
                zipHint.textContent = '';
                zipHint.hidden = true;
              }
            }
          }
        }

        function updateProvinces() {
          if (!provSelect || !provContainer) return;
          var selectedOption = countrySelect.options[countrySelect.selectedIndex];
          if (!selectedOption) return;

          var rawProvinces = selectedOption.getAttribute('data-provinces');
          var provinces = [];
          try {
            provinces = JSON.parse(rawProvinces || '[]');
          } catch(err) {
            provinces = [];
          }

          provSelect.innerHTML = '';
          if (provinces && provinces.length > 0) {
            var defaultProv = provSelect.getAttribute('data-default');
            provinces.forEach(function(p) {
              var opt = document.createElement('option');
              opt.value = p[0];
              opt.textContent = p[1] || p[0];
              if (defaultProv && (p[0] === defaultProv || p[1] === defaultProv)) {
                opt.selected = true;
              }
              provSelect.appendChild(opt);
            });
            provContainer.style.display = 'flex';
          } else {
            provContainer.style.display = 'none';
            clearFieldError(provSelect);
          }
        }

        function syncPhoneDialWithCountry(force) {
          if (!dialSelect) return;
          if (!force && dialSelect.dataset.lvManual === '1') return;
          var meta = findCountryMeta(countrySelect.value);
          var iso = meta.iso === 'INT' ? LV_STORE_ISO : meta.iso;
          setDialByIso(dialSelect, dialLabel, phoneInput, iso);
          updatePhoneLiveHint(form, phoneInput, dialSelect);
        }

        countrySelect.addEventListener('change', function(ev) {
          clearFieldError(countrySelect);
          updateProvinces();
          updateZipRule();
          if (ev && ev.isTrusted && dialSelect) {
            delete dialSelect.dataset.lvManual;
          }
          syncPhoneDialWithCountry(false);
        });

        if (dialSelect) {
          dialSelect.addEventListener('change', function() {
            dialSelect.dataset.lvManual = '1';
            var info = getSelectedDialInfo(dialSelect);
            if (dialLabel) dialLabel.textContent = info.flag + ' +' + info.dial;
            if (phoneInput && info.phoneEx) phoneInput.placeholder = info.phoneEx;
            updatePhoneLiveHint(form, phoneInput, dialSelect);
            clearFieldError(phoneInput);
          });
        }

        if (phoneInput) {
          phoneInput.addEventListener('input', function() {
            var val = phoneInput.value;
            var detected = detectDialFromInternational(val);
            if (detected && dialSelect) {
              dialSelect.dataset.lvManual = '1';
              setDialByIso(dialSelect, dialLabel, phoneInput, detected.meta.iso);
              phoneInput.value = detected.national;
            } else {
              var clean = val.replace(/[^\d\s]/g, '').replace(/\s{2,}/g, ' ');
              if (clean !== val) phoneInput.value = clean;
            }
            updatePhoneLiveHint(form, phoneInput, dialSelect);
            clearFieldError(phoneInput);
          });
        }

        if (zipInput) {
          zipInput.addEventListener('input', function() {
            var mode = zipInput.dataset.lvZipMode || 'alnum';
            var v = zipInput.value;
            if (mode === 'num') {
              zipInput.value = v.replace(/\D/g, '');
            } else if (mode === 'num-dash') {
              zipInput.value = v.replace(/[^\d-]/g, '').replace(/-{2,}/g, '-');
            } else if (mode === 'nl' || mode === 'alnum') {
              zipInput.value = v.toUpperCase().replace(/[^A-Z0-9\s-]/g, '').replace(/\s{2,}/g, ' ');
            }
            clearFieldError(zipInput);
          });
          zipInput.addEventListener('blur', function() {
            if (zipInput.dataset.lvZipMode === 'nl') {
              var m = zipInput.value.trim().toUpperCase().replace(/\s+/g, '');
              if (/^\d{4}[A-Z]{2}$/.test(m)) {
                zipInput.value = m.slice(0, 4) + ' ' + m.slice(4);
              }
            }
          });
        }

        // Clear inline error as soon as user edits any text/select field
        form.querySelectorAll('input:not([type="checkbox"]):not([type="hidden"]), select').forEach(function(inp) {
          if (inp === dialSelect || inp === zipInput || inp === phoneInput) return;
          inp.addEventListener('input', function() { clearFieldError(inp); });
          inp.addEventListener('change', function() { clearFieldError(inp); });
        });

        updateProvinces();
        updateZipRule();
        if (!initialPhoneDetected) {
          syncPhoneDialWithCountry(true);
        } else {
          updatePhoneLiveHint(form, phoneInput, dialSelect);
        }
      });
    }

    function initAddressForms() {
      // AJAX Address Create & Update
      var acctI18n = (window.theme && window.theme.i18n) || {};
      var txtSaving = acctI18n.saving || {{ 'customer.addresses.saving' | t | json }};
      var txtSaved = acctI18n.addressSaved || {{ 'customer.addresses.saved' | t | json }};
      var txtSaveErr = acctI18n.addressSaveError || {{ 'customer.addresses.save_error' | t | json }};
      var txtConfirmDelete = acctI18n.confirmDeleteAddress || {{ 'customer.addresses.delete_confirm' | t | json }};
      var txtDeleted = acctI18n.addressDeleted || {{ 'customer.addresses.deleted' | t | json }};
      var txtDeleteErr = acctI18n.addressDeleteError || {{ 'customer.addresses.delete_error' | t | json }};

      function clearFormError(form) {
        var box = form.querySelector('[data-lv-acct-form-error]');
        if (box) {
          box.textContent = '';
          box.hidden = true;
        }
      }

      function clearAllFieldErrors(form) {
        form.querySelectorAll('.lv-acct-field.has-error').forEach(function(f) {
          f.classList.remove('has-error');
        });
        form.querySelectorAll('[data-lv-acct-field-err]').forEach(function(e) {
          e.textContent = '';
          e.hidden = true;
        });
        form.querySelectorAll('[aria-invalid]').forEach(function(el) {
          el.removeAttribute('aria-invalid');
        });
      }

      function setInlineErr(inputEl, message) {
        var field = inputEl ? inputEl.closest('.lv-acct-field') : null;
        if (!field) return;
        field.classList.add('has-error');
        inputEl.setAttribute('aria-invalid', 'true');
        var errEl = field.querySelector('[data-lv-acct-field-err]');
        if (!errEl) {
          errEl = document.createElement('span');
          errEl.className = 'lv-acct-field__err';
          errEl.setAttribute('data-lv-acct-field-err', '');
          field.appendChild(errEl);
        }
        errEl.textContent = message;
        errEl.hidden = false;
      }

      function validateAddressForm(form) {
        clearFormError(form);
        clearAllFieldErrors(form);
        var firstInvalid = null;
        function fail(el, msg) {
          setInlineErr(el, msg);
          if (!firstInvalid) firstInvalid = el;
        }

        var fn = form.querySelector('[name="address[first_name]"]');
        var ln = form.querySelector('[name="address[last_name]"]');
        var a1 = form.querySelector('[name="address[address1]"]');
        var city = form.querySelector('[name="address[city]"]');
        var country = form.querySelector('[name="address[country]"]');
        var prov = form.querySelector('[name="address[province]"]');
        var zip = form.querySelector('[name="address[zip]"]');
        var phone = form.querySelector('[name="address[phone]"]');
        var dial = form.querySelector('[data-lv-acct-dial]');

        [fn, ln, a1, city, zip].forEach(function(inp) {
          if (inp) inp.value = inp.value.trim();
        });

        var hasLetter = /[A-Za-z\u00C0-\u024F\u0400-\u04FF\u0600-\u06FF\u0980-\u09FF\u4E00-\u9FFF]/;
        var onlyNums = /^[\d\s\-+.()]+$/;

        if (fn) {
          if (!fn.value) fail(fn, LV_VAL_TXT.firstReq);
          else if (onlyNums.test(fn.value) || !hasLetter.test(fn.value)) fail(fn, LV_VAL_TXT.firstAlpha);
        }
        if (ln) {
          if (!ln.value) fail(ln, LV_VAL_TXT.lastReq);
          else if (onlyNums.test(ln.value) || !hasLetter.test(ln.value)) fail(ln, LV_VAL_TXT.lastAlpha);
        }
        if (a1) {
          if (!a1.value) fail(a1, LV_VAL_TXT.addrReq);
          else if (a1.value.length < 3) fail(a1, LV_VAL_TXT.addrShort);
        }
        if (city) {
          if (!city.value) fail(city, LV_VAL_TXT.cityReq);
          else if (onlyNums.test(city.value) || !hasLetter.test(city.value)) fail(city, LV_VAL_TXT.cityAlpha);
        }
        if (country) {
          if (!country.value || country.value === '---') fail(country, LV_VAL_TXT.countryReq);
        }
        if (prov) {
          var provField = prov.closest('.lv-acct-field');
          if (provField && provField.style.display !== 'none' && prov.options.length > 0 && !prov.value) {
            fail(prov, LV_VAL_TXT.provReq);
          }
        }
        if (zip) {
          var zMode = zip.dataset.lvZipMode || 'alnum';
          var zReStr = zip.dataset.lvZipRe || '';
          var zEx = zip.dataset.lvZipEx || '';
          if (zMode !== 'none') {
            if (!zip.value) {
              fail(zip, LV_VAL_TXT.zipReq);
            } else if ((zMode === 'num' || zMode === 'num-dash') && /[A-Za-z]/.test(zip.value)) {
              fail(zip, LV_VAL_TXT.zipDigitsOnly);
            } else if (zReStr) {
              try {
                var re = new RegExp(zReStr);
                if (!re.test(zip.value.toUpperCase())) {
                  fail(zip, LV_VAL_TXT.zipFormat + (zEx ? ' (' + zEx + ')' : '') + '.');
                }
              } catch (err) {}
            } else if (zip.value.length < 2) {
              fail(zip, LV_VAL_TXT.zipFormat + '.');
            }
          }
        }

        var formattedPhone = '';
        if (phone && phone.value.trim()) {
          var rawPhone = phone.value.trim();
          if (/[A-Za-z]/.test(rawPhone)) {
            fail(phone, LV_VAL_TXT.phoneDigitsOnly);
          } else {
            var nationalDigits = rawPhone.replace(/\D/g, '');
            if (!nationalDigits || nationalDigits.length < 5 || nationalDigits.length > 15 || /^(\d)\1{5,}$/.test(nationalDigits)) {
              fail(phone, LV_VAL_TXT.phoneInvalid);
            } else if (dial && dial.selectedIndex >= 0) {
              var opt = dial.options[dial.selectedIndex];
              var dCode = opt.getAttribute('data-dial') || '31';
              var trunk = opt.getAttribute('data-trunk-zero') === '1';
              var nat = nationalDigits;
              if (trunk && nat.charAt(0) === '0') nat = nat.slice(1);
              if (nat.indexOf(dCode) === 0 && nat.length >= dCode.length + 7) {
                formattedPhone = '+' + nat;
              } else {
                formattedPhone = '+' + dCode + nat;
              }
              var totalDigits = formattedPhone.replace(/\D/g, '');
              if (totalDigits.length < 7 || totalDigits.length > 15) {
                fail(phone, LV_VAL_TXT.phoneInvalid);
              }
            } else {
              formattedPhone = nationalDigits;
            }
          }
        }

        if (firstInvalid) {
          showFormError(form, LV_VAL_TXT.checkFields);
          if (typeof firstInvalid.focus === 'function') firstInvalid.focus();
          return { valid: false, phone: formattedPhone };
        }
        return { valid: true, phone: formattedPhone };
      }

      function showFormError(form, message) {
        var box = form.querySelector('[data-lv-acct-form-error]');
        if (box) {
          box.textContent = message;
          box.hidden = false;
        } else {
          showToast(message, 'error');
        }
      }

      function extractHtmlError(html) {
        if (!html) return '';
        try {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var errEl = doc.querySelector('.errors, .form__message[role="alert"], [data-form-status], .note.form-error');
          return errEl ? errEl.textContent.replace(/\s+/g, ' ').trim() : '';
        } catch (err) {
          return '';
        }
      }

      function postUrlEncoded(actionUrl, formData) {
        var encoded = new URLSearchParams(formData).toString();
        return fetch(actionUrl, {
          method: 'POST',
          body: encoded,
          credentials: 'same-origin',
          redirect: 'manual',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
            'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8'
          }
        });
      }

      function syncAddressesFromDoc(doc) {
        syncElementHtml(doc, '[data-tab-panel="addresses"]');
        syncElementHtml(doc, '[data-lv-acct-addresses-pill]');
        syncElementHtml(doc, '[data-lv-acct-overview-address]');
        if (!document.querySelector('dialog.lv-acct-modal[open]')) {
          syncElementHtml(doc, '[data-lv-acct-edit-modals]');
        }
        var root = document.querySelector('[data-lv-acct-dashboard]');
        var activeNav = root ? root.querySelector('.lv-acct-nav__btn.is-active') : null;
        var mobileCurrentEl = root ? root.querySelector('[data-lv-acct-mobile-current]') : null;
        if (mobileCurrentEl && activeNav) {
          var labelEl = activeNav.querySelector('.lv-acct-nav__label');
          var pillEl = activeNav.querySelector('.lv-acct-nav__pill');
          var txt = labelEl ? labelEl.textContent.trim() : '';
          if (pillEl && pillEl.textContent.trim()) txt += ' (' + pillEl.textContent.trim() + ')';
          mobileCurrentEl.textContent = txt;
        }
        initAddressViewToggle();
        initAddressModals();
        initAddressForms();
      }

      document.querySelectorAll('form[data-lv-acct-address-form]').forEach(function(form) {
        if (form.dataset.lvFormBound) return;
        form.dataset.lvFormBound = '1';
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          var check = validateAddressForm(form);
          if (!check.valid) return;

          var submitBtn = form.querySelector('button[type="submit"]');
          var origBtnHtml = submitBtn ? submitBtn.innerHTML : '';
          if (submitBtn) {
            submitBtn.disabled = true;
            var sp = document.createElement('span');
            sp.textContent = txtSaving;
            submitBtn.innerHTML = '';
            submitBtn.appendChild(sp);
          }

          var restoreBtn = function() {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = origBtnHtml;
            }
          };

          var formData = new FormData(form);
          formData.set('address[phone]', check.phone || '');
          var actionUrl = form.getAttribute('action') || form.action;

          postUrlEncoded(actionUrl, formData)
          .then(function(res) {
            if (res.type === 'opaqueredirect') {
              return { ok: true };
            }
            if (!res.ok) {
              return res.text().then(function(html) {
                return { ok: false, errMsg: extractHtmlError(html) || txtSaveErr };
              });
            }
            return res.text().then(function(html) {
              var errMsg = extractHtmlError(html);
              if (errMsg) return { ok: false, errMsg: errMsg };
              return { ok: true };
            });
          })
          .then(function(result) {
            if (!result.ok) {
              restoreBtn();
              showFormError(form, result.errMsg || txtSaveErr);
              return null;
            }
            return fetchDashboardDoc();
          })
          .then(function(doc) {
            if (!doc) return;
            if (!doc.querySelector('[data-lv-acct-addresses-pill]')) {
              window.location.hash = 'addresses';
              window.location.reload();
              return;
            }
            var modal = form.closest('dialog');
            if (modal && typeof modal.close === 'function') {
              modal.close();
            }
            if (modal && modal.id === 'LvAcctAddAddressModal') {
              form.reset();
            }
            restoreBtn();
            syncAddressesFromDoc(doc);
            showToast(txtSaved, 'success');
          })
          .catch(function(err) {
            console.error('Address form submit error:', err);
            restoreBtn();
            showFormError(form, txtSaveErr);
          });
        });
      });

      // AJAX Address Delete
      document.querySelectorAll('form[data-lv-acct-delete-form]').forEach(function(delForm) {
        if (delForm.dataset.lvFormBound) return;
        delForm.dataset.lvFormBound = '1';
        delForm.addEventListener('submit', function(e) {
          e.preventDefault();
          if (!confirm(txtConfirmDelete)) {
            return;
          }
          var submitBtn = delForm.querySelector('button[type="submit"]');
          if (submitBtn) submitBtn.disabled = true;

          var addrId = delForm.getAttribute('data-lv-addr-id') || '';
          var actionUrl = delForm.getAttribute('action') || delForm.action;
          if (addrId) {
            var editDialogForm = document.querySelector('#LvAcctEditAddressModal-' + addrId + ' form[data-lv-acct-address-form]');
            if (editDialogForm) {
              var editAction = editDialogForm.getAttribute('action');
              if (editAction && editAction.charAt(0) === '/') {
                actionUrl = editAction;
              }
            }
          }

          var formData = new FormData(delForm);

          postUrlEncoded(actionUrl, formData)
          .then(function(res) {
            if (res.type !== 'opaqueredirect' && !res.ok) {
              throw new Error('HTTP ' + res.status);
            }
            return fetchDashboardDoc();
          })
          .then(function(doc) {
            if (!doc) return;
            if (!doc.querySelector('[data-lv-acct-addresses-pill]')) {
              window.location.hash = 'addresses';
              window.location.reload();
              return;
            }
            if (addrId && doc.querySelector('[data-lv-addr-id="' + addrId + '"]')) {
              if (submitBtn) submitBtn.disabled = false;
              showToast(txtDeleteErr, 'error');
              return;
            }
            syncAddressesFromDoc(doc);
            showToast(txtDeleted, 'success');
          })
          .catch(function(err) {
            console.error('Address delete error:', err);
            if (submitBtn) submitBtn.disabled = false;
            showToast(txtDeleteErr, 'error');
          });
        });
      });
    }

    function initAddressViewToggle() {
      var grid = document.querySelector('[data-lv-acct-addresses-grid]');
      var buttons = document.querySelectorAll('[data-lv-acct-addr-view]');
      if (!grid || !buttons.length) return;

      var storageKey = 'lv_acct_addr_view';

      function applyView(mode) {
        var view = mode === 'list' ? 'list' : 'grid';
        grid.setAttribute('data-view', view);
        buttons.forEach(function(btn) {
          var isMatch = btn.getAttribute('data-lv-acct-addr-view') === view;
          btn.classList.toggle('is-active', isMatch);
          btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
        });
        try {
          window.localStorage.setItem(storageKey, view);
        } catch (err) {}
      }

      var savedView = 'grid';
      try {
        var stored = window.localStorage.getItem(storageKey);
        if (stored === 'list' || stored === 'grid') {
          savedView = stored;
        }
      } catch (err) {}
      applyView(savedView);

      buttons.forEach(function(btn) {
        if (btn.dataset.lvAcctBound) return;
        btn.dataset.lvAcctBound = '1';
        btn.addEventListener('click', function() {
          applyView(btn.getAttribute('data-lv-acct-addr-view'));
        });
      });
    }

    function initMobileDrawer() {
      var nav = document.getElementById('LvAcctSidebarNav');
      var root = document.querySelector('[data-lv-acct-dashboard]');
      if (!nav || !root) return;

      var openBtn = root.querySelector('[data-lv-acct-drawer-open]');
      var closeBtns = root.querySelectorAll('[data-lv-acct-drawer-close]');
      var backdrop = root.querySelector('.lv-acct-drawer-backdrop');
      var closeTimer = null;

      function closeDrawer(restoreFocus) {
        var wasOpen = nav.classList.contains('is-open');
        var activeInsideNav = document.activeElement && nav.contains(document.activeElement);
        nav.classList.remove('is-open');
        if (backdrop) backdrop.classList.remove('is-open');
        document.body.classList.remove('lv-acct-drawer-lock');
        if (openBtn) openBtn.setAttribute('aria-expanded', 'false');

        clearTimeout(closeTimer);
        if (backdrop) {
          closeTimer = setTimeout(function() {
            if (!nav.classList.contains('is-open')) backdrop.hidden = true;
          }, 280);
        }

        if ((restoreFocus || activeInsideNav) && wasOpen && openBtn && window.innerWidth <= 860) {
          openBtn.focus({ preventScroll: true });
        }
      }

      function openDrawer() {
        if (window.innerWidth > 860) return;
        clearTimeout(closeTimer);
        if (backdrop) {
          backdrop.hidden = false;
          void backdrop.offsetWidth;
          backdrop.classList.add('is-open');
        }
        nav.classList.add('is-open');
        document.body.classList.add('lv-acct-drawer-lock');
        if (openBtn) openBtn.setAttribute('aria-expanded', 'true');
        var closeBtn = nav.querySelector('.lv-acct-nav__drawer-close');
        if (closeBtn) {
          requestAnimationFrame(function() { closeBtn.focus({ preventScroll: true }); });
        }
      }

      closeMobileDrawerFn = closeDrawer;

      if (nav.dataset.lvDrawerBound) return;
      nav.dataset.lvDrawerBound = '1';

      if (openBtn) {
        openBtn.addEventListener('click', openDrawer);
      }
      closeBtns.forEach(function(btn) {
        btn.addEventListener('click', function() { closeDrawer(true); });
      });

      if (!document.documentElement.dataset.lvAcctDrawerGlobal) {
        document.documentElement.dataset.lvAcctDrawerGlobal = '1';
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            var activeNav = document.getElementById('LvAcctSidebarNav');
            if (activeNav && activeNav.classList.contains('is-open') && typeof closeMobileDrawerFn === 'function') {
              closeMobileDrawerFn(true);
            }
          }
        });
        window.addEventListener('resize', function() {
          if (window.innerWidth > 860) {
            var activeNav = document.getElementById('LvAcctSidebarNav');
            if (activeNav && activeNav.classList.contains('is-open') && typeof closeMobileDrawerFn === 'function') {
              closeMobileDrawerFn(false);
            }
          }
        }, { passive: true });
      }
    }

    function initStickySync() {
      var followUntil = 0;
      var rafId = 0;

      function syncStickyOffsets() {
        var wrap = document.querySelector('.lv-acct-wrap[data-section-id]');
        if (!wrap) return;
        var hero = wrap.querySelector('.lv-acct-hero');
        var layout = wrap.querySelector('[data-lv-acct-dashboard]');
        var nav = wrap.querySelector('#LvAcctSidebarNav');

        var headerWrap = document.querySelector('[data-header-wrapper]');
        var headerStickyEl = headerWrap ? (headerWrap.closest('.shopify-section') || headerWrap) : null;
        var stickyTop = 0;

        if (headerStickyEl) {
          var hStyle = window.getComputedStyle(headerStickyEl);
          if (hStyle.position === 'sticky' || hStyle.position === 'fixed') {
            var hRect = headerStickyEl.getBoundingClientRect();
            if (hRect.top <= 4 && hRect.bottom > 2) {
              stickyTop = Math.max(0, Math.round(hRect.bottom));
            }
          }
        }

        var heroH = hero ? Math.round(hero.getBoundingClientRect().height) : 98;
        wrap.style.setProperty('--lv-acct-sticky-top', stickyTop + 'px');
        wrap.style.setProperty('--lv-acct-hero-h', heroH + 'px');

        if (window.innerWidth > 860 && hero && layout && nav) {
          var layoutRect = layout.getBoundingClientRect();
          var navStickyTop = stickyTop + heroH + 20;
          var visualNavTop = Math.max(navStickyTop, Math.round(layoutRect.top));
          var navMaxH = Math.max(360, window.innerHeight - visualNavTop - 24);
          wrap.style.setProperty('--lv-acct-nav-max-h', navMaxH + 'px');

          var navH = Math.round(nav.getBoundingClientRect().height);
          var maxHeroTop = layoutRect.bottom - navH - 20 - heroH;
          var heroTop = Math.round(Math.min(stickyTop, maxHeroTop));
          wrap.style.setProperty('--lv-acct-hero-top', heroTop + 'px');
          var heroRect = hero.getBoundingClientRect();
          var isStuck = window.scrollY > 2 && heroRect.top <= heroTop + 1.5 && layoutRect.bottom > heroTop + heroH + 20;
          hero.classList.toggle('is-stuck', isStuck);
        } else {
          wrap.style.removeProperty('--lv-acct-nav-max-h');
          wrap.style.setProperty('--lv-acct-hero-top', stickyTop + 'px');
          if (hero) hero.classList.remove('is-stuck');
        }
      }

      function tickStickySync() {
        syncStickyOffsets();
        if (performance.now() < followUntil) {
          rafId = requestAnimationFrame(tickStickySync);
        } else {
          rafId = 0;
        }
      }

      function scheduleStickySync(durationMs) {
        var until = performance.now() + (durationMs || 0);
        if (until > followUntil) followUntil = until;
        if (!rafId) {
          rafId = requestAnimationFrame(tickStickySync);
        }
      }

      scheduleStickySyncFn = scheduleStickySync;
      syncStickyOffsets();

      if (!document.documentElement.dataset.lvAcctStickyGlobal) {
        document.documentElement.dataset.lvAcctStickyGlobal = '1';
        window.addEventListener('scroll', function() { scheduleStickySync(340); }, { passive: true });
        window.addEventListener('resize', function() { scheduleStickySync(120); }, { passive: true });
        window.addEventListener('load', function() { scheduleStickySync(120); }, { passive: true });

        var headerEl = document.querySelector('[data-header-wrapper]');
        var headerSec = headerEl ? (headerEl.closest('.shopify-section') || headerEl) : null;
        if (headerSec && window.MutationObserver) {
          new MutationObserver(function() {
            scheduleStickySync(340);
          }).observe(headerSec, { attributes: true, attributeFilter: ['class', 'style'] });
        }
      }

      var wrap = document.querySelector('.lv-acct-wrap[data-section-id]');
      if (wrap && !wrap.dataset.lvStickyObserved && window.ResizeObserver) {
        wrap.dataset.lvStickyObserved = '1';
        var ro = new ResizeObserver(function() { scheduleStickySync(0); });
        var heroEl = wrap.querySelector('.lv-acct-hero');
        var layoutEl = wrap.querySelector('[data-lv-acct-dashboard]');
        if (heroEl) ro.observe(heroEl);
        if (layoutEl) ro.observe(layoutEl);
      }
    }

    function initAll() {
      initStickySync();
      initMobileDrawer();
      initDashboardTabs();
      initAddressViewToggle();
      initAddressModals();
      initAddressForms();
      initOrderRefresh();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.target && e.target.querySelector && e.target.querySelector('[data-lv-acct-dashboard]')) {
        initAll();
      }
    });
  })();
</script>

