<!-- /sections/main-account-dashboard.liquid -->
{%- liquid
  assign concierge_email = section.settings.concierge_email | default: 'info@bssoln.com'
  assign wishlist_url = section.settings.wishlist_url | default: '/pages/wishlist'

  comment
    With New customer accounts customer.orders_count / total_spent can read 0 even though customer.orders lists the orders,
    so use whichever is larger and fall back to summing the listed orders.
  endcomment
  assign orders_total = 0
  assign spent_total = 0
  if customer
    assign orders_total = customer.orders_count
    if customer.orders.size > orders_total
      assign orders_total = customer.orders.size
    endif
    assign spent_total = customer.total_spent
    if spent_total == 0 and customer.orders.size > 0
      for o in customer.orders
        assign spent_total = spent_total | plus: o.total_price
      endfor
    endif
  endif

  assign initials = 'A'
  if customer
    assign first_letter = customer.first_name | slice: 0, 1 | upcase
    assign last_letter = customer.last_name | slice: 0, 1 | upcase
    if first_letter != blank
      assign initials = first_letter | append: last_letter
    elsif customer.email != blank
      assign initials = customer.email | slice: 0, 2 | upcase
    endif
  endif
-%}

<style>
  .ad-wrap {
    --ad-line: var(--hairline, color-mix(in srgb, var(--text) 14%, transparent));
    --ad-surface: color-mix(in srgb, var(--text) 3%, var(--bg));
    --ad-surface-2: color-mix(in srgb, var(--text) 6%, var(--bg));
    --ad-muted: color-mix(in srgb, var(--text) 62%, transparent);
    --ad-accent: var(--lv-accent, #9b7c53);
    --ad-radius: var(--card-radius, 0px);
    --ad-btn-r: var(--btn-radius, 0px);
    --ad-btn-bw: var(--btn-border-thickness, 1px);
    --ad-badge-r: var(--badge-radius, 2px);
    --ad-media-r: var(--media-radius, 0px);
    --ad-input-r: {{ settings.input_border_radius | default: 0 }}px;
    --ad-input-bw: {{ settings.input_border_thickness | default: 1 }}px;
    --ad-input-line: color-mix(in srgb, var(--text) 38%, transparent);
    font-family: 'Quicksand', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--text);
    background: var(--bg);
    width: 100%;
    box-sizing: border-box;
  }
  .ad-wrap *, .ad-wrap *::before, .ad-wrap *::after { box-sizing: border-box; }
  .ad-inner {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: var(--ad-pt, 40px) var(--outer, 24px) var(--ad-pb, 70px);
  }
  .ad-wrap .lv-crumbs { margin-bottom: 22px; }
  .ad-wrap svg.ad-i { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .ad-eyebrow { display: block; font-size: 11px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--ad-accent); }

  /* ---------- Hero / welcome ---------- */
  .ad-hero {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(16px, 3vw, 32px);
    padding: clamp(22px, 3.4vw, 36px) clamp(18px, 3.4vw, 40px);
    background: var(--ad-surface);
    border: 1px solid var(--ad-line);
    border-radius: var(--ad-radius);
    margin-bottom: clamp(20px, 3vw, 32px);
  }
  .ad-hero::before { content: ""; position: absolute; left: -1px; right: -1px; top: -1px; height: 3px; background: var(--ad-accent); border-radius: var(--ad-radius) var(--ad-radius) 0 0; }
  .ad-avatar {
    width: clamp(60px, 7vw, 84px); height: clamp(60px, 7vw, 84px);
    border-radius: 50%;
    display: grid; place-items: center;
    background: var(--bg);
    border: 1px solid var(--ad-accent);
    outline: 1px solid color-mix(in srgb, var(--ad-accent) 35%, transparent);
    outline-offset: 4px;
    font-size: clamp(18px, 2.2vw, 26px); font-weight: 700; letter-spacing: .08em; color: var(--text);
  }
  .ad-hero__text { min-width: 0; }
  .ad-hero__title { margin: 6px 0 6px; font-size: clamp(20px, 2.6vw, 30px); font-weight: 600; letter-spacing: .1em; text-transform: uppercase; line-height: 1.2; overflow-wrap: anywhere; }
  .ad-hero__meta { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 13px; color: var(--ad-muted); }
  .ad-hero__meta span { overflow-wrap: anywhere; }
  .ad-badge { display: inline-block; padding: 3px 10px; font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--ad-accent); border: 1px solid color-mix(in srgb, var(--ad-accent) 45%, transparent); border-radius: var(--ad-badge-r); background: color-mix(in srgb, var(--ad-accent) 8%, transparent); white-space: nowrap; }
  .ad-signout { display: inline-flex; align-items: center; gap: 8px; padding: 11px 20px; font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--text); text-decoration: none; border: var(--ad-btn-bw) solid var(--ad-input-line); border-radius: var(--ad-btn-r); background: var(--bg); transition: border-color .25s, background .25s; white-space: nowrap; }
  .ad-signout:hover { border-color: var(--text); background: var(--ad-surface-2); }
  .ad-signout svg.ad-i { width: 16px; height: 16px; }

  /* ---------- Layout + nav ---------- */
  .ad-layout { display: grid; grid-template-columns: clamp(220px, 22vw, 260px) minmax(0, 1fr); gap: clamp(20px, 3vw, 36px); align-items: start; }
  .ad-content { min-width: 0; }
  .ad-nav { position: sticky; top: 96px; display: flex; flex-direction: column; border: 1px solid var(--ad-line); background: var(--bg); border-radius: var(--ad-radius); padding: 8px; }
  .ad-nav__btn {
    position: relative; display: flex; align-items: center; gap: 12px; width: 100%;
    padding: 14px 14px 14px 16px; background: transparent; border: 0; border-radius: var(--ad-radius);
    color: var(--ad-muted); font: inherit; font-size: 12.5px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; text-align: left; cursor: pointer;
    transition: background .2s, color .2s;
  }
  .ad-nav__btn::before { content: ""; position: absolute; left: 0; top: 10px; bottom: 10px; width: 2px; background: var(--ad-accent); transform: scaleY(0); transition: transform .25s; }
  .ad-nav__btn:hover { color: var(--text); background: var(--ad-surface); }
  .ad-nav__btn.is-active { color: var(--text); background: var(--ad-surface-2); }
  .ad-nav__btn.is-active::before { transform: scaleY(1); }
  .ad-nav__btn.is-active svg.ad-i { stroke: var(--ad-accent); }
  .ad-nav__label { flex: 1 1 auto; min-width: 0; }
  .ad-nav__pill { min-width: 22px; padding: 2px 7px; text-align: center; font-size: 10.5px; font-weight: 700; border-radius: var(--ad-badge-r); background: color-mix(in srgb, var(--text) 9%, transparent); color: var(--text); }

  /* ---------- Panels ---------- */
  .ad-panel { display: none; }
  .ad-panel.is-active { display: block; animation: adFade .35s ease; }
  @keyframes adFade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .ad-ptitle { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px 20px; flex-wrap: wrap; padding-bottom: 16px; margin-bottom: 22px; border-bottom: 1px solid var(--ad-line); }
  .ad-ptitle h2 { margin: 4px 0 0; font-size: clamp(17px, 2vw, 22px); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .ad-link { font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--text); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: color-mix(in srgb, var(--text) 35%, transparent); transition: color .2s; }
  .ad-link:hover { color: var(--ad-accent); }

  .ad-card { background: var(--bg); border: 1px solid var(--ad-line); border-radius: var(--ad-radius); padding: clamp(16px, 2.4vw, 28px); margin-bottom: clamp(16px, 2.4vw, 24px); }
  .ad-card__head { display: flex; align-items: center; justify-content: space-between; gap: 10px 16px; flex-wrap: wrap; margin-bottom: 18px; }
  .ad-card__title { margin: 0; display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .ad-card__title svg.ad-i { stroke: var(--ad-accent); }

  /* ---------- Stats ---------- */
  .ad-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(10px, 1.6vw, 18px); margin-bottom: clamp(16px, 2.4vw, 24px); }
  .ad-stat { display: flex; align-items: center; gap: 16px; padding: clamp(16px, 2vw, 24px); background: var(--ad-surface); border: 1px solid var(--ad-line); border-radius: var(--ad-radius); min-width: 0; }
  .ad-stat__icon { width: 46px; height: 46px; display: grid; place-items: center; border: 1px solid color-mix(in srgb, var(--ad-accent) 45%, transparent); border-radius: 50%; color: var(--ad-accent); flex: none; }
  .ad-stat__body { min-width: 0; }
  .ad-stat__label { margin: 0 0 4px; font-size: 10.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--ad-muted); }
  .ad-stat__val { margin: 0; font-size: clamp(18px, 2vw, 24px); font-weight: 700; letter-spacing: .04em; line-height: 1.1; overflow-wrap: anywhere; }

  /* ---------- Quick actions ---------- */
  .ad-quick { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(10px, 1.6vw, 16px); margin-bottom: clamp(16px, 2.4vw, 24px); }
  .ad-quick__item { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 18px; background: var(--bg); border: 1px solid var(--ad-line); border-radius: var(--ad-radius); color: var(--text); text-decoration: none; font: inherit; text-align: left; cursor: pointer; transition: border-color .25s, transform .25s; }
  .ad-quick__item:hover { border-color: var(--ad-accent); transform: translateY(-2px); }
  .ad-quick__item svg.ad-i { stroke: var(--ad-accent); width: 22px; height: 22px; }
  .ad-quick__name { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .ad-quick__sub { font-size: 12.5px; color: var(--ad-muted); line-height: 1.5; margin-top: -4px; }

  /* ---------- Orders ---------- */
  .ad-order { display: grid; grid-template-columns: minmax(0, 1.4fr) auto auto; gap: 14px clamp(16px, 3vw, 36px); align-items: center; padding: clamp(14px, 2vw, 22px); border: 1px solid var(--ad-line); border-radius: var(--ad-radius); background: var(--bg); margin-bottom: 14px; transition: border-color .25s; }
  .ad-order:last-child { margin-bottom: 0; }
  .ad-order:hover { border-color: color-mix(in srgb, var(--text) 40%, transparent); }
  .ad-order__id { min-width: 0; }
  .ad-order__num { display: inline-block; font-size: 15px; font-weight: 700; letter-spacing: .08em; color: var(--text); text-decoration: none; }
  .ad-order__num:hover { color: var(--ad-accent); }
  .ad-order__date { margin: 3px 0 10px; font-size: 12.5px; color: var(--ad-muted); }
  .ad-order__thumbs { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .ad-order__thumb { width: 52px; height: 52px; object-fit: cover; border: 1px solid var(--ad-line); border-radius: var(--ad-media-r); background: var(--ad-surface); }
  .ad-order__more { font-size: 12px; font-weight: 600; color: var(--ad-muted); }
  .ad-order__status { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
  .ad-order__buy { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; text-align: right; }
  .ad-order__total { font-size: 16px; font-weight: 700; letter-spacing: .04em; }
  .ad-pill { display: inline-block; padding: 3px 10px; font-size: 10.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; border: 1px solid var(--ad-line); border-radius: var(--ad-badge-r); background: var(--ad-surface); color: var(--text); white-space: nowrap; }
  .ad-pill--paid, .ad-pill--fulfilled { color: var(--ad-accent); border-color: color-mix(in srgb, var(--ad-accent) 30%, transparent); background: color-mix(in srgb, var(--ad-accent) 9%, transparent); }
  .ad-pill--pending, .ad-pill--partially_paid, .ad-pill--unfulfilled, .ad-pill--partial, .ad-pill--authorized { color: var(--ad-accent); border-color: color-mix(in srgb, var(--ad-accent) 40%, transparent); background: color-mix(in srgb, var(--ad-accent) 9%, transparent); }

  /* ---------- Addresses / concierge ---------- */
  .ad-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr)); gap: clamp(12px, 1.8vw, 18px); }
  .ad-tile { position: relative; padding: 20px; background: var(--ad-surface); border: 1px solid var(--ad-line); border-radius: var(--ad-radius); font-size: 13.5px; line-height: 1.65; }
  .ad-tile--default { border-color: var(--ad-accent); background: color-mix(in srgb, var(--ad-accent) 5%, var(--bg)); }
  .ad-tile__top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
  .ad-tile address { font-style: normal; color: var(--ad-muted); }
  .ad-tile__phone { margin: 8px 0 0; font-size: 12.5px; color: var(--ad-muted); }
  .ad-tile__icon { color: var(--ad-accent); margin-bottom: 12px; }
  .ad-tile__title { margin: 0 0 6px; font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .ad-tile__text { margin: 0 0 14px; font-size: 13px; color: var(--ad-muted); }

  /* ---------- Empty ---------- */
  .ad-empty { text-align: center; padding: clamp(32px, 5vw, 56px) 20px; border: 1px dashed var(--ad-line); border-radius: var(--ad-radius); background: var(--ad-surface); }
  .ad-empty svg.ad-i { display: block; width: 34px; height: 34px; stroke: var(--ad-accent); margin: 0 auto 14px; }
  .ad-empty__title { margin: 0 0 8px; font-size: 15px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .ad-empty__text { margin: 0 auto 22px; max-width: 440px; font-size: 13.5px; line-height: 1.65; color: var(--ad-muted); }
  .ad-muted-text { margin: 0 0 14px; font-size: 13.5px; color: var(--ad-muted); }

  /* ---------- Buttons / perks ---------- */
  .ad-btn { padding: 12px 26px; font-size: 12.5px; max-width: 100%; text-align: center; }
  .ad-btn--sm { padding: 9px 18px; font-size: 11.5px; }
  .ad-btn--ghost { background: transparent; color: var(--text); border: var(--ad-btn-bw) solid var(--ad-input-line); }
  .ad-actions { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
  .ad-pagination { margin-top: 24px; text-align: center; }
  .ad-perks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border: 1px solid var(--ad-line); border-radius: var(--ad-radius); background: var(--ad-surface); }
  .ad-perk { display: flex; align-items: center; justify-content: center; gap: 12px; padding: 18px 14px; font-size: 11.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; text-align: left; }
  .ad-perk + .ad-perk { border-left: 1px solid var(--ad-line); }
  .ad-perk svg.ad-i { stroke: var(--ad-accent); }

  /* ---------- Modals ---------- */
  dialog.ad-modal:not([open]) {
    display: none;
  }
  .ad-modal {
    width: min(540px, calc(100vw - 32px));
    max-height: calc(100vh - 48px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--ad-line);
    border-radius: var(--ad-radius);
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.22);
    overflow: hidden;
  }
  .ad-modal::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .ad-modal__inner {
    padding: clamp(20px, 3.5vw, 32px);
    max-height: calc(100vh - 60px);
    overflow-y: auto;
  }
  .ad-modal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--ad-line);
  }
  .ad-modal__title {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .ad-modal__close {
    background: transparent;
    border: 0;
    color: var(--ad-muted);
    font-size: 26px;
    cursor: pointer;
    line-height: 1;
    padding: 2px 8px;
    transition: color .2s;
  }
  .ad-modal__close:hover {
    color: var(--text);
  }
  .ad-modal__form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ad-modal__foot {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 14px;
    padding-top: 16px;
    border-top: 1px solid var(--ad-line);
  }
  .ad-field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  @media (max-width: 580px) {
    .ad-field-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .ad-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ad-muted);
    text-align: left;
  }
  .ad-field input, .ad-field select {
    width: 100%;
    height: 44px;
    padding: 0 12px;
    font: inherit;
    font-size: 13.5px;
    font-weight: 500;
    text-transform: none;
    letter-spacing: normal;
    color: var(--text);
    background: var(--ad-surface);
    border: 1px solid var(--ad-line);
    border-radius: var(--ad-radius);
    outline: none;
    transition: border-color .2s;
    box-sizing: border-box;
  }
  .ad-field input:focus, .ad-field select:focus {
    border-color: var(--text);
  }
  .ad-check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 500;
    text-transform: none;
    cursor: pointer;
    color: var(--text);
    margin-top: 4px;
  }
  .ad-tile__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--ad-line);
  }
  .ad-toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    padding: 12px 22px;
    background: var(--text);
    color: var(--bg);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .04em;
    border-radius: var(--ad-radius);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    z-index: 999999;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity .3s, transform .3s;
    pointer-events: none;
  }
  .ad-toast.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---------- Guest ---------- */
  .ad-guest { max-width: 680px; margin: 0 auto; text-align: center; background: var(--ad-surface); border: 1px solid var(--ad-line); border-radius: var(--ad-radius); padding: clamp(32px, 6vw, 56px) clamp(18px, 4vw, 40px); position: relative; }
  .ad-guest::before { content: ""; position: absolute; left: -1px; right: -1px; top: -1px; height: 3px; background: var(--ad-accent); }
  .ad-guest__title { margin: 8px 0 12px; font-size: clamp(20px, 3vw, 28px); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .ad-guest__desc { margin: 0 auto 28px; max-width: 480px; font-size: 14px; line-height: 1.7; color: var(--ad-muted); }
  .ad-guest__actions { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-bottom: 34px; }
  .ad-guest__perks { border-top: 1px solid var(--ad-line); padding-top: 26px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .ad-guest-perk { font-size: 11.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .ad-guest-perk span { display: block; margin-top: 4px; font-size: 12px; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--ad-muted); }

  /* ================= Tablet ================= */
  @media (max-width: 1024px) {
    .ad-quick { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ad-order { grid-template-columns: minmax(0, 1fr) auto; }
    .ad-order__status { grid-column: 2; grid-row: 1; align-items: flex-end; }
    .ad-order__buy { grid-column: 1 / -1; flex-direction: row; justify-content: space-between; align-items: center; border-top: 1px solid var(--ad-line); padding-top: 14px; text-align: left; }
  }

  /* ================= Tablet portrait + mobile: tab bar ================= */
  @media (max-width: 860px) {
    .ad-layout { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .ad-nav { position: static; flex-direction: row; gap: 4px; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; padding: 6px; -webkit-overflow-scrolling: touch; }
    .ad-nav::-webkit-scrollbar { display: none; }
    .ad-nav__btn { flex: 0 0 auto; width: auto; white-space: nowrap; padding: 12px 14px; scroll-snap-align: start; }
    .ad-nav__btn::before { left: 12px; right: 12px; top: auto; bottom: 2px; width: auto; height: 2px; transform: scaleX(0); }
    .ad-nav__btn.is-active::before { transform: scaleX(1); }
  }

  /* ================= Mobile ================= */
  @media (max-width: 640px) {
    .ad-hero { grid-template-columns: auto minmax(0, 1fr); align-items: center; }
    .ad-signout { grid-column: 1 / -1; justify-content: center; width: 100%; }
    .ad-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .ad-stat { flex-direction: column; align-items: flex-start; gap: 10px; padding: 14px 12px; }
    .ad-stat__icon { width: 34px; height: 34px; }
    .ad-stat__icon svg.ad-i { width: 16px; height: 16px; }
    .ad-stat__label { font-size: 9.5px; letter-spacing: .1em; }
    .ad-stat__val { font-size: 16px; }
    .ad-quick__item { padding: 14px; }
    .ad-quick__sub { display: none; }
    .ad-order { grid-template-columns: minmax(0, 1fr); }
    .ad-order__status { grid-column: auto; grid-row: auto; flex-direction: row; flex-wrap: wrap; align-items: center; }
    .ad-order__buy { flex-direction: column; align-items: stretch; gap: 12px; text-align: center; }
    .ad-order__buy .btn { width: 100%; }
    .ad-order__thumb { width: 46px; height: 46px; }
    .ad-perks { grid-template-columns: minmax(0, 1fr); }
    .ad-perk { justify-content: flex-start; padding: 14px 16px; }
    .ad-perk + .ad-perk { border-left: 0; border-top: 1px solid var(--ad-line); }
    .ad-actions .btn, .ad-guest__actions .btn { width: 100%; }
    .ad-guest__perks { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 380px) {
    .ad-stat__val { font-size: 14px; }
    .ad-nav__btn { padding: 11px 11px; font-size: 11.5px; }
  }
</style>

<div
  class="ad-wrap color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="--ad-pt: {{ section.settings.padding_top | default: 40 }}px; --ad-pb: {{ section.settings.padding_bottom | default: 70 }}px;"
>
  <div class="ad-inner">
    {% render 'breadcrumb', current: 'My Account' %}

    {% if customer %}
      <!-- ================= LOGGED IN ================= -->
      <header class="ad-hero">
        <div class="ad-avatar" aria-hidden="true">{{ initials }}</div>
        <div class="ad-hero__text">
          <span class="ad-eyebrow">Welcome back</span>
          <h1 class="ad-hero__title">{{ customer.name | default: 'Atelier Member' }}</h1>
          <p class="ad-hero__meta"><span>{{ customer.email }}</span><span class="ad-badge">VIP Member</span></p>
        </div>
        <a href="{{ routes.account_logout_url }}" class="ad-signout">
          <svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Sign Out
        </a>
      </header>

      <div class="ad-layout" data-ad-dashboard>
        <nav class="ad-nav" role="tablist" aria-label="Account sections">
          <button type="button" class="ad-nav__btn is-active" data-tab-target="overview" role="tab" aria-selected="true">
            <svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span class="ad-nav__label">Overview</span>
          </button>
          <button type="button" class="ad-nav__btn" data-tab-target="orders" role="tab" aria-selected="false">
            <svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <span class="ad-nav__label">Orders</span>
            <span class="ad-nav__pill">{{ orders_total }}</span>
          </button>
          <button type="button" class="ad-nav__btn" data-tab-target="addresses" role="tab" aria-selected="false">
            <svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span class="ad-nav__label">Addresses</span>
            <span class="ad-nav__pill">{{ customer.addresses_count }}</span>
          </button>
          {% if section.settings.show_wishlist %}
            <button type="button" class="ad-nav__btn" data-tab-target="wishlist" role="tab" aria-selected="false">
              <svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              <span class="ad-nav__label">Saved</span>
            </button>
          {% endif %}
          <button type="button" class="ad-nav__btn" data-tab-target="concierge" role="tab" aria-selected="false">
            <svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <span class="ad-nav__label">Concierge</span>
          </button>
        </nav>

        <main class="ad-content">

          <!-- OVERVIEW -->
          <div class="ad-panel is-active" data-tab-panel="overview" role="tabpanel">
            <div class="ad-stats">
              <div class="ad-stat">
                <span class="ad-stat__icon"><svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg></span>
                <div class="ad-stat__body"><p class="ad-stat__label">Orders</p><p class="ad-stat__val">{{ orders_total }}</p></div>
              </div>
              <div class="ad-stat">
                <span class="ad-stat__icon"><svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M14.5 9.2c-.5-.8-1.4-1.2-2.5-1.2-1.4 0-2.5.8-2.5 2s1 1.7 2.5 2 2.5.8 2.5 2-1.1 2-2.5 2c-1.1 0-2-.4-2.5-1.2M12 6.5V8m0 8v1.5"/></svg></span>
                <div class="ad-stat__body"><p class="ad-stat__label">Total spent</p><p class="ad-stat__val">{{ spent_total | money }}</p></div>
              </div>
              <div class="ad-stat">
                <span class="ad-stat__icon"><svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>
                <div class="ad-stat__body"><p class="ad-stat__label">Status</p><p class="ad-stat__val">VIP</p></div>
              </div>
            </div>

            <div class="ad-quick">
              <a class="ad-quick__item" href="{{ routes.all_products_collection_url }}">
                <svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18M9 3l3 18M15 3l-3 18"/></svg>
                <span class="ad-quick__name">Shop</span><span class="ad-quick__sub">Explore the collection</span>
              </a>
              <button type="button" class="ad-quick__item" data-switch-to="orders">
                <svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="6" width="14" height="10"/><path d="M15 9h4l3 3v4h-7z"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
                <span class="ad-quick__name">Track order</span><span class="ad-quick__sub">See delivery status</span>
              </button>
              <a class="ad-quick__item" href="/pages/size-guide">
                <svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/></svg>
                <span class="ad-quick__name">Size guide</span><span class="ad-quick__sub">Find your fit</span>
              </a>
              <a class="ad-quick__item" href="mailto:{{ concierge_email }}">
                <svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14"/><polyline points="3 7 12 13 21 7"/></svg>
                <span class="ad-quick__name">Contact</span><span class="ad-quick__sub">Talk to our concierge</span>
              </a>
            </div>

            <div class="ad-card">
              <div class="ad-card__head">
                <h3 class="ad-card__title"><svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg>Latest order</h3>
                {% if customer.orders.size > 0 %}<a href="#orders" class="ad-link" data-switch-to="orders">View all</a>{% endif %}
              </div>
              {% if customer.orders.size > 0 %}
                {% assign order = customer.orders.first %}
                {% render 'account-order-row', order: order %}
              {% else %}
                <div class="ad-empty">
                  <svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg>
                  <p class="ad-empty__title">No orders yet</p>
                  <p class="ad-empty__text">Explore our fine waterproof jewelry, personal engravings and heirloom rings.</p>
                  <a href="{{ routes.all_products_collection_url }}" class="btn btn-sliding-hover ad-btn">Explore Collection</a>
                </div>
              {% endif %}
            </div>

            <div class="ad-card">
              <div class="ad-card__head">
                <h3 class="ad-card__title"><svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>Delivery address</h3>
                <a href="#addresses" class="ad-link" data-switch-to="addresses">Manage</a>
              </div>
              {% if customer.default_address %}
                <div class="ad-tile ad-tile--default">
                  <div class="ad-tile__top"><strong>{{ customer.default_address.name }}</strong><span class="ad-badge">Default</span></div>
                  <address>{{ customer.default_address | format_address }}</address>
                </div>
              {% else %}
                <p class="ad-muted-text">No default delivery address saved yet.</p>
                <button type="button" class="btn btn-sliding-hover ad-btn ad-btn--sm" data-ad-open-modal="AdAddAddressModal">Add Address</button>
              {% endif %}
            </div>

            <div class="ad-perks">
              <div class="ad-perk"><svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Waterproof &amp; sweat-proof</span></div>
              <div class="ad-perk"><svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 14 14"/></svg><span>14 days easy returns</span></div>
              <div class="ad-perk"><svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg><span>Free shipping from €39</span></div>
            </div>
          </div>

          <!-- ORDERS -->
          <div class="ad-panel" data-tab-panel="orders" role="tabpanel">
            <div class="ad-ptitle"><div><span class="ad-eyebrow">History</span><h2>My orders ({{ orders_total }})</h2></div></div>
            {% if customer.orders.size > 0 %}
              {% paginate customer.orders by 15 %}
                {% for order in customer.orders %}
                  {% render 'account-order-row', order: order %}
                {% endfor %}
                {% if paginate.pages > 1 %}<div class="ad-pagination">{{ paginate | default_pagination }}</div>{% endif %}
              {% endpaginate %}
            {% else %}
              <div class="ad-empty">
                <svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg>
                <p class="ad-empty__title">No orders yet</p>
                <p class="ad-empty__text">Every Aurelle piece is crafted with hypoallergenic materials and made to be worn daily.</p>
                <a href="{{ routes.all_products_collection_url }}" class="btn btn-sliding-hover ad-btn">Explore Collections</a>
              </div>
            {% endif %}
          </div>

          <!-- ADDRESSES -->
          <div class="ad-panel" data-tab-panel="addresses" role="tabpanel">
            <div class="ad-ptitle">
              <div><span class="ad-eyebrow">Delivery</span><h2>Saved addresses ({{ customer.addresses_count }})</h2></div>
              <button type="button" class="btn btn-sliding-hover ad-btn ad-btn--sm" data-ad-open-modal="AdAddAddressModal">Add address</button>
            </div>
            {% if customer.addresses.size > 0 %}
              <div class="ad-grid">
                {% for addr in customer.addresses %}
                  <div class="ad-tile{% if addr == customer.default_address %} ad-tile--default{% endif %}">
                    <div class="ad-tile__top">
                      <strong>{{ addr.name }}</strong>
                      {% if addr == customer.default_address %}<span class="ad-badge">Default</span>{% endif %}
                    </div>
                    <address>{{ addr | format_address }}</address>
                    {% if addr.phone != blank %}<p class="ad-tile__phone">{{ addr.phone }}</p>{% endif %}
                    <div class="ad-tile__actions">
                      <button type="button" class="btn btn-sliding-hover ad-btn ad-btn--sm" data-ad-open-modal="AdEditAddressModal-{{ addr.id }}">Edit</button>
                      <form method="post" action="{{ routes.account_addresses_url }}/{{ addr.id }}" data-ad-delete-form style="margin: 0; display: inline;">
                        <input type="hidden" name="_method" value="delete">
                        <button type="submit" class="btn btn-sliding-hover ad-btn ad-btn--sm ad-btn--ghost">Delete</button>
                      </form>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% else %}
              <div class="ad-empty">
                <svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <p class="ad-empty__title">No addresses saved</p>
                <p class="ad-empty__text">Save your delivery addresses for a faster checkout on your next order.</p>
                <button type="button" class="btn btn-sliding-hover ad-btn" data-ad-open-modal="AdAddAddressModal">Add New Address</button>
              </div>
            {% endif %}
          </div>

          <!-- SAVED -->
          {% if section.settings.show_wishlist %}
            <div class="ad-panel" data-tab-panel="wishlist" role="tabpanel">
              <div class="ad-ptitle"><div><span class="ad-eyebrow">Favourites</span><h2>Saved pieces</h2></div></div>
              <div class="ad-empty">
                <svg class="ad-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                <p class="ad-empty__title">Curate your collection</p>
                <p class="ad-empty__text">Save your favourite rings, chains and earrings as you browse the atelier.</p>
                <div class="ad-actions">
                  <a href="{{ wishlist_url }}" class="btn btn-sliding-hover ad-btn">View Wishlist</a>
                  <a href="{{ routes.collections_url }}/bestsellers" class="btn btn-sliding-hover ad-btn ad-btn--ghost">Bestsellers</a>
                </div>
              </div>
            </div>
          {% endif %}

          <!-- CONCIERGE -->
          <div class="ad-panel" data-tab-panel="concierge" role="tabpanel">
            <div class="ad-ptitle"><div><span class="ad-eyebrow">Atelier</span><h2>Concierge &amp; care</h2></div></div>
            <div class="ad-grid">
              <div class="ad-tile">
                <svg class="ad-i ad-tile__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/></svg>
                <h4 class="ad-tile__title">Sizing &amp; fit</h4>
                <p class="ad-tile__text">Find your ring diameter, bracelet drape or necklace layering length.</p>
                <a href="/pages/size-guide" class="ad-link">Open sizing guide</a>
              </div>
              <div class="ad-tile">
                <svg class="ad-i ad-tile__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg>
                <h4 class="ad-tile__title">Permanent jewelry</h4>
                <p class="ad-tile__text">Book an in-person micro-weld session for a bespoke claspless chain.</p>
                <a href="/pages/permanent-jewelry-on-site" class="ad-link">Book appointment</a>
              </div>
              <div class="ad-tile">
                <svg class="ad-i ad-tile__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14"/><polyline points="3 7 12 13 21 7"/></svg>
                <h4 class="ad-tile__title">Questions &amp; engravings</h4>
                <p class="ad-tile__text">Need help with an engraving or an order change? We are here.</p>
                <a href="mailto:{{ concierge_email }}" class="ad-link">Email concierge</a>
              </div>
            </div>
          </div>

        </main>
      </div>

      <!-- ================= ADDRESS MODALS ================= -->
      <dialog id="AdAddAddressModal" class="ad-modal">
        <div class="ad-modal__inner">
          <div class="ad-modal__head">
            <h3 class="ad-modal__title">Add New Address</h3>
            <button type="button" class="ad-modal__close" data-ad-close-modal aria-label="Close modal">&times;</button>
          </div>
          {% form 'customer_address', customer.new_address, class: 'ad-modal__form', data-ad-address-form: '' %}
            <div class="ad-field-row">
              <div class="ad-field">
                <label for="AddressFirstNameNew">First Name</label>
                <input type="text" id="AddressFirstNameNew" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" required>
              </div>
              <div class="ad-field">
                <label for="AddressLastNameNew">Last Name</label>
                <input type="text" id="AddressLastNameNew" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" required>
              </div>
            </div>
            <div class="ad-field">
              <label for="AddressCompanyNew">Company (optional)</label>
              <input type="text" id="AddressCompanyNew" name="address[company]" value="{{ form.company }}" autocomplete="organization">
            </div>
            <div class="ad-field">
              <label for="AddressAddress1New">Address line 1</label>
              <input type="text" id="AddressAddress1New" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" required>
            </div>
            <div class="ad-field">
              <label for="AddressAddress2New">Apartment, suite, etc. (optional)</label>
              <input type="text" id="AddressAddress2New" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
            </div>
            <div class="ad-field-row">
              <div class="ad-field">
                <label for="AddressCityNew">City</label>
                <input type="text" id="AddressCityNew" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" required>
              </div>
              <div class="ad-field">
                <label for="AddressZipNew">Postal / ZIP Code</label>
                <input type="text" id="AddressZipNew" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code" required>
              </div>
            </div>
            <div class="ad-field-row">
              <div class="ad-field">
                <label for="AddressCountryNew">Country</label>
                <select id="AddressCountryNew" name="address[country]" data-default="{{ form.country }}" data-ad-country autocomplete="country">
                  {{ all_country_option_tags }}
                </select>
              </div>
              <div class="ad-field" id="AddressProvinceContainerNew" style="display: none;">
                <label for="AddressProvinceNew">Region / State</label>
                <select id="AddressProvinceNew" name="address[province]" data-default="{{ form.province }}" data-ad-province autocomplete="address-level1">
                </select>
              </div>
            </div>
            <div class="ad-field">
              <label for="AddressPhoneNew">Phone (optional)</label>
              <input type="tel" id="AddressPhoneNew" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
            </div>
            <label class="ad-check" for="address_default_address_new">
              <input type="checkbox" id="address_default_address_new" name="address[default]" value="1">
              <span>Set as default delivery address</span>
            </label>
            <div class="ad-modal__foot">
              <button type="button" class="btn btn-sliding-hover ad-btn ad-btn--sm ad-btn--ghost" data-ad-close-modal>Cancel</button>
              <button type="submit" class="btn btn-sliding-hover ad-btn ad-btn--sm">Save Address</button>
            </div>
          {% endform %}
        </div>
      </dialog>

      {% for addr in customer.addresses %}
        <dialog id="AdEditAddressModal-{{ addr.id }}" class="ad-modal">
          <div class="ad-modal__inner">
            <div class="ad-modal__head">
              <h3 class="ad-modal__title">Edit Address</h3>
              <button type="button" class="ad-modal__close" data-ad-close-modal aria-label="Close modal">&times;</button>
            </div>
            {% form 'customer_address', addr, class: 'ad-modal__form', data-ad-address-form: '' %}
              <div class="ad-field-row">
                <div class="ad-field">
                  <label for="AddressFirstName_{{ addr.id }}">First Name</label>
                  <input type="text" id="AddressFirstName_{{ addr.id }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" required>
                </div>
                <div class="ad-field">
                  <label for="AddressLastName_{{ addr.id }}">Last Name</label>
                  <input type="text" id="AddressLastName_{{ addr.id }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" required>
                </div>
              </div>
              <div class="ad-field">
                <label for="AddressCompany_{{ addr.id }}">Company (optional)</label>
                <input type="text" id="AddressCompany_{{ addr.id }}" name="address[company]" value="{{ form.company }}" autocomplete="organization">
              </div>
              <div class="ad-field">
                <label for="AddressAddress1_{{ addr.id }}">Address line 1</label>
                <input type="text" id="AddressAddress1_{{ addr.id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" required>
              </div>
              <div class="ad-field">
                <label for="AddressAddress2_{{ addr.id }}">Apartment, suite, etc. (optional)</label>
                <input type="text" id="AddressAddress2_{{ addr.id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
              </div>
              <div class="ad-field-row">
                <div class="ad-field">
                  <label for="AddressCity_{{ addr.id }}">City</label>
                  <input type="text" id="AddressCity_{{ addr.id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" required>
                </div>
                <div class="ad-field">
                  <label for="AddressZip_{{ addr.id }}">Postal / ZIP Code</label>
                  <input type="text" id="AddressZip_{{ addr.id }}" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code" required>
                </div>
              </div>
              <div class="ad-field-row">
                <div class="ad-field">
                  <label for="AddressCountry_{{ addr.id }}">Country</label>
                  <select id="AddressCountry_{{ addr.id }}" name="address[country]" data-default="{{ addr.country }}" data-ad-country autocomplete="country">
                    {{ all_country_option_tags }}
                  </select>
                </div>
                <div class="ad-field" id="AddressProvinceContainer_{{ addr.id }}" style="display: none;">
                  <label for="AddressProvince_{{ addr.id }}">Region / State</label>
                  <select id="AddressProvince_{{ addr.id }}" name="address[province]" data-default="{{ addr.province }}" data-ad-province autocomplete="address-level1">
                  </select>
                </div>
              </div>
              <div class="ad-field">
                <label for="AddressPhone_{{ addr.id }}">Phone (optional)</label>
                <input type="tel" id="AddressPhone_{{ addr.id }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
              </div>
              <label class="ad-check" for="address_default_address_{{ addr.id }}">
                <input type="checkbox" id="address_default_address_{{ addr.id }}" name="address[default]" value="1"{% if addr == customer.default_address %} checked{% endif %}>
                <span>Set as default delivery address</span>
              </label>
              <div class="ad-modal__foot">
                <button type="button" class="btn btn-sliding-hover ad-btn ad-btn--sm ad-btn--ghost" data-ad-close-modal>Cancel</button>
                <button type="submit" class="btn btn-sliding-hover ad-btn ad-btn--sm">Update Address</button>
              </div>
            {% endform %}
          </div>
        </dialog>
      {% endfor %}

      <div id="AdToast" class="ad-toast" role="status" aria-live="polite"></div>
    {% else %}
      <!-- ================= GUEST ================= -->
      {%- assign guest_return_to = '/pages/account' | url_encode -%}
      {%- assign guest_login_url = '/customer_authentication/login?return_to=' | append: guest_return_to -%}
      <div class="ad-guest">
        <span class="ad-eyebrow">Aurelle Atelier Privileges</span>
        <h1 class="ad-guest__title">Sign in to your account</h1>
        <p class="ad-guest__desc">Track orders, manage delivery addresses, review engravings and enjoy concierge privileges.</p>
        <div class="ad-guest__actions">
          <a href="{{ guest_login_url }}" class="btn btn-sliding-hover ad-btn">Sign In</a>
          <a href="{{ guest_login_url }}" class="btn btn-sliding-hover ad-btn ad-btn--ghost">Create Account</a>
        </div>
        <div class="ad-guest__perks">
          <div class="ad-guest-perk">Order tracking<span>Real-time delivery updates</span></div>
          <div class="ad-guest-perk">Saved details<span>Addresses &amp; engraving records</span></div>
          <div class="ad-guest-perk">Member privileges<span>Complimentary care &amp; offers</span></div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    function initDashboardTabs() {
      var root = document.querySelector('[data-ad-dashboard]');
      if (!root) return;

      var navBtns = root.querySelectorAll('[data-tab-target]');
      var panels = root.querySelectorAll('[data-tab-panel]');
      var quickSwitchers = root.querySelectorAll('[data-switch-to]');

      function switchTab(tabId) {
        if (!tabId) return;
        navBtns.forEach(function(btn) {
          var target = btn.getAttribute('data-tab-target');
          var isActive = target === tabId;
          btn.classList.toggle('is-active', isActive);
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        panels.forEach(function(panel) {
          var id = panel.getAttribute('data-tab-panel');
          panel.classList.toggle('is-active', id === tabId);
        });

        // Update URL hash without jump
        if (history.replaceState) {
          history.replaceState(null, null, '#' + tabId);
        }
      }

      navBtns.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var target = this.getAttribute('data-tab-target');
          switchTab(target);
        });
      });

      quickSwitchers.forEach(function(switcher) {
        switcher.addEventListener('click', function(e) {
          e.preventDefault();
          var target = this.getAttribute('data-switch-to');
          switchTab(target);
        });
      });

      // Handle initial hash in URL
      var hash = window.location.hash ? window.location.hash.substring(1) : '';
      if (hash && root.querySelector('[data-tab-panel="' + hash + '"]')) {
        switchTab(hash);
      }
    }

    function showToast(message) {
      var toast = document.getElementById('AdToast');
      if (!toast) return;
      toast.textContent = message;
      toast.classList.add('is-visible');
      setTimeout(function() {
        toast.classList.remove('is-visible');
      }, 3500);
    }

    function initAddressModals() {
      // Open modal triggers
      document.querySelectorAll('[data-ad-open-modal]').forEach(function(trigger) {
        trigger.addEventListener('click', function(e) {
          e.preventDefault();
          var modalId = this.getAttribute('data-ad-open-modal');
          var modal = document.getElementById(modalId);
          if (modal && typeof modal.showModal === 'function') {
            modal.showModal();
            // Trigger country change to populate provinces properly
            var countrySelect = modal.querySelector('[data-ad-country]');
            if (countrySelect) {
              countrySelect.dispatchEvent(new Event('change'));
            }
          }
        });
      });

      // Close modal triggers
      document.querySelectorAll('[data-ad-close-modal]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var modal = this.closest('dialog');
          if (modal && typeof modal.close === 'function') {
            modal.close();
          }
        });
      });

      // Close on backdrop click
      document.querySelectorAll('dialog.ad-modal').forEach(function(modal) {
        modal.addEventListener('click', function(e) {
          var rect = modal.getBoundingClientRect();
          var isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
            rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
          if (!isInDialog) {
            modal.close();
          }
        });
      });

      // Country & Province synchronization
      document.querySelectorAll('[data-ad-country]').forEach(function(countrySelect) {
        var form = countrySelect.closest('form');
        if (!form) return;
        var provSelect = form.querySelector('[data-ad-province]');
        var provContainer = provSelect ? provSelect.closest('.ad-field') : null;

        var defaultCountry = countrySelect.getAttribute('data-default');
        if (defaultCountry) {
          for (var i = 0; i < countrySelect.options.length; i++) {
            if (countrySelect.options[i].value === defaultCountry) {
              countrySelect.selectedIndex = i;
              break;
            }
          }
        }

        function updateProvinces() {
          if (!provSelect || !provContainer) return;
          var selectedOption = countrySelect.options[countrySelect.selectedIndex];
          if (!selectedOption) return;

          var rawProvinces = selectedOption.getAttribute('data-provinces');
          var provinces = [];
          try {
            provinces = JSON.parse(rawProvinces || '[]');
          } catch(err) {
            provinces = [];
          }

          provSelect.innerHTML = '';
          if (provinces && provinces.length > 0) {
            var defaultProv = provSelect.getAttribute('data-default');
            provinces.forEach(function(p) {
              var opt = document.createElement('option');
              opt.value = p[0];
              opt.textContent = p[1] || p[0];
              if (defaultProv && (p[0] === defaultProv || p[1] === defaultProv)) {
                opt.selected = true;
              }
              provSelect.appendChild(opt);
            });
            provContainer.style.display = 'flex';
          } else {
            provContainer.style.display = 'none';
          }
        }

        countrySelect.addEventListener('change', updateProvinces);
        updateProvinces();
      });
    }

    function initAddressForms() {
      // AJAX Address Create & Update
      document.querySelectorAll('form[data-ad-address-form]').forEach(function(form) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          var submitBtn = form.querySelector('button[type="submit"]');
          var origBtnText = '';
          if (submitBtn) {
            submitBtn.disabled = true;
            origBtnText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<span>Saving...</span>';
          }

          var formData = new FormData(form);

          fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8'
            }
          })
          .then(function() {
            var modal = form.closest('dialog');
            if (modal) modal.close();
            showToast('Address saved successfully');
            setTimeout(function() {
              if (window.location.hash !== '#addresses') {
                window.location.hash = 'addresses';
              }
              window.location.reload();
            }, 600);
          })
          .catch(function(err) {
            console.error('Address form submit error:', err);
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = origBtnText;
            }
            showToast('Error saving address. Please try again.');
          });
        });
      });

      // AJAX Address Delete
      document.querySelectorAll('form[data-ad-delete-form]').forEach(function(delForm) {
        delForm.addEventListener('submit', function(e) {
          e.preventDefault();
          if (!confirm('Are you sure you want to delete this address?')) {
            return;
          }
          var submitBtn = delForm.querySelector('button[type="submit"]');
          if (submitBtn) submitBtn.disabled = true;

          var formData = new FormData(delForm);

          fetch(delForm.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8'
            }
          })
          .then(function() {
            showToast('Address removed successfully');
            setTimeout(function() {
              if (window.location.hash !== '#addresses') {
                window.location.hash = 'addresses';
              }
              window.location.reload();
            }, 600);
          })
          .catch(function(err) {
            console.error('Address delete error:', err);
            if (submitBtn) submitBtn.disabled = false;
            showToast('Error removing address.');
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initDashboardTabs();
        initAddressModals();
        initAddressForms();
      });
    } else {
      initDashboardTabs();
      initAddressModals();
      initAddressForms();
    }
  })();
</script>

{% schema %}
{
  "name": "Customer Dashboard",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show Wishlist tab",
      "default": true
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist page URL"
    },
    {
      "type": "text",
      "id": "concierge_email",
      "label": "Concierge email address",
      "default": "info@bssoln.com"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 70
    }
  ]
}
{% endschema %}
