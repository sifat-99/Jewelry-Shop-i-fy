<!-- /sections/main-account-dashboard.liquid -->
{%- liquid
  assign concierge_email = section.settings.concierge_email | default: 'info@bssoln.com'
  assign root_prefix = routes.root_url
  unless root_prefix == '/'
    assign root_prefix = root_prefix | append: '/'
  endunless
  assign default_wishlist_url = root_prefix | append: 'pages/wishlist'
  assign wishlist_url = section.settings.wishlist_url | default: default_wishlist_url
  assign size_guide_url = root_prefix | append: 'pages/size-guide'
  assign permanent_jewelry_url = root_prefix | append: 'pages/permanent-jewelry-on-site'

  comment
    With New customer accounts customer.orders_count / total_spent can read 0 even though customer.orders lists the orders,
    so use whichever is larger and fall back to summing the listed orders.
  endcomment
  assign orders_total = 0
  assign spent_total = 0
  if customer
    assign orders_total = customer.orders_count
    if customer.orders.size > orders_total
      assign orders_total = customer.orders.size
    endif
    assign spent_total = customer.total_spent
    if spent_total == 0 and customer.orders.size > 0
      for o in customer.orders
        assign spent_total = spent_total | plus: o.total_price
      endfor
    endif
  endif

  assign initials = 'A'
  if customer
    assign first_letter = customer.first_name | slice: 0, 1 | upcase
    assign last_letter = customer.last_name | slice: 0, 1 | upcase
    if first_letter != blank
      assign initials = first_letter | append: last_letter
    elsif customer.email != blank
      assign initials = customer.email | slice: 0, 2 | upcase
    endif
  endif
-%}

<style>
  .lv-acct-wrap {
    --lv-acct-line: var(--lv-border);
    --lv-acct-surface: color-mix(in srgb, var(--text) 3%, var(--bg));
    --lv-acct-surface-2: color-mix(in srgb, var(--text) 6%, var(--bg));
    --lv-acct-muted: color-mix(in srgb, var(--text) 62%, transparent);
    --lv-acct-accent: var(--lv-accent, #9b7c53);
    --lv-acct-radius: var(--card-radius, 0px);
    --lv-acct-btn-r: var(--btn-radius, 0px);
    --lv-acct-btn-bw: var(--btn-border-thickness, 1px);
    --lv-acct-badge-r: var(--badge-radius, 2px);
    --lv-acct-media-r: var(--media-radius, 0px);
    --lv-acct-input-r: {{ settings.input_border_radius | default: 0 }}px;
    --lv-acct-input-bw: {{ settings.input_border_thickness | default: 1 }}px;
    --lv-acct-input-line: var(--lv-border);
    --lv-acct-edge-x: clamp(16px, 2.2vw, 24px);
    --lv-acct-cta-w: 160px;
    --lv-acct-cta-h: 40px;
    --lv-acct-sticky-top: 0px;
    --lv-acct-hero-top: 0px;
    --lv-acct-hero-h: 98px;
    font-family: var(--FONT-STACK-BODY, sans-serif);
    color: var(--text);
    background: var(--bg);
    width: 100%;
    box-sizing: border-box;
  }
  .lv-acct-wrap *, .lv-acct-wrap *::before, .lv-acct-wrap *::after { box-sizing: border-box; }
  .lv-acct-inner {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: var(--lv-acct-pt, 40px) var(--outer, 24px) var(--lv-acct-pb, 70px);
  }
  .lv-acct-wrap .lv-crumbs { margin-bottom: 22px; }
  .lv-acct-wrap svg.lv-acct-i { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .lv-acct-eyebrow { display: block; font-size: 11px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--lv-acct-accent); }

  /* ---------- Hero / welcome ---------- */
  .lv-acct-hero {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(14px, 2.5vw, 26px);
    padding: clamp(14px, 2vw, 20px) var(--lv-acct-edge-x);
    background: var(--lv-acct-surface);
    border: 1px solid var(--lv-acct-line);
    border-radius: var(--lv-acct-radius);
    margin-bottom: clamp(18px, 2.6vw, 26px);
    transition: box-shadow .25s ease;
  }
  .lv-acct-hero::before { content: ""; position: absolute; left: -1px; right: -1px; top: -1px; height: 3px; background: var(--lv-acct-accent); border-radius: var(--lv-acct-radius) var(--lv-acct-radius) 0 0; }
  @media (min-width: 861px) {
    .lv-acct-hero {
      position: sticky;
      top: var(--lv-acct-hero-top, var(--lv-acct-sticky-top, 0px));
      z-index: 40;
    }
    .lv-acct-hero.is-stuck {
      box-shadow: 0 12px 28px -16px rgba(0, 0, 0, .18);
    }
  }
  .lv-acct-avatar {
    position: relative;
    overflow: hidden;
    width: clamp(54px, 5.4vw, 70px); height: clamp(54px, 5.4vw, 70px);
    border-radius: 50%;
    display: grid; place-items: center;
    background: var(--bg);
    border: 1px solid var(--lv-acct-accent);
    outline: 1px solid color-mix(in srgb, var(--lv-acct-accent) 35%, transparent);
    outline-offset: 4px;
    font-size: clamp(17px, 2vw, 22px); font-weight: 700; letter-spacing: .08em; color: var(--text);
  }
  .lv-acct-avatar__inner {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
  }
  .lv-acct-avatar__inner__letter {
    position: relative;
    z-index: 1;
    line-height: 1;
  }
  .lv-acct-avatar__inner__media,
  .lv-acct-avatar__inner__media > *,
  .lv-acct-avatar__inner__media img,
  .lv-acct-avatar__inner__media svg {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: cover;
    border-radius: 50%;
    display: block;
  }
  .lv-acct-avatar__inner__media { z-index: 2; }
  .lv-acct-avatar__inner.is-avatar-error .lv-acct-avatar__inner__media { display: none !important; }
  .lv-acct-hero__text { min-width: 0; }
  .lv-acct-hero__title-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: 4px 0 4px; }
  .lv-acct-hero__title { margin: 0; font-family: var(--FONT-STACK-HEADING, sans-serif); font-size: calc(clamp(18px, 2.3vw, 26px) * var(--FONT-ADJUST-HEADING, 1)); font-weight: var(--FONT-WEIGHT-HEADING, 600); letter-spacing: var(--FONT-HEADING-LETTER-SPACING, .1em); text-transform: var(--FONT-HEADING-TRANSFORM, uppercase); line-height: 1.2; overflow-wrap: anywhere; }
  .lv-acct-hero__meta { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 13px; color: var(--lv-acct-muted); }
  .lv-acct-hero__meta span { overflow-wrap: anywhere; }

  /* Luxury VIP Crest Badge */
  .lv-acct-vip-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px 4px 8px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--lv-acct-accent);
    border: 1px solid color-mix(in srgb, var(--lv-acct-accent) 55%, transparent);
    border-radius: var(--lv-acct-badge-r);
    background: linear-gradient(135deg, color-mix(in srgb, var(--lv-acct-accent) 16%, var(--bg)), color-mix(in srgb, var(--lv-acct-accent) 5%, var(--bg)));
    box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 55%, transparent), 0 1px 4px color-mix(in srgb, var(--lv-acct-accent) 14%, transparent);
    white-space: nowrap;
    vertical-align: middle;
  }
  .lv-acct-vip-badge svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
    flex: none;
  }
  .lv-acct-vip-badge--sm {
    padding: 3px 8px 3px 6px;
    font-size: 9.5px;
    gap: 4px;
    letter-spacing: .16em;
  }
  .lv-acct-vip-badge--sm svg { width: 12px; height: 12px; }

  .lv-acct-badge { display: inline-block; padding: 3px 10px; font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--lv-acct-accent); border: 1px solid color-mix(in srgb, var(--lv-acct-accent) 45%, transparent); border-radius: var(--lv-acct-badge-r); background: color-mix(in srgb, var(--lv-acct-accent) 8%, transparent); white-space: nowrap; }
  .lv-acct-signout { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 9px 18px; min-height: var(--lv-acct-cta-h); font-family: var(--TYPE-STACK-BUTTON, inherit); font-size: 11.5px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; line-height: 1.2; color: var(--btn-regular-text); text-decoration: none; border: var(--lv-acct-btn-bw) solid var(--btn-regular-border); border-radius: var(--lv-acct-btn-r); background: var(--btn-regular-bg); transition: border-color .25s, background .25s, color .25s; white-space: nowrap; }
  .lv-acct-signout:hover { color: var(--btn-regular-hover-text); border-color: var(--btn-regular-hover-border); background: var(--btn-regular-hover-bg); }
  .lv-acct-signout svg.lv-acct-i { width: 15px; height: 15px; }
  .lv-acct-signout--sidebar { width: 100%; }

  /* ---------- Layout + sidebar nav ---------- */
  .lv-acct-layout { display: grid; grid-template-columns: clamp(220px, 22vw, 260px) minmax(0, 1fr); gap: clamp(20px, 3vw, 36px); align-items: stretch; }
  .lv-acct-sidebar { min-width: 0; }
  .lv-acct-content { min-width: 0; }
  .lv-acct-nav {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--lv-acct-line);
    background: var(--bg);
    border-radius: var(--lv-acct-radius);
    padding: 8px;
  }
  @media (min-width: 861px) {
    .lv-acct-sidebar { height: 100%; }
    .lv-acct-nav {
      position: sticky;
      top: calc(var(--lv-acct-sticky-top, 0px) + var(--lv-acct-hero-h, 98px) + 20px);
      height: 100%;
      min-height: min(440px, var(--lv-acct-nav-max-h, calc(100vh - var(--lv-acct-sticky-top, 0px) - var(--lv-acct-hero-h, 98px) - 56px)));
      max-height: var(--lv-acct-nav-max-h, calc(100vh - var(--lv-acct-sticky-top, 0px) - var(--lv-acct-hero-h, 98px) - 56px));
    }
  }
  .lv-acct-nav__drawer-head { display: none; }
  .lv-acct-nav__list { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; overflow-y: auto; gap: 2px; }
  .lv-acct-nav__foot { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--lv-acct-line); }

  /* Mobile navigation bar (hidden on desktop) */
  .lv-acct-mobile-bar { display: none; }
  .lv-acct-drawer-backdrop { display: none; }

  .lv-acct-nav__btn {
    position: relative; display: flex; align-items: center; gap: 12px; width: 100%;
    padding: 14px 14px 14px 16px; background: transparent; border: 0; border-radius: var(--lv-acct-radius);
    color: var(--lv-acct-muted); font: inherit; font-size: 12.5px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; text-align: left; cursor: pointer;
    transition: background .2s, color .2s;
  }
  .lv-acct-nav__btn::before { content: ""; position: absolute; left: 0; top: 10px; bottom: 10px; width: 2px; background: var(--lv-acct-accent); transform: scaleY(0); transition: transform .25s; }
  .lv-acct-nav__btn:hover { color: var(--text); background: var(--lv-acct-surface); }
  .lv-acct-nav__btn.is-active { color: var(--text); background: var(--lv-acct-surface-2); }
  .lv-acct-nav__btn.is-active::before { transform: scaleY(1); }
  .lv-acct-nav__btn.is-active svg.lv-acct-i { stroke: var(--lv-acct-accent); }
  .lv-acct-nav__label { flex: 1 1 auto; min-width: 0; }
  .lv-acct-nav__pill { min-width: 22px; padding: 2px 7px; text-align: center; font-size: 10.5px; font-weight: 700; border-radius: var(--lv-acct-badge-r); background: color-mix(in srgb, var(--text) 9%, transparent); color: var(--text); }

  /* ---------- Panels ---------- */
  .lv-acct-panel { display: none; }
  .lv-acct-panel.is-active { display: block; animation: lvAcctFade .35s ease; }
  @keyframes lvAcctFade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .lv-acct-ptitle {
    display: flex; align-items: center; justify-content: space-between; gap: 12px 20px; flex-wrap: wrap;
    padding: 18px var(--lv-acct-edge-x); margin-bottom: 20px;
    background: var(--bg); border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-radius);
  }
  .lv-acct-ptitle h2 { margin: 4px 0 0; font-family: var(--FONT-STACK-HEADING, sans-serif); font-size: calc(clamp(17px, 2vw, 22px) * var(--FONT-ADJUST-HEADING, 1)); font-weight: var(--FONT-WEIGHT-HEADING, 600); letter-spacing: var(--FONT-HEADING-LETTER-SPACING, .12em); text-transform: var(--FONT-HEADING-TRANSFORM, uppercase); }
  .lv-acct-ptitle__actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-wrap: wrap; }
  .lv-acct-view-toggle { display: inline-flex; align-items: stretch; height: var(--lv-acct-cta-h); border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-btn-r); background: var(--bg); overflow: hidden; }
  .lv-acct-view-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    padding: 0 13px; border: 0; background: transparent; color: var(--lv-acct-muted);
    font: inherit; font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; cursor: pointer;
    transition: background .2s, color .2s;
  }
  .lv-acct-view-btn + .lv-acct-view-btn { border-left: 1px solid var(--lv-acct-line); }
  .lv-acct-view-btn:hover { color: var(--text); background: var(--lv-acct-surface); }
  .lv-acct-view-btn.is-active { color: var(--text); background: var(--lv-acct-surface-2); box-shadow: inset 0 -2px 0 var(--lv-acct-accent); }
  .lv-acct-view-btn.is-active svg { stroke: var(--lv-acct-accent); }
  .lv-acct-view-btn svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .lv-acct-link { font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--text); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: color-mix(in srgb, var(--text) 35%, transparent); transition: color .2s; }
  .lv-acct-link:hover { color: var(--lv-acct-accent); }

  .lv-acct-card { background: var(--bg); border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-radius); padding: clamp(16px, 2.2vw, 24px) var(--lv-acct-edge-x); margin-bottom: clamp(16px, 2.4vw, 24px); }
  .lv-acct-card__head { display: flex; align-items: center; justify-content: space-between; gap: 10px 16px; flex-wrap: wrap; margin-bottom: 18px; }
  .lv-acct-card__title { margin: 0; display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .lv-acct-card__title svg.lv-acct-i { stroke: var(--lv-acct-accent); }

  /* ---------- Stats ---------- */
  .lv-acct-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(10px, 1.6vw, 18px); margin-bottom: clamp(16px, 2.4vw, 24px); }
  .lv-acct-stat { display: flex; align-items: center; gap: 16px; padding: clamp(16px, 2vw, 24px); background: var(--lv-acct-surface); border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-radius); min-width: 0; }
  .lv-acct-stat__icon { width: 46px; height: 46px; display: grid; place-items: center; border: 1px solid color-mix(in srgb, var(--lv-acct-accent) 45%, transparent); border-radius: 50%; color: var(--lv-acct-accent); flex: none; }
  .lv-acct-stat__body { min-width: 0; }
  .lv-acct-stat__label { margin: 0 0 4px; font-size: 10.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--lv-acct-muted); }
  .lv-acct-stat__val { margin: 0; font-size: clamp(18px, 2vw, 24px); font-weight: 700; letter-spacing: .04em; line-height: 1.1; overflow-wrap: anywhere; }

  /* ---------- Quick actions ---------- */
  .lv-acct-quick { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(10px, 1.6vw, 16px); margin-bottom: clamp(16px, 2.4vw, 24px); }
  .lv-acct-quick__item { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 18px; background: var(--bg); border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-radius); color: var(--text); text-decoration: none; font: inherit; text-align: left; cursor: pointer; transition: border-color .25s, transform .25s; }
  .lv-acct-quick__item:hover { border-color: var(--lv-acct-accent); transform: translateY(-2px); }
  .lv-acct-quick__item svg.lv-acct-i { stroke: var(--lv-acct-accent); width: 22px; height: 22px; }
  .lv-acct-quick__name { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .lv-acct-quick__sub { font-size: 12.5px; color: var(--lv-acct-muted); line-height: 1.5; margin-top: -4px; }

  /* ---------- Orders ---------- */
  .lv-acct-order { display: grid; grid-template-columns: minmax(0, 1.4fr) auto auto; gap: 14px clamp(16px, 3vw, 36px); align-items: center; padding: clamp(14px, 2vw, 22px) var(--lv-acct-edge-x); border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-radius); background: var(--bg); margin-bottom: 14px; transition: border-color .25s; }
  .lv-acct-order:last-child { margin-bottom: 0; }
  .lv-acct-order:hover { border-color: color-mix(in srgb, var(--text) 40%, transparent); }
  .lv-acct-order__id { min-width: 0; }
  .lv-acct-order__num { display: inline-block; padding: 0; border: 0; background: transparent; font: inherit; font-size: 15px; font-weight: 700; letter-spacing: .08em; color: var(--text); text-decoration: none; cursor: pointer; text-align: left; transition: color .2s; }
  .lv-acct-order__num:hover { color: var(--lv-acct-accent); }
  .lv-acct-order__num:focus-visible { outline: 2px solid var(--lv-acct-accent); outline-offset: 2px; }
  .lv-acct-order__date { margin: 3px 0 10px; font-size: 12.5px; color: var(--lv-acct-muted); }
  .lv-acct-order__thumbs { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .lv-acct-order__thumb { width: 52px; height: 52px; object-fit: cover; border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-media-r); background: var(--lv-acct-surface); }
  .lv-acct-order__more { font-size: 12px; font-weight: 600; color: var(--lv-acct-muted); }
  .lv-acct-order__status { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
  .lv-acct-order__buy { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; text-align: right; }
  .lv-acct-order__total { font-size: 16px; font-weight: 700; letter-spacing: .04em; }
  .lv-acct-pill { display: inline-block; padding: 3px 10px; font-size: 10.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-badge-r); background: var(--lv-acct-surface); color: var(--text); white-space: nowrap; }
  .lv-acct-pill--paid, .lv-acct-pill--fulfilled { color: #2d6a4f; border-color: color-mix(in srgb, #2d6a4f 35%, transparent); background: color-mix(in srgb, #2d6a4f 9%, transparent); }
  .lv-acct-pill--pending, .lv-acct-pill--partially_paid, .lv-acct-pill--partial, .lv-acct-pill--partially_fulfilled, .lv-acct-pill--authorized, .lv-acct-pill--in_progress, .lv-acct-pill--scheduled, .lv-acct-pill--on_hold { color: #a16207; border-color: color-mix(in srgb, #b45309 38%, transparent); background: color-mix(in srgb, #d97706 11%, transparent); }
  .lv-acct-pill--unfulfilled { color: var(--lv-acct-muted); border-color: var(--lv-acct-line); background: var(--lv-acct-surface); }
  .lv-acct-pill--cancelled, .lv-acct-pill--refunded, .lv-acct-pill--partially_refunded, .lv-acct-pill--voided, .lv-acct-pill--restocked { color: #9f2d2d; border-color: color-mix(in srgb, #9f2d2d 35%, transparent); background: color-mix(in srgb, #9f2d2d 9%, transparent); }
  .lv-acct-pill--tracking { color: var(--lv-acct-accent); border-color: color-mix(in srgb, var(--lv-acct-accent) 35%, transparent); background: color-mix(in srgb, var(--lv-acct-accent) 8%, transparent); }
  .lv-acct-refresh-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 9px 14px; min-height: var(--lv-acct-cta-h); font-family: var(--TYPE-STACK-BUTTON, inherit); font-size: 11px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; line-height: 1.2; border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-btn-r); background: var(--bg); color: var(--text); cursor: pointer; transition: border-color .2s, color .2s; white-space: nowrap; }
  .lv-acct-refresh-btn:hover { border-color: var(--lv-acct-accent); color: var(--lv-acct-accent); }
  .lv-acct-refresh-btn:disabled { opacity: .65; cursor: wait; }
  .lv-acct-refresh-btn svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 1.8; }
  .lv-acct-refresh-btn.is-loading svg { animation: lvAcctSpin .85s linear infinite; }
  @keyframes lvAcctSpin { to { transform: rotate(360deg); } }

  /* ---------- Addresses / concierge ---------- */
  .lv-acct-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr)); gap: clamp(12px, 1.8vw, 18px); }
  .lv-acct-grid--addresses { grid-template-columns: repeat(auto-fill, minmax(min(290px, 100%), 1fr)); }
  .lv-acct-tile { position: relative; padding: 20px; background: var(--lv-acct-surface); border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-radius); font-size: 13.5px; line-height: 1.65; }
  .lv-acct-grid--addresses .lv-acct-tile { display: flex; flex-direction: column; }
  .lv-acct-tile__main { flex: 1 1 auto; min-width: 0; }
  .lv-acct-tile--default { border-color: var(--lv-acct-accent); background: color-mix(in srgb, var(--lv-acct-accent) 5%, var(--bg)); }
  .lv-acct-tile__top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
  .lv-acct-tile address { font-style: normal; color: var(--lv-acct-muted); }
  .lv-acct-tile__phone { margin: 8px 0 0; font-size: 12.5px; color: var(--lv-acct-muted); }
  .lv-acct-tile__icon { color: var(--lv-acct-accent); margin-bottom: 12px; }
  .lv-acct-tile__title { margin: 0 0 6px; font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .lv-acct-tile__text { margin: 0 0 14px; font-size: 13px; color: var(--lv-acct-muted); }
  .lv-acct-grid--addresses[data-view="list"] { grid-template-columns: minmax(0, 1fr); gap: 14px; }
  .lv-acct-grid--addresses[data-view="list"] .lv-acct-tile { flex-direction: row; align-items: center; justify-content: space-between; gap: 16px clamp(16px, 3vw, 36px); padding: 20px var(--lv-acct-edge-x); }
  .lv-acct-grid--addresses[data-view="list"] .lv-acct-tile__top { justify-content: flex-start; gap: 10px; margin-bottom: 6px; }
  .lv-acct-grid--addresses[data-view="list"] .lv-acct-tile address p { margin: 0; }
  .lv-acct-grid--addresses[data-view="list"] .lv-acct-tile__actions { margin-top: 0; padding-top: 0; border-top: 0; flex-shrink: 0; }

  /* ---------- Empty ---------- */
  .lv-acct-empty { text-align: center; padding: clamp(32px, 5vw, 56px) 20px; border: 1px dashed var(--lv-acct-line); border-radius: var(--lv-acct-radius); background: var(--lv-acct-surface); }
  .lv-acct-empty svg.lv-acct-i { display: block; width: 34px; height: 34px; stroke: var(--lv-acct-accent); margin: 0 auto 14px; }
  .lv-acct-empty__title { margin: 0 0 8px; font-size: 15px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .lv-acct-empty__text { margin: 0 auto 22px; max-width: 440px; font-size: 13.5px; line-height: 1.65; color: var(--lv-acct-muted); }
  .lv-acct-muted-text { margin: 0 0 14px; font-size: 13.5px; color: var(--lv-acct-muted); }

  /* ---------- Buttons / perks ---------- */
  .lv-acct-btn { display: inline-flex; align-items: center; justify-content: center; padding: 12px 26px; font-family: var(--TYPE-STACK-BUTTON, inherit); font-size: 12.5px; line-height: 1.2; max-width: 100%; text-align: center; }
  .lv-acct-btn--sm { padding: 9px 18px; min-height: 36px; font-size: 11.5px; letter-spacing: .12em; }
  @media (min-width: 641px) {
    .lv-acct-ptitle .lv-acct-btn,
    .lv-acct-ptitle .lv-acct-refresh-btn,
    .lv-acct-order__buy .lv-acct-btn {
      min-width: var(--lv-acct-cta-w);
      min-height: var(--lv-acct-cta-h);
      justify-content: center;
    }
  }
  .lv-acct-btn--ghost { background: transparent; color: var(--text); border: var(--lv-acct-btn-bw) solid var(--lv-acct-input-line); }
  .lv-acct-actions { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
  .lv-acct-pagination { margin-top: 24px; text-align: center; }
  .lv-acct-perks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-radius); background: var(--lv-acct-surface); }
  .lv-acct-perk { display: flex; align-items: center; justify-content: center; gap: 12px; padding: 18px 14px; font-size: 11.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; text-align: left; }
  .lv-acct-perk + .lv-acct-perk { border-left: 1px solid var(--lv-acct-line); }
  .lv-acct-perk svg.lv-acct-i { stroke: var(--lv-acct-accent); }

  /* ---------- Modals ---------- */
  dialog.lv-acct-modal:not([open]) {
    display: none;
  }
  .lv-acct-modal {
    width: min(540px, calc(100vw - 32px));
    max-height: calc(100vh - 48px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--lv-acct-line);
    border-radius: var(--lv-acct-radius);
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.22);
    overflow: hidden;
  }
  .lv-acct-modal::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .lv-acct-modal__inner {
    padding: clamp(20px, 3.5vw, 32px);
    max-height: calc(100vh - 60px);
    overflow-y: auto;
  }
  .lv-acct-modal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--lv-acct-line);
  }
  .lv-acct-modal__title {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .lv-acct-modal__close {
    background: transparent;
    border: 0;
    color: var(--lv-acct-muted);
    font-size: 26px;
    cursor: pointer;
    line-height: 1;
    padding: 2px 8px;
    transition: color .2s;
  }
  .lv-acct-modal__close:hover {
    color: var(--text);
  }
  .lv-acct-modal__form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .lv-acct-modal__foot {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 14px;
    padding-top: 16px;
    border-top: 1px solid var(--lv-acct-line);
  }

  /* ---------- Order Details Modal ---------- */
  .lv-acct-modal--order { width: min(780px, calc(100vw - 32px)); }
  .lv-acct-om__head { align-items: flex-start; }
  .lv-acct-om__head-info { min-width: 0; }
  .lv-acct-om__placed { margin: 6px 0 0; font-size: 12.5px; color: var(--lv-acct-muted); }
  .lv-acct-om__statuses { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 18px; }
  .lv-acct-om__notice { padding: 12px 16px; margin-bottom: 18px; border-radius: var(--lv-acct-radius); border: 1px solid color-mix(in srgb, #9f2d2d 30%, transparent); background: color-mix(in srgb, #9f2d2d 7%, transparent); color: #7f1d1d; font-size: 13px; line-height: 1.5; }
  .lv-acct-om__notice-reason { margin: 4px 0 0; }
  .lv-acct-om__section { margin-bottom: 20px; padding-bottom: 18px; border-bottom: 1px solid var(--lv-acct-line); }
  .lv-acct-om__subhead { margin: 0 0 12px; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--lv-acct-muted); }
  .lv-acct-om__ships { display: flex; flex-direction: column; gap: 10px; }
  .lv-acct-om__ship-card { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-radius); background: var(--lv-acct-surface); }
  .lv-acct-om__ship-title { margin: 0; font-size: 13.5px; font-weight: 700; }
  .lv-acct-om__carrier { font-weight: 500; color: var(--lv-acct-muted); }
  .lv-acct-om__ship-date, .lv-acct-om__ship-track { margin: 4px 0 0; font-size: 12.5px; color: var(--lv-acct-muted); }
  .lv-acct-om__ship-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .lv-acct-om__mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; color: var(--text); }
  .lv-acct-om__muted-note { margin: 0; font-size: 13px; color: var(--lv-acct-muted); }
  .lv-acct-om__items { display: flex; flex-direction: column; gap: 12px; }
  .lv-acct-om__item { display: grid; grid-template-columns: 68px minmax(0, 1fr) auto; gap: 14px; align-items: start; padding: 12px; border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-radius); background: var(--bg); }
  .lv-acct-om__thumb-link { display: block; }
  .lv-acct-om__thumb { display: block; width: 68px; height: 68px; object-fit: cover; border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-media-r); background: var(--lv-acct-surface); }
  .lv-acct-om__thumb--empty { display: grid; place-items: center; font-size: 12px; font-weight: 700; letter-spacing: .12em; color: var(--lv-acct-muted); }
  .lv-acct-om__item-body { min-width: 0; }
  .lv-acct-om__item-title { display: inline-block; font-size: 14px; font-weight: 600; color: var(--text); text-decoration: none; margin-bottom: 4px; overflow-wrap: anywhere; }
  .lv-acct-om__item-title:hover { color: var(--lv-acct-accent); }
  .lv-acct-om__item-meta, .lv-acct-om__item-ful { margin: 2px 0 0; font-size: 12.5px; color: var(--lv-acct-muted); }
  .lv-acct-om__props { margin-top: 6px; display: flex; flex-direction: column; gap: 3px; font-size: 12.5px; color: var(--lv-acct-muted); }
  .lv-acct-om__prop-key { font-weight: 600; color: var(--text); }
  .lv-acct-om__item-discounts { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 6px; }
  .lv-acct-om__disc-tag { display: inline-block; padding: 2px 8px; font-size: 11px; border-radius: var(--lv-acct-badge-r); background: color-mix(in srgb, #2d6a4f 10%, transparent); color: #2d6a4f; font-weight: 600; }
  .lv-acct-om__item-price { text-align: right; font-size: 13px; white-space: nowrap; }
  .lv-acct-om__unit-price { color: var(--lv-acct-muted); font-size: 12px; display: flex; justify-content: flex-end; gap: 6px; align-items: baseline; }
  .lv-acct-om__line-total { margin-top: 4px; font-size: 14px; display: flex; justify-content: flex-end; gap: 6px; align-items: baseline; }
  .lv-acct-om__unit-price s, .lv-acct-om__line-total s { opacity: .65; }
  .lv-acct-om__totals { display: flex; flex-direction: column; gap: 8px; padding: 14px 16px; background: var(--lv-acct-surface); border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-radius); font-size: 13.5px; }
  .lv-acct-om__tot-row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; color: var(--lv-acct-muted); }
  .lv-acct-om__tot-row--discount span:last-child { color: #2d6a4f; font-weight: 600; }
  .lv-acct-om__tot-row--refund span:last-child { color: #9f2d2d; font-weight: 600; }
  .lv-acct-om__tot-row--grand, .lv-acct-om__tot-row--net { padding-top: 10px; margin-top: 2px; border-top: 1px solid var(--lv-acct-line); color: var(--text); font-weight: 700; font-size: 15px; }
  .lv-acct-om__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-bottom: 16px; }
  .lv-acct-om__box { padding: 14px 16px; border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-radius); background: var(--lv-acct-surface); font-size: 13px; line-height: 1.6; }
  .lv-acct-om__box--full { margin-bottom: 16px; }
  .lv-acct-om__addr p { margin: 0; color: var(--lv-acct-muted); }
  .lv-acct-om__addr-phone { margin-top: 6px !important; }
  .lv-acct-om__txs { display: flex; flex-direction: column; gap: 10px; }
  .lv-acct-om__tx-top { display: flex; justify-content: space-between; gap: 10px; font-weight: 600; }
  .lv-acct-om__tx-meta { margin: 2px 0 0; font-size: 12px; color: var(--lv-acct-muted); }
  .lv-acct-om__contact p { margin: 0 0 4px; color: var(--lv-acct-muted); overflow-wrap: anywhere; }
  .lv-acct-om__contact p:last-child { margin-bottom: 0; }
  .lv-acct-om__contact-label { font-weight: 600; color: var(--text); }
  .lv-acct-om__note { margin: 0; color: var(--lv-acct-muted); overflow-wrap: anywhere; }
  .lv-acct-field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  @media (max-width: 580px) {
    .lv-acct-field-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .lv-acct-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--lv-acct-muted);
    text-align: left;
  }
  .lv-acct-field input, .lv-acct-field select {
    width: 100%;
    height: 44px;
    padding: 0 12px;
    font: inherit;
    font-size: 13.5px;
    font-weight: 500;
    text-transform: none;
    letter-spacing: normal;
    color: var(--text);
    background: var(--lv-acct-surface);
    border: 1px solid var(--lv-acct-line);
    border-radius: var(--lv-acct-radius);
    outline: none;
    transition: border-color .2s;
    box-sizing: border-box;
  }
  .lv-acct-field input:focus, .lv-acct-field select:focus {
    border-color: var(--text);
  }
  .lv-acct-check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 500;
    text-transform: none;
    cursor: pointer;
    color: var(--text);
    margin-top: 4px;
  }
  .lv-acct-tile__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--lv-acct-line);
  }
  .lv-acct-toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    padding: 12px 22px;
    background: var(--text);
    color: var(--bg);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .04em;
    border-radius: var(--lv-acct-radius);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    z-index: 999999;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity .3s, transform .3s;
    pointer-events: none;
  }
  .lv-acct-toast.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---------- Guest ---------- */
  .lv-acct-guest { max-width: 680px; margin: 0 auto; text-align: center; background: var(--lv-acct-surface); border: 1px solid var(--lv-acct-line); border-radius: var(--lv-acct-radius); padding: clamp(32px, 6vw, 56px) clamp(18px, 4vw, 40px); position: relative; }
  .lv-acct-guest::before { content: ""; position: absolute; left: -1px; right: -1px; top: -1px; height: 3px; background: var(--lv-acct-accent); }
  .lv-acct-guest__title { margin: 8px 0 12px; font-size: clamp(20px, 3vw, 28px); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .lv-acct-guest__desc { margin: 0 auto 28px; max-width: 480px; font-size: 14px; line-height: 1.7; color: var(--lv-acct-muted); }
  .lv-acct-guest__actions { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-bottom: 34px; }
  .lv-acct-guest__perks { border-top: 1px solid var(--lv-acct-line); padding-top: 26px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .lv-acct-guest-perk { font-size: 11.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .lv-acct-guest-perk span { display: block; margin-top: 4px; font-size: 12px; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--lv-acct-muted); }

  /* ================= Tablet ================= */
  @media (max-width: 1024px) {
    .lv-acct-quick { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lv-acct-order { grid-template-columns: minmax(0, 1fr) auto; }
    .lv-acct-order__status { grid-column: 2; grid-row: 1; align-items: flex-end; }
    .lv-acct-order__buy { grid-column: 1 / -1; flex-direction: row; justify-content: space-between; align-items: center; border-top: 1px solid var(--lv-acct-line); padding-top: 14px; text-align: left; }
  }

  /* ================= Tablet portrait + mobile: slide-out sidebar drawer ================= */
  @media (max-width: 860px) {
    body.lv-acct-drawer-lock { overflow: hidden; }
    .lv-acct-layout { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .lv-acct-sidebar { display: contents; }

    .lv-acct-mobile-bar {
      position: sticky;
      top: var(--lv-acct-sticky-top, 0px);
      z-index: 40;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 14px;
      background: var(--bg);
      border: 1px solid var(--lv-acct-line);
      border-radius: var(--lv-acct-radius);
      box-shadow: 0 8px 20px -16px rgba(0, 0, 0, .14);
    }
    .lv-acct-mobile-bar__info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .lv-acct-mobile-bar__label { font-size: 9.5px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--lv-acct-accent); }
    .lv-acct-mobile-bar__current { font-size: 13.5px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .lv-acct-mobile-toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      min-height: 36px;
      border: var(--lv-acct-btn-bw) solid var(--lv-acct-line);
      border-radius: var(--lv-acct-btn-r);
      background: var(--lv-acct-surface);
      color: var(--text);
      font: inherit;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      cursor: pointer;
      flex: none;
      transition: border-color .2s, background .2s;
    }
    .lv-acct-mobile-toggle:hover { border-color: var(--lv-acct-accent); background: var(--lv-acct-surface-2); }
    .lv-acct-mobile-toggle svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

    .lv-acct-drawer-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 6999;
      background: rgba(0, 0, 0, .48);
      backdrop-filter: blur(2px);
      opacity: 0;
      pointer-events: none;
      transition: opacity .26s ease;
    }
    .lv-acct-drawer-backdrop[hidden] { display: none; }
    .lv-acct-drawer-backdrop.is-open { opacity: 1; pointer-events: auto; }

    .lv-acct-nav {
      position: fixed;
      inset: 0 auto 0 0;
      width: min(310px, 85vw);
      height: 100vh;
      height: 100dvh;
      max-height: 100dvh;
      z-index: 7000;
      padding: 0;
      border: 0;
      border-right: 1px solid var(--lv-acct-line);
      border-radius: 0;
      background: var(--bg);
      transform: translateX(-105%);
      visibility: hidden;
      pointer-events: none;
      transition: transform .28s cubic-bezier(.16, 1, .3, 1), visibility .28s;
      box-shadow: 12px 0 36px rgba(0, 0, 0, .2);
    }
    .lv-acct-nav.is-open {
      transform: translateX(0);
      visibility: visible;
      pointer-events: auto;
    }
    .lv-acct-nav__drawer-head {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 18px 16px;
      background: var(--lv-acct-surface);
      border-bottom: 1px solid var(--lv-acct-line);
      position: relative;
      flex: none;
    }
    .lv-acct-nav__drawer-head::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px; background: var(--lv-acct-accent); }
    .lv-acct-nav__drawer-avatar {
      position: relative;
      overflow: hidden;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: var(--bg);
      border: 1px solid var(--lv-acct-accent);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: .08em;
      color: var(--text);
      flex: none;
    }
    .lv-acct-nav__drawer-meta { flex: 1 1 auto; min-width: 0; }
    .lv-acct-nav__drawer-name { margin: 0 0 6px; font-size: 12px; font-weight: 700; letter-spacing: .08em; line-height: 1.3; text-transform: uppercase; color: var(--text); overflow-wrap: anywhere; }
    .lv-acct-nav__drawer-close {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border: 1px solid var(--lv-acct-line);
      border-radius: var(--lv-acct-btn-r);
      background: var(--bg);
      color: var(--text);
      cursor: pointer;
      flex: none;
      padding: 0;
      transition: border-color .2s, background .2s;
    }
    .lv-acct-nav__drawer-close:hover { border-color: var(--lv-acct-accent); background: var(--lv-acct-surface-2); }
    .lv-acct-nav__drawer-close svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .lv-acct-nav__list { padding: 12px 10px; }
    .lv-acct-nav__foot { padding: 12px 14px calc(16px + env(safe-area-inset-bottom, 0px)); }
    .lv-acct-nav__btn { padding: 13px 14px 13px 16px; }
  }

  /* ================= Mobile ================= */
  @media (max-width: 640px) {
    .lv-acct-hero { grid-template-columns: auto minmax(0, 1fr); align-items: center; padding: 14px 16px; gap: 14px; }
    .lv-acct-avatar { outline-offset: 3px; }
    .lv-acct-ptitle { align-items: flex-start; }
    .lv-acct-ptitle__actions { width: 100%; justify-content: space-between; gap: 8px; }
    .lv-acct-view-toggle { height: 36px; }
    .lv-acct-view-btn { padding: 0 10px; font-size: 10.5px; gap: 5px; }
    .lv-acct-ptitle .lv-acct-btn,
    .lv-acct-ptitle .lv-acct-refresh-btn { min-height: 36px; padding: 8px 14px; font-size: 11px; }
    .lv-acct-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .lv-acct-stat { flex-direction: column; align-items: flex-start; gap: 10px; padding: 14px 12px; }
    .lv-acct-stat__icon { width: 34px; height: 34px; }
    .lv-acct-stat__icon svg.lv-acct-i { width: 16px; height: 16px; }
    .lv-acct-stat__label { font-size: 9.5px; letter-spacing: .1em; }
    .lv-acct-stat__val { font-size: 16px; }
    .lv-acct-quick__item { padding: 14px; }
    .lv-acct-quick__sub { display: none; }
    .lv-acct-order { grid-template-columns: minmax(0, 1fr); }
    .lv-acct-order__status { grid-column: auto; grid-row: auto; flex-direction: row; flex-wrap: wrap; align-items: center; }
    .lv-acct-order__buy { flex-direction: column; align-items: stretch; gap: 12px; text-align: center; }
    .lv-acct-order__buy .btn { width: 100%; }
    .lv-acct-order__thumb { width: 46px; height: 46px; }
    .lv-acct-grid--addresses[data-view="list"] .lv-acct-tile { flex-direction: column; align-items: stretch; gap: 14px; }
    .lv-acct-grid--addresses[data-view="list"] .lv-acct-tile__actions { margin-top: 2px; padding-top: 12px; border-top: 1px solid var(--lv-acct-line); justify-content: flex-start; }
    .lv-acct-perks { grid-template-columns: minmax(0, 1fr); }
    .lv-acct-perk { justify-content: flex-start; padding: 14px 16px; }
    .lv-acct-perk + .lv-acct-perk { border-left: 0; border-top: 1px solid var(--lv-acct-line); }
    .lv-acct-actions .btn, .lv-acct-guest__actions .btn { width: 100%; }
    .lv-acct-guest__perks { grid-template-columns: minmax(0, 1fr); }
    .lv-acct-om__grid { grid-template-columns: minmax(0, 1fr); }
    .lv-acct-om__item { grid-template-columns: 56px minmax(0, 1fr); }
    .lv-acct-om__thumb { width: 56px; height: 56px; }
    .lv-acct-om__item-price { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; text-align: left; padding-top: 8px; border-top: 1px solid var(--lv-acct-line); }
    .lv-acct-om__unit-price, .lv-acct-om__line-total { justify-content: flex-start; margin-top: 0; }
  }
  @media (max-width: 380px) {
    .lv-acct-stat__val { font-size: 14px; }
    .lv-acct-nav__btn { padding: 11px 11px; font-size: 11.5px; }
  }
</style>

<div
  class="lv-acct-wrap color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  data-section-id="{{ section.id }}"
  style="--lv-acct-pt: {{ section.settings.padding_top | default: 40 }}px; --lv-acct-pb: {{ section.settings.padding_bottom | default: 70 }}px;"
>
  <div class="lv-acct-inner">
    {%- assign acct_breadcrumb_label = 'customer.account.title' | t -%}
    {% render 'breadcrumb', current: acct_breadcrumb_label %}

    {% if customer %}
      {%- assign member_fallback = 'customer.account.member_fallback' | t -%}
      {%- assign vip_badge_label = 'customer.account.vip_short' | t -%}
      {%- capture vip_crown_svg -%}
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="3.8" r="1.15"/><circle cx="2.5" cy="7.4" r="0.95"/><circle cx="21.5" cy="7.4" r="0.95"/><path d="M4 17.2L2.4 8.5l5.4 3.7L12 5.2l4.2 7L21.6 8.5 20 17.2H4z"/><rect x="4" y="18.6" width="16" height="1.8"/></svg>
      {%- endcapture -%}
      <!-- ================= LOGGED IN ================= -->
      <header class="lv-acct-hero">
        <div class="lv-acct-avatar" aria-hidden="true">{%- render 'header-account-avatar', customer_obj: customer, fallback_text: initials, wrapper_class: 'lv-acct-avatar__inner' -%}</div>
        <div class="lv-acct-hero__text">
          <span class="lv-acct-eyebrow">{{ 'customer.account.welcome_back' | t }}</span>
          <div class="lv-acct-hero__title-row">
            <h1 class="lv-acct-hero__title">{{ customer.name | default: member_fallback }}</h1>
            <span class="lv-acct-vip-badge" title="{{ vip_badge_label }}" aria-label="{{ vip_badge_label }}">{{ vip_crown_svg }}<span>{{ vip_badge_label }}</span></span>
          </div>
          <p class="lv-acct-hero__meta"><span>{{ customer.email | escape }}</span></p>
        </div>
      </header>

      <div class="lv-acct-layout" data-lv-acct-dashboard>
        <div class="lv-acct-mobile-bar">
          <div class="lv-acct-mobile-bar__info">
            <span class="lv-acct-mobile-bar__label">{{ 'customer.account.mobile_dashboard' | t }}</span>
            <span class="lv-acct-mobile-bar__current" data-lv-acct-mobile-current>{{ 'customer.account.nav_overview' | t }}</span>
          </div>
          <button
            type="button"
            class="lv-acct-mobile-toggle"
            data-lv-acct-drawer-open
            aria-expanded="false"
            aria-controls="LvAcctSidebarNav"
            aria-label="{{ 'customer.account.open_nav' | t }}"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="16" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            <span>{{ 'customer.account.menu' | t }}</span>
          </button>
        </div>

        <div class="lv-acct-drawer-backdrop" data-lv-acct-drawer-close hidden></div>

        <aside class="lv-acct-sidebar">
          <nav class="lv-acct-nav" id="LvAcctSidebarNav" aria-label="{{ 'customer.account.nav_aria' | t }}">
            <div class="lv-acct-nav__drawer-head">
              <div class="lv-acct-nav__drawer-avatar" aria-hidden="true">{%- render 'header-account-avatar', customer_obj: customer, fallback_text: initials, wrapper_class: 'lv-acct-avatar__inner' -%}</div>
              <div class="lv-acct-nav__drawer-meta">
                <p class="lv-acct-nav__drawer-name">{{ customer.name | default: member_fallback }}</p>
                <span class="lv-acct-vip-badge lv-acct-vip-badge--sm" title="{{ vip_badge_label }}" aria-label="{{ vip_badge_label }}">{{ vip_crown_svg }}<span>{{ vip_badge_label }}</span></span>
              </div>
              <button type="button" class="lv-acct-nav__drawer-close" data-lv-acct-drawer-close aria-label="{{ 'customer.account.close_nav' | t }}">
                <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>

            <div class="lv-acct-nav__list" role="tablist" aria-label="{{ 'customer.account.sections_aria' | t }}">
              <button type="button" class="lv-acct-nav__btn is-active" data-tab-target="overview" role="tab" aria-selected="true">
                <svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                <span class="lv-acct-nav__label">{{ 'customer.account.nav_overview' | t }}</span>
              </button>
              <button type="button" class="lv-acct-nav__btn" data-tab-target="orders" role="tab" aria-selected="false">
                <svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                <span class="lv-acct-nav__label">{{ 'customer.account.nav_orders' | t }}</span>
                <span class="lv-acct-nav__pill" data-lv-acct-orders-pill>{{ orders_total }}</span>
              </button>
              <button type="button" class="lv-acct-nav__btn" data-tab-target="addresses" role="tab" aria-selected="false">
                <svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span class="lv-acct-nav__label">{{ 'customer.account.nav_addresses' | t }}</span>
                <span class="lv-acct-nav__pill">{{ customer.addresses_count }}</span>
              </button>
              {% if section.settings.show_wishlist %}
                <button type="button" class="lv-acct-nav__btn" data-tab-target="wishlist" role="tab" aria-selected="false">
                  <svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  <span class="lv-acct-nav__label">{{ 'customer.account.nav_saved' | t }}</span>
                </button>
              {% endif %}
              <button type="button" class="lv-acct-nav__btn" data-tab-target="concierge" role="tab" aria-selected="false">
                <svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span class="lv-acct-nav__label">{{ 'customer.account.nav_concierge' | t }}</span>
              </button>
            </div>

            <div class="lv-acct-nav__foot">
              <a href="{{ routes.account_logout_url }}" class="lv-acct-signout lv-acct-signout--sidebar">
                <svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span>{{ 'customer.log_out' | t }}</span>
              </a>
            </div>
          </nav>
        </aside>

        <main class="lv-acct-content">

          <!-- OVERVIEW -->
          <div class="lv-acct-panel is-active" data-tab-panel="overview" role="tabpanel">
            <div class="lv-acct-stats">
              <div class="lv-acct-stat">
                <span class="lv-acct-stat__icon"><svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg></span>
                <div class="lv-acct-stat__body"><p class="lv-acct-stat__label">{{ 'customer.account.stat_orders' | t }}</p><p class="lv-acct-stat__val" data-lv-acct-stat-orders>{{ orders_total }}</p></div>
              </div>
              <div class="lv-acct-stat">
                <span class="lv-acct-stat__icon"><svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M14.5 9.2c-.5-.8-1.4-1.2-2.5-1.2-1.4 0-2.5.8-2.5 2s1 1.7 2.5 2 2.5.8 2.5 2-1.1 2-2.5 2c-1.1 0-2-.4-2.5-1.2M12 6.5V8m0 8v1.5"/></svg></span>
                <div class="lv-acct-stat__body"><p class="lv-acct-stat__label">{{ 'customer.account.stat_total_spent' | t }}</p><p class="lv-acct-stat__val" data-lv-acct-stat-spent>{{ spent_total | money }}</p></div>
              </div>
              <div class="lv-acct-stat">
                <span class="lv-acct-stat__icon"><svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18M9 3l3 18M15 3l-3 18"/></svg></span>
                <div class="lv-acct-stat__body"><p class="lv-acct-stat__label">{{ 'customer.account.stat_status' | t }}</p><p class="lv-acct-stat__val"><span class="lv-acct-vip-badge lv-acct-vip-badge--sm" title="{{ vip_badge_label }}" aria-label="{{ vip_badge_label }}">{{ vip_crown_svg }}<span>{{ vip_badge_label }}</span></span></p></div>
              </div>
            </div>

            <div class="lv-acct-quick">
              <a class="lv-acct-quick__item" href="{{ routes.all_products_collection_url }}">
                <svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18M9 3l3 18M15 3l-3 18"/></svg>
                <span class="lv-acct-quick__name">{{ 'customer.account.quick_shop' | t }}</span><span class="lv-acct-quick__sub">{{ 'customer.account.quick_shop_sub' | t }}</span>
              </a>
              <button type="button" class="lv-acct-quick__item" data-switch-to="orders">
                <svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="6" width="14" height="10"/><path d="M15 9h4l3 3v4h-7z"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
                <span class="lv-acct-quick__name">{{ 'customer.account.quick_track' | t }}</span><span class="lv-acct-quick__sub">{{ 'customer.account.quick_track_sub' | t }}</span>
              </button>
              <a class="lv-acct-quick__item" href="{{ size_guide_url }}">
                <svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/></svg>
                <span class="lv-acct-quick__name">{{ 'customer.account.quick_size' | t }}</span><span class="lv-acct-quick__sub">{{ 'customer.account.quick_size_sub' | t }}</span>
              </a>
              <a class="lv-acct-quick__item" href="mailto:{{ concierge_email }}">
                <svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14"/><polyline points="3 7 12 13 21 7"/></svg>
                <span class="lv-acct-quick__name">{{ 'customer.account.quick_contact' | t }}</span><span class="lv-acct-quick__sub">{{ 'customer.account.quick_contact_sub' | t }}</span>
              </a>
            </div>

            <div class="lv-acct-card">
              <div class="lv-acct-card__head">
                <h3 class="lv-acct-card__title"><svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg>{{ 'customer.account.latest_order' | t }}</h3>
                {% if customer.orders.size > 0 %}<a href="#orders" class="lv-acct-link" data-switch-to="orders">{{ 'customer.account.view_all' | t }}</a>{% endif %}
              </div>
              <div data-lv-acct-latest-order>
                {% if customer.orders.size > 0 %}
                  {% assign order = customer.orders.first %}
                  {% render 'account-order-row', order: order %}
                {% else %}
                  <div class="lv-acct-empty">
                    <svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg>
                    <p class="lv-acct-empty__title">{{ 'customer.orders.none_title' | t }}</p>
                    <p class="lv-acct-empty__text">{{ 'customer.orders.none_overview_text' | t }}</p>
                    <a href="{{ routes.all_products_collection_url }}" class="btn btn-sliding-hover lv-acct-btn">{{ 'customer.account.explore_collection' | t }}</a>
                  </div>
                {% endif %}
              </div>
            </div>

            <div class="lv-acct-card">
              <div class="lv-acct-card__head">
                <h3 class="lv-acct-card__title"><svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>{{ 'customer.account.delivery_address' | t }}</h3>
                <a href="#addresses" class="lv-acct-link" data-switch-to="addresses">{{ 'customer.account.manage' | t }}</a>
              </div>
              {% if customer.default_address %}
                <div class="lv-acct-tile lv-acct-tile--default">
                  <div class="lv-acct-tile__top"><strong>{{ customer.default_address.name }}</strong><span class="lv-acct-badge">{{ 'customer.addresses.default_pill' | t }}</span></div>
                  <address>{{ customer.default_address | format_address }}</address>
                </div>
              {% else %}
                <p class="lv-acct-muted-text">{{ 'customer.addresses.none_default' | t }}</p>
                <button type="button" class="btn btn-sliding-hover lv-acct-btn lv-acct-btn--sm" data-lv-acct-open-modal="LvAcctAddAddressModal">{{ 'customer.addresses.add_new' | t }}</button>
              {% endif %}
            </div>

            <div class="lv-acct-perks">
              <div class="lv-acct-perk"><svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>{{ 'customer.account.perk_waterproof' | t }}</span></div>
              <div class="lv-acct-perk"><svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 14 14"/></svg><span>{{ 'customer.account.perk_returns' | t }}</span></div>
              <div class="lv-acct-perk"><svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg><span>{{ 'customer.account.perk_shipping' | t }}</span></div>
            </div>
          </div>

          <!-- ORDERS -->
          <div class="lv-acct-panel" data-tab-panel="orders" role="tabpanel">
            <div class="lv-acct-ptitle">
              <div><span class="lv-acct-eyebrow">{{ 'customer.orders.history_eyebrow' | t }}</span><h2 data-lv-acct-orders-heading>{{ 'customer.orders.my_orders_count' | t: count: orders_total }}</h2></div>
              <button type="button" class="lv-acct-refresh-btn" data-lv-acct-refresh-orders>
                <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                <span>{{ 'customer.orders.refresh_status' | t }}</span>
              </button>
            </div>
            <div data-lv-acct-orders-list>
              {% if customer.orders.size > 0 %}
                {% paginate customer.orders by 15 %}
                  {% for order in customer.orders %}
                    {% render 'account-order-row', order: order %}
                  {% endfor %}
                  {% if paginate.pages > 1 %}<div class="lv-acct-pagination">{{ paginate | default_pagination }}</div>{% endif %}
                {% endpaginate %}
              {% else %}
                <div class="lv-acct-empty">
                  <svg class="lv-acct-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg>
                  <p class="lv-acct-empty__title">{{ 'customer.orders.none_title' | t }}</p>
                  <p class="lv-acct-empty__text">{{ 'customer.orders.none_list_text' | t }}</p>
                  <a href="{{ routes.all_products_collection_url }}" class="btn btn-sliding-hover lv-acct-btn">{{ 'customer.account.explore_collections' | t }}</a>
                </div>
              {% endif %}
            </div>
          </div>

          <!-- ADDRESSES -->
          <div class="lv-acct-panel" data-tab-panel="addresses" role="tabpanel">
            <div class="lv-acct-ptitle">
              <div><span class="lv-acct-eyebrow">{{ 'customer.addresses.delivery_eyebrow' | t }}</span><h2>{{ 'customer.addresses.saved_count' | t: count: customer.addresses_count }}</h2></div>
              <div class="lv-acct-ptitle__actions">
                {% if customer.addresses.size > 0 %}
                  <div class="lv-acct-view-toggle" role="group" aria-label="{{ 'customer.addresses.layout_view_aria' | t }}">
                    <button type="button" class="lv-acct-view-btn is-active" data-lv-acct-addr-view="grid" aria-pressed="true" title="{{ 'customer.addresses.grid_view' | t }}">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                      <span>{{ 'customer.addresses.grid' | t }}</span>
                    </button>
                    <button type="button" class="lv-acct-view-btn" data-lv-acct-addr-view="list" aria-pressed="false" title="{{ 'customer.addresses.list_view' | t }}">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                      <span>{{ 'customer.addresses.list' | t }}</span>
                    </button>
                  </div>
                {% endif %}
                <button type="button" class="btn btn-sliding-hover lv-acct-btn lv-acct-btn--sm" data-lv-acct-open-modal="LvAcctAddAddressModal">{{ 'customer.addresses.add_new' | t }}</button>
              </div>
            </div>
            {% if customer.addresses.size > 0 %}
              <div class="lv-acct-grid lv-acct-grid--addresses" data-lv-acct-addresses-grid data-view="grid">
