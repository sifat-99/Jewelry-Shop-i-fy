                      <button type="button" class="btn btn-sliding-hover lv-acct-btn lv-acct-btn--sm" data-lv-acct-open-modal="LvAcctEditAddressModal-{{ addr.id }}">{{ 'customer.addresses.edit' | t }}</button>
