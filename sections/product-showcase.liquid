{%- comment -%}
  Product Showcase section — supports either an editorial header + horizontal
  bleed carousel ("text" mode) or a sticky portrait media / moving showcase column
  paired with a collection grid ("image" mode).
  Rendering and styles are shared cleanly via `snippets/product-showcase-render.liquid`.
{%- endcomment -%}

{% render 'product-showcase-render',
  section_id: section.id,
  section_index: section.index,
  color_scheme: section.settings.color_scheme,
  content_type: section.settings.content_type,
  media_type: section.settings.media_type,
  image: section.settings.image,
  video: section.settings.video,
  image_link: section.settings.image_link,
  image_position: section.settings.image_position,
  image_heading: section.settings.image_heading,
  image_subtitle: section.settings.image_subtitle,
  heading: section.settings.heading,
  text: section.settings.text,
  text_alignment: section.settings.text_alignment,
  button_1_label: section.settings.button_1_label,
  button_1_link: section.settings.button_1_link,
  button_1_style: section.settings.button_1_style,
  button_2_label: section.settings.button_2_label,
  button_2_link: section.settings.button_2_link,
  button_2_style: section.settings.button_2_style,
  collection: section.settings.collection,
  max_products: section.settings.max_products,
  columns: section.settings.columns,
  mobile_columns: section.settings.mobile_columns,
  columns_gap: section.settings.columns_gap,
  rows_gap: section.settings.rows_gap,
  card_border_radius: section.settings.card_border_radius,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  showcase_products: section.settings.showcase_products,
  showcase_effect: section.settings.showcase_effect,
  showcase_autoplay: section.settings.showcase_autoplay,
  showcase_speed: section.settings.showcase_speed,
  showcase_show_caption: section.settings.showcase_show_caption,
  showcase_show_dots: section.settings.showcase_show_dots
%}

{% schema %}
{
  "name": "Product showcase",
  "tag": "div",
  "class": "section-product-showcase",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_type",
      "label": "Showcase layout",
      "options": [
        { "value": "image", "label": "Sticky media & grid" },
        { "value": "text", "label": "Editorial header & carousel" }
      ],
      "default": "image"
    },
    {
      "type": "header",
      "content": "Editorial header",
      "visible_if": "{{ section.settings.content_type == 'text' }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated Pieces",
      "visible_if": "{{ section.settings.content_type == 'text' }}"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Explore signature silhouettes crafted for everyday ritual and lasting luminescence.</p>",
      "visible_if": "{{ section.settings.content_type == 'text' }}"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_type == 'text' }}"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "First button label",
      "default": "Shop Collection",
      "visible_if": "{{ section.settings.content_type == 'text' }}"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "First button link",
      "visible_if": "{{ section.settings.content_type == 'text' }}"
    },
    {
      "type": "select",
      "id": "button_1_style",
      "label": "First button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Outline" }
      ],
      "default": "primary",
      "visible_if": "{{ section.settings.content_type == 'text' }}"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label",
      "visible_if": "{{ section.settings.content_type == 'text' }}"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Second button link",
      "visible_if": "{{ section.settings.content_type == 'text' }}"
    },
    {
      "type": "select",
      "id": "button_2_style",
      "label": "Second button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Outline" }
      ],
      "default": "secondary",
      "visible_if": "{{ section.settings.content_type == 'text' }}"
    },
    {
      "type": "header",
      "content": "Sticky media",
      "visible_if": "{{ section.settings.content_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media source",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" },
        { "value": "products", "label": "Selected products (moving showcase)" }
      ],
      "default": "image",
      "visible_if": "{{ section.settings.content_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Portrait image",
      "info": "Recommended 1600 × 2400 px (2:3 portrait). Cropped automatically to fill the sticky column.",
      "visible_if": "{{ section.settings.content_type == 'image' and section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Portrait video",
      "info": "Upload an MP4/MOV video (2:3 portrait recommended). Autoplays muted on loop with a pause/play button.",
      "visible_if": "{{ section.settings.content_type == 'image' and section.settings.media_type == 'video' }}"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Media link",
      "visible_if": "{{ section.settings.content_type == 'image' and section.settings.media_type != 'products' }}"
    },
    {
      "type": "product_list",
      "id": "showcase_products",
      "label": "Showcase products",
      "limit": 8,
      "info": "Only used when Media source = Selected products (moving showcase)."
    },
    {
      "type": "select",
      "id": "showcase_effect",
      "label": "Moving showcase transition",
      "options": [
        { "value": "fade_zoom", "label": "Fade & soft zoom" },
        { "value": "slide", "label": "Horizontal slide" }
      ],
      "default": "fade_zoom",
      "visible_if": "{{ section.settings.content_type == 'image' and section.settings.media_type == 'products' }}"
    },
    {
      "type": "checkbox",
      "id": "showcase_autoplay",
      "label": "Auto-advance slides",
      "default": true,
      "visible_if": "{{ section.settings.content_type == 'image' and section.settings.media_type == 'products' }}"
    },
    {
      "type": "range",
      "id": "showcase_speed",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "unit": "ms",
      "label": "Slide interval",
      "default": 4500,
      "visible_if": "{{ section.settings.content_type == 'image' and section.settings.media_type == 'products' }}"
    },
    {
      "type": "checkbox",
      "id": "showcase_show_caption",
      "label": "Show product title & price overlay",
      "default": true,
      "visible_if": "{{ section.settings.content_type == 'image' and section.settings.media_type == 'products' }}"
    },
    {
      "type": "checkbox",
      "id": "showcase_show_dots",
      "label": "Show pagination dots",
      "default": true,
      "visible_if": "{{ section.settings.content_type == 'image' and section.settings.media_type == 'products' }}"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Media position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.content_type == 'image' }}"
    },
    {
      "type": "text",
      "id": "image_heading",
      "label": "Overlay heading",
      "visible_if": "{{ section.settings.content_type == 'image' }}"
    },
    {
      "type": "text",
      "id": "image_subtitle",
      "label": "Overlay subtitle",
      "visible_if": "{{ section.settings.content_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "min": 4,
      "max": 16,
      "step": 1,
      "label": "Maximum products",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop columns",
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Column gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "rows_gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Row gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Product card corner radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Product showcase"
    }
  ]
}
{% endschema %}
