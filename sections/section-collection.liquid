<!-- /sections/section-collection.liquid -->
{%- liquid
  assign current_product = product
  assign current_collection_ctx = collection
  assign use_prod_col = section.settings.use_product_collection
  if use_prod_col == nil
    assign use_prod_col = true
  endif

  assign featured_collection = collections[section.settings.collection]

  if featured_collection == blank
    if use_prod_col
      if current_product != blank
        if current_collection_ctx != blank
          assign ctx_excluded = false
          case current_collection_ctx.handle
            when 'all', 'frontpage'
              assign ctx_excluded = true
          endcase
          unless ctx_excluded
            for cp in current_collection_ctx.products limit: 2
              if cp.id != current_product.id
                assign featured_collection = current_collection_ctx
                break
              endif
            endfor
          endunless
        endif

        if featured_collection == blank
          for pc in current_product.collections
            assign skip_broad = false
            case pc.handle
              when 'all', 'frontpage', 'all-products', 'new', 'new-arrivals', 'bestsellers', 'best-sellers', 'featured', 'sale', 'outlet', 'jewellery', 'jewelry'
                assign skip_broad = true
            endcase
            unless skip_broad
              for cp in pc.products limit: 2
                if cp.id != current_product.id
                  assign featured_collection = pc
                  break
                endif
              endfor
              if featured_collection != blank
                break
              endif
            endunless
          endfor
        endif

        if featured_collection == blank
          for pc in current_product.collections
            assign skip_root = false
            case pc.handle
              when 'all', 'frontpage'
                assign skip_root = true
            endcase
            unless skip_root
              for cp in pc.products limit: 2
                if cp.id != current_product.id
                  assign featured_collection = pc
                  break
                endif
              endfor
              if featured_collection != blank
                break
              endif
            endunless
          endfor
        endif
      endif
    endif
  endif

  if featured_collection == blank
    assign featured_collection = collections.all
  else
    if featured_collection.products_count == 0
      assign featured_collection = collections.all
    endif
  endif

  assign shuffle_enabled = section.settings.shuffle_products
  if shuffle_enabled == nil
    assign shuffle_enabled = true
  endif

  assign layout = section.settings.layout | default: 'grid'
  assign display_limit = section.settings.limit | default: 8
  if layout == 'split'
    assign display_limit = section.settings.split_limit | default: 12
  endif
  assign pool_limit = display_limit
  if shuffle_enabled
    assign pool_limit = 48
  endif
  assign loop_fetch_limit = pool_limit
  if current_product != blank
    assign loop_fetch_limit = pool_limit | plus: 1
  endif
-%}

{{ 'product-grid.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} .lv-shuffled-hidden {
    display: none !important;
  }
  {%- if display_limit <= 2 -%}
  #shopify-section-{{ section.id }} .lv-product-grid {
    max-width: 680px;
    margin: 0 auto;
  }
  {%- endif -%}
  {%- if section.settings.rows_by_screen -%}
    {%- liquid
      assign sel = '#shopify-section-' | append: section.id | append: ' .lv-product-grid > product-grid-item:nth-of-type(n+'
      assign c_d = section.settings.grid_columns_desktop | default: 4
      assign c_1024 = section.settings.grid_columns_1024 | default: 3 | times: 2
      assign c_960 = section.settings.grid_columns_960 | default: 3 | times: 2
      assign c_768 = section.settings.grid_columns_768 | default: 2 | times: 2
      assign c_650 = section.settings.grid_columns_650 | default: 1 | times: 2
      assign c_450 = section.settings.grid_columns_mobile | default: 1 | times: 2
    -%}
  @media (min-width: 1025px) { {{ sel }}{{ c_d | plus: 1 }}) { display: none !important; } }
  @media (min-width: 961px) and (max-width: 1024px) { {{ sel }}{{ c_1024 | plus: 1 }}) { display: none !important; } }
  @media (min-width: 769px) and (max-width: 960px) { {{ sel }}{{ c_960 | plus: 1 }}) { display: none !important; } }
  @media (min-width: 651px) and (max-width: 768px) { {{ sel }}{{ c_768 | plus: 1 }}) { display: none !important; } }
  @media (min-width: 451px) and (max-width: 650px) { {{ sel }}{{ c_650 | plus: 1 }}) { display: none !important; } }
  @media (max-width: 450px) { {{ sel }}{{ c_450 | plus: 1 }}) { display: none !important; } }
  {%- endif -%}
</style>

<div class="section-collection color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  data-section-id="{{ section.id }}"
  data-section-type="collection-row"
  style="--PT: {{ section.settings.padding_top | default: 26 }}px; --PB: {{ section.settings.padding_bottom | default: 14 }}px; --card-radius: {{ section.settings.card_border_radius | default: settings.card_border_radius | default: 4 }}px;">
  <div class="wrapper--full section-padding">

    {%- capture product_cards -%}
      {%- assign rendered_count = 0 -%}
      {%- comment -%} Performance: below the first section the card images are lazy-loaded (they do not compete with the page HTML). {%- endcomment -%}
      {%- assign cards_lazy = false -%}
      {%- if section.index != nil and section.index > 1 -%}{%- assign cards_lazy = true -%}{%- endif -%}
      {%- if featured_collection.products.size > 0 -%}
        {%- for rec_product in featured_collection.products limit: loop_fetch_limit -%}
          {%- if current_product != blank -%}
            {%- if rec_product.id == current_product.id -%}
              {%- continue -%}
            {%- endif -%}
          {%- endif -%}
          {%- assign rendered_count = rendered_count | plus: 1 -%}
          {%- assign extra_cls = '' -%}
          {%- if shuffle_enabled -%}
            {%- if rendered_count > display_limit -%}
              {%- assign extra_cls = 'lv-shuffled-hidden' -%}
            {%- endif -%}
          {%- endif -%}
          {% render 'product-grid-item', product: rec_product, fallback_index: rendered_count, card_border_radius: section.settings.card_border_radius, extra_class: extra_cls, lazy_load: cards_lazy %}
          {%- if rendered_count >= pool_limit -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if rendered_count == 0 -%}
        {%- for i in (1..display_limit) -%}
          {% render 'product-grid-item', fallback_index: i, card_border_radius: section.settings.card_border_radius %}
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}

    {%- if layout == 'split' -%}
      {%- comment -%}
        Text panel + product slider: heading, text, note and arrows on the left, the product cards scroll
        horizontally on the right. Stacks (text on top, cards below) on tablets and phones.
      {%- endcomment -%}
      <collection-slider class="lv-nis" style="--nis-cols: {{ section.settings.split_columns | default: 3 }};">
        <div class="lv-nis__intro">
          {%- if section.settings.split_image != blank -%}
            {%- liquid
              assign banner_img = section.settings.split_image
              assign banner_url = section.settings.split_image_link | default: featured_collection.url | default: routes.all_products_collection_url
              assign banner_label = banner_img.alt | default: section.settings.title | default: featured_collection.title
            -%}
            {%- comment -%} Banner keeps its own aspect ratio (never cropped) on every screen size and links to the collection. {%- endcomment -%}
            <a class="lv-nis__banner" href="{{ banner_url }}" aria-label="{{ banner_label | escape }}" style="aspect-ratio: {{ banner_img.aspect_ratio | default: 0.75 }};">
              {{ banner_img | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 990px) 26vw, 100vw', loading: 'lazy', class: 'lv-nis__banner-img', alt: banner_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.split_image == blank -%}
          <div class="lv-nis__copy">
            {%- if section.settings.title != blank -%}
              <h2 class="lv-nis__title">{{ section.settings.title }}</h2>
            {%- endif -%}
            {%- if section.settings.split_text != blank -%}
              <div class="lv-nis__text rte">{{ section.settings.split_text }}</div>
            {%- endif -%}
            {%- if section.settings.split_note != blank -%}
              <p class="lv-nis__note">{{ section.settings.split_note | escape }}</p>
            {%- endif -%}
            {%- if section.settings.show_view_all -%}
              <a class="lv-nis__link" href="{{ featured_collection.url | default: routes.all_products_collection_url }}">{{ 'collections.general.view_all_products' | t }}</a>
            {%- endif -%}
          </div>
          {%- endif -%}
        </div>
        <div class="lv-nis__track" data-product-row data-nis-track tabindex="0" aria-label="{{ section.settings.title | default: featured_collection.title | escape }}">
          {{ product_cards }}
        </div>
        <div class="lv-nis__nav">
          <button type="button" class="lv-nis__btn" data-nis-prev aria-label="{{ 'sections.collection_slider.previous' | t }}">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <span class="lv-nis__count" aria-live="polite"><span data-nis-current>1</span>/<span data-nis-total>{{ display_limit }}</span></span>
          <button type="button" class="lv-nis__btn" data-nis-next aria-label="{{ 'sections.collection_slider.next' | t }}">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </collection-slider>
    {%- else -%}
    {%- if section.settings.title != blank -%}
      <h2 class="kicker-flourished mb-r9">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p style="text-align: center; font-family: var(--FONT-STACK-SUBHEADING, sans-serif); font-size: calc(13.5px * var(--FONT-ADJUST-ACCENT, 1)); font-weight: var(--FONT-WEIGHT-SUBHEADING, 500); color: var(--text, #2b2622); margin: -6px auto 26px auto; letter-spacing: var(--FONT-SUBHEADING-LETTER-SPACING, 0.05em); text-transform: var(--FONT-SUBHEADING-TRANSFORM, none); max-width: 600px; opacity: 1;">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <div class="lv-product-grid" data-product-row style="{% render 'product-grid-vars', settings: section.settings %}">
      {{ product_cards }}
    </div>
    {%- endif -%}

    {%- if shuffle_enabled -%}
      <script>
        (function() {
          function shuffleGrid() {
            var sectionEl = document.getElementById('shopify-section-{{ section.id }}');
            if (!sectionEl) return;
            var grid = sectionEl.querySelector('[data-product-row]');
            if (!grid) return;
            var items = Array.prototype.slice.call(grid.querySelectorAll('product-grid-item, .product-grid-item'));
            if (items.length <= 1) return;

            var limit = {{ display_limit }};

            // Fisher-Yates shuffle
            for (var i = items.length - 1; i > 0; i--) {
              var j = Math.floor(Math.random() * (i + 1));
              var temp = items[i];
              items[i] = items[j];
              items[j] = temp;
            }

            var frag = document.createDocumentFragment();
            for (var k = 0; k < items.length; k++) {
              var item = items[k];
              if (k < limit) {
                item.classList.remove('lv-shuffled-hidden');
                item.style.display = '';
              } else {
                item.classList.add('lv-shuffled-hidden');
                item.style.display = 'none';
              }
              frag.appendChild(item);
            }
            grid.appendChild(frag);
            grid.dispatchEvent(new CustomEvent('lv:products-shuffled', { bubbles: true }));
          }

          // Run immediately inline
          shuffleGrid();

          // Also support Shopify Theme Editor changes
          document.addEventListener('shopify:section:load', function(e) {
            if (e.target && e.target.id === 'shopify-section-{{ section.id }}') {
              shuffleGrid();
            }
          });
        })();
      </script>
    {%- endif -%}

    {%- if section.settings.show_view_all and layout != 'split' -%}
      <div style="text-align: center; margin-top: 36px;">
        <a href="{{ featured_collection.url | default: routes.all_products_collection_url }}" class="btn btn--outline btn-sliding-hover" style="display: inline-flex; padding: 12px 32px; font-family: var(--TYPE-STACK-BUTTON, sans-serif); font-size: 12px; font-weight: var(--TYPE-WEIGHT-BUTTON, 600); text-transform: var(--FONT-BUTTON-TRANSFORM, uppercase); letter-spacing: var(--FONT-BUTTON-LETTER-SPACING, 0.15em); text-decoration: none;">
          <span class="btn__text-content">{{ 'collections.general.view_all_products' | t }}</span>
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  /* ---------- Layout "Text panel + product slider" ---------- */
  .lv-nis {
    --nis-gap: clamp(12px, 1.4vw, 20px);
    display: grid;
    grid-template-columns: minmax(220px, 25%) minmax(0, 1fr);
    /* desktop: text on the left, arrows in the top right corner above the cards */
    grid-template-rows: auto minmax(0, 1fr);
    grid-template-areas:
      'intro nav'
      'intro track';
    column-gap: clamp(20px, 3.2vw, 56px);
    row-gap: 18px;
    align-items: stretch;
  }

  .lv-nis__intro { grid-area: intro; }
  .lv-nis__track { grid-area: track; }
  .lv-nis__nav { grid-area: nav; }

  .lv-nis__intro {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Optional banner: shown at its own aspect ratio (width follows the column, height follows the image) */
  /* the link box carries the image's own aspect ratio, so the picture is never cropped or stretched */
  .lv-nis__banner {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
    border-radius: var(--card-radius, 0px);
  }

  .lv-nis__banner-img {
    display: block;
    width: 100% !important;
    height: 100% !important;
    max-width: none;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .lv-nis__banner:hover .lv-nis__banner-img {
    transform: scale(1.03);
  }

  .lv-nis__banner:focus-visible {
    outline: 2px solid var(--lv-accent-deep, #806745);
    outline-offset: 3px;
  }

  .lv-nis__title {
    margin: 0 0 18px;
    font-family: var(--FONT-STACK-HEADING, serif);
    font-size: clamp(36px, 4.2vw, 64px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-align: left;
    color: inherit;
    text-wrap: balance;
  }

  .lv-nis__text {
    max-width: 34ch;
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.78;
  }

  .lv-nis__text p {
    margin: 0;
  }

  .lv-nis__note {
    margin: 18px 0 0;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lv-nis__link {
    display: inline-block;
    margin-top: 18px;
    padding-bottom: 2px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .lv-nis__link:hover {
    opacity: 0.7;
  }

  .lv-nis__nav {
    display: flex;
    align-items: center;
    gap: 14px;
    align-self: end;
    justify-self: end;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }

  .lv-nis__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }

  .lv-nis__btn:hover:not([disabled]) {
    background: var(--lv-accent-deep, #806745);
    border-color: var(--lv-accent-deep, #806745);
    color: #fff;
  }

  .lv-nis__btn[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  .lv-nis__count {
    min-width: 3.4em;
    text-align: center;
  }

  .lv-nis__track {
    display: flex;
    gap: var(--nis-gap);
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 2px;
  }

  .lv-nis__track::-webkit-scrollbar {
    display: none;
  }

  .lv-nis__track:focus-visible {
    outline: 2px solid var(--lv-accent-deep, #806745);
    outline-offset: 4px;
  }

  .lv-nis__track > * {
    flex: 0 0 calc((100% - (var(--nis-cols) - 1) * var(--nis-gap)) / var(--nis-cols));
    min-width: 0;
    scroll-snap-align: start;
  }

  .lv-nis__track > .lv-shuffled-hidden {
    display: none !important;
  }

  /* Tablet: text on top with the arrows on its right, about two and a half cards below */
  @media (max-width: 989px) {
    .lv-nis {
      --nis-cols: 2.4 !important;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto auto;
      grid-template-areas:
        'intro nav'
        'track track';
      gap: 26px 24px;
    }

    .lv-nis__banner {
      max-width: 440px;
    }

    .lv-nis__text {
      max-width: 48ch;
      font-size: 17px;
      line-height: 1.55;
    }

    .lv-nis__note {
      font-size: 12.5px;
    }
  }

  /* Phone: text on top, one card and a peek of the next, arrows under the cards */
  @media (max-width: 599px) {
    .lv-nis {
      --nis-cols: 1.3 !important;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'intro'
        'track'
        'nav';
      gap: 22px;
    }

    .lv-nis__title {
      margin-bottom: 12px;
    }

    .lv-nis__text {
      max-width: none;
      font-size: 16px;
    }

    .lv-nis__banner {
      max-width: none;
    }

    .lv-nis__nav {
      justify-self: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lv-nis__track {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    if (customElements.get('collection-slider')) return;

    class CollectionSlider extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-nis-track]');
        this.prev = this.querySelector('[data-nis-prev]');
        this.next = this.querySelector('[data-nis-next]');
        this.cur = this.querySelector('[data-nis-current]');
        this.tot = this.querySelector('[data-nis-total]');
        if (!this.track) return;
        var self = this;
        this.update = this.update.bind(this);
        this.prev.addEventListener('click', function () { self.go(-1); });
        this.next.addEventListener('click', function () { self.go(1); });
        this.track.addEventListener('scroll', function () {
          if (self.raf) return;
          self.raf = requestAnimationFrame(function () { self.raf = null; self.update(); });
        }, { passive: true });
        this.track.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowRight') { e.preventDefault(); self.go(1); }
          if (e.key === 'ArrowLeft') { e.preventDefault(); self.go(-1); }
        });
        this.addEventListener('lv:products-shuffled', function () { self.track.scrollLeft = 0; self.update(); });
        window.addEventListener('resize', this.update, { passive: true });
        this.update();
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this.update);
      }

      cards() {
        return Array.prototype.filter.call(this.track.children, function (c) { return c.offsetParent !== null; });
      }

      stepSize() {
        var cards = this.cards();
        if (cards.length < 2) return cards[0] ? cards[0].offsetWidth : this.track.clientWidth;
        return cards[1].offsetLeft - cards[0].offsetLeft;
      }

      go(dir) {
        this.track.scrollBy({ left: dir * this.stepSize(), behavior: 'smooth' });
      }

      update() {
        var cards = this.cards();
        var step = this.stepSize() || 1;
        var max = this.track.scrollWidth - this.track.clientWidth;
        var x = this.track.scrollLeft;
        var idx = max <= 2 ? 0 : Math.round(x / step);
        if (x >= max - 2) idx = Math.max(idx, cards.length - Math.round(this.track.clientWidth / step));
        if (this.cur) this.cur.textContent = String(Math.min(cards.length, idx + 1));
        if (this.tot) this.tot.textContent = String(cards.length);
        this.prev.disabled = x <= 2;
        this.next.disabled = x >= max - 2;
      }
    }

    customElements.define('collection-slider', CollectionSlider);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "visible_if": "{{ section.settings.layout != 'split' }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid (classic)"
        },
        {
          "value": "split",
          "label": "Text panel + product slider"
        }
      ],
      "default": "grid",
      "info": "Text panel + product slider: heading and text on the left, product cards scrolling on the right."
    },
    {
      "type": "richtext",
      "id": "split_text",
      "label": "Text",
      "default": "<p>A curated selection of newly arrived pieces, made to bring a little everyday elegance.</p>",
      "visible_if": "{{ section.settings.layout == 'split' and section.settings.split_image == blank }}"
    },
    {
      "type": "text",
      "id": "split_note",
      "label": "Small note",
      "default": "*Limited seasonal drop",
      "visible_if": "{{ section.settings.layout == 'split' and section.settings.split_image == blank }}"
    },
    {
      "type": "image_picker",
      "id": "split_image",
      "label": "Banner image",
      "info": "Optional. When a banner is chosen it replaces the text panel (heading, text, note and link are hidden). It keeps its own proportions on every screen size and opens the link below when clicked.",
      "visible_if": "{{ section.settings.layout == 'split' }}"
    },
    {
      "type": "url",
      "id": "split_image_link",
      "label": "Banner link",
      "info": "Leave empty to open the collection above.",
      "visible_if": "{{ section.settings.layout == 'split' and section.settings.split_image != blank }}"
    },
    {
      "type": "range",
      "id": "split_limit",
      "min": 4,
      "max": 24,
      "step": 1,
      "label": "Products in the slider",
      "default": 12,
      "visible_if": "{{ section.settings.layout == 'split' }}"
    },
    {
      "type": "range",
      "id": "split_columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Cards visible on desktop",
