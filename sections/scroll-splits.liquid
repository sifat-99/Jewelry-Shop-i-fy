{%- comment -%}
  Scroll story splits: full-screen "splits" placed one after the other. Each split has a left and a right
  side, and each side is Content (heading, text, button), an Image or a Video, so any mix works:
  content + image, image + content, image + image, image + video ...

  Scrolling is the browser's own scroll (nothing is locked or hijacked). Each split sticks under the header
  while the next one slides up over it; the covered split eases back and dims, the new one's image settles
  and its text fades in, all following the scroll position so it never jumps.
  A split taller than the screen (long text on a phone) is scrolled through completely before the next
  one covers it. Without JavaScript the splits are simply stacked.
{%- endcomment -%}
{%- liquid
  assign splits = section.blocks | where: 'type', 'split'
  assign split_count = splits.size
  assign sides = 'left,right' | split: ','
  assign region_label = section.settings.label
  if region_label == blank
    assign region_label = 'sections.scroll_splits.label' | t
  endif
-%}

<scroll-splits
  class="scroll-splits{% if section.settings.mobile_media_first %} ss--media-first{% endif %}"
  style="--ss-accent: {{ section.settings.accent | default: 'var(--lv-accent-deep, #806745)' }};"
  role="region"
  aria-label="{{ region_label | escape }}"
>
  <div class="ss-stack" data-ss-stack>
    {%- for block in splits -%}
      {%- liquid
        assign media_sides = 0
        for side in sides
          assign side_type_key = side | append: '_type'
          if block.settings[side_type_key] != 'content'
            assign media_sides = media_sides | plus: 1
          endif
        endfor
        case media_sides
          when 0
            assign kind = 'cc'
          when 1
            assign kind = 'cm'
          else
            assign kind = 'mm'
        endcase
        assign panel_scheme = block.settings.color_scheme | default: section.settings.color_scheme | default: 'scheme-1'
      -%}
      <div
        class="ss-panel ss-panel--{{ kind }} color-{{ panel_scheme }}{% if forloop.first %} is-in{% endif %}"
        style="--i: {{ forloop.index }};"
        data-ss-panel
        {{ block.shopify_attributes }}
      >
        {%- for side in sides -%}
          {%- liquid
            assign side_type_key = side | append: '_type'
            assign side_image_key = side | append: '_image'
            assign side_video_key = side | append: '_video'
            assign side_type = block.settings[side_type_key]
            assign side_image = block.settings[side_image_key]
            assign side_video = block.settings[side_video_key]
            assign side_link_key = side | append: '_link'
            assign side_link = block.settings[side_link_key]
            assign side_image_m_key = side | append: '_image_mobile'
            assign side_video_m_key = side | append: '_video_mobile'
            assign side_image_m = block.settings[side_image_m_key]
            assign side_video_m = block.settings[side_video_m_key]
          -%}
          {%- if side_type == 'content' -%}
            <div class="ss-side ss-content ss-side--{{ side }}">
              <div class="ss-content__inner" data-ss-content>
                {%- if block.settings.eyebrow != blank -%}
                  <p class="ss-eyebrow">{{ block.settings.eyebrow | escape }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  {%- liquid
                    assign heading_html = block.settings.heading | escape
                    if block.settings.accent_text != blank
                      assign accent_plain = block.settings.accent_text | escape
                      assign accent_html = '<span class="ss-accent">' | append: accent_plain | append: '</span>'
                      assign heading_html = heading_html | replace_first: accent_plain, accent_html
                    endif
                  -%}
                  <h2 class="ss-heading">{{ heading_html }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="ss-text rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a class="btn btn--primary btn-sliding-hover ss-btn" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">
                    <span class="btn__text-content">{{ block.settings.button_label | escape }}</span>
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- else -%}
            {%- liquid
              assign media_tag = 'div'
              if side_link != blank
                assign media_tag = 'a'
                assign link_label = side_image.alt | default: block.settings.heading
                if link_label == blank
                  assign link_label = 'sections.scroll_splits.open_link' | t
                endif
              endif
            -%}
            {%- comment -%} With a link set, the whole image / video opens that page (e.g. a collection). {%- endcomment -%}
            <{{ media_tag }}
              class="ss-side ss-media ss-side--{{ side }}{% if side_link != blank %} ss-media--link{% endif %}"
              {% if side_link != blank %}href="{{ side_link }}" aria-label="{{ link_label | escape }}"{% endif %}
            >
              {%- liquid
                # desktop media: the video (Video type) or the image
                assign d_video = nil
                if side_type == 'video' and side_video != blank
                  assign d_video = side_video
                endif

                # phones and tablets (up to 989px): own video / image when set, otherwise the desktop media
                assign m_video = nil
                if side_type == 'video' and side_video_m != blank
                  assign m_video = side_video_m
                endif
                assign has_mobile = false
                if m_video != blank or side_image_m != blank
                  assign has_mobile = true
                endif

                assign img_loading = 'lazy'
                if forloop.parentloop.first and section.index == 1
                  assign img_loading = 'eager'
                endif
                assign fallback_alt = block.settings.heading
              -%}
              {%- if has_mobile == false -%}
                {%- render 'scroll-split-media', video: d_video, image: side_image, alt: fallback_alt, loading: img_loading -%}
              {%- elsif d_video == blank and m_video == blank and side_image != blank -%}
                {%- comment -%} Two images: one <picture>, the browser downloads only the one for this screen {%- endcomment -%}
                {%- liquid
                  assign fp_d = side_image.presentation.focal_point | default: '50% 50%'
                  assign fp_m = side_image_m.presentation.focal_point | default: '50% 50%'
                  assign pic_style = '--fp-d: ' | append: fp_d | append: '; --fp-m: ' | append: fp_m | append: ';'
                  assign pic_alt = side_image.alt | default: fallback_alt
                -%}
                <picture>
                  <source
                    media="(max-width: 989px)"
                    srcset="{{ side_image_m | image_url: width: 600 }} 600w, {{ side_image_m | image_url: width: 900 }} 900w, {{ side_image_m | image_url: width: 1200 }} 1200w, {{ side_image_m | image_url: width: 1600 }} 1600w"
                    sizes="100vw"
                  >
                  {{
                    side_image
                    | image_url: width: 2000
                    | image_tag:
                      widths: '600, 900, 1200, 1600, 2000',
                      sizes: '(min-width: 990px) 50vw, 100vw',
                      loading: img_loading,
                      alt: pic_alt,
                      class: 'ss-media__el',
                      style: pic_style
                  }}
                </picture>
              {%- else -%}
                {%- comment -%} Different kinds (e.g. video on desktop, image on phones): one element per screen size {%- endcomment -%}
                {%- render 'scroll-split-media', video: d_video, image: side_image, alt: fallback_alt, loading: img_loading, extra_class: 'ss-hide-m' -%}
                {%- if m_video != blank -%}
                  {%- render 'scroll-split-media', video: m_video, image: side_image_m, alt: fallback_alt, extra_class: 'ss-hide-d', sizes: '100vw' -%}
                {%- else -%}
                  {%- render 'scroll-split-media', image: side_image_m, alt: fallback_alt, extra_class: 'ss-hide-d', sizes: '100vw' -%}
                {%- endif -%}
              {%- endif -%}
            </{{ media_tag }}>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}

  </div>

    {%- if section.settings.show_dots and split_count > 1 -%}
      <div class="ss-dots-rail">
      <div class="ss-dots" data-ss-dots>
        {%- for block in splits -%}
          <button
            type="button"
            class="ss-dot"
            data-ss-dot="{{ forloop.index0 }}"
            aria-label="{{ 'sections.scroll_splits.go_to' | t: number: forloop.index, total: split_count }}"
            {% if forloop.first %}aria-current="true"{% endif %}
          ></button>
        {%- endfor -%}
      </div>
      </div>
    {%- endif -%}
</scroll-splits>

{% stylesheet %}
  .scroll-splits {
    /* height of the sticky header, set by the script so each split sticks right under it */
    --ss-top: 0px;
    --ss-screen: calc(100vh - var(--ss-top));
    position: relative;
    display: block;
  }

  @supports (height: 100svh) {
    .scroll-splits {
      --ss-screen: calc(100svh - var(--ss-top));
    }
  }

  /* ---------- splits, one after the other ---------- */
  .ss-stack {
    position: relative;
  }

  .ss-panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: min(88vh, 920px);
    background: rgb(var(--color-background, 255, 255, 255));
    color: rgb(var(--color-foreground, 26, 26, 26));
  }

  /* ---------- stacking: each split sticks while the next one slides over it ---------- */
  .scroll-splits.is-stacking .ss-panel {
    position: sticky;
    top: var(--ss-stick, var(--ss-top));
    z-index: var(--i, 1);
    min-height: var(--ss-screen);
    transform: scale(calc(1 - 0.04 * var(--ss-cover, 0)));
    transform-origin: 50% 0;
    will-change: transform;
  }

  .scroll-splits.is-stacking .ss-panel + .ss-panel {
    box-shadow: 0 -22px 44px -24px rgba(0, 0, 0, 0.35);
  }

  /* the covered split dims as the next one slides over it */
  .scroll-splits.is-stacking .ss-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
    background: #000;
    opacity: calc(0.3 * var(--ss-cover, 0));
    pointer-events: none;
  }

  /* the image settles as its split comes in */
  .scroll-splits.is-stacking .ss-media__el {
    transform: scale(calc(1.08 - 0.08 * var(--ss-enter, 1)));
    will-change: transform;
  }

  /* text fades in when its split arrives */
  .scroll-splits.is-stacking .ss-content__inner {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.8s ease, transform 1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .scroll-splits.is-stacking .ss-panel.is-in .ss-content__inner {
    opacity: 1;
    transform: none;
  }

  .ss-side {
    position: relative;
    min-width: 0;
    min-height: 0;
  }

  .ss-media {
    overflow: hidden;
    background: color-mix(in srgb, rgb(var(--color-foreground, 26, 26, 26)) 6%, transparent);
  }

  .ss-media__el {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--fp-d, 50% 50%);
    transform-origin: 50% 50%;
  }

  .ss-media--link {
    display: block;
    cursor: pointer;
    color: inherit;
  }

  .ss-media--link::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0);
    transition: background-color 0.35s ease;
    pointer-events: none;
  }

  .ss-media--link:hover::after {
    background: rgba(0, 0, 0, 0.06);
  }

  .ss-media--link:focus-visible {
    outline: 2px solid var(--ss-accent);
    outline-offset: -4px;
  }

  .ss-media__el--ph {
    fill: color-mix(in srgb, currentColor 25%, transparent);
  }

  .ss-content {
    display: flex;
    align-items: center;
    padding: clamp(32px, 6vw, 112px);
  }

  .ss-content__inner {
    width: 100%;
    max-width: 680px;
  }

  .ss-eyebrow {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ss-accent);
  }

  .ss-heading {
    margin: 0 0 18px;
    font-family: var(--FONT-STACK-HEADING, serif);
    font-size: clamp(28px, 2.8vw, 48px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.005em;
    text-align: left;
    text-transform: none;
    color: inherit;
    text-wrap: balance;
  }

  .ss-accent {
    color: var(--ss-accent);
  }

  .ss-text {
    max-width: 62ch;
    font-size: 15.5px;
    line-height: 1.7;
    opacity: 0.86;
  }

  .ss-text p {
    margin: 0 0 0.8em;
  }

  .ss-text p:last-child {
    margin-bottom: 0;
  }

  .ss-btn {
    display: inline-flex;
    margin-top: 28px;
  }

  /* ---------- progress dots ---------- */
  .ss-dots-rail {
    display: none;
  }

  /* the rail spans the whole section; the dots stick in the middle of the screen while it scrolls by */
  .scroll-splits.is-stacking .ss-dots-rail {
    position: absolute;
    inset: 0;
    z-index: 60;
    display: block;
    pointer-events: none;
  }

  .scroll-splits.is-stacking .ss-dots {
    position: sticky;
    top: 50vh;
    float: right;
    margin-right: clamp(12px, 1.6vw, 24px);
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 10px 7px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transform: translateY(-50%);
  }

  .ss-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 1px solid rgba(26, 26, 26, 0.45);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
  }

  .ss-dot[aria-current='true'] {
    background: var(--ss-accent);
    border-color: var(--ss-accent);
    transform: scale(1.25);
  }

  .ss-dot:focus-visible {
    outline: 2px solid var(--ss-accent);
    outline-offset: 3px;
  }

  /* separate desktop and mobile media: only the one for this screen size is shown */
  @media (min-width: 990px) {
    .ss-media .ss-hide-d {
      display: none !important;
    }
  }

  /* ---------- tablets and phones: media above the content ---------- */
  @media (max-width: 989px) {
    .ss-media .ss-hide-m {
      display: none !important;
    }

    .ss-media__el {
      object-position: var(--fp-m, var(--fp-d, 50% 50%));
    }

    .ss-panel--cm,
    .ss-panel--cc {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto;
      min-height: 0;
    }

    .ss--media-first .ss-panel--cm .ss-media {
      order: -1;
    }

    .ss-panel--cm .ss-media,
    .ss-panel--mm .ss-media {
      aspect-ratio: 4 / 5;
    }

    /* two images / image + video: one above the other */
    .ss-panel--mm {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto;
      min-height: 0;
    }

    .ss-content {
      padding: 32px max(20px, 5vw) 40px;
    }

    .ss-heading {
      font-size: clamp(26px, 5.4vw, 40px);
    }

    .ss-text {
      font-size: 15px;
      line-height: 1.65;
    }

    /* stacking on phones / tablets: each split fills the screen, media takes the space the text leaves */
    .scroll-splits.is-stacking .ss-panel--cm {
      grid-template-rows: minmax(42vh, 1fr) auto;
    }

    .scroll-splits.is-stacking .ss-panel--cc,
    .scroll-splits.is-stacking .ss-panel--mm {
      grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    }

    .scroll-splits.is-stacking .ss-media {
      aspect-ratio: auto;
    }

    .scroll-splits.is-stacking .ss-dots {
      float: none;
      top: auto;
      bottom: 14px;
      width: max-content;
      margin: 0 auto;
      flex-direction: row;
      padding: 7px 10px;
      transform: none;
    }

    .scroll-splits.is-stacking .ss-dots-rail {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }
  }

  @media (max-width: 599px) {
    .ss-content {
      padding: 26px 20px 34px;
    }

    .ss-btn {
      margin-top: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-splits.is-stacking .ss-panel,
    .scroll-splits.is-stacking .ss-media__el {
      transform: none;
    }

    .scroll-splits.is-stacking .ss-content__inner {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    if (customElements.get('scroll-splits')) return;

    var REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)');

    function clamp(v, a, b) { return Math.min(b, Math.max(a, v)); }

    class ScrollSplits extends HTMLElement {
      connectedCallback() {
        this.panels = Array.prototype.slice.call(this.querySelectorAll('[data-ss-panel]'));
        this.dots = Array.prototype.slice.call(this.querySelectorAll('[data-ss-dot]'));
        this.n = this.panels.length;
        if (!this.n) return;

        this.headerEls = Array.prototype.slice.call(document.querySelectorAll('.shopify-section-group-header-group, [data-header-wrapper]'));
        this.raf = null;
        this.active = -1;
        this.onScroll = this.onScroll.bind(this);
        this.onResize = this.onResize.bind(this);

        var self = this;
        this.dots.forEach(function (dot) {
          dot.addEventListener('click', function () { self.goTo(parseInt(dot.getAttribute('data-ss-dot'), 10)); });
        });
        this.blockSelect = function (e) {
          var idx = self.panels.indexOf(e.target);
          if (idx > -1) self.goTo(idx, true);
        };
        document.addEventListener('shopify:block:select', this.blockSelect);
        window.addEventListener('scroll', this.onScroll, { passive: true });
        window.addEventListener('resize', this.onResize, { passive: true });
        Array.prototype.forEach.call(this.querySelectorAll('img'), function (img) {
          if (!img.complete) img.addEventListener('load', function () { self.onResize(); }, { once: true });
        });
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { self.onResize(); });

        this.classList.add('is-stacking');
        this.measure();
        this.update();
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.onScroll);
        window.removeEventListener('resize', this.onResize);
        document.removeEventListener('shopify:block:select', this.blockSelect);
        cancelAnimationFrame(this.raf);
      }

      /* Height of the sticky header currently on screen */
      headerOffset() {
        var bottom = 0;
        this.headerEls.forEach(function (h) {
          var pos = getComputedStyle(h).position;
          if (pos !== 'sticky' && pos !== 'fixed') return;
          var r = h.getBoundingClientRect();
          if (r.height > 0 && r.top <= 1) bottom = Math.max(bottom, Math.round(r.bottom));
        });
        return Math.min(bottom, Math.round(window.innerHeight * 0.3));
      }

      /* where each split sticks: under the header, or (when taller than the screen) once its bottom is reached */
      measure() {
        this.top = this.headerOffset();
        this.style.setProperty('--ss-top', this.top + 'px');
        var vh = window.innerHeight;
        var top = this.top;
        this.panels.forEach(function (p) {
          var stick = Math.min(top, vh - p.offsetHeight);
          p.style.setProperty('--ss-stick', stick + 'px');
        });
      }

      onResize() {
        clearTimeout(this.resizeTimer);
        var self = this;
        this.resizeTimer = setTimeout(function () { self.measure(); self.update(); }, 100);
      }

      onScroll() {
        if (this.raf) return;
        var self = this;
        this.raf = requestAnimationFrame(function () {
          self.raf = null;
          var top = self.headerOffset();
          if (Math.abs(top - self.top) > 1) self.measure();
          self.update();
        });
      }

      /* every value follows the scroll position, so the change is as smooth as the scrolling itself */
      update() {
        var vh = window.innerHeight;
        var sec = this.getBoundingClientRect();
        if (sec.bottom < -vh || sec.top > vh * 2) return;
        var reduced = REDUCED.matches;
        var best = 0, bestArea = -1;
        var rects = this.panels.map(function (p) { return p.getBoundingClientRect(); });
        var self = this;

        this.panels.forEach(function (p, k) {
          var r = rects[k];
          var next = rects[k + 1];
          /* how far the next split has slid over this one (0..1) */
          var cover = 0;
          if (next) cover = clamp((vh - next.top) / Math.max(1, vh - self.top), 0, 1);
          /* how far this split has come in (0..1) */
          var enter = clamp((vh - r.top) / Math.max(1, vh - self.top), 0, 1);
          if (reduced) { cover = 0; enter = 1; }
          p.style.setProperty('--ss-cover', cover.toFixed(4));
          p.style.setProperty('--ss-enter', enter.toFixed(4));

          /* text fades in once a split is a third of the way in, and again when scrolling back down to it */
          if (enter > 0.35) p.classList.add('is-in');
          else if (r.top > vh * 0.8) p.classList.remove('is-in');

          /* visible part of this split: from its top to where the next one starts */
          var visTop = Math.max(r.top, 0);
          var visBottom = Math.min(next ? next.top : r.bottom, r.bottom, vh);
          var area = Math.max(0, visBottom - visTop);
          if (area > bestArea) { bestArea = area; best = k; }
          self.playVideos(p, area > vh * 0.25);
        });

        if (best !== this.active) {
          this.active = best;
          this.dots.forEach(function (d, i) {
            if (i === best) d.setAttribute('aria-current', 'true');
            else d.removeAttribute('aria-current');
          });
        }
      }

      playVideos(panel, play) {
        panel.querySelectorAll('video[data-ss-video]').forEach(function (v) {
          v.muted = true;
          var visible = v.offsetParent !== null; /* the other screen size's version is display: none */
          if (play && visible && !REDUCED.matches) {
            if (v.paused) { var pr = v.play(); if (pr && pr.catch) pr.catch(function () {}); }
          } else if (!v.paused) {
            v.pause();
          }
        });
      }

      /* scroll to the point where split k has fully arrived */
      goTo(k, instant) {
        var y = window.scrollY + this.getBoundingClientRect().top - this.top;
        for (var i = 0; i < k; i++) y += this.panels[i].offsetHeight;
        window.scrollTo({ top: Math.round(y), behavior: instant || REDUCED.matches ? 'auto' : 'smooth' });
      }
    }

    customElements.define('scroll-splits', ScrollSplits);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Scroll story splits",
  "tag": "section",
  "class": "section-scroll-splits",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Highlight color",
      "info": "Colour of the highlighted words and the progress dots. Leave empty to use the theme accent."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Name for screen readers",
