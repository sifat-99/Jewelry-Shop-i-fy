      {
        "type": "header",
        "content": "Header Navigation Menu"
      },
      {
        "type": "range",
        "id": "nav_font_size",
        "min": 11,
        "max": 16,
        "step": 1,
        "unit": "px",
        "label": "Menu font size",
        "default": 13
      },
      {
        "type": "select",
        "id": "nav_font_weight",
        "label": "Menu font weight",
        "options": [
          {
            "value": "400",
            "label": "Regular (400)"
          },
          {
            "value": "500",
            "label": "Medium (500)"
          },
          {
            "value": "600",
            "label": "Semi-Bold (600)"
          },
          {
            "value": "700",
            "label": "Bold (700)"
          }
        ],
        "default": "600"
      },
      {
        "type": "checkbox",
        "id": "nav_uppercase",
        "label": "Uppercase navigation menu",
        "default": true
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1800,
        "step": 50,
        "unit": "px",
        "label": "Maximum page width",
        "default": 1600
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "min": 0,
        "max": 80,
        "step": 5,
        "unit": "px",
        "label": "Vertical spacing between sections",
        "default": 30
      },
      {
        "type": "range",
        "id": "grid_horizontal_space",
        "min": 8,
        "max": 40,
        "step": 4,
        "unit": "px",
        "label": "Horizontal grid spacing",
        "default": 20
      },
      {
        "type": "range",
        "id": "grid_vertical_space",
        "min": 8,
        "max": 40,
        "step": 4,
        "unit": "px",
        "label": "Vertical grid spacing",
        "default": 24
      }
    ]
  },
  {
    "name": "Breadcrumbs",
    "settings": [
      {
        "type": "header",
        "content": "Breadcrumbs (all pages)"
      },
      {
        "type": "checkbox",
        "id": "show_breadcrumbs",
        "label": "Show breadcrumbs",
        "default": true,
        "info": "Applies to collection, product, and content pages."
      },
      {
        "type": "select",
        "id": "breadcrumb_separator",
        "label": "Separator",
        "options": [
          {
            "value": "/",
            "label": "/  Slash"
          },
          {
            "value": ">",
            "label": ">  Arrow"
          },
          {
            "value": "·",
            "label": "·  Dot"
          },
          {
            "value": "—",
            "label": "—  Dash"
          }
        ],
        "default": "/"
      },
      {
        "type": "range",
        "id": "breadcrumb_font_size",
        "min": 10,
        "max": 16,
        "step": 1,
        "unit": "px",
        "label": "Text size",
        "default": 12
      },
      {
        "type": "checkbox",
        "id": "breadcrumb_uppercase",
        "label": "Uppercase text",
        "default": false
      },
      {
        "type": "range",
        "id": "breadcrumb_space_above",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Space above",
        "default": 0
      },
      {
        "type": "range",
        "id": "breadcrumb_space_below",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Space below",
        "default": 16
      }
    ]
  },
  {
    "name": "Loading & skeleton",
    "settings": [
      {
        "type": "header",
        "content": "Skeleton (product cards)"
      },
      {
        "type": "checkbox",
        "id": "enable_skeleton",
        "label": "Show skeleton while product images load",
        "default": true,
        "info": "Colours are taken from your theme text/background colours."
      },
      {
        "type": "select",
        "id": "skeleton_style",
        "label": "Skeleton animation",
        "options": [
          {
            "value": "shimmer",
            "label": "Shimmer"
          },
          {
            "value": "pulse",
            "label": "Pulse"
          }
        ],
        "default": "shimmer"
      },
      {
        "type": "header",
        "content": "Product page loader"
      },
      {
        "type": "checkbox",
        "id": "enable_product_loader",
        "label": "Show animated loader while product images load",
        "default": true
      },
      {
        "type": "range",
        "id": "loader_size",
        "min": 32,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Loader size",
        "default": 64
      },
      {
        "type": "color",
        "id": "loader_color_a",
        "label": "Loader corner colour (dark)",
        "default": "#8d6e63"
      },
      {
        "type": "color",
        "id": "loader_color_b",
        "label": "Loader corner colour (light)",
        "default": "#d7b8a6"
      },
      {
        "type": "color",
        "id": "loader_color_c",
        "label": "Loader centre colour",
        "default": "#3b2a26"
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_hover_animations",
        "label": "Enable hover transitions & button animations",
        "default": true,
        "info": "When disabled, hover states appear instantly without transitions or shadows."
      },
      {
        "type": "range",
        "id": "button_hover_speed",
        "min": 200,
        "max": 900,
        "step": 50,
        "unit": "ms",
        "label": "Button hover speed",
        "default": 450,
        "info": "How long the colour fill takes on buttons. Higher = slower and softer. Needs \"Enable hover transitions & button animations\" turned on."
      },
      {
        "type": "checkbox",
        "id": "button_fill_slide",
        "label": "Sliding fill animation on hover",
        "default": false,
        "info": "Off: the hover colour fades in smoothly. On: it slides in from the left. Applies to buttons, not to the variant/size option buttons."
      },
      {
        "type": "checkbox",
        "id": "enable_image_zoom",
        "label": "Enable subtle image zoom on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_scroll_animations",
        "label": "Enable reveal animations on scroll",
        "default": true
      }
    ]
  },
  {
    "name": "Buttons & Controls",
    "settings": [
      {
        "type": "header",
        "content": "Button Styles"
      },
      {
        "type": "select",
        "id": "global_button_style",
        "label": "Universal button style",
