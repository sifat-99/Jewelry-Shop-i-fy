[
  {
    "name": "theme_info",
    "theme_name": "Jewelry Shop",
    "theme_author": "Bangladesh Software Solutions",
    "theme_version": "2.0.0",
    "theme_documentation_url": "https://bssoln.com",
    "theme_support_url": "https://bssoln.com"
  },
  {
    "name": "Logo & Favicon (Global)",
    "settings": [
      {
        "type": "header",
        "content": "Universal Store Logo"
      },
      {
        "type": "paragraph",
        "content": "This logo applies across your Desktop Header, Mobile Header, Drawer Menu, Footer, and Password Page. Note: Shopify Checkout & Hosted Customer Login pages pull their logo from Shopify Admin > Settings > Brand. To sync everything seamlessly with 1 click, enable 'Use Shopify Brand Logo' below or upload the logo in Admin > Settings > Brand."
      },
      {
        "type": "checkbox",
        "id": "use_brand_logo",
        "label": "Use Shopify Brand Logo (from Admin > Settings > Brand)",
        "default": false,
        "info": "When enabled, the theme prioritizes your primary brand logo from Shopify Admin > Settings > Brand, ensuring Header, Footer, Password Page, Checkout, and Customer Accounts match 100%."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Custom Theme Logo (Optional)",
        "info": "Upload here to use a custom logo for the theme. Leave blank to automatically use the Shopify Brand Logo."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 5,
        "unit": "px",
        "label": "Desktop logo width",
        "default": 150
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "min": 40,
        "max": 200,
        "step": 5,
        "unit": "px",
        "label": "Mobile logo width",
        "default": 110
      },
      {
        "type": "select",
        "id": "mobile_logo_alignment",
        "label": "Mobile logo alignment",
        "options": [
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "left",
            "label": "Left (Next to Menu)"
          }
        ],
        "default": "center",
        "info": "Choose whether the logo is centered or on the left in the mobile header."
      },
      {
        "type": "range",
        "id": "footer_logo_width",
        "min": 50,
        "max": 300,
        "step": 5,
        "unit": "px",
        "label": "Footer logo width",
        "default": 170
      },
      {
        "type": "header",
        "content": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Background gradient"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Solid button background"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Solid button label"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "Secondary button label"
          },
          {
            "type": "color",
            "id": "shadow",
            "label": "Border / Shadow"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "secondary_button_label",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label"
        }
      }
    ]
  },
  {
    "name": "Typography",
