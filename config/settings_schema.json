        "max": 18,
        "step": 1,
        "unit": "px",
        "label": "Button text size",
        "default": 12
      },
      {
        "type": "select",
        "id": "button_font_weight",
        "label": "Button text weight",
        "options": [
          {
            "value": "500",
            "label": "Medium"
          },
          {
            "value": "600",
            "label": "Semi-bold"
          },
          {
            "value": "700",
            "label": "Bold"
          }
        ],
        "default": "600"
      },
      {
        "type": "range",
        "id": "button_letter_spacing",
        "min": 0,
        "max": 30,
        "step": 2,
        "label": "Button letter spacing",
        "default": 14,
        "info": "In hundredths of an em (14 = 0.14em)."
      },
      {
        "type": "header",
        "content": "Round buttons (wishlist, quick view, close...)"
      },
      {
        "type": "color",
        "id": "round_button_bg",
        "label": "Round button background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "round_button_text",
        "label": "Round button icon color",
        "default": "#000000",
        "info": "Hover colors come from the Universal button hover colors above, so square and round buttons always match."
      }
