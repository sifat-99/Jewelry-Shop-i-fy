      },
      {
        "type": "select",
        "id": "heading_text_transform",
        "label": "Heading text transform",
        "options": [
          {
            "value": "uppercase",
            "label": "Uppercase"
          },
          {
            "value": "capitalize",
            "label": "Capitalize"
          },
          {
            "value": "none",
            "label": "None"
          }
