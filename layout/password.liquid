<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#000000">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
  {%- else -%}
    <link rel="shortcut icon" href="{{ 'favicon.png' | asset_url }}" type="image/png">
  {%- endif -%}

  <title>{{ shop.name }} &ndash; Opening Soon</title>

  <!-- Google Fonts: Quicksand -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">

  {{ content_for_header }}

  <style>
    *, *::before, *::after {
      box-sizing: border-box;
    }
    :root {
      --bg: #ffffff;
      --text: #111111;
      --border: #ece8e1;
      --gold: #b48a4c;
      --btn-radius: {{ settings.button_border_radius | default: 0 }}px;
    }
    body {
      margin: 0;
      padding: 0;
      font-family: 'Quicksand', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      position: relative;
    }
    body::before {
      content: "";
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #b48a4c 0%, #dfc38e 50%, #b48a4c 100%);
      z-index: 9999;
    }

    /* Header Bar */
    .password-header {
      width: 100%;
      padding: 24px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
      position: relative;
      background: #ffffff;
      box-sizing: border-box;
    }
    @media (max-width: 768px) {
      .password-header {
        padding: 16px 20px;
      }
    }
    .password-header__left {
      min-width: 140px;
      display: flex;
      align-items: center;
    }
    @media (max-width: 768px) {
      .password-header__left {
        display: none;
      }
    }
    .password-header__center {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 1;
    }
    .password-header__logo-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
    }
    .password-header__logo-link img {
      max-width: {{ settings.logo_width | default: 150 }}px;
      max-height: 52px;
      width: auto;
      height: auto;
      object-fit: contain;
      display: block;
    }
    @media (max-width: 768px) {
      .password-header__logo-link img {
        max-width: {{ settings.logo_width_mobile | default: 110 }}px;
        max-height: 42px;
      }
    }
    .password-header__right {
      min-width: 140px;
      display: flex;
      align-items: center;
      justify-content: flex-end;
    }
    .password-enter-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 18px;
    }
    .password-enter-btn svg {
      width: 13px;
      height: 13px;
    }

    /* Main Content */
    .password-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
    }

    /* Footer */
    .password-footer {
      width: 100%;
      padding: 24px 32px;
      border-top: 1px solid var(--border);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      color: #777777;
      background: #faf9f6;
      box-sizing: border-box;
      gap: 16px;
    }
    @media (max-width: 768px) {
      .password-footer {
        flex-direction: column;
        text-align: center;
        padding: 20px;
      }
    }
    .password-footer__copyright {
      margin: 0;
      letter-spacing: 0.04em;
    }
    .password-footer__social {
      display: flex;
      align-items: center;
      gap: 18px;
    }
    .password-footer__social a {
      color: #222222;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: color 0.2s, transform 0.15s;
    }
    .password-footer__social a:hover {
      color: var(--gold);
      transform: translateY(-2px);
    }
    .password-footer__social svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }
    .password-footer__owner a {
      color: #888888;
      text-decoration: underline;
      font-size: 11px;
      transition: color 0.2s;
    }
    .password-footer__owner a:hover {
      color: #111111;
    }

    /* Password Modal */
    .password-modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 10000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    .password-modal-backdrop.is-open {
      opacity: 1;
      visibility: visible;
    }
    .password-modal-card {
      background: #ffffff;
      width: 100%;
      max-width: 440px;
      padding: 36px 32px 32px;
      border-radius: 4px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
      position: relative;
      text-align: center;
      transform: translateY(20px) scale(0.97);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .password-modal-backdrop.is-open .password-modal-card {
      transform: translateY(0) scale(1);
    }
    .password-modal__close {
      position: absolute;
      top: 16px;
      right: 16px;
      background: transparent;
      border: none;
      color: #666666;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: color 0.2s, background 0.2s;
    }
    .password-modal__close:hover {
      color: #000000;
      background: #f0f0f0;
    }
    .password-modal__icon {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #f7f4ee;
      color: #b48a4c;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
    }
    .password-modal__title {
      font-family: 'Quicksand', sans-serif;
      font-size: 20px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #111111;
      margin: 0 0 8px 0;
    }
    .password-modal__subtitle {
      font-size: 13px;
      color: #666666;
      margin: 0 0 24px 0;
      line-height: 1.5;
    }
    .password-form__group {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
    }
    .password-form__input {
      width: 100%;
      padding: 13px 16px;
      font-family: 'Quicksand', sans-serif;
      font-size: 14px;
      border: 1px solid #d4cfc5;
      border-radius: var(--btn-radius);
      outline: none;
      box-sizing: border-box;
      text-align: center;
      letter-spacing: 0.1em;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .password-form__input:focus {
      border-color: #111111;
      box-shadow: 0 0 0 1px #111111;
    }
    .password-form__submit {
      width: 100%;
      padding: 13px;
    }
    .password-modal__errors {
      background: #fff3f3;
      border: 1px solid #ffd1d1;
      color: #c92a2a;
      padding: 10px 14px;
      border-radius: 4px;
      font-size: 12px;
      margin-bottom: 16px;
      text-align: left;
    }
    .password-modal__admin-link {
      margin-top: 20px;
      font-size: 11px;
      color: #888888;
    }
    .password-modal__admin-link a {
      color: #111111;
      text-decoration: underline;
    }
  </style>
  {% render 'custom-button-animations' %}
  <style>
    .btn { border-width: {{ settings.button_border_thickness | default: 1 }}px !important; {% if settings.button_uppercase %}text-transform: uppercase !important;{% endif %} }
  </style>
</head>
<body class="template-password">
  {%- liquid
    if settings.use_brand_logo and shop.brand.logo != blank
      assign global_logo = shop.brand.logo
    elsif settings.logo != blank
      assign global_logo = settings.logo
    else
      assign global_logo = shop.brand.logo
    endif
    assign pass_logo_w = settings.logo_width | default: 150
    assign pass_logo_ratio = global_logo.aspect_ratio | default: 2.2
  -%}

  <!-- Header -->
  <header class="password-header">
    <div class="password-header__left">
      <span style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #888888; font-weight: 600;">PRIVATE ACCESS</span>
    </div>

    <div class="password-header__center">
      <a href="{{ routes.root_url }}" class="password-header__logo-link" aria-label="{{ shop.name | escape }}">
        {%- if global_logo != blank -%}
          {%- assign pass_logo_w_2x = pass_logo_w | times: 2 -%}
          {%- assign pass_logo_w_3x = pass_logo_w | times: 3 -%}
          <img src="{{ global_logo | image_url: width: pass_logo_w_2x }}"
            srcset="{{ global_logo | image_url: width: pass_logo_w }} 1x, {{ global_logo | image_url: width: pass_logo_w_2x }} 2x, {{ global_logo | image_url: width: pass_logo_w_3x }} 3x"
            alt="{{ global_logo.alt | default: shop.name | escape }}"
            width="{{ pass_logo_w }}"
            height="{{ pass_logo_w | divided_by: pass_logo_ratio | round }}"
            loading="eager"
            style="image-rendering: -webkit-optimize-contrast;">
        {%- else -%}
          <img src="{{ 'aurelle_fine_jewelry_logo_transparent.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="{{ pass_logo_w }}"
            height="{{ pass_logo_w | divided_by: 4.1 | round }}"
            loading="eager">
        {%- endif -%}
      </a>
    </div>

    <div class="password-header__right">
      <button type="button" class="btn btn-sliding-hover password-enter-btn" data-password-modal-trigger aria-label="Enter store with password">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span>ENTER STORE</span>
      </button>
    </div>
  </header>

  <!-- Main Content -->
  <main class="password-main" role="main">
    {{ content_for_layout }}
  </main>

  <!-- Footer -->
  <footer class="password-footer">
    <p class="password-footer__copyright">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
    </p>

    <!-- Social Links -->
    <div class="password-footer__social">
      {%- if settings.social_instagram_link != blank -%}
        <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
      {%- endif -%}
      {%- if settings.social_tiktok_link != blank -%}
        <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok">
          <svg viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        </a>
      {%- endif -%}
    </div>

    <!-- Store Owner Login -->
    <div class="password-footer__owner">
      <span>Store owner? <a href="/admin">Log in here</a></span>
    </div>
  </footer>

  <!-- Password Access Modal -->
  <div class="password-modal-backdrop" id="PasswordModal" role="dialog" aria-modal="true" aria-labelledby="PasswordModalTitle">
    <div class="password-modal-card">
      <button type="button" class="password-modal__close" data-password-modal-close aria-label="Close dialog">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>

      <div class="password-modal__icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </div>

      <h2 class="password-modal__title" id="PasswordModalTitle">Private Store Access</h2>
      <p class="password-modal__subtitle">Enter your private access password to enter the store:</p>

      {% form 'storefront_password', class: 'password-login-form', id: 'PasswordLoginForm' %}
        {%- if form.errors -%}
          {%- assign password_form_has_errors = true -%}
          <div class="password-modal__errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="password-form__group">
          <label for="StorePasswordInput" class="visually-hidden">Store Password</label>
          <input type="password"
            name="password"
            id="StorePasswordInput"
            class="password-form__input"
            placeholder="Enter store password"
            autocomplete="current-password"
            required
            autofocus>
          <button type="submit" name="commit" class="btn btn-sliding-hover password-form__submit">
            ENTER STORE
          </button>
        </div>
      {% endform %}

      <div class="password-modal__admin-link">
        Are you the store owner? <a href="/admin">Log in to Shopify admin</a>
      </div>
    </div>
  </div>

  <!-- Interactive Modal Script -->
  <script>
    (function() {
      var modal = document.getElementById('PasswordModal');
      var openButtons = document.querySelectorAll('[data-password-modal-trigger]');
      var closeButtons = document.querySelectorAll('[data-password-modal-close]');
      var passwordInput = document.getElementById('StorePasswordInput');

      function openModal() {
        if (!modal) return;
        modal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        setTimeout(function() {
          if (passwordInput) passwordInput.focus();
        }, 150);
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      openButtons.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          openModal();
        });
      });

      closeButtons.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          closeModal();
        });
      });

      // Click outside card to close
      if (modal) {
        modal.addEventListener('click', function(e) {
          if (e.target === modal) {
            closeModal();
          }
        });
      }

      // Close on Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal && modal.classList.contains('is-open')) {
          closeModal();
        }
      });

      // Automatically open modal if there are form errors (e.g. invalid password submitted)
      {% if password_form_has_errors %}
        openModal();
      {% endif %}
    })();
  </script>
</body>
</html>
