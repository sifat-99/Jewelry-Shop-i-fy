<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#000000">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
  {%- else -%}
    <link rel="shortcut icon" href="{{ 'favicon.png' | asset_url }}" type="image/png">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags -%}
      {%- assign meta_tags = current_tags | join: ', ' | escape -%}
      &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}
    {%- endif -%}
    {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {% render 'social-meta-tags' %}

  <!-- Fonts & Stylesheets -->
  {% render 'theme-typography', part: 'head' %}
  {{ 'font-settings.css' | asset_url | stylesheet_tag }}
  {% render 'css-variables' %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <style>
    :root {
      --lv-rating-star-gold: #d4af37;
      --lv-rating-star-empty: #ded8c8;
      --lv-rating-star-shadow: rgba(141, 104, 21, 0.22);
    }
    html .product__rating__star:before,
    html .spr-badge-starrating .spr-icon-star,
    html .spr-badge-starrating .spr-icon-star-half-alt {
      color: var(--lv-rating-star-gold) !important;
      text-shadow: 0 1px 2px var(--lv-rating-star-shadow);
    }
    html .spr-badge-starrating .spr-icon-star-empty {
      color: var(--lv-rating-star-empty) !important;
    }
    .lv-rating-stars { display: inline-flex; align-items: center; gap: 2px; color: transparent; white-space: nowrap; }
    .lv-rating-stars__star { display: inline-block; color: transparent; font-size: 1em; font-weight: 700; line-height: 1; background: linear-gradient(90deg, var(--lv-rating-star-gold) 0 var(--lv-star-fill), var(--lv-rating-star-empty) var(--lv-star-fill) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 1px 0 var(--lv-rating-star-shadow)); }
    body {
      font-family: var(--FONT-STACK-BODY, 'Quicksand', -apple-system, BlinkMacSystemFont, sans-serif);
      font-weight: var(--FONT-WEIGHT-BODY, 500);
      color: var(--text, #000000);
      background-color: var(--bg, #ffffff);
      -webkit-font-smoothing: antialiased;
      margin: 0;
      padding: 0;
    }
    a {
      text-decoration: none;
      color: inherit;
    }

    /* === Dynamic Online Store 2.0 Color Schemes === */
    {%- comment -%}
      ===== Aurelle Theme Palette =====
      One master palette (Theme settings > Theme Palette) drives all color schemes, the gold accent and the buttons.
      Every text/button color is contrast-checked so no scheme ends up unreadable.
    {%- endcomment -%}
    {%- liquid
      assign pal_on = settings.palette_control
      if pal_on == nil
        assign pal_on = true
      endif
      assign pal_preset = settings.palette_preset | default: 'champagne'

      case pal_preset
        when 'rose'
          assign p_ivory = '#fffafa'
          assign p_cream = '#fbeeec'
          assign p_sand = '#f4dcd6'
          assign p_ink = '#2b1a1e'
          assign p_accent = '#b76e79'
          assign p_dark = '#3a1f27'
          assign p_line = '#eacfca'
        when 'platinum'
          assign p_ivory = '#fbfcfd'
          assign p_cream = '#eff2f5'
          assign p_sand = '#dfe4ea'
          assign p_ink = '#0f1319'
          assign p_accent = '#5d6b7c'
          assign p_dark = '#12171f'
          assign p_line = '#d5dbe2'
        when 'emerald'
          assign p_ivory = '#fafdfb'
          assign p_cream = '#eaf2ec'
          assign p_sand = '#d9e7dd'
          assign p_ink = '#0e1f17'
          assign p_accent = '#b08d4a'
          assign p_dark = '#0a2d21'
          assign p_line = '#cfe0d5'
        when 'midnight'
          assign p_ivory = '#fafbff'
          assign p_cream = '#edf0fa'
          assign p_sand = '#dce2f4'
          assign p_ink = '#0e1430'
          assign p_accent = '#b08d57'
          assign p_dark = '#0e1430'
          assign p_line = '#d3d9ec'
        when 'custom'
          assign p_ivory = settings.pal_ivory | default: '#ffffff'
          assign p_cream = settings.pal_cream | default: '#f7f5f0'
          assign p_sand = settings.pal_sand | default: '#f0e9dd'
          assign p_ink = settings.pal_ink | default: '#1a1a1a'
          assign p_accent = settings.pal_accent | default: '#9b7c53'
          assign p_dark = settings.pal_dark | default: '#1c1a17'
          assign p_line = settings.pal_line | default: '#e6e2d8'
        else
          assign p_ivory = '#ffffff'
          assign p_cream = '#f7f5f0'
          assign p_sand = '#f0e9dd'
          assign p_ink = '#1a1a1a'
          assign p_accent = '#9b7c53'
          assign p_dark = '#1c1a17'
          assign p_line = '#e6e2d8'
      endcase

      comment
        Accent used as TEXT on light backgrounds: darken until it reaches 4.5:1 on ivory.
        Accent used on DARK backgrounds: lighten until it reaches 4.5:1 on the dark color.
      endcomment
      assign p_accent_deep = p_accent
      assign c_deep = p_accent_deep | color_contrast: p_ivory
      if c_deep < 4.5
        assign p_accent_deep = p_accent_deep | color_darken: 8
        assign c_deep = p_accent_deep | color_contrast: p_ivory
      endif
      if c_deep < 4.5
        assign p_accent_deep = p_accent_deep | color_darken: 8
        assign c_deep = p_accent_deep | color_contrast: p_ivory
      endif
      if c_deep < 4.5
        assign p_accent_deep = p_accent_deep | color_darken: 8
      endif

      assign p_accent_light = p_accent
      assign c_light = p_accent_light | color_contrast: p_dark
      if c_light < 4.5
        assign p_accent_light = p_accent_light | color_lighten: 12
        assign c_light = p_accent_light | color_contrast: p_dark
      endif
      if c_light < 4.5
        assign p_accent_light = p_accent_light | color_lighten: 12
      endif

      assign p_tint = p_accent | color_lighten: 40
      assign p_border = p_line | color_darken: 7
      assign p_dark_line = p_dark | color_lighten: 10
      assign p_ink_hover = p_ink | color_lighten: 14
    -%}
    {% for scheme in settings.color_schemes -%}
    {% liquid
      assign s_background = scheme.settings.background
      assign s_background_gradient = scheme.settings.background_gradient
      assign s_text = scheme.settings.text
      assign s_button = scheme.settings.button
      assign s_button_label = scheme.settings.button_label
      assign s_secondary_button_label = scheme.settings.secondary_button_label
      assign s_shadow = scheme.settings.shadow
      assign s_accent = settings.brand_accent | default: '#9b7c53'
      assign s_btn_bg = settings.button_bg | default: s_button
      assign s_btn_text = settings.button_text | default: s_button_label
      assign s_btn_hover_bg = settings.btn_hover_bg | default: s_text
      assign s_btn_hover_text = settings.btn_hover_text | default: s_background
      assign s_btn_border = settings.button_border_color | default: s_btn_bg
      assign s_btn_hover_border = settings.btn_hover_border_color | default: s_btn_hover_bg
      assign s_sel_bg = s_btn_hover_bg
      assign s_sel_text = s_btn_hover_text
      assign s_sel_border = s_btn_hover_border
      assign s_sel_hover_bg = s_btn_bg
      assign s_sel_hover_text = s_btn_text
      assign s_sel_hover_border = s_btn_border
      assign s_round_bg = settings.round_button_bg | default: s_background
      assign s_round_text = settings.round_button_text | default: s_text

      if pal_on
        assign s_background_gradient = ''
        assign s_accent = p_accent
        case scheme.id
          when 'scheme-1'
            assign s_background = p_ivory
            assign s_text = p_ink
            assign s_button = p_ink
            assign s_button_label = p_ivory
            assign s_secondary_button_label = p_ink
            assign s_shadow = p_border
            assign s_btn_hover_bg = p_ink_hover
            assign s_btn_hover_text = p_ivory
          when 'scheme-2'
            assign s_background = p_cream
            assign s_text = p_ink
            assign s_button = p_ink
            assign s_button_label = p_cream
            assign s_secondary_button_label = p_ink
            assign s_shadow = p_border
            assign s_btn_hover_bg = p_ink_hover
            assign s_btn_hover_text = p_cream
          when 'scheme-3'
            assign s_background = p_sand
            assign s_text = p_ink
            assign s_button = p_ink
            assign s_button_label = p_sand
            assign s_secondary_button_label = p_ink
            assign s_shadow = p_border
            assign s_btn_hover_bg = p_ink_hover
            assign s_btn_hover_text = p_sand
          when 'scheme-4'
            assign s_background = p_tint
            assign s_text = p_ink
            assign s_button = p_accent_deep
            assign l_white = p_accent_deep | color_contrast: p_ivory
            assign l_ink = p_accent_deep | color_contrast: p_ink
            if l_white >= l_ink
              assign s_button_label = p_ivory
            else
              assign s_button_label = p_ink
            endif
            assign s_secondary_button_label = p_accent_deep
            assign s_shadow = p_border
            assign s_btn_hover_bg = p_ink
            assign s_btn_hover_text = p_ivory
          when 'scheme-5'
            assign s_background = p_dark
            assign s_text = p_ivory
            assign s_button = p_accent_light
            assign l_white = p_accent_light | color_contrast: p_ivory
            assign l_dark = p_accent_light | color_contrast: p_dark
            if l_white >= l_dark
              assign s_button_label = p_ivory
            else
              assign s_button_label = p_dark
            endif
            assign s_secondary_button_label = p_accent_light
            assign s_shadow = p_dark_line
            assign s_btn_hover_bg = p_ivory
            assign s_btn_hover_text = p_dark
        endcase
        comment
          Button colors: one palette-driven style for every button. Light schemes vs the dark scheme get matching pairs.
        endcomment
        assign pal_dark_scheme = false
        if scheme.id == 'scheme-5'
          assign pal_dark_scheme = true
        endif
        assign btn_style = settings.palette_button_style | default: 'ivory'
        assign l_w = p_accent_deep | color_contrast: p_ivory
        assign l_i = p_accent_deep | color_contrast: p_ink
        assign gold_label = p_ink
        if l_w >= l_i
          assign gold_label = p_ivory
        endif
        assign l_w2 = p_accent_light | color_contrast: p_ivory
        assign l_d2 = p_accent_light | color_contrast: p_dark
        assign gold_label_dark = p_dark
        if l_w2 >= l_d2
          assign gold_label_dark = p_ivory
        endif

        if btn_style == 'ink'
          if pal_dark_scheme
            assign s_btn_bg = p_accent_light
            assign s_btn_text = gold_label_dark
            assign s_btn_border = p_accent_light
            assign s_btn_hover_bg = p_ivory
            assign s_btn_hover_text = p_dark
          else
            assign s_btn_bg = p_ink
            assign s_btn_text = p_ivory
            assign s_btn_border = p_ink
            assign s_btn_hover_bg = p_ink_hover
            assign s_btn_hover_text = p_ivory
          endif
        elsif btn_style == 'gold'
          if pal_dark_scheme
            assign s_btn_bg = p_accent_light
            assign s_btn_text = gold_label_dark
            assign s_btn_border = p_accent_light
            assign s_btn_hover_bg = p_ivory
            assign s_btn_hover_text = p_dark
          else
            assign s_btn_bg = p_accent_deep
            assign s_btn_text = gold_label
            assign s_btn_border = p_accent_deep
            assign s_btn_hover_bg = p_ink
            assign s_btn_hover_text = p_ivory
          endif
        elsif btn_style == 'outline'
          if pal_dark_scheme
            assign s_btn_bg = 'transparent'
            assign s_btn_text = p_ivory
            assign s_btn_border = p_ivory
            assign s_btn_hover_bg = p_ivory
            assign s_btn_hover_text = p_dark
          else
            assign s_btn_bg = 'transparent'
            assign s_btn_text = p_ink
            assign s_btn_border = p_ink
            assign s_btn_hover_bg = p_ink
            assign s_btn_hover_text = p_ivory
          endif
        else
          if pal_dark_scheme
            assign s_btn_bg = p_ivory
            assign s_btn_text = p_dark
            assign s_btn_border = p_ivory
            assign s_btn_hover_bg = p_accent_light
            assign s_btn_hover_text = p_dark
          else
            assign s_btn_bg = p_ivory
            assign s_btn_text = p_ink
            assign s_btn_border = p_border
            assign s_btn_hover_bg = p_ink
            assign s_btn_hover_text = p_ivory
          endif
        endif
        assign s_btn_hover_border = s_btn_hover_bg
        comment
          Selected / active state of pills, toggles, tabs, pagination: same family as the button style.
          Solid styles keep the button colors, white and outline styles use the hover (dark) colors.
        endcomment
        case btn_style
          when 'ink', 'gold'
            assign s_sel_bg = s_btn_bg
            assign s_sel_text = s_btn_text
            assign s_sel_border = s_btn_border
            assign s_sel_hover_bg = s_btn_hover_bg
            assign s_sel_hover_text = s_btn_hover_text
            assign s_sel_hover_border = s_btn_hover_border
          else
            assign s_sel_bg = s_btn_hover_bg
            assign s_sel_text = s_btn_hover_text
            assign s_sel_border = s_btn_hover_bg
            assign s_sel_hover_bg = s_btn_bg
            assign s_sel_hover_text = s_btn_text
            assign s_sel_hover_border = s_btn_border
        endcase
        assign s_round_bg = s_background
        assign s_round_text = s_text
      endif
    %}
      {% if forloop.index == 1 -%}
        :root,
      {%- endif %}
      .color-{{ scheme.id }} {
        --color-background: {{ s_background | color_extract: 'red' }},{{ s_background | color_extract: 'green' }},{{ s_background | color_extract: 'blue' }};
        {% if s_background_gradient != empty and s_background_gradient != blank %}
          --gradient-background: {{ s_background_gradient }};
        {% else %}
          --gradient-background: {{ s_background }};
        {% endif %}
        --color-foreground: {{ s_text | color_extract: 'red' }},{{ s_text | color_extract: 'green' }},{{ s_text | color_extract: 'blue' }};
        --color-button: {{ s_button | color_extract: 'red' }},{{ s_button | color_extract: 'green' }},{{ s_button | color_extract: 'blue' }};
        --color-button-text: {{ s_button_label | color_extract: 'red' }},{{ s_button_label | color_extract: 'green' }},{{ s_button_label | color_extract: 'blue' }};
        --color-secondary-button-text: {{ s_secondary_button_label | color_extract: 'red' }},{{ s_secondary_button_label | color_extract: 'green' }},{{ s_secondary_button_label | color_extract: 'blue' }};
        --color-shadow: {{ s_shadow | color_extract: 'red' }},{{ s_shadow | color_extract: 'green' }},{{ s_shadow | color_extract: 'blue' }};

        /* Theme variable overrides */
        --page-width: {{ settings.page_width | default: 1600 }}px;
        --LAYOUT-WIDTH: {{ settings.page_width | default: 1600 }}px;
        --spacing-sections: {{ settings.spacing_sections | default: 30 }}px;
        --grid-horizontal-space: {{ settings.grid_horizontal_space | default: 20 }}px;
        --grid-vertical-space: {{ settings.grid_vertical_space | default: 24 }}px;
        --BUTTON-RADIUS: {{ settings.button_border_radius | default: 0 }}px;
        --btn-radius: {{ settings.button_border_radius | default: 0 }}px;
        --btn-animation-duration: {% if settings.enable_hover_animations == false %}0ms{% else %}{{ settings.button_hover_speed | default: 450 }}ms{% endif %};
        --btn-ease: cubic-bezier(0.65, 0, 0.35, 1);
        --btn-border-thickness: {{ settings.button_border_thickness | default: 1 }}px;
        --input-radius: {{ settings.input_border_radius | default: 0 }}px;
        --card-radius: {{ settings.card_border_radius | default: 0 }}px;
        --badge-radius: {{ settings.badge_corner_radius | default: 2 }}px;
        --product-gallery-radius: {{ settings.product_gallery_radius | default: 0 }}px;
        --product-thumb-radius: {{ settings.product_thumb_radius | default: settings.product_gallery_radius | default: 0 }}px;
        --media-radius: {{ settings.media_border_radius | default: settings.card_border_radius | default: 0 }}px;
        --cart-image-radius: {{ settings.media_border_radius | default: settings.card_border_radius | default: 0 }}px;
        --bg: {{ s_background }};
        --bg-accent: {{ s_background }};
        --text: {{ s_text }};
        --text-dark: {{ s_text }};
        --text-light: rgba({{ s_text | color_extract: 'red' }}, {{ s_text | color_extract: 'green' }}, {{ s_text | color_extract: 'blue' }}, 0.88);
        --contrast: {{ s_text }};
        --border: {{ s_shadow }};
        --hairline: {{ s_shadow }};
        --lv-border: {{ s_shadow }};
        --primary: {{ s_button }};
        --secondary: {{ s_secondary_button_label }};
        --COLOR-ANNOUNCEMENT-BG: {{ s_background }};
        --COLOR-ANNOUNCEMENT-TEXT: {{ s_text }};
        --COLOR-FOOTER-BG: {{ s_background }};
        --COLOR-FOOTER-TEXT: {{ s_text }};

        --lv-accent: {{ s_accent }};

        /* Universal Round Button Color Variables (Online Store 2.0 Color Schemes) */
        --round-btn-bg: {{ s_round_bg }};
        --round-btn-text: {{ s_round_text }};
        --round-btn-border: rgba({{ s_text | color_extract: 'red' }}, {{ s_text | color_extract: 'green' }}, {{ s_text | color_extract: 'blue' }}, 0.14);
        --round-btn-hover-bg: {{ s_btn_hover_bg }};
        --round-btn-hover-text: {{ s_btn_hover_text }};
        --round-btn-hover-border: {{ s_btn_hover_bg }};
        --round-btn-shadow: rgba({{ s_shadow | color_extract: 'red' }}, {{ s_shadow | color_extract: 'green' }}, {{ s_shadow | color_extract: 'blue' }}, 0.16);

        /* Universal Regular (Square/Rectangular) Button Color Variables (Online Store 2.0 Color Schemes) */
        --btn-regular-bg: {{ s_btn_bg }};
        --btn-regular-text: {{ s_btn_text }};
        --btn-regular-border: {{ s_btn_border }};
        --btn-regular-hover-bg: {{ s_btn_hover_bg }};
        --btn-regular-hover-text: {{ s_btn_hover_text }};
        --btn-regular-hover-border: {{ s_btn_hover_border }};
        --btn-selected-bg: {{ s_sel_bg }};
        --btn-selected-text: {{ s_sel_text }};
        --btn-selected-border: {{ s_sel_border }};
        --btn-selected-hover-bg: {{ s_sel_hover_bg }};
        --btn-selected-hover-text: {{ s_sel_hover_text }};
        --btn-selected-hover-border: {{ s_sel_hover_border }};

        /* Soft / Muted Button Variables */
        --btn-soft-bg: var(--btn-regular-bg);
        --btn-soft-text: var(--btn-regular-text);
        --btn-soft-border: var(--btn-regular-border);
        --btn-soft-hover-bg: var(--btn-regular-hover-bg);
        --btn-soft-hover-text: var(--btn-regular-hover-text);
        --btn-soft-hover-border: var(--btn-regular-hover-border);

        /* Outline Button Variables */
        --btn-outline-bg: var(--btn-regular-bg);
        --btn-outline-text: var(--btn-regular-text);
        --btn-outline-border: var(--btn-regular-border);
        --btn-outline-hover-bg: var(--btn-regular-hover-bg);
        --btn-outline-hover-text: var(--btn-regular-hover-text);
        --btn-outline-hover-border: var(--btn-regular-hover-border);

        /* Global Universal Button Setting Overrides (theme settings) */
        background-color: {{ s_background }};
        color: {{ s_text }};
      }
      .color-{{ scheme.id }} .btn--primary,
      .color-{{ scheme.id }} .btn--soft {
        background-color: {{ s_btn_bg }};
        color: {{ s_btn_text }};
        border-color: {{ s_btn_border }};
      }
      .color-{{ scheme.id }} .btn--primary:hover,
      .color-{{ scheme.id }} .btn--soft:hover,
      .color-{{ scheme.id }} .btn:hover {
        color: var(--btn-regular-hover-text) !important;
      }
      .color-{{ scheme.id }} .btn--primary:hover *,
      .color-{{ scheme.id }} .btn--soft:hover *,
      .color-{{ scheme.id }} .btn:hover * {
        color: var(--btn-regular-hover-text) !important;
      }
      .color-{{ scheme.id }} .text-black {
        color: {{ s_text }};
      }
      .color-{{ scheme.id }} .text-gray-500,
      .color-{{ scheme.id }} .text-gray-600 {
        color: rgba({{ s_text | color_extract: 'red' }}, {{ s_text | color_extract: 'green' }}, {{ s_text | color_extract: 'blue' }}, 0.85);
      }
      .color-{{ scheme.id }} .border-gray-100,
      .color-{{ scheme.id }} .border-gray-200 {
        border-color: rgba({{ s_shadow | color_extract: 'red' }}, {{ s_shadow | color_extract: 'green' }}, {{ s_shadow | color_extract: 'blue' }}, 0.25);
      }
    {% endfor %}

    /* Aurelle palette, available to every section: var(--lv-ivory) ... var(--lv-line) */
    :root {
      --lv-ivory: {{ p_ivory }};
      --lv-cream: {{ p_cream }};
      --lv-sand: {{ p_sand }};
      --lv-ink: {{ p_ink }};
      --lv-dark: {{ p_dark }};
      --lv-line: {{ p_line }};
      --lv-accent-deep: {{ p_accent_deep }};
      --lv-accent-light: {{ p_accent_light }};
    }

    /* ==========================================================================
       Global Synced Luxury Typography & High-Contrast Palette
       Driven by Theme settings > Typography
       ========================================================================== */
    /* Universal Headings & Titles */
    h1, h2, h3, h4, h5, h6,
    .h1, .h2, .h3, .h4, .h5, .h6,
    .hero__title,
    .hero__title p,
    .section__title,
    .standard__heading,
    .standard__heading p,
    .tile__title,
    [class*="heading-size-"] {
      font-family: var(--FONT-STACK-HEADING) !important;
      font-weight: var(--FONT-WEIGHT-HEADING) !important;
      letter-spacing: var(--FONT-HEADING-LETTER-SPACING);
      text-transform: var(--FONT-HEADING-TRANSFORM);
      color: var(--text, #111111) !important;
      opacity: 1 !important;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Section Flourished Headings */
    .kicker-flourished {
      font-family: var(--FONT-STACK-HEADING) !important;
      font-size: calc(clamp(22px, 2.6vw, 30px) * var(--FONT-ADJUST-HEADING, 1)) !important;
      font-weight: var(--FONT-WEIGHT-HEADING) !important;
      letter-spacing: var(--FONT-HEADING-LETTER-SPACING) !important;
      text-transform: var(--FONT-HEADING-TRANSFORM) !important;
      color: var(--text, #111111) !important;
      opacity: 1 !important;
      padding-bottom: 14px !important;
      text-align: center;
    }
    .kicker-flourished:after {
      opacity: 0.85 !important;
      background-color: var(--text, #111111) !important;
      height: 2px !important;
      width: 38px !important;
    }

    /* Subheadings, Eyebrows & Accents */
    .hero__subtitle,
    .subheading,
    .subtitle,
    .type-accent,
    .accent-title,
    .accent-title-large,
    [class*="accent-size-"],
    .banner__subheading {
      font-family: var(--FONT-STACK-SUBHEADING) !important;
      text-transform: var(--FONT-SUBHEADING-TRANSFORM);
      letter-spacing: var(--FONT-SUBHEADING-LETTER-SPACING);
    }
    .standard__kicker,
    .lv-acct-eyebrow,
    .search-eyebrow,
    .pg-page__eyebrow,
    .dp__eyebrow,
    .sl-hero__eyebrow,
    .sl-sec__eyebrow,
    .sl-cta__eyebrow,
    .account-eyebrow,
    .customer-auth-eyebrow {
      font-family: var(--TYPE-STACK-KICKER) !important;
    }

    /* Header Navigation Items */
    .navlink,
    .navlink--toplevel,
    .navlink--toplevel .navtext,
    .navtext {
      font-family: var(--TYPE-STACK-NAV) !important;
      font-size: {{ settings.nav_font_size | default: 13 }}px !important;
      font-weight: {{ settings.nav_font_weight | default: 600 }} !important;
      letter-spacing: var(--FONT-NAV-LETTER-SPACING, 0.09em) !important;
      color: var(--text, #111111) !important;
      opacity: 1 !important;
      text-transform: {% if settings.nav_uppercase %}uppercase{% else %}none{% endif %} !important;
    }
    .header__menu__inner .menu__item .navlink--toplevel {
      opacity: 1 !important;
      color: var(--text, #111111) !important;
    }
    .header__menu__inner:hover .menu__item:not(:hover) .navlink--toplevel {
      opacity: 0.72 !important;
    }
    .header__menu__inner .menu__item:hover .navlink--toplevel {
      opacity: 1 !important;
      color: var(--text, #000000) !important;
    }
    .header__desktop__button svg,
    .header__mobile__button svg {
      color: var(--text, #111111) !important;
      stroke-width: 2px !important;
      opacity: 1 !important;
    }

    /* Global Button and Form Radius & Styling */
    .btn, .btn--primary, .btn--outline, .btn--soft, .btn--white, .btn--full, .btn--large, .btn--hero, .btn--neutral, .btn--add-to-cart, .btn-sliding-hover, .hero__btn, button.btn {
      border-radius: {{ settings.button_border_radius | default: 0 }}px !important;
      border-width: {{ settings.button_border_thickness | default: 1 }}px !important;
      font-family: var(--TYPE-STACK-BUTTON) !important;
      font-size: {{ settings.button_font_size | default: 12 }}px !important;
      font-weight: {{ settings.button_font_weight | default: 600 }} !important;
      letter-spacing: {{ settings.button_letter_spacing | default: 14 | divided_by: 100.0 }}em !important;
      {% if settings.button_uppercase %}
        text-transform: uppercase !important;
      {% else %}
        text-transform: none !important;
      {% endif %}
    }
    input[type="text"], input[type="email"], input[type="password"], input[type="search"], textarea, select {
      border-radius: {{ settings.input_border_radius | default: 0 }}px !important;
      border-width: {{ settings.input_border_thickness | default: 1 }}px !important;
      font-family: var(--FONT-STACK-BODY);
    }
    /* One border color for every field (Theme Palette > border); focus uses the text color */
    input[type="text"], input[type="email"], input[type="password"], input[type="search"], input[type="tel"], input[type="number"], input[type="url"], textarea, select {
      border-color: var(--lv-border);
      font-family: var(--FONT-STACK-BODY);
    }
    input[type="text"]:focus, input[type="email"]:focus, input[type="password"]:focus, input[type="search"]:focus, input[type="tel"]:focus, input[type="number"]:focus, input[type="url"]:focus, textarea:focus, select:focus {
      border-color: var(--text);
    }

    /* Announcement Bar Ticker */
    .announcement,
    .announcement [data-ticker-text],
    .announcement [data-ticker-text] p,
    .announcement [data-ticker-text] strong,
    .announcement [data-ticker-text] a {
      font-family: var(--TYPE-STACK-NAV) !important;
      font-size: 12.5px !important;
      font-weight: 600 !important;
      letter-spacing: 0.12em !important;
      color: var(--text, #111111) !important;
      opacity: 1 !important;
    }

    /* Rich text & body paragraphs */
    body, p, li, .rte, .rte p {
      font-family: var(--FONT-STACK-BODY);
      color: var(--text, #1a1a1a);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    .rte p {
      font-weight: var(--FONT-WEIGHT-BODY, 500);
    }
    .text-muted, .text-gray-500, .text-gray-600 {
      color: #3b3632 !important;
    }

    /* Product Grid Card Typography */
    .product__grid__title {
      font-family: var(--FONT-STACK-CARD-TITLE, var(--FONT-STACK-HEADING)) !important;
      font-size: var(--FONT-SIZE-CARD-TITLE, 13px) !important;
      font-weight: var(--FONT-WEIGHT-CARD-TITLE, 600) !important;
      color: var(--text, #111111) !important;
      letter-spacing: 0.04em !important;
      opacity: 1 !important;
    }
    .price-item--regular {
      font-weight: 600 !important;
      opacity: 1 !important;
    }

    /* Split Section Hero Titles & Subtitles */
    .collection-split__block .hero__title {
      font-size: calc(clamp(24px, 3.2vw, 38px) * var(--FONT-ADJUST-HEADING, 1)) !important;
      font-weight: var(--FONT-WEIGHT-HEADING, 600) !important;
      letter-spacing: var(--FONT-HEADING-LETTER-SPACING, 0.06em) !important;
      text-transform: var(--FONT-HEADING-TRANSFORM, uppercase) !important;
      color: #ffffff !important;
      opacity: 1 !important;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35) !important;
    }
    .collection-split__block .hero__subtitle {
      font-family: var(--FONT-STACK-SUBHEADING) !important;
      font-size: 13.5px !important;
      font-weight: 500 !important;
      letter-spacing: 0.06em !important;
      color: #ffffff !important;
      opacity: 1 !important;
      text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35) !important;
    }

    /* Footer Typography */
    .footer__title {
      font-family: var(--FONT-STACK-CARD-TITLE, var(--FONT-STACK-HEADING)) !important;
      font-size: 13px !important;
      font-weight: 700 !important;
      letter-spacing: 0.12em !important;
      text-transform: uppercase !important;
      color: var(--text, #111111) !important;
      opacity: 1 !important;
    }
    .footer__quicklinks a {
      font-family: var(--FONT-STACK-BODY) !important;
      font-size: 13px !important;
      font-weight: var(--FONT-WEIGHT-BODY, 500) !important;
      color: var(--text, #222222) !important;
      opacity: 1 !important;
    }
    .footer__quicklinks a:hover {
      color: var(--text, #000000) !important;
    }
  </style>

  {% render 'custom-button-animations' %}
  {% render 'loading-states' %}
  {% render 'policy-page-css' %}
  {%- if settings.button_fill_slide %}{% render 'button-fill-slide' %}{% endif %}
  {% render 'sale-badge-css' %}
  {% render 'card-mini-add-assets' %}

  {%- liquid
    assign smooth_scroll_on = settings.enable_smooth_scroll
    if smooth_scroll_on == nil
      assign smooth_scroll_on = true
    endif
    assign smooth_scroll_anchors_on = settings.smooth_scroll_anchors
    if smooth_scroll_anchors_on == nil
      assign smooth_scroll_anchors_on = true
    endif
  -%}
  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    document.documentElement.classList.add('aos-initialized');
    let root = '{{ routes.root_url }}';
    if (root[root.length - 1] !== '/') {
      root = `${root}/`;
    }
    var theme = {
      routes: {
        root_url: root,
        cart: '{{ routes.cart_url }}',
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        search_url: '{{ routes.search_url }}',
        all_products_collection_url: '{{ routes.all_products_collection_url }}',
        product_recommendations_url: '{{ routes.product_recommendations_url }}',
        account_addresses_url: '{{ routes.account_addresses_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      },
      state: {
        cartOpen: null,
      },
      sizes: {
        small: 480,
        medium: 768,
        large: 1100,
        widescreen: 1400
      },
      assets: {
        photoswipe: '{{ "photoswipe.js" | asset_url }}',
        smoothscroll: '{{ "smoothscroll.js" | asset_url }}',
        swatches: '{{ "swatches.json" | asset_url }}',
        base: '{{ "" | asset_url }}'
      },
      strings: {
        swatchesKey: "Colour",
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        preOrder: {{ 'products.product.pre_order' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }},
        sale: {{ 'products.product.sale' | t | json }},
        subscription: {{ 'products.product.subscription' | t | json }},
        successMessage: {{ 'products.product.link_copied' | t | json }},
        noShippingAvailable: {{ 'cart.shipping.no_shipping_available' | t | json }},
        stockout: {{ 'cart.general.stockout' | t | json }},
        free: {{ 'products.product.free' | t | json }},
        from: {{ 'products.product.from' | t | json }}
      },
      i18n: {
        shopName: {{ shop.name | json }},
        adding: {{ 'products.product.adding' | t | json }},
        added: {{ 'products.product.added' | t | json }},
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }},
        addFailed: {{ 'products.product.add_failed' | t | json }},
        onlyLeftTemplate: {{ 'products.product.only_left_js' | t | json }},
        percentOffTemplate: {{ 'products.product.percent_off' | t: percent: '__PERCENT__' | json }},
        saleBadgeText: {{ 'products.product.sale_badge_text' | t | json }},
        quickViewLoadError: {{ 'products.quick_view.load_error' | t | json }},
        wishlistAdded: {{ 'products.wishlist.added' | t | json }},
        wishlistRemoved: {{ 'products.wishlist.removed' | t | json }},
        wishlistIn: {{ 'products.wishlist.in_wishlist' | t | json }},
        wishlistAdd: {{ 'products.wishlist.add' | t | json }},
        cartAddError: {{ 'cart.general.add_error' | t | json }},
        cartNetworkError: {{ 'cart.general.network_error' | t | json }},
        saving: {{ 'customer.addresses.saving' | t | json }},
        addressSaved: {{ 'customer.addresses.saved' | t | json }},
        addressSaveError: {{ 'customer.addresses.save_error' | t | json }},
        confirmDeleteAddress: {{ 'customer.addresses.delete_confirm' | t | json }},
        addressDeleted: {{ 'customer.addresses.deleted' | t | json }},
        addressDeleteError: {{ 'customer.addresses.delete_error' | t | json }},
        ordersRefreshed: {{ 'customer.orders.refreshed' | t | json }},
        ordersRefreshError: {{ 'customer.orders.refresh_error' | t | json }},
        showMore: {{ 'collections.filtering.show_more' | t | json }},
        showLess: {{ 'collections.filtering.show_less' | t | json }}
      },
      settings: {
        badge_sale_type: {{ settings.sale_badge_type | default: "percentage" | json }},
        animate_hover: {{ settings.enable_hover_animations | default: true | json }},
        animate_scroll: {{ settings.enable_scroll_animations | default: true | json }},
        smooth_scroll: {{ smooth_scroll_on | json }},
        smooth_scroll_strength: {{ settings.smooth_scroll_strength | default: 3 | json }},
        smooth_scroll_anchors: {{ smooth_scroll_anchors_on | json }},
        currency_code_enable: {{ settings.currency_code_enabled | default: false | json }}
      },
      currency: {{ shop.currency | json }},
      currencyCode: {{ cart.currency.iso_code | default: shop.currency | json }},
      moneyFormat: {{ shop.money_format | json }}
    };
    let windowInnerHeight = window.innerHeight;
    document.documentElement.style.setProperty('--full-screen', `${windowInnerHeight}px`);
  </script>

  {%- if settings.custom_css != blank -%}
    <style id="ThemeCustomCSS">
      {{ settings.custom_css }}
    </style>
  {%- endif -%}

  {{ content_for_header }}

  <script src="{{ 'vendor.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  {%- if smooth_scroll_on -%}
    <script src="{{ 'smooth-page-scroll.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
</head>
<body id="{{ page_title | handle }}" class="template-{{ template.name | handle }}">
  {% sections 'header-group' %}

  <main id="MainContent" class="main-content" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <div class="search--popdown">
    {% render 'search-predictive', style: 'search-popdown' %}
  </div>

  {% render 'cart-drawer' %}
  {% render 'quick-view-modal' %}
</body>
</html>
