<!-- /templates/customers/activate_account.liquid -->
<div class="customer-auth-wrapper">
  <div class="customer-auth-container">
    <div class="customer-auth-card">
      <div class="customer-auth-header">
        <span class="customer-auth-badge">{{ 'customer.activate_account.badge' | t }}</span>
        <h1 class="customer-auth-title">{{ 'customer.activate_account.title' | t }}</h1>
        <p class="customer-auth-subtitle">{{ 'customer.activate_account.subtext' | t }}</p>
      </div>

      {%- form 'activate_customer_password', class: 'customer-auth-form' -%}
        {%- if form.errors -%}
          <div class="customer-auth-errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form-field">
          <label for="password" class="form-label">{{ 'customer.activate_account.password' | t }}</label>
          <input
            type="password"
            name="customer[password]"
            id="password"
            autocomplete="new-password"
            class="form-input"
            required
          >
        </div>

        <div class="form-field">
          <label for="password_confirmation" class="form-label">{{ 'customer.activate_account.password_confirm' | t }}</label>
          <input
            type="password"
            name="customer[password_confirmation]"
            id="password_confirmation"
            autocomplete="new-password"
            class="form-input"
            required
          >
        </div>

        <button type="submit" class="btn btn-sliding-hover customer-auth-btn">
          <span>{{ 'customer.activate_account.submit' | t }}</span>
        </button>

        <button type="submit" name="decline" class="btn btn-sliding-hover customer-auth-btn" style="margin-top: 10px;">
          <span>{{ 'customer.activate_account.cancel' | t }}</span>
        </button>
      {%- endform -%}
    </div>
  </div>
</div>
