<script>
  /* Auto-wrap button text nodes in a span so they are never covered by ::before pseudo-elements */
  (function() {
    function wrapButtonTextNodes() {
      var sel = '.btn, .btn--primary, .btn--soft, .btn--outline, .btn--hero, .btn--full, .btn--add-to-cart, .product-add-to-cart-btn, .checkout__button, #AddToCartMainBtn, .filter-drawer__apply-btn, .filter-drawer__clear-btn, .qv-add-btn, .collection-filter-toggle-btn, .search-empty-btn';
      var buttons = document.querySelectorAll(sel);
      buttons.forEach(function(btn) {
        Array.from(btn.childNodes).forEach(function(node) {
          if (node.nodeType === 3 && node.textContent.trim().length > 0) {
            var span = document.createElement('span');
            span.className = 'btn__text-content';
            node.parentNode.insertBefore(span, node);
            span.appendChild(node);
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', wrapButtonTextNodes);
    } else {
      wrapButtonTextNodes();
    }

    if (window.MutationObserver) {
      var observer = new MutationObserver(function() {
        wrapButtonTextNodes();
      });
      observer.observe(document.body || document.documentElement, { childList: true, subtree: true });
    }
  })();
</script>
