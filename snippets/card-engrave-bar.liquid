{%- comment -%}
  Hover bar for engravable products on product cards: a plain text button instead of the size/variant pills.
  Clicking it opens the variant + engraving popup or goes to the product page (Theme settings > Engraving).
  Accepts: product
{%- endcomment -%}
{%- if product != blank and product.available != false -%}
  {%- capture ce_raw -%}{% render 'engraving-info', product: product %}{%- endcapture -%}
  {%- assign ce_parts = ce_raw | strip | split: '~~' -%}
  {%- if ce_parts[0] == 'true' -%}
    <button type="button" class="lv-card-action-bar lv-card-direct-add-btn lv-card-eng-btn" data-lv-eng-bar aria-label="{{ settings.engraving_card_label | default: 'Personalise' | escape }}: {{ product.title | escape }}">
      <span class="lv-card-bar-label btn__text-content"><span>{{ settings.engraving_card_label | default: 'Personalise' }}</span></span>
    </button>
  {%- endif -%}
{%- endif -%}
