{% doc %}
  A customer review shown as a speech bubble (text + stars) with the customer's avatar, name and date below it.
  Used by the "Speech bubble slider" review design in sections/customer-feedback.liquid and sections/product-reviews.liquid.
  Colors come from the section's color scheme (--bg, --text) and the theme accent (--cf-accent).

  @param {string} [name] - Customer name
  @param {number} [rating] - Rating 0-5, halves allowed
  @param {string} [title] - Optional short review title
  @param {string} [body] - Review text
  @param {image} [photo] - Optional customer photo, used as the avatar
  @param {product} [reviewed_product] - Optional reviewed product (links the product name)
  @param {string} [product_title] - Optional product name when there is no product object
  @param {boolean} [verified] - Shows the verified badge
  @param {string} [date] - Date text shown under the name

  @example
  {% render 'feedback-bubble', name: 'Sarah M.', rating: 5, body: 'Beautiful quality.', verified: true, date: '2026-11-01' %}
{% enddoc %}

{%- liquid
  assign r = rating | plus: 0 | round: 1
  if r > 5
    assign r = 5
  endif
  if r < 0
    assign r = 0
  endif
  assign display_product_title = product_title
  assign product_url = ''
  if reviewed_product != blank
    assign display_product_title = reviewed_product.title | default: product_title
    assign product_url = reviewed_product.url
  elsif product_title != blank
    assign product_handle = product_title | handleize
    assign matched_product = all_products[product_handle]
    if matched_product != blank
      assign display_product_title = matched_product.title
      assign product_url = matched_product.url
    endif
  endif
-%}
<article class="cf-bubble">
  <div class="cf-bubble__box">
    {%- render 'rating-stars', rating: r, class_name: 'cf-stars cf-bubble__stars' -%}
    {%- if title != blank -%}<h3 class="cf-bubble__title">{{ title | escape }}</h3>{%- endif -%}
    {%- if body != blank -%}<p class="cf-bubble__text">{{ body | escape }}</p>{%- endif -%}
  </div>
  <div class="cf-bubble__by">
    {%- if photo != blank -%}
      <img class="cf-bubble__avatar" src="{{ photo | image_url: width: 120, height: 120, crop: 'center' }}" alt="{{ name | escape }}" width="44" height="44" loading="lazy">
    {%- else -%}
      <span class="cf-bubble__avatar cf-bubble__avatar--initial" aria-hidden="true">{{ name | strip | slice: 0 | upcase }}</span>
    {%- endif -%}
    <div class="cf-bubble__who">
      <p class="cf-bubble__name">{{ name | escape }}
        {%- if verified == true -%}
          <span class="cf-bubble__verified" title="{{ 'products.reviews.verified_buyer' | t }}" role="img" aria-label="{{ 'products.reviews.verified_buyer' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2l2.4 1.9 3-.3 1.1 2.8 2.7 1.4-.6 3 1.2 2.7-2.2 2.1-.3 3-3 .6-2 2.3-2.6-1.6-2.6 1.6-2-2.3-3-.6-.3-3-2.2-2.1 1.2-2.7-.6-3 2.7-1.4 1.1-2.8 3 .3L12 2zm-1.3 12.6l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1 2.8 2.8z"/></svg></span>
        {%- endif -%}
      </p>
      {%- if display_product_title != blank or date != blank -%}
        <p class="cf-bubble__meta">
          {%- if display_product_title != blank -%}
            {%- if product_url != blank -%}<a href="{{ product_url }}">{{ display_product_title | escape }}</a>{%- else -%}{{ display_product_title | escape }}{%- endif -%}
          {%- endif -%}
          {%- if display_product_title != blank and date != blank %} &middot; {% endif -%}
          {{- date -}}
        </p>
      {%- endif -%}
    </div>
  </div>
</article>

{% stylesheet %}
  .cf-bubble { display: flex; flex-direction: column; width: 100%; min-width: 0; }
  .cf-bubble__box {
    position: relative;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 26px 28px 24px;
    border-radius: 18px 18px 18px 0;
    background: color-mix(in srgb, var(--bg, #fff) 93%, var(--cf-accent, #9b7c53));
    color: var(--text, #111);
  }
  /* tail at the bottom-left corner of the bubble */
  .cf-bubble__box::after {
    content: "";
    position: absolute;
    left: 0;
    top: 100%;
    width: 22px;
    height: 16px;
    background: inherit;
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }
  .cf-bubble__stars { font-size: 18px; order: 2; margin-top: auto; }
  .cf-bubble__title { order: 0; margin: 0; font-size: 15px; font-weight: 700; line-height: 1.4; letter-spacing: 0.02em; text-transform: none; }
  .cf-bubble__text { order: 1; margin: 0; font-size: 15px; line-height: 1.75; }
  .cf-bubble__by { display: flex; align-items: center; gap: 12px; padding: 22px 0 0 14px; }
  .cf-bubble__avatar {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .cf-bubble__avatar--initial { background: var(--text, #111); color: var(--bg, #fff); font-size: 15px; font-weight: 600; }
  .cf-bubble__who { min-width: 0; }
  .cf-bubble__name { margin: 0; display: flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 600; line-height: 1.3; }
  .cf-bubble__verified { display: inline-flex; color: var(--cf-accent, #9b7c53); }
  .cf-bubble__verified svg { width: 16px; height: 16px; }
  .cf-bubble__meta { margin: 2px 0 0; font-size: 11.5px; line-height: 1.4; opacity: 0.7; }
  .cf-bubble__meta a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  @media (max-width: 650px) {
    .cf-bubble__box { padding: 22px 22px 20px; }
  }
{% endstylesheet %}
