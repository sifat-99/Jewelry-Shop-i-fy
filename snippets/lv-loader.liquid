{%- comment -%}
  Animated brand loader (4 corner facets around a diamond with a pulsing centre).
  Colours: Theme settings > Loading & skeleton. Size via --lv-loader-size.
{%- endcomment -%}
{%- if overlay and settings.enable_product_loader == false -%}{%- else -%}
{%- if overlay -%}<div class="lv-loader-overlay lv-skel-fill" aria-hidden="true">{%- endif -%}
<svg class="lv-loader" viewBox="0 0 100 100" role="img" aria-label="Loading" focusable="false">
  <polygon class="lv-loader__f lv-loader__f--a1" points="2,2 42,2 2,42"/>
  <polygon class="lv-loader__f lv-loader__f--b1" points="98,2 98,42 58,2"/>
  <polygon class="lv-loader__f lv-loader__f--a2" points="98,98 58,98 98,58"/>
  <polygon class="lv-loader__f lv-loader__f--b2" points="2,98 2,58 42,98"/>
  <polygon class="lv-loader__d" points="50,12 88,50 50,88 12,50"/>
  <rect class="lv-loader__c" x="33" y="33" width="34" height="34"/>
</svg>
{%- if overlay -%}</div>{%- endif -%}
{%- endif -%}
