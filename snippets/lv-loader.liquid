{% doc %}
  Animated brand loader - Aurelle luxury jewelry streaming marquee featuring delicate chain necklace medallion, eternity band ring, and marquise solitaire drop charm.
  Colours match global theme accent (--lv-accent-deep, #806745). Continuous horizontal stream motion from right to left.

  @param {boolean} [overlay] - Optional overlay wrapper for image containers
  @param {string} [extra_class] - Optional additional CSS classes
{% enddoc %}
{%- if overlay and settings.enable_product_loader == false and extra_class == blank -%}{%- else -%}
{%- if overlay -%}<div class="lv-loader-overlay lv-skel-fill" aria-hidden="true">{%- endif -%}
<div class="lv-loader-badge{% if extra_class %} {{ extra_class }}{% endif %}" role="status" aria-label="{{ 'accessibility.loading' | t | default: 'Loading' }}">
  <svg class="lv-loader" viewBox="0 0 150 60" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" focusable="false">
    <defs>
      <!-- Soft edge fade gradient for seamless continuous entrance and exit -->
      <linearGradient id="lvLoaderMaskGrad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0" />
        <stop offset="12%" stop-color="#fff" stop-opacity="1" />
        <stop offset="88%" stop-color="#fff" stop-opacity="1" />
        <stop offset="100%" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
      <mask id="lvLoaderEdgeMask">
        <rect x="0" y="0" width="150" height="60" fill="url(#lvLoaderMaskGrad)" />
      </mask>

      <!-- Reusable Item 1: Chain Necklace with Diamond Medallion -->
      <g id="lv-item-necklace">
        <!-- Chain links V-shape -->
        <path class="lv-chain" d="M -11 6 L -8 11 L -5 16 L -2.5 21" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-dasharray="1.5 2" />
        <path class="lv-chain" d="M 11 6 L 8 11 L 5 16 L 2.5 21" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-dasharray="1.5 2" />
        <!-- Bail clasp -->
        <path class="lv-bail" d="M -2 21 C -2 19 2 19 2 21 L 2.5 24 C 2.5 25.5 -2.5 25.5 -2.5 24 Z" stroke="currentColor" stroke-width="1.1" fill="color-mix(in srgb, currentColor 10%, #fff)" />
        <!-- Medallion -->
        <circle class="lv-rim-out" cx="0" cy="37" r="11.5" stroke="currentColor" stroke-width="1.3" fill="#ffffff" />
        <circle class="lv-rim-beads" cx="0" cy="37" r="9.5" stroke="currentColor" stroke-width="0.8" stroke-dasharray="1.2 1.6" fill="none" opacity="0.85" />
        <circle class="lv-rim-in" cx="0" cy="37" r="8" stroke="currentColor" stroke-width="0.8" fill="color-mix(in srgb, currentColor 6%, #fff)" />
        <!-- Center Faceted Gem -->
        <polygon class="lv-facet-hi" points="-2.5,33.5 2.5,33.5 4.5,35.5 4.5,38.5 2.5,40.5 -2.5,40.5 -4.5,38.5 -4.5,35.5" stroke="currentColor" stroke-width="0.8" fill="color-mix(in srgb, currentColor 22%, #fff)" />
        <line x1="-2.5" y1="33.5" x2="-5" y2="31" stroke="currentColor" stroke-width="0.75" />
        <line x1="2.5" y1="33.5" x2="5" y2="31" stroke="currentColor" stroke-width="0.75" />
        <line x1="4.5" y1="35.5" x2="7.5" y2="35.5" stroke="currentColor" stroke-width="0.75" />
        <line x1="4.5" y1="38.5" x2="7.5" y2="38.5" stroke="currentColor" stroke-width="0.75" />
        <line x1="2.5" y1="40.5" x2="5" y2="43" stroke="currentColor" stroke-width="0.75" />
        <line x1="-2.5" y1="40.5" x2="-5" y2="43" stroke="currentColor" stroke-width="0.75" />
        <line x1="-4.5" y1="38.5" x2="-7.5" y2="38.5" stroke="currentColor" stroke-width="0.75" />
        <line x1="-4.5" y1="35.5" x2="-7.5" y2="35.5" stroke="currentColor" stroke-width="0.75" />
        <!-- Center point -->
        <polygon points="0,35 2,37 0,39 -2,37" stroke="currentColor" stroke-width="0.7" fill="currentColor" />
        <!-- Sparkles -->
        <path class="lv-sparkle" d="M -11 30 Q -11 32 -12.5 32 Q -11 32 -11 34 Q -11 32 -9.5 32 Q -11 32 -11 30 Z" fill="currentColor" />
        <path class="lv-sparkle" d="M 12 43 Q 12 44.5 10.5 44.5 Q 12 44.5 12 46 Q 12 44.5 13.5 44.5 Q 12 44.5 12 43 Z" fill="currentColor" />
      </g>

      <!-- Reusable Item 2: Eternity Ring / Sculpted Pavé Hoop -->
      <g id="lv-item-ring">
        <!-- Outer hoop / band -->
        <ellipse class="lv-ring-outer" cx="0" cy="30" rx="12" ry="12" stroke="currentColor" stroke-width="1.3" fill="none" />
        <!-- Inner aperture -->
        <ellipse class="lv-ring-inner" cx="0" cy="30" rx="7.5" ry="7.5" stroke="currentColor" stroke-width="1.0" fill="#ffffff" />
        <!-- Pavé setting bead dots along circumference -->
        <circle cx="-9" cy="24" r="0.75" fill="currentColor" />
        <circle cx="-10" cy="30" r="0.75" fill="currentColor" />
        <circle cx="-9" cy="36" r="0.75" fill="currentColor" />
        <circle cx="-6" cy="40" r="0.75" fill="currentColor" />
        <circle cx="0" cy="41.5" r="0.75" fill="currentColor" />
        <circle cx="6" cy="40" r="0.75" fill="currentColor" />
        <circle cx="9" cy="36" r="0.75" fill="currentColor" />
        <circle cx="10" cy="30" r="0.75" fill="currentColor" />
        <circle cx="9" cy="24" r="0.75" fill="currentColor" />
        <circle cx="6" cy="20" r="0.75" fill="currentColor" />
        <circle cx="-6" cy="20" r="0.75" fill="currentColor" />
        <!-- Crown Solitaire Stone at top -->
        <g class="lv-ring-crown">
          <path d="M -3 18 L -3.5 15.5 L 3.5 15.5 L 3 18 Z" stroke="currentColor" stroke-width="0.9" fill="color-mix(in srgb, currentColor 15%, #fff)" />
          <polygon points="0,13.5 3,16 0,18.5 -3,16" stroke="currentColor" stroke-width="0.8" fill="color-mix(in srgb, currentColor 30%, #fff)" />
          <path class="lv-sparkle" d="M 7 13 Q 7 15 5.5 15 Q 7 15 7 17 Q 7 15 8.5 15 Q 7 15 7 13 Z" fill="currentColor" />
        </g>
      </g>

      <!-- Reusable Item 3: Marquise Solitaire Drop / Charm -->
      <g id="lv-item-drop">
        <!-- Top jump ring & hanging link -->
        <circle cx="0" cy="12" r="2.2" stroke="currentColor" stroke-width="1.1" fill="none" />
        <line x1="0" y1="14.2" x2="0" y2="19" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
        <!-- Top accent stone -->
        <circle cx="0" cy="19.5" r="1.3" stroke="currentColor" stroke-width="0.8" fill="color-mix(in srgb, currentColor 25%, #fff)" />
        <!-- Marquise Gemstone Body -->
        <path class="lv-marquise-outer" d="M 0 21.5 C 7.5 27.5 7.5 35 0 42 C -7.5 35 -7.5 27.5 0 21.5 Z" stroke="currentColor" stroke-width="1.3" fill="#ffffff" />
        <path class="lv-marquise-inner" d="M 0 24 C 5 28.5 5 34 0 39.5 C -5 34 -5 28.5 0 24 Z" stroke="currentColor" stroke-width="0.8" fill="color-mix(in srgb, currentColor 8%, #fff)" />
        <!-- Marquise Facets -->
        <line x1="0" y1="21.5" x2="0" y2="27" stroke="currentColor" stroke-width="0.75" />
        <line x1="0" y1="36" x2="0" y2="42" stroke="currentColor" stroke-width="0.75" />
        <polygon class="lv-marquise-core" points="0,27 3.5,31.5 0,36 -3.5,31.5" stroke="currentColor" stroke-width="0.8" fill="color-mix(in srgb, currentColor 28%, #fff)" />
        <line x1="-3.5" y1="31.5" x2="-6.5" y2="31.5" stroke="currentColor" stroke-width="0.75" />
        <line x1="3.5" y1="31.5" x2="6.5" y2="31.5" stroke="currentColor" stroke-width="0.75" />
        <!-- Sparkle stars -->
        <path class="lv-sparkle" d="M 9 24 Q 9 26 7.5 26 Q 9 26 9 28 Q 9 26 10.5 26 Q 9 26 9 24 Z" fill="currentColor" />
        <path class="lv-sparkle" d="M -8 38 Q -8 39.5 -9.5 39.5 Q -8 39.5 -8 41 Q -8 39.5 -6.5 39.5 Q -8 39.5 -8 38 Z" fill="currentColor" />
      </g>
    </defs>

    <!-- Streaming conveyor masked by fade edges: right-to-left continuous flow -->
    <g mask="url(#lvLoaderEdgeMask)">
      <g class="lv-loader-stream-track">
        <!-- Set 1 (x: 0 .. 150) -->
        <g transform="translate(25, 0)">
          <use href="#lv-item-necklace" />
        </g>
        <g transform="translate(75, 0)">
          <use href="#lv-item-ring" />
        </g>
        <g transform="translate(125, 0)">
          <use href="#lv-item-drop" />
        </g>

        <!-- Set 2 (x: 150 .. 300) for seamless 100% infinite marquee loop -->
        <g transform="translate(175, 0)">
          <use href="#lv-item-necklace" />
        </g>
        <g transform="translate(225, 0)">
          <use href="#lv-item-ring" />
        </g>
        <g transform="translate(275, 0)">
          <use href="#lv-item-drop" />
        </g>
      </g>
    </g>
  </svg>
</div>
{%- if overlay -%}</div>{%- endif -%}
{%- endif -%}
