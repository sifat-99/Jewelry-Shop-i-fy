{% doc %}
  One customer feedback card (used by sections/customer-feedback.liquid). Accepts: name, rating (0-5, including halves), title, body, photo, reviewed_product, product_title,...

  @param [name] - Optional name passed by the parent file
  @param [rating] - Optional rating passed by the parent file
  @param [title] - Optional title passed by the parent file
  @param [body] - Optional body passed by the parent file
  @param [photo] - Optional photo passed by the parent file
  @param [reviewed_product] - Optional reviewed product passed by the parent file
  @param [product_title] - Optional product title passed by the parent file
  @param [verified] - Optional verified passed by the parent file
  @param [date] - Optional date passed by the parent file
{% enddoc %}
{%- comment -%}
  One customer feedback card (used by sections/customer-feedback.liquid).
  Accepts: name, rating (0-5, including halves), title, body, photo, reviewed_product, product_title, verified, date
{%- endcomment -%}
{%- assign r = rating | plus: 0 | round: 1 -%}
{%- if r > 5 -%}{%- assign r = 5 -%}{%- endif -%}
{%- if r < 0 -%}{%- assign r = 0 -%}{%- endif -%}
{%- assign display_product_title = product_title -%}
{%- assign product_url = reviewed_product.url -%}
{%- if reviewed_product != blank -%}
  {%- assign display_product_title = reviewed_product.title | default: product_title -%}
{%- elsif product_title != blank -%}
  {%- assign product_handle = product_title | handleize -%}
  {%- assign matched_product = all_products[product_handle] -%}
  {%- if matched_product != blank -%}
    {%- assign display_product_title = matched_product.title -%}
    {%- assign product_url = matched_product.url -%}
  {%- endif -%}
{%- endif -%}
<article class="cf-card">
  <div class="cf-card__rating">
    {%- render 'rating-stars', rating: r, class_name: 'cf-stars' -%}
    <span class="cf-card__rating-value">{{ r }} / 5</span>
  </div>
  {%- if title != blank -%}<h3 class="cf-card__title">{{ title | escape }}</h3>{%- endif -%}
  {%- if body != blank -%}<p class="cf-card__text">{{ body | escape }}</p>{%- endif -%}
  <div class="cf-card__by">
    {%- if photo != blank -%}
      <img class="cf-card__avatar" src="{{ photo | image_url: width: 120, height: 120, crop: 'center' }}" alt="{{ name | escape }}" width="44" height="44" loading="lazy">
    {%- else -%}
      <span class="cf-card__avatar cf-card__avatar--initial" aria-hidden="true">{{ name | strip | slice: 0 | upcase }}</span>
    {%- endif -%}
    <div class="cf-card__who">
      <p class="cf-card__name">{{ name | escape }}
        {%- if verified == true -%}<span class="cf-card__verified" title="{{ 'products.reviews.verified_buyer' | t }}" role="img" aria-label="{{ 'products.reviews.verified_buyer' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 1.6l2.5 1.9 3.1-.2 1.2 2.9 2.7 1.6-.7 3 1.2 2.8-2 2.4-.3 3.1-3 .9-2 2.4-2.8-1.3-2.8 1.3-2-2.4-3-.9-.3-3.1-2-2.4L3 10.8l-.7-3 2.7-1.6 1.2-2.9 3.1.2z"/><path d="M8 12.4l2.7 2.7L16.2 9.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{%- endif -%}
      </p>
      {%- if display_product_title != blank or date != blank -%}
        <p class="cf-card__meta">
          {%- if display_product_title != blank -%}
            {%- if product_url != blank -%}<a class="cf-card__product" href="{{ product_url }}">{{ display_product_title | escape }}</a>{%- else -%}{{ display_product_title | escape }}{%- endif -%}
          {%- endif -%}
          {%- if display_product_title != blank and date != blank -%} &middot; {% endif %}{{ date }}
        </p>
      {%- endif -%}
    </div>
  </div>
</article>
