{% doc %}
  Snippet "cart-drawer" used by the theme sections.
{% enddoc %}
<!-- /snippets/cart-drawer.liquid -->
{%- assign checkout_after_items = false -%}
{%- if settings.cart_checkout_position == 'after_items' -%}
  {%- assign checkout_after_items = true -%}
{%- endif -%}
<section
  data-section-id="cart-drawer"
  data-section-type="cart-drawer"
>
  {%- liquid
    assign cart_btn_bg = settings.cart_checkout_button_bg
    if cart_btn_bg == blank
      assign cart_btn_bg = 'var(--btn-regular-bg, var(--lv-accent-deep, #806745))'
    endif
    assign cart_btn_text = settings.cart_checkout_button_text
    if cart_btn_text == blank
      assign cart_btn_text = 'var(--btn-regular-text, #ffffff)'
    endif
    assign cart_btn_border = settings.cart_checkout_button_border
    if cart_btn_border == blank
      assign cart_btn_border = 'var(--btn-regular-border, var(--lv-accent-deep, #806745))'
    endif
    assign cart_btn_hover_bg = settings.cart_checkout_button_hover_bg
    if cart_btn_hover_bg == blank
      assign cart_btn_hover_bg = 'var(--btn-regular-hover-bg, #1a1a1a)'
    endif
    assign cart_btn_hover_text = settings.cart_checkout_button_hover_text
    if cart_btn_hover_text == blank
      assign cart_btn_hover_text = 'var(--btn-regular-hover-text, #ffffff)'
    endif
    assign cart_btn_hover_border = settings.cart_checkout_button_hover_border
    if cart_btn_hover_border == blank
      assign cart_btn_hover_border = 'var(--btn-regular-hover-border, #1a1a1a)'
    endif
  -%}
  <style>
    :root {
      --cart-checkout-btn-bg: {{ cart_btn_bg }};
      --cart-checkout-btn-text: {{ cart_btn_text }};
      --cart-checkout-btn-border: {{ cart_btn_border }};
      --cart-checkout-btn-hover-bg: {{ cart_btn_hover_bg }};
      --cart-checkout-btn-hover-text: {{ cart_btn_hover_text }};
      --cart-checkout-btn-hover-border: {{ cart_btn_hover_border }};
    }

    #drawer-cart .checkout__button {
      width: 100% !important;
      min-height: {{ settings.cart_checkout_button_height | default: 60 }}px !important;
      height: auto !important;
      padding: 14px 20px !important;
      font-size: {{ settings.cart_checkout_button_text_size | default: 14 }}px !important;
      font-weight: 700 !important;
      line-height: 1.3 !important;
      letter-spacing: 0.12em !important;
      text-transform: uppercase !important;
      text-align: center !important;
      text-decoration: none !important;
      border-radius: var(--btn-radius, 0px) !important;
      color: var(--cart-checkout-btn-text) !important;
      background-color: var(--cart-checkout-btn-bg) !important;
      border: var(--btn-border-thickness, 1px) solid var(--cart-checkout-btn-border) !important;
      transition: background-color var(--btn-animation-duration, 300ms) ease, border-color var(--btn-animation-duration, 300ms) ease, color var(--btn-animation-duration, 300ms) ease !important;
    }
    #drawer-cart .checkout__button::before {
      background-color: var(--cart-checkout-btn-hover-bg) !important;
    }
    #drawer-cart .checkout__button[data-button-style="outline"] {
      background-color: var(--bg, #ffffff) !important;
      color: var(--cart-checkout-btn-border) !important;
    }
    #drawer-cart .checkout__button:hover {
      border-color: var(--cart-checkout-btn-hover-border) !important;
      background-color: var(--cart-checkout-btn-hover-bg) !important;
      color: var(--cart-checkout-btn-hover-text) !important;
    }
    #drawer-cart .checkout__button:hover span {
      color: var(--cart-checkout-btn-hover-text) !important;
      text-decoration: none !important;
    }
    html #drawer-cart.cart__drawer .checkout__button:hover span {
      color: var(--cart-checkout-btn-hover-text) !important;
      text-decoration: none !important;
    }

    #drawer-cart .cart__items__grid[data-item] {
      grid-template-columns: 90px minmax(0, 1fr) auto !important;
      grid-template-areas: "image title title" "image price quantity" !important;
      column-gap: 12px !important;
      row-gap: 8px !important;
      align-items: center !important;
    }
    #drawer-cart .cart__items__image {
      grid-area: image !important;
      width: 90px !important;
      height: 90px !important;
    }
    #drawer-cart .cart__items__title {
      grid-area: title !important;
      min-width: 0 !important;
      padding-right: 26px !important;
      align-self: start !important;
    }
    #drawer-cart .cart__items__price {
      grid-area: price !important;
      min-width: 0 !important;
      align-self: center !important;
    }
    #drawer-cart .cart__items__price .line__price { margin: 0 !important; line-height: 1.3 !important; }
    #drawer-cart .cart__items__quantity {
      grid-area: quantity !important;
      display: flex !important;
      min-width: 96px !important;
      align-self: center !important;
      justify-self: end !important;
    }
    #drawer-cart .cart__items__quantity .quantity__wrapper { margin: 0 !important; }
    #drawer-cart .cart__items__savings { grid-column: 2 / -1 !important; }

    /* Free-shipping message stays visible (theme JS hides it with .cart--hidden when the cart is empty, which made it flash then vanish) */
    .drawer__body .cart__message[data-cart-message],
    .drawer__body .cart__message[data-cart-message].cart--hidden,
    .drawer__body .cart__message[data-cart-message].is-hidden {
      display: flex !important;
      visibility: visible !important;
      opacity: 1 !important;
      height: auto !important;
      max-height: none !important;
      overflow: visible !important;
      pointer-events: auto !important;
      padding: 15px var(--gutter, 20px) !important;
      background-color: var(--lv-cream, #f7f5f0) !important;
      border-bottom: 1px solid var(--lv-line, #e6e2d8) !important;
      color: var(--text, var(--lv-ink, #1a1a1a)) !important;
    }
    #drawer-cart [data-left-to-spend] {
      color: var(--lv-accent-deep, #806745) !important;
      font-weight: 700 !important;
    }
    #drawer-cart .cart__graph-progress {
      stroke: var(--lv-accent-deep, #806745) !important;
    }
    #drawer-cart .cart__graph circle:first-child {
      stroke: rgba(128, 103, 69, 0.22) !important;
    }
    #drawer-cart .cart__message.is-success {
      background-color: color-mix(in srgb, #2e7d32 9%, var(--lv-cream, #f7f5f0)) !important;
      color: #1b5e20 !important;
    }
    #drawer-cart .cart__message.is-success .cart__graph-progress {
      stroke: #2e7d32 !important;
    }
    .cart--hidden,
    .cart__drawer .cart--hidden,
    [data-cart-empty].cart--hidden {
      display: none !important;
      opacity: 0 !important;
      height: 0 !important;
      visibility: hidden !important;
      overflow: hidden !important;
      pointer-events: none !important;
    }

    /* Lighter background blur behind the cart drawer (theme default is 10px) */
    @media only screen and (min-width: 480px) {
      #drawer-cart .drawer__underlay .drawer__underlay__blur {
        -webkit-backdrop-filter: blur(2px) !important;
        backdrop-filter: blur(2px) !important;
      }
    }

    /* Clear all: underline text button in the top bar */
    #drawer-cart .drawer__top__left {
      display: flex;
      align-items: baseline;
      gap: 16px;
    }
    #drawer-cart .cart__clear-all {
      appearance: none;
      background: transparent !important;
      border: 0 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      padding: 0 !important;
      margin: 0;
      font: inherit;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: none;
      color: color-mix(in srgb, var(--text, #111111) 70%, transparent) !important;
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
      transition: color 0.2s ease;
    }
    #drawer-cart .cart__clear-all:hover,
    #drawer-cart .cart__clear-all:focus-visible {
      color: var(--lv-accent-deep, #806745) !important;
    }
    #drawer-cart .cart__clear-all[disabled] {
      opacity: 0.45;
      pointer-events: none;
    }

    /* Lock buttons and animate line item while updating to prevent race conditions */
    .cart--loading .quantity__button,
    .cart--loading [data-remove-key],
    .cart--loading [data-quantity-selector] button {
      pointer-events: none !important;
      opacity: 0.45 !important;
      cursor: wait !important;
    }
    .cart--loading .cart__items__row {
      opacity: 0.7;
      transition: opacity 0.2s ease;
    }

    /* Keep the quantity number and +/- icons visible while loading.
       theme.css sets --text/--color to transparent on .quantity__wrapper during loading,
       which made the whole quantity box look empty. */
    html .cart--loading .quantity__wrapper {
      --text: inherit;
      --color: inherit;
    }
    html .cart--loading .quantity__input {
      opacity: 1 !important;
      color: var(--text, #111111) !important;
      -webkit-text-fill-color: currentColor !important;
    }

    /* Checkout button placed right after the last product (setting: Cart & Drawer > Checkout button position) */
    .drawer__body > .drawer__bottom {
      flex: 0 0 100%;
      width: 100%;
      box-sizing: border-box;
      align-self: flex-start;
      border-top: 0;
    }

    /* Trash Icon Hover Animation */
    .cart__items__remove a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: color-mix(in srgb, var(--text, #888888) 62%, transparent);
      transition: color 0.2s ease, transform 0.15s ease;
      padding: 4px;
    }
    .cart__items__remove a:hover {
      color: #d32f2f;
      transform: scale(1.15);
    }
    .cart__items__remove a:active {
      transform: scale(0.95);
    }

    /* Item title, quantity hover */
    #drawer-cart .cart__items__title a {
      color: var(--text, var(--lv-ink, #1a1a1a)) !important;
      transition: color 0.2s ease;
    }
    #drawer-cart .cart__items__title a:hover {
      color: var(--lv-accent-deep, #806745) !important;
    }
    #drawer-cart .cart__items__quantity .quantity__button:hover {
      color: var(--lv-accent-deep, #806745) !important;
    }

    /* Empty State Synced with Global Aurelle Luxury Palette */
    #drawer-cart .cart__empty {
      background: transparent !important;
    }
    #drawer-cart .cart__empty p {
      font-family: var(--FONT-STACK-HEADING, 'Playfair Display', serif) !important;
      font-size: 21px !important;
      font-weight: 500 !important;
      letter-spacing: 0.03em !important;
      color: var(--text, var(--lv-ink, #1a1a1a)) !important;
    }
    #drawer-cart .cart__circle {
      background-color: var(--lv-cream, #f7f5f0) !important;
      border: 1px solid var(--lv-line, #e6e2d8) !important;
      color: var(--lv-accent-deep, #806745) !important;
      box-shadow: 0 4px 18px rgba(128, 103, 69, 0.1) !important;
      transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease !important;
    }
    #drawer-cart .cart__circle svg {
      stroke: var(--lv-accent-deep, #806745) !important;
      color: var(--lv-accent-deep, #806745) !important;
      opacity: 0.82 !important;
      transition: opacity 0.35s ease, transform 0.35s ease !important;
    }
    #drawer-cart .cart__circle__wrapper:hover .cart__circle {
      border-color: var(--lv-accent-deep, #806745) !important;
      box-shadow: 0 8px 26px rgba(128, 103, 69, 0.24) !important;
      transform: translateY(-2px);
    }
    #drawer-cart .cart__circle__wrapper:hover svg {
      opacity: 1 !important;
      transform: scale(1.06);
    }
    #drawer-cart .cart__continue__link {
      color: var(--lv-accent-deep, #806745) !important;
      font-family: var(--FONT-STACK-ACCENT, var(--FONT-STACK-BODY, sans-serif)) !important;
      font-size: 13px !important;
      font-weight: 600 !important;
      letter-spacing: 0.12em !important;
      text-transform: uppercase !important;
      transition: color 0.3s ease !important;
    }
    #drawer-cart .cart__continue__link::after {
      background: var(--lv-accent-deep, #806745) !important;
      height: 1.5px !important;
      /* theme default is width .9s, which felt too slow */
      transition: width 0.25s ease, background-color 0.2s ease !important;
    }
    #drawer-cart .cart__circle__wrapper:hover .cart__continue__link {
      color: var(--text, #111111) !important;
    }
    #drawer-cart .cart__circle__wrapper:hover .cart__continue__link::after {
      background: var(--text, #111111) !important;
    }

    /* Remove confirmation modal inside drawer */
    #drawer-cart .cart-confirm[hidden] {
      display: none !important;
    }
    #drawer-cart .cart-confirm {
      position: absolute;
      inset: 0;
      z-index: 600;
      background: rgba(17, 15, 13, 0.45);
      backdrop-filter: blur(2px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    #drawer-cart .cart-confirm__card {
      width: 100%;
      max-width: 340px;
      background: var(--bg, #ffffff) !important;
      border: 1px solid var(--lv-line, #e6e2d8) !important;
      border-radius: var(--btn-radius, 0px) !important;
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.18);
      padding: 26px 22px 22px;
      text-align: center;
    }
    #drawer-cart .cart-confirm__badge {
      width: 44px;
      height: 44px;
      margin: 0 auto 14px;
      border-radius: 50%;
      background: var(--lv-cream, #f7f5f0) !important;
      border: 1px solid var(--lv-line, #e6e2d8) !important;
      color: var(--lv-accent-deep, #806745) !important;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    #drawer-cart .cart-confirm__title {
      margin: 0 0 8px;
      font-family: var(--FONT-STACK-HEADING, serif) !important;
      font-size: 19px;
      font-weight: 500;
      color: var(--text, var(--lv-ink, #1a1a1a)) !important;
    }
    #drawer-cart .cart-confirm__message {
      margin: 0 0 20px;
      font-size: 13px;
      line-height: 1.55;
      color: var(--text-light, #5c5349) !important;
      word-break: break-word;
    }
    #drawer-cart .cart-confirm__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    #drawer-cart .cart-confirm__btn {
      min-height: 42px;
      padding: 0 14px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      border-radius: var(--btn-radius, 0px) !important;
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }
    #drawer-cart .cart-confirm__btn--cancel {
      background: var(--bg, #ffffff) !important;
      color: var(--text, var(--lv-ink, #1a1a1a)) !important;
      border: 1px solid var(--lv-line, #d6cec0) !important;
    }
    #drawer-cart .cart-confirm__btn--cancel:hover {
      background: var(--lv-cream, #f7f4ee) !important;
      border-color: var(--lv-accent-deep, #806745) !important;
    }
    #drawer-cart .cart-confirm__btn--remove {
      background: var(--btn-regular-bg, var(--lv-accent-deep, #806745)) !important;
      color: var(--btn-regular-text, #ffffff) !important;
      border: 1px solid var(--btn-regular-border, var(--lv-accent-deep, #806745)) !important;
    }
    #drawer-cart .cart-confirm__btn--remove:hover {
      background: #a93226 !important;
      border-color: #a93226 !important;
      color: #ffffff !important;
    }
  </style>

  <div class="drawer cart__drawer drawer--right palette--light bg--neutral color-scheme-1"
    data-cart-message-container
    data-drawer="drawer-cart"
    id="drawer-cart">
    <div class="drawer__content" aria-label="{{ 'cart.title' | t }}">

      <!-- Top Bar: Title & Close 'X' Button -->
      <div class="drawer__top">
        <div class="drawer__top__left">
          <p class="cart__drawer__title">{{ 'cart.title' | t }}</p>
          <button type="button"
            class="cart__clear-all {% if cart.item_count == 0 %}cart--hidden{% endif %}"
            data-cart-clear-all
            data-cart-bottom
            aria-label="{{ 'cart.clear_all.aria' | t }}">{{ 'cart.clear_all.button' | t }}</button>
        </div>

        <button class="drawer__button drawer__close"
          data-first-focus
          data-drawer-toggle="drawer-cart"
          aria-label="{{ 'accessibility.close' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" stroke-linecap="square" stroke-linejoin="arcs" aria-hidden="true" class="icon-theme icon-theme-stroke icon-core-x" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Drawer Body -->
      <div class="drawer__body" data-drawer-scrolls>

        <!-- Free Shipping Progress / Message -->
        {%- liquid
          assign free_shipping_limit = 4000
          if shop.currency != 'BDT'
            assign free_shipping_limit = 39
          endif
          assign free_shipping_limit_cents = free_shipping_limit | times: 100
          if cart.total_price < free_shipping_limit_cents
            assign free_shipping_left_money = free_shipping_limit_cents | minus: cart.total_price | money
          else
            assign free_shipping_left_money = 0 | money
          endif
          assign free_shipping_left_html = '<span data-left-to-spend class="strong">' | append: free_shipping_left_money | append: '</span>'
          assign free_shipping_threshold_money = free_shipping_limit_cents | money
        -%}
        <p class="cart__message {% if cart.total_price >= free_shipping_limit_cents and cart.item_count > 0 %}is-success{% endif %}" data-cart-message="true" data-limit="{{ free_shipping_limit }}">
          <small class="cart__graph">
            <small class="cart__graph-dot cart__graph-dot--1"></small>
            <small class="cart__graph-dot cart__graph-dot--2"></small>
            <small class="cart__graph-dot cart__graph-dot--3"></small>
            <small class="cart__graph-dot cart__graph-dot--4"></small>
            <small class="cart__graph-dot cart__graph-dot--5"></small>
            <small class="cart__graph-dot cart__graph-dot--6"></small>
            <svg height="18" width="18">
              <circle r="7" cx="9" cy="9" />
              <circle class="cart__graph-progress" stroke-dasharray="87.96459430051421 87.96459430051421" style="stroke-dashoffset: 87.96459430051421" data-cart-progress data-percent="0" r="7" cx="9" cy="9" />
            </svg>
          </small>

          <span class="cart__message-success">{{ 'cart.shipping_bar.unlocked' | t }}</span>

          <span class="cart__message-default">
            {{ 'cart.shipping_bar.remaining_html' | t: amount: free_shipping_left_html }}
          </span>
        </p>

        <div class="errors" data-form-errors style="display: none;"></div>

        <!-- Empty State -->
        <div class="{% if cart.item_count > 0 %}cart--hidden{% endif %}" data-cart-empty style="{% if cart.item_count > 0 %}display: none;{% endif %}">
          <div class="cart__empty align--middle-center">
            <div class="wrapper">
              <p class="body-size-7 m-0">{{ 'cart.empty' | t }}</p>
              <div class="image-overlay" style="--overlay-opacity: 0.05;"></div>
            </div>
          </div>
          <a href="{{ routes.all_products_collection_url }}" class="cart__circle__wrapper" data-drawer-toggle="drawer-cart">
            <div class="cart__circle">
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="icon-theme icon-theme-stroke icon-set-classic-cart" viewBox="0 0 24 24"><path d="M20.5 16.5H5.715l1.082-4.195-2.126-7.456L3.715 1.5H1.5m5.22 10h11.702l3.002-6.13s.428-.87-.745-.87H4.5m2 16.986a1 1 0 1 0 2 .028 1 1 0 0 0-2-.028Zm11 .014a1 1 0 1 0 2 0 1 1 0 0 0-2 0Z"/><circle class="icon-cart-full" cx="13" cy="4.5" r="4"/></svg>
            </div>
            <p class="cart__continue__link">
              {{ 'cart.continue_shopping' | t }}
            </p>
          </a>
        </div>

        <!-- Cart Items Loading & Form -->
        <div data-cart-form data-cart-loading class="{% if cart.item_count == 0 %}cart--hidden{% endif %}">
          <div data-line-items>
            {% render 'cart-line-items' %}
          </div>
        </div>

        {%- capture drawer_checkout_html -%}
        <div class="drawer__bottom drawer__bottom--checkout {% if cart.item_count == 0 %}cart--hidden{% endif %}" data-cart-bottom data-accordion-group>
          <p class="drawer__bottom__meta body-size-3"><em></em></p>

          <div class="drawer__footer__subtotal" data-cart-subtotal style="display: none;">
            {% render 'cart-subtotal' %}
          </div>

          <form id="cart-form" action="{{ routes.cart_url }}" method="post" novalidate class="cart">
            <button type="submit" name="checkout" class="btn btn--primary btn--large btn--full checkout__button" data-button-style="{{ settings.cart_checkout_button_style | default: 'solid' | escape }}">
              <span>{{ 'cart.checkout' | t }} •</span>
              <span data-cart-final style="margin-left: 4px;">
                {{ cart.total_price | money }}
              </span>
            </button>
          </form>
        </div>
        {%- endcapture -%}

        {%- capture drawer_notes_html -%}
        <!-- Free shipping notice + payment icons: always at the bottom of the drawer -->
        <div class="drawer__bottom drawer__bottom--notes {% if cart.item_count == 0 %}cart--hidden{% endif %}" data-cart-bottom>
          <center>
            <div style="font-weight: bold; text-transform: uppercase; margin: 10px 0; font-size: 13px; letter-spacing: 0.05em;">
              {{ 'cart.shipping_bar.notice' | t: amount: free_shipping_threshold_money }}
            </div>
          </center>

          <center>
            <img src="https://cdn.shopify.com/s/files/1/0642/5221/5561/files/Conversie_afbeeldingen_Shopify_11.png?v=1727602721" alt="{{ 'cart.payment_methods' | t }}" style="width: 70%; padding-bottom: 5px;" width="300" height="40" loading="lazy">
          </center>
        </div>
        {%- endcapture -%}
        {%- if checkout_after_items -%}{{ drawer_checkout_html }}{%- endif -%}

      </div>

      {%- unless checkout_after_items -%}{{ drawer_checkout_html }}{%- endunless -%}
      {{ drawer_notes_html }}

      <div class="cart-confirm" id="cart-remove-confirm" role="dialog" aria-modal="true" aria-labelledby="cart-remove-confirm-title" aria-hidden="true" hidden>
        <div class="cart-confirm__card">
          <div class="cart-confirm__badge" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m19.5 4-1.072 18H5.571L4.5 4M10 9v8m4-8v8M3 4h18M9 4V2h6v2"/></svg>
          </div>
          <p class="cart-confirm__title" id="cart-remove-confirm-title">{{ 'cart.remove_confirm.title' | t }}</p>
          <p class="cart-confirm__message" data-cart-confirm-message>{{ 'cart.remove_confirm.message_generic' | t }}</p>
          <div class="cart-confirm__actions">
            <button type="button" class="cart-confirm__btn cart-confirm__btn--cancel" data-cart-confirm-cancel>{{ 'cart.remove_confirm.cancel' | t }}</button>
            <button type="button" class="cart-confirm__btn cart-confirm__btn--remove" data-cart-confirm-ok>{{ 'cart.remove_confirm.confirm' | t }}</button>
          </div>
        </div>
      </div>

    </div>

    <!-- Backdrop Underlay -->
    <span class="drawer__underlay" data-drawer-underlay>
      <span class="drawer__underlay__fill"></span>
      <span class="drawer__underlay__blur"></span>
    </span>
  </div>
</section>

<script>
  (function() {
    // Money Formatter Helper
    // Mirrors Shopify's money format types so the live-updated price looks identical to the server-rendered one
    function fmtMoney(cents) {
      var moneyFormat = (typeof theme !== 'undefined' && theme.moneyFormat) ? theme.moneyFormat : {{ shop.money_format | json }};
      var match = moneyFormat.match(/\{\{\s*(\w+)\s*\}\}/);
      var type = match ? match[1] : 'amount';
      var value = (cents / 100.0).toFixed(2);

      function group(str, thousands, decimal) {
        var p = str.split('.');
        var whole = p[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands);
        return p[1] === undefined ? whole : whole + decimal + p[1];
      }

      var formatted;
      switch (type) {
        case 'amount_no_decimals':
          formatted = group(Math.round(cents / 100).toString(), ',', '.'); break;
        case 'amount_with_comma_separator':
          formatted = group(value, '.', ','); break;
        case 'amount_no_decimals_with_comma_separator':
          formatted = group(Math.round(cents / 100).toString(), '.', ','); break;
        case 'amount_no_decimals_with_space_separator':
          formatted = group(Math.round(cents / 100).toString(), ' ', '.'); break;
        case 'amount_with_space_separator':
          formatted = group(value, ' ', ','); break;
        case 'amount_with_apostrophe_separator':
          formatted = group(value, "'", '.'); break;
        case 'amount_with_period_and_space_separator':
          formatted = group(value, ' ', '.'); break;
        default:
          formatted = group(value, ',', '.');
      }
      return match ? moneyFormat.replace(match[0], formatted) : formatted;
    }

    // Same as theme: append the currency code (e.g. "EUR") when the setting is enabled
    function fmtMoneyWithCode(cents) {
      var out = fmtMoney(cents);
      if (typeof theme !== 'undefined' && theme.settings && theme.settings.currency_code_enable && theme.currencyCode && out.indexOf(theme.currencyCode) === -1) {
        out += ' ' + theme.currencyCode;
      }
      return out;
    }

    // Unified UI Synchronization Engine
    function syncCartDrawerUI(cart) {
      if (!cart) return;
      var drawerRoot = document.getElementById('drawer-cart') || document;
      var emptyEl = drawerRoot.querySelector('[data-cart-empty]');
      var formEl = drawerRoot.querySelector('[data-cart-form]');
      var bottomEls = drawerRoot.querySelectorAll('[data-cart-bottom]');
      var finalPriceEls = drawerRoot.querySelectorAll('[data-cart-final]');
      var headerPriceEls = document.querySelectorAll('[data-header-cart-price]');
      var headerCountEls = document.querySelectorAll('[data-header-cart-count]');
      var leftToSpendEl = drawerRoot.querySelector('[data-left-to-spend]');
      var cartMsgEl = drawerRoot.querySelector('[data-cart-message]');
      var progressEl = drawerRoot.querySelector('[data-cart-progress]');

      var formattedTotal = fmtMoney(cart.total_price);

      // 1. Update final price on checkout buttons
      var formattedTotalWithCode = fmtMoneyWithCode(cart.total_price);
      finalPriceEls.forEach(function(el) {
        el.textContent = formattedTotalWithCode;
      });

      // 2. Update header prices & count badges
      headerPriceEls.forEach(function(el) {
        el.textContent = formattedTotal;
      });
      headerCountEls.forEach(function(el) {
        el.textContent = '(' + cart.item_count + ')';
      });

      // 3. Strict Toggle of Empty State vs Form & Checkout Bottom
      if (cart.item_count > 0) {
        if (emptyEl) {
          emptyEl.classList.add('cart--hidden');
          emptyEl.style.display = 'none';
        }
        if (formEl) {
          formEl.classList.remove('cart--hidden');
          formEl.classList.remove('cart--loading');
          formEl.style.display = '';
        }
        bottomEls.forEach(function(el) {
          el.classList.remove('cart--hidden');
          el.style.display = '';
        });
      } else {
        if (emptyEl) {
          emptyEl.classList.remove('cart--hidden');
          emptyEl.style.display = 'block';
        }
        if (formEl) {
          formEl.classList.add('cart--hidden');
          formEl.classList.remove('cart--loading');
          formEl.style.display = 'none';
        }
        bottomEls.forEach(function(el) {
          el.classList.add('cart--hidden');
          el.style.display = 'none';
        });
      }

      // 4. Update Free Shipping Gauge & Text
      var threshold = (typeof theme !== 'undefined' && theme.currency === 'BDT') ? 400000 : 3900;
      if (cartMsgEl) {
        if (cart.total_price >= threshold && cart.item_count > 0) {
          cartMsgEl.classList.add('is-success');
        } else {
          cartMsgEl.classList.remove('is-success');
          if (leftToSpendEl) {
            leftToSpendEl.textContent = fmtMoney(Math.max(0, threshold - cart.total_price));
          }
        }
      }

      if (progressEl) {
        var pct = Math.min(100, Math.round((cart.total_price / threshold) * 100));
        var circumference = 28 * Math.PI;
        var offset = circumference - (pct / 100) * (circumference / 2);
        progressEl.style.strokeDashoffset = offset;
      }
    }

    // Global Cart Drawer Open/Close Helpers
    var routesObj = (typeof theme !== 'undefined' && theme.routes) ? theme.routes : {};
    var cartJsonUrl = (routesObj.cart || {{ routes.cart_url | json }}) + '.js';
    var cartAddJsonUrl = (routesObj.cart_add_url || {{ routes.cart_add_url | json }}) + '.js';
    var addingText = (typeof theme !== 'undefined' && theme.i18n && theme.i18n.adding) ? theme.i18n.adding : {{ 'products.product.adding' | t | json }};

    var fallbackClosersBound = false;
    var fallbackOpenTimer = null;

    function bindFallbackClosers(drawer) {
      if (fallbackClosersBound || !drawer) return;
      fallbackClosersBound = true;

      drawer.querySelectorAll('[data-drawer-toggle="drawer-cart"]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          if (drawer.dataset.drawerFallback === '1') {
            e.preventDefault();
            window.closeCartDrawer();
          }
        });
      });

      var underlay = drawer.querySelector('[data-drawer-underlay]');
      if (underlay) {
        underlay.addEventListener('click', function() {
          if (drawer.dataset.drawerFallback === '1') {
            window.closeCartDrawer();
          }
        });
      }

      document.addEventListener('keydown', function(e) {
        if ((e.key === 'Escape' || e.keyCode === 27) && drawer.dataset.drawerFallback === '1' && drawer.classList.contains('drawer--visible')) {
          window.closeCartDrawer();
        }
      });
    }

    function forceOpenDrawer(drawer) {
      if (!drawer) return;
      bindFallbackClosers(drawer);
      drawer.dataset.drawerFallback = '1';
      drawer.classList.remove('display-none');
      void drawer.offsetWidth;
      drawer.classList.add('drawer--visible');
      document.querySelectorAll('[data-drawer-toggle="drawer-cart"]').forEach(function(el) {
        el.setAttribute('aria-expanded', 'true');
      });
      if (!document.documentElement.hasAttribute('data-scroll-locked')) {
        document.documentElement.style.overflow = 'hidden';
        drawer.dataset.fallbackScrollLocked = '1';
      }
      if (window.theme && window.theme.state) {
        window.theme.state.cartOpen = true;
      }
    }

    function forceCloseDrawer(drawer) {
      if (!drawer) return;
      delete drawer.dataset.drawerFallback;
      drawer.classList.remove('drawer--visible');
      document.querySelectorAll('[data-drawer-toggle="drawer-cart"]').forEach(function(el) {
        el.setAttribute('aria-expanded', 'false');
      });
      if (drawer.dataset.fallbackScrollLocked === '1') {
        document.documentElement.style.overflow = '';
        delete drawer.dataset.fallbackScrollLocked;
      }
      if (window.theme && window.theme.state) {
        window.theme.state.cartOpen = false;
      }
      setTimeout(function() {
        if (!drawer.classList.contains('drawer--visible')) {
          drawer.classList.add('display-none');
        }
      }, 350);
    }

    window.openCartDrawer = function() {
      var drawer = document.getElementById('drawer-cart');
      if (drawer) {
        delete drawer.dataset.drawerFallback;
        drawer.dispatchEvent(new CustomEvent('theme:drawer:open', { bubbles: false }));
        if (fallbackOpenTimer) clearTimeout(fallbackOpenTimer);
        fallbackOpenTimer = setTimeout(function() {
          if (!drawer.classList.contains('drawer--visible')) {
            forceOpenDrawer(drawer);
          }
        }, 40);
      }
      document.dispatchEvent(new CustomEvent('theme:cart:reload', { bubbles: true }));
      // Direct live cart fetch and UI sync
      fetch(cartJsonUrl)
        .then(function(res) { return res.json(); })
        .then(function(cart) {
          syncCartDrawerUI(cart);
        })
        .catch(function(e) { console.error(e); });
    };

    window.closeCartDrawer = function() {
      var drawer = document.getElementById('drawer-cart');
      if (drawer) {
        if (fallbackOpenTimer) {
          clearTimeout(fallbackOpenTimer);
          fallbackOpenTimer = null;
        }
        if (drawer.dataset.drawerFallback === '1') {
          forceCloseDrawer(drawer);
          return;
        }
        drawer.dispatchEvent(new CustomEvent('theme:drawer:close', { bubbles: false }));
        setTimeout(function() {
          if (drawer.classList.contains('drawer--visible')) {
            forceCloseDrawer(drawer);
          }
        }, 40);
      }
    };

    // Global AddToCart Function
    window.addToCartAjax = function(variantId, quantity, properties) {
      quantity = quantity || 1;
      var bodyObj = { id: variantId, quantity: quantity };
      if (properties) bodyObj.properties = properties;

      return fetch(cartAddJsonUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(bodyObj)
      })
      .then(function(res) { return res.json(); })
      .then(function(item) {
        window.openCartDrawer();
        fetch(cartJsonUrl)
          .then(function(r) { return r.json(); })
          .then(function(cart) {
            syncCartDrawerUI(cart);
            document.dispatchEvent(new CustomEvent('theme:cart:change', { detail: { cart: cart }, bubbles: true }));
            document.dispatchEvent(new CustomEvent('theme:cart:reload', { bubbles: true }));
          });
        return item;
      })
      .catch(function(err) {
        console.error('Add to cart error:', err);
        window.openCartDrawer();
      });
    };

    // Delegated Quick Add Buttons on Product Cards
    document.addEventListener('click', function(e) {
      var quickBtn = e.target.closest('.quick-add-btn');
      if (quickBtn) {
        e.preventDefault();
        var variantId = quickBtn.getAttribute('data-variant-id');
        if (variantId) {
          quickBtn.disabled = true;
          var originalText = quickBtn.textContent;
          quickBtn.textContent = addingText;
          window.addToCartAjax(variantId, 1).then(function() {
            quickBtn.disabled = false;
            quickBtn.textContent = originalText;
          }).catch(function() {
            quickBtn.disabled = false;
            quickBtn.textContent = originalText;
          });
        }
      }
    });

    // Event Listener for theme:cart:change
    document.addEventListener('theme:cart:change', function(e) {
      if (e.detail && e.detail.cart) {
        syncCartDrawerUI(e.detail.cart);
      }
    });

    // Confirmation before removing the last unit of an item (qty 1 -> 0) in Cart Drawer
    var drawerRootEl = document.getElementById('drawer-cart');
    var confirmModal = document.getElementById('cart-remove-confirm');
    var confirmMsgEl = confirmModal ? confirmModal.querySelector('[data-cart-confirm-message]') : null;
    var confirmCancelBtn = confirmModal ? confirmModal.querySelector('[data-cart-confirm-cancel]') : null;
    var confirmOkBtn = confirmModal ? confirmModal.querySelector('[data-cart-confirm-ok]') : null;
    var confirmMsgTpl = {{ 'cart.remove_confirm.message' | t: title: '__TITLE__' | json }};
    var confirmMsgGeneric = {{ 'cart.remove_confirm.message_generic' | t | json }};
    var cartChangeJsonUrl = (routesObj.cart_change_url || {{ routes.cart_change_url | json }}) + '.js';
    var pendingRemoveTarget = null;

    // Clear all: reuses the same confirm modal with its own texts
    var confirmTitleEl = confirmModal ? confirmModal.querySelector('.cart-confirm__title') : null;
    var clearAllBtn = drawerRootEl ? drawerRootEl.querySelector('[data-cart-clear-all]') : null;
    var clearAllTexts = {
      title: {{ 'cart.clear_all.title' | t | json }},
      message: {{ 'cart.clear_all.message' | t | json }},
      cancel: {{ 'cart.clear_all.cancel' | t | json }},
      confirm: {{ 'cart.clear_all.confirm' | t | json }}
    };
    var defaultConfirmTexts = confirmModal ? {
      title: confirmTitleEl ? confirmTitleEl.textContent : '',
      message: confirmMsgEl ? confirmMsgEl.textContent : '',
      cancel: confirmCancelBtn ? confirmCancelBtn.textContent : '',
      confirm: confirmOkBtn ? confirmOkBtn.textContent : ''
    } : null;
    var confirmMode = 'remove';

    function setConfirmTexts(t) {
      if (confirmTitleEl) confirmTitleEl.textContent = t.title;
      if (confirmMsgEl) confirmMsgEl.textContent = t.message;
      if (confirmCancelBtn) confirmCancelBtn.textContent = t.cancel;
      if (confirmOkBtn) confirmOkBtn.textContent = t.confirm;
    }

    function openClearAllConfirm() {
      if (!confirmModal) return;
      confirmMode = 'clear';
      pendingRemoveTarget = null;
      setConfirmTexts(clearAllTexts);
      confirmModal.hidden = false;
      confirmModal.setAttribute('aria-hidden', 'false');
      if (confirmCancelBtn) confirmCancelBtn.focus();
    }

    function clearCartNow() {
      var formEl = drawerRootEl.querySelector('[data-cart-form]');
      var itemsEl = drawerRootEl.querySelector('[data-line-items]');
      if (formEl) formEl.classList.add('cart--loading');
      if (clearAllBtn) clearAllBtn.disabled = true;
      fetch({{ routes.cart_clear_url | json }} + '.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      })
        .then(function(res) { return res.json(); })
        .then(function(cart) {
          if (itemsEl) itemsEl.innerHTML = '';
          syncCartDrawerUI(cart);
          document.dispatchEvent(new CustomEvent('theme:cart:change', { detail: { cart: cart }, bubbles: true }));
        })
        .catch(function(err) { console.error(err); })
        .then(function() {
          if (formEl) formEl.classList.remove('cart--loading');
          if (clearAllBtn) clearAllBtn.disabled = false;
        });
    }

    function closeRemoveConfirm(restoreValue) {
      if (restoreValue && pendingRemoveTarget && pendingRemoveTarget.input) {
        pendingRemoveTarget.input.value = pendingRemoveTarget.prevQty || '1';
      }
      pendingRemoveTarget = null;
      if (confirmMode === 'clear' && defaultConfirmTexts) setConfirmTexts(defaultConfirmTexts);
      confirmMode = 'remove';
      if (!confirmModal) return;
      confirmModal.hidden = true;
      confirmModal.setAttribute('aria-hidden', 'true');
    }

    function openRemoveConfirm(input, prevQty) {
      if (!confirmModal || !input) return;
      var row = input.closest('[data-cart-item]');
      var titleEl = row ? row.querySelector('.cart__items__title a') : null;
      var titleText = titleEl ? titleEl.textContent.trim() : '';
      pendingRemoveTarget = { input: input, row: row, prevQty: prevQty || '1' };
      if (confirmMsgEl) {
        confirmMsgEl.textContent = titleText ? confirmMsgTpl.replace('__TITLE__', titleText) : confirmMsgGeneric;
      }
      confirmModal.hidden = false;
      confirmModal.setAttribute('aria-hidden', 'false');
      if (confirmCancelBtn) confirmCancelBtn.focus();
    }

    if (drawerRootEl && confirmModal) {
      drawerRootEl.addEventListener('focusin', function(e) {
        var inp = e.target && e.target.matches && e.target.matches('[data-quantity-input]') ? e.target : null;
        if (inp) inp.dataset.prevQty = inp.value || '1';
      }, true);

      drawerRootEl.addEventListener('click', function(e) {
        var decBtn = e.target.closest ? e.target.closest('[data-decrease-quantity]') : null;
        if (!decBtn) return;
        var wrap = decBtn.closest('[data-quantity-selector]');
        var input = wrap ? wrap.querySelector('[data-quantity-input]') : null;
        if (!input) return;
        var cur = parseInt(input.value, 10);
        if (!isNaN(cur) && cur <= 1) {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          openRemoveConfirm(input, String(Math.max(1, cur)));
        }
      }, true);

      drawerRootEl.addEventListener('change', function(e) {
        var input = e.target && e.target.matches && e.target.matches('[data-quantity-input]') ? e.target : null;
        if (!input) return;
        if (input.dataset.confirmedRemove === '1') {
          delete input.dataset.confirmedRemove;
          return;
        }
        var nextVal = parseInt(input.value, 10);
        if (!isNaN(nextVal) && nextVal <= 0) {
          var prevQty = input.dataset.prevQty || '1';
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          input.value = prevQty;
          openRemoveConfirm(input, prevQty);
        } else if (!isNaN(nextVal) && nextVal > 0) {
          input.dataset.prevQty = String(nextVal);
        }
      }, true);

      if (clearAllBtn) {
        clearAllBtn.addEventListener('click', openClearAllConfirm);
      }

      if (confirmCancelBtn) {
        confirmCancelBtn.addEventListener('click', function() {
          closeRemoveConfirm(true);
        });
      }

      if (confirmOkBtn) {
        confirmOkBtn.addEventListener('click', function() {
          if (confirmMode === 'clear') {
            closeRemoveConfirm(false);
            clearCartNow();
            return;
          }
          var target = pendingRemoveTarget;
          closeRemoveConfirm(false);
          if (!target || !target.input) return;
          var input = target.input;
          var key = input.getAttribute('data-update-cart');
          var formEl = drawerRootEl.querySelector('[data-cart-form]');
          if (formEl) formEl.classList.remove('cart--loading');
          input.dataset.confirmedRemove = '1';
          input.value = '0';
          input.dispatchEvent(new Event('change'));
          var handledByTheme = formEl && formEl.classList.contains('cart--loading');
          if (!handledByTheme && key) {
            fetch(cartChangeJsonUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: key, quantity: 0 })
            })
              .then(function(res) { return res.json(); })
              .then(function(cart) {
                if (target.row && target.row.parentNode) target.row.remove();
                syncCartDrawerUI(cart);
                document.dispatchEvent(new CustomEvent('theme:cart:change', { detail: { cart: cart }, bubbles: true }));
              })
              .catch(function(err) { console.error(err); });
          }
        });
      }

      confirmModal.addEventListener('click', function(e) {
        if (e.target === confirmModal) closeRemoveConfirm(true);
      });

      function handleConfirmEscape(e) {
        if ((e.key === 'Escape' || e.keyCode === 27) && !confirmModal.hidden) {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          closeRemoveConfirm(true);
        }
      }
      drawerRootEl.addEventListener('keydown', handleConfirmEscape, true);
      drawerRootEl.addEventListener('keyup', handleConfirmEscape, true);
    }

    // Run on initial page load to ensure state consistency
    document.addEventListener('DOMContentLoaded', function() {
      fetch(cartJsonUrl)
        .then(function(res) { return res.json(); })
        .then(function(cart) {
          syncCartDrawerUI(cart);
        })
        .catch(function() {});
    });
  })();
</script>
