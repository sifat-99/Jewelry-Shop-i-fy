{%- comment -%} Styles Shopify's built-in /policies/* pages (refund, shipping, privacy, terms) to match the theme. {%- endcomment -%}
<style>
  .shopify-policy__container {
    max-width: 860px !important; width: 100%; box-sizing: border-box; margin: 0 auto !important;
    padding: clamp(36px, 6vw, 80px) clamp(16px, 4vw, 32px) clamp(56px, 8vw, 110px) !important;
  }
  .shopify-policy__title { text-align: center; margin: 0 0 clamp(28px, 4vw, 48px) !important; padding-bottom: 28px; position: relative; }
  .shopify-policy__title::after { content: ""; position: absolute; left: 50%; bottom: 0; width: 56px; height: 2px; margin-left: -28px; background: var(--text, #111); }
  .shopify-policy__title h1 { margin: 0 !important; font-size: clamp(26px, 4vw, 40px) !important; font-weight: 600 !important; letter-spacing: .14em !important; text-transform: uppercase; line-height: 1.2; }
  .shopify-policy__body { max-width: 760px; margin: 0 auto; }
  .shopify-policy__body .rte, .shopify-policy__body > div { font-size: 15px; line-height: 1.85; color: var(--text, #1a1a1a); }
  .shopify-policy__body p { margin: 0 0 14px !important; font-size: 15px !important; line-height: 1.85 !important; font-weight: 400 !important; }
  /* "Last updated" line */
  .shopify-policy__body .rte > p:first-child, .shopify-policy__body > div > p:first-child {
    margin-bottom: 34px !important; padding: 12px 16px; font-size: 12px !important; font-weight: 600 !important; letter-spacing: .12em;
    text-transform: uppercase; text-align: center; color: rgba(var(--color-foreground, 17, 17, 17), .62);
    background: rgba(var(--color-foreground, 17, 17, 17), .035); border-radius: var(--ct-radius, 4px);
  }
  .shopify-policy__body h2 {
    margin: 44px 0 14px !important; padding-top: 28px; border-top: 1px solid var(--hairline, rgba(0, 0, 0, .14));
    font-size: 15px !important; font-weight: 700 !important; letter-spacing: .16em !important; text-transform: uppercase; line-height: 1.4;
  }
  .shopify-policy__body h2:first-of-type { margin-top: 0 !important; }
  .shopify-policy__body h3 { margin: 24px 0 8px !important; font-size: 14px !important; font-weight: 700 !important; letter-spacing: .08em; }
  .shopify-policy__body ul, .shopify-policy__body ol { margin: 0 0 18px; padding-left: 22px; }
  .shopify-policy__body li { margin: 0 0 8px; font-size: 15px; line-height: 1.8; padding-left: 4px; }
  .shopify-policy__body li::marker { color: rgba(var(--color-foreground, 17, 17, 17), .5); font-weight: 600; }
  .shopify-policy__body strong { font-weight: 700; }
  .shopify-policy__body a { color: inherit; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; transition: opacity .25s ease; }
  .shopify-policy__body a:hover { opacity: .6; }
  @media (max-width: 640px) {
    .shopify-policy__body h2 { margin-top: 34px !important; padding-top: 22px; letter-spacing: .12em !important; }
  }
</style>
