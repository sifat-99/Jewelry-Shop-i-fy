<!-- /snippets/pagination.liquid -->
{%- comment -%}
  Renders luxury responsive pagination navigation for Jewelry Shop.
  Accepts:
  - paginate: {Object} Shopify paginate object (required)
  - class: {String} Additional CSS classes (optional)
{%- endcomment -%}

{%- if paginate.pages > 1 -%}
  <nav class="lv-pagination-wrapper {{ class }}" role="navigation" aria-label="Pagination">
    {%- render 'pagination-css' -%}

    <ul class="lv-pagination" role="list">
      {%- comment -%} Previous Button {%- endcomment -%}
      <li class="lv-pagination__item">
        {%- if paginate.previous -%}
          <a
            href="{{ paginate.previous.url }}"
            class="lv-pagination__arrow lv-pagination__prev"
            aria-label="Previous page"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
            <span class="lv-pagination__arrow-text">Prev</span>
          </a>
        {%- else -%}
          <span class="lv-pagination__arrow lv-pagination__prev is-disabled" aria-disabled="true">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
            <span class="lv-pagination__arrow-text">Prev</span>
          </span>
        {%- endif -%}
      </li>

      {%- comment -%} Page Number Pills {%- endcomment -%}
      {%- for part in paginate.parts -%}
        <li class="lv-pagination__item">
          {%- if part.is_link -%}
            <a
              href="{{ part.url }}"
              class="lv-pagination__link"
              aria-label="Page {{ part.title }}"
            >
              {{ part.title }}
            </a>
          {%- else -%}
            {%- if part.title == paginate.current_page -%}
              <span class="lv-pagination__current" aria-current="page">
                {{ part.title }}
              </span>
            {%- else -%}
              <span class="lv-pagination__ellipsis" aria-hidden="true">
                &hellip;
              </span>
            {%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- comment -%} Next Button {%- endcomment -%}
      <li class="lv-pagination__item">
        {%- if paginate.next -%}
          <a
            href="{{ paginate.next.url }}"
            class="lv-pagination__arrow lv-pagination__next"
            aria-label="Next page"
          >
            <span class="lv-pagination__arrow-text">Next</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        {%- else -%}
          <span class="lv-pagination__arrow lv-pagination__next is-disabled" aria-disabled="true">
            <span class="lv-pagination__arrow-text">Next</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </span>
        {%- endif -%}
      </li>
    </ul>

    <div class="lv-pagination__summary">
      Page {{ paginate.current_page }} of {{ paginate.pages }} ({{ paginate.items }} total)
    </div>
  </nav>
{%- endif -%}
