{%- comment -%}
  Engraving text input for the product page (always inside the .pv-eng-card box).
  Accepts: sid, label, required ('true'|'false'), max, prop, placeholder
           titled: true shows the title (only when there is no "Engraving: ..." option legend above, so the title never appears twice)
{%- endcomment -%}
<div class="pv-engrave" data-pv-engrave data-required="{{ required }}">
  <label for="pv-engrave-{{ sid }}" class="pv-engrave__label">
    {%- if titled %}<span class="pv-engrave__title">{{ label }}</span>{% endif %}
    <span class="pv-optional">{% if required == 'true' %}Required{% else %}Optional{% endif %} &middot; max. <span data-pv-engrave-max>{{ max }}</span> characters</span>
  </label>
  <div class="pv-engrave__field">
    <input type="text" class="pv-engrave__input" id="pv-engrave-{{ sid }}" name="properties[{{ prop | escape }}]" maxlength="{{ max }}" autocomplete="off" placeholder="{{ placeholder | escape }}" data-pv-engrave-input data-property="{{ prop | escape }}">
    <span class="pv-engrave__count" data-pv-engrave-count>0/{{ max }}</span>
  </div>
  <p class="pv-engrave__preview" data-pv-engrave-preview hidden>Preview <span class="pv-engrave__preview-text" data-pv-engrave-preview-text></span></p>
  <p class="pv-field-error" data-pv-engrave-error role="alert" hidden>Please add your engraving text.</p>
</div>
