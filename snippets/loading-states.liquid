{% doc %}
  Global loading states: image skeleton on product cards + animated loader on the product page gallery. Settings: Theme settings > Loading & skeleton.
{% enddoc %}
{%- comment -%}
  Global loading states: image skeleton on product cards + animated loader on the product page gallery.
  Settings: Theme settings > Loading & skeleton.
{%- endcomment -%}
{%- liquid
  assign skel_on = true
  if settings.enable_skeleton == false
    assign skel_on = false
  endif
  assign loader_on = true
  if settings.enable_product_loader == false
    assign loader_on = false
  endif
  assign ld_a = settings.loader_color_a | default: '#8d6e63'
  assign ld_b = settings.loader_color_b | default: '#d7b8a6'
  assign ld_c = settings.loader_color_c | default: '#3b2a26'
  assign ld_size = settings.loader_size | default: 64
  assign skel_style = settings.skeleton_style | default: 'shimmer'
-%}
{%- if skel_on or loader_on -%}
<style>
  :root {
    --lv-skel-base: color-mix(in srgb, var(--text, #111) 7%, var(--bg, #fff));
    --lv-skel-shine: color-mix(in srgb, var(--text, #111) 13%, var(--bg, #fff));
    --lv-loader-size: {{ ld_size }}px;
    --lv-loader-color: var(--lv-accent-deep, {{ ld_a | default: '#806745' }});
  }
  @keyframes lv-shimmer { 0% { background-position: 130% 0; } 100% { background-position: -30% 0; } }
  @keyframes lv-skel-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
  .lv-skel-fill {
    {%- if skel_style == 'pulse' %}
    background: var(--lv-skel-base);
    animation: lv-skel-pulse 1.4s ease-in-out infinite;
    {%- else %}
    background: linear-gradient(100deg, var(--lv-skel-base) 30%, var(--lv-skel-shine) 50%, var(--lv-skel-base) 70%);
    background-size: 250% 100%;
    animation: lv-shimmer 1.6s ease-in-out infinite;
    {%- endif %}
  }

  {%- if skel_on %}
  /* Product card image skeleton */
  .lv-card-media-wrap::before {
    content: ""; position: absolute; inset: 0; z-index: 0; border-radius: inherit;
    transition: opacity .3s ease, visibility .3s ease;
    {%- if skel_style == 'pulse' %}
    background: var(--lv-skel-base); animation: lv-skel-pulse 1.4s ease-in-out infinite;
    {%- else %}
    background: linear-gradient(100deg, var(--lv-skel-base) 30%, var(--lv-skel-shine) 50%, var(--lv-skel-base) 70%);
    background-size: 250% 100%; animation: lv-shimmer 1.6s ease-in-out infinite;
    {%- endif %}
  }
  .lv-card-media-wrap.lv-ready::before { opacity: 0; visibility: hidden; animation: none; }
  {%- endif %}

  /* Hide alt text while images are still loading (browsers print it over the skeleton) */
  .lv-card-media-wrap img, img.pg__img { color: transparent; font-size: 0; text-indent: -9999px; }

  /* Animated Luxury Jewelry Streaming Loader (Aurelle continuous right-to-left marquee) */
  .lv-loader-badge {
    width: 148px;
    height: 58px;
    border-radius: 29px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(128, 103, 69, 0.28);
    box-shadow: 0 12px 34px rgba(128, 103, 69, 0.18), 0 2px 8px rgba(0, 0, 0, 0.04);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-sizing: border-box;
    pointer-events: none;
  }

  .lv-loader {
    width: 136px;
    height: 54px;
    aspect-ratio: 150 / 60;
    display: block;
    overflow: hidden;
    color: var(--lv-loader-color, var(--lv-accent-deep, #806745));
  }

  /* Seamless infinite horizontal stream (right-to-left) */
  .lv-loader-stream-track {
    animation: lvLoaderStream 3.8s linear infinite;
    will-change: transform;
    transform: translateZ(0);
  }

  @keyframes lvLoaderStream {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-150px); }
  }

  /* Sparkles twinkle */
  .lv-sparkle {
    transform-box: fill-box;
    transform-origin: center;
    animation: lvSparkleTwinkle 2.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes lvSparkleTwinkle {
    0%, 100% {
      opacity: 0.25;
      transform: scale(0.5) rotate(0deg);
    }
    50% {
      opacity: 1;
      transform: scale(1.15) rotate(45deg);
    }
  }

  /* Gemstone facets gleam */
  .lv-facet-hi, .lv-marquise-core {
    animation: lvGemGleam 2.4s ease-in-out infinite;
    will-change: opacity;
  }

  @keyframes lvGemGleam {
    0%, 100% { opacity: 0.55; }
    50%      { opacity: 1; }
  }

  {%- if loader_on %}
  .lv-loader-overlay {
    position: absolute; inset: 0; z-index: 6; display: flex; align-items: center; justify-content: center;
    border-radius: var(--pv-gallery-radius, 0px); pointer-events: none;
    transition: opacity .35s ease, visibility .35s ease;
  }
  .lv-loader-overlay.is-done { opacity: 0; visibility: hidden; }
  {%- endif %}

  /* Card loader overlay & badge sizing */
  .lv-card-media-wrap .lv-loader-overlay {
    position: absolute; inset: 0; z-index: 5; display: flex; align-items: center; justify-content: center;
    border-radius: inherit; pointer-events: none;
    transition: opacity .35s ease, visibility .35s ease;
  }
  .lv-card-media-wrap.lv-ready .lv-loader-overlay {
    opacity: 0 !important; visibility: hidden !important; pointer-events: none !important;
  }
  .lv-loader-badge--card {
    width: 110px !important;
    height: 44px !important;
    border-radius: 22px !important;
    box-shadow: 0 6px 20px rgba(128, 103, 69, 0.16) !important;
  }
  .lv-loader-badge--card .lv-loader {
    width: 98px !important;
    height: 39px !important;
  }
  @media (max-width: 767px) {
    .lv-loader-badge--card {
      width: 88px !important;
      height: 36px !important;
      border-radius: 18px !important;
    }
    .lv-loader-badge--card .lv-loader {
      width: 78px !important;
      height: 31px !important;
    }
  }

  /* Keep images hidden before fully loaded to eliminate partial/clipped rendering */
  .lv-card-media-wrap:not(.lv-ready) .card-media-slide {
    opacity: 0 !important;
    visibility: hidden !important;
  }
  .lv-card-media-wrap.lv-ready .card-media-slide.is-active {
    opacity: 1 !important;
    visibility: visible !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .lv-card-media-wrap::before, .lv-skel-fill, .lv-loader-stream-track, .lv-sparkle, .lv-facet-hi, .lv-marquise-core { animation: none !important; }
  }
</style>
<noscript><style>.lv-card-media-wrap::before, .lv-loader-overlay { display: none !important; } .lv-card-media-wrap .card-media-slide { opacity: 1 !important; visibility: visible !important; }</style></noscript>
<script>
  (function () {
    var raf = null;
    function loaderDone(o) { if (o) o.classList.add('is-done'); }
    function cardReady(w) {
      if (w.classList.contains('lv-ready')) return;
      var img = w.querySelector('.card-media-slide.is-active') || w.querySelector('.card-media-slide');
      if (!img || img.tagName !== 'IMG' || (img.complete && img.naturalWidth > 0)) {
        w.classList.add('lv-ready');
        var o = w.querySelector('.lv-loader-overlay');
        if (o) loaderDone(o);
      }
    }
    function loaderCheck(o) {
      var wrap = o.closest('.lv-card-media-wrap');
      if (wrap) {
        var cardImg = wrap.querySelector('.card-media-slide.is-active') || wrap.querySelector('.card-media-slide');
        if (!cardImg || cardImg.tagName !== 'IMG' || (cardImg.complete && cardImg.naturalWidth > 0)) {
          wrap.classList.add('lv-ready');
          loaderDone(o);
        }
        return;
      }
      var g = o.closest('[data-pg]') || o.parentNode;
      var img = g && g.querySelector('img.pg__img');
      if (!img || (img.complete && img.naturalWidth > 0)) loaderDone(o);
    }
    function scan() {
      raf = null;
      document.querySelectorAll('.lv-card-media-wrap:not(.lv-ready)').forEach(cardReady);
      document.querySelectorAll('.lv-loader-overlay:not(.is-done)').forEach(loaderCheck);
    }
    function queue() { if (!raf) raf = requestAnimationFrame(scan); }
    function onImg(e) {
      var t = e.target;
      if (!t || t.tagName !== 'IMG') return;
      var w = t.closest && t.closest('.lv-card-media-wrap');
      if (w) {
        cardReady(w);
        var o = w.querySelector('.lv-loader-overlay');
        if (o) loaderDone(o);
      }
      var o2 = t.closest && t.closest('[data-pg]');
      if (o2) loaderDone(o2.querySelector('.lv-loader-overlay'));
    }
    document.addEventListener('load', onImg, true);
    document.addEventListener('error', onImg, true);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', queue); else queue();
    window.addEventListener('load', function () {
      scan();
      document.querySelectorAll('.lv-card-media-wrap').forEach(function (w) { w.classList.add('lv-ready'); });
      document.querySelectorAll('.lv-loader-overlay').forEach(loaderDone);
    });
    if ('MutationObserver' in window) {
      new MutationObserver(queue).observe(document.documentElement, { childList: true, subtree: true });
    }
    setTimeout(function () {
      document.querySelectorAll('.lv-card-media-wrap').forEach(function (w) { w.classList.add('lv-ready'); });
      document.querySelectorAll('.lv-loader-overlay').forEach(loaderDone);
    }, 5000);
  })();
</script>
{%- endif -%}
