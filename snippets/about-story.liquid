{% doc %}
  About us landing layout with auto-rotating product secondary images slideshow. Accepts: blocks, cfg (section.settings), page_title, page_content

  @param [blocks] - Optional blocks passed by the parent file
  @param [cfg] - Optional cfg passed by the parent file
  @param [page_content] - Optional page content passed by the parent file
{% enddoc %}
{%- comment -%}
  About us landing layout with auto-rotating product secondary images slideshow.
  Accepts: blocks, cfg (section.settings), page_title, page_content
{%- endcomment -%}
{%- liquid
  assign root_prefix = routes.root_url
  unless root_prefix == '/'
    assign root_prefix = root_prefix | append: '/'
  endunless
  assign contact_page_url = root_prefix | append: 'pages/contact'
  assign shop_link = cfg.about_button_link
  if shop_link == blank
    assign shop_link = routes.all_products_collection_url
  endif
  assign cta_link = cfg.about_cta_link
  if cta_link == blank
    assign cta_link = contact_page_url
  endif

  assign ab_eyebrow = cfg.about_eyebrow
  if ab_eyebrow == blank
    assign ab_eyebrow = 'pages.about.eyebrow' | t
  endif
  assign ab_heading = cfg.about_heading
  if ab_heading == blank
    assign ab_heading = 'pages.about.heading' | t
  endif
  assign ab_lead = cfg.about_lead
  if ab_lead == blank
    assign ab_lead = 'pages.about.lead' | t
  endif
  assign ab_btn_label = cfg.about_button_label
  if ab_btn_label == blank
    assign ab_btn_label = 'pages.about.button_label' | t
  endif
  assign ab_story_eyebrow = cfg.about_story_eyebrow
  if ab_story_eyebrow == blank
    assign ab_story_eyebrow = 'pages.about.story_eyebrow' | t
  endif
  assign ab_story_title = cfg.about_story_title
  if ab_story_title == blank
    assign ab_story_title = 'pages.about.story_title' | t
  endif
  assign ab_values_title = cfg.about_values_title
  if ab_values_title == blank
    assign ab_values_title = 'pages.about.values_title' | t
  endif
  assign ab_cta_title = cfg.about_cta_title
  if ab_cta_title == blank
    assign ab_cta_title = 'pages.about.cta_title' | t
  endif
  assign ab_cta_text = cfg.about_cta_text
  if ab_cta_text == blank
    assign ab_cta_text = 'pages.about.cta_text' | t
  endif
  assign ab_cta_label = cfg.about_cta_label
  if ab_cta_label == blank
    assign ab_cta_label = 'pages.about.cta_label' | t
  endif
  assign ab_brand_fallback = 'pages.about.brand_fallback' | t

  assign has_stats = false
  assign has_values = false
  for block in blocks
    if block.type == 'stat'
      assign has_stats = true
    elsif block.type == 'value'
      assign has_values = true
    endif
  endfor
-%}
{% render 'landing-css' %}

<style>
  /* === Theme Design System Synchronization for About Us === */
  :root, .pg-page {
    --ct-radius: var(--card-radius, 0px);
  }

  /* Dynamic Product Rotating Slider Styles */
  .about-media-rotator {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 580px;
    width: 100%;
    overflow: hidden;
    border-radius: var(--media-radius, 0px) !important;
    background: var(--pp-soft, color-mix(in srgb, var(--text, #000) 3%, var(--bg, #fff)));
    border: 1px solid var(--pp-line, rgba(var(--color-foreground, 0, 0, 0), 0.12));
    box-shadow: none !important;
  }
  .about-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transform: scale(1.02);
    transition: opacity 0.85s cubic-bezier(0.4, 0, 0.2, 1), transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0.85s;
    pointer-events: none;
    border-radius: var(--media-radius, 0px) !important;
  }
  .about-slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    pointer-events: auto;
    z-index: 2;
  }
  .about-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: var(--media-radius, 0px) !important;
  }
  .about-slide__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.02) 0%, rgba(0,0,0,0.08) 55%, rgba(0,0,0,0.6) 100%);
    pointer-events: none;
  }
  .about-slide__card {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    background: var(--bg, #ffffff);
    border: 1px solid var(--pp-line, rgba(var(--color-foreground, 0, 0, 0), 0.14));
    border-radius: var(--card-radius, 0px) !important;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    z-index: 4;
  }
  .about-slide__badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pp-muted, rgba(var(--color-foreground, 0, 0, 0), 0.65));
    margin-bottom: 3px;
  }
  .about-slide__title {
    display: block;
    margin: 0;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text, #000000);
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 230px;
    transition: opacity 0.2s ease;
  }
  .about-slide__title:hover {
    opacity: 0.7;
  }
  .about-slide__btn {
    flex: none;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-family: var(--TYPE-STACK-BUTTON, sans-serif) !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    line-height: 1 !important;
    white-space: nowrap !important;
    color: var(--btn-regular-text, #ffffff) !important;
    background: var(--btn-regular-bg, #000000) !important;
    border: 1px solid var(--btn-regular-border, #000000) !important;
    border-radius: var(--btn-radius, 0px) !important;
    padding: 10px 18px !important;
    text-decoration: none !important;
    cursor: pointer !important;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease !important;
  }
  .about-slide__btn span,
  .about-slide__btn .about-slide__btn-text {
    color: var(--btn-regular-text, #ffffff) !important;
    display: inline-block !important;
    line-height: 1 !important;
    position: relative !important;
    z-index: 2 !important;
  }
  .about-slide__btn:hover {
    background: var(--btn-regular-hover-bg, #ffffff) !important;
    color: var(--btn-regular-hover-text, #000000) !important;
    border-color: var(--btn-regular-hover-border, #000000) !important;
  }
  .about-slide__btn:hover span,
  .about-slide__btn:hover .about-slide__btn-text {
    color: var(--btn-regular-hover-text, #000000) !important;
  }
  .about-slide-nav {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 5;
    background: rgba(var(--color-background, 255, 255, 255), 0.92);
    padding: 6px 10px;
    border: 1px solid var(--pp-line, rgba(var(--color-foreground, 0, 0, 0), 0.12));
    border-radius: var(--card-radius, 0px) !important;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .about-slide-dot {
    width: 14px;
    height: 2px;
    border-radius: 0 !important;
    background: rgba(var(--color-foreground, 0, 0, 0), 0.25);
    cursor: pointer;
    transition: width 0.3s ease, background-color 0.3s ease;
  }
  .about-slide-dot.is-active {
    background: var(--text, #000000);
    width: 24px;
  }

  /* Quote Box Theme Styling */
  .about-quote-box {
    margin: 64px 0 76px;
    padding: 44px 36px;
    text-align: center;
    background: var(--pp-soft, color-mix(in srgb, var(--text, #000000) 3%, var(--bg, #ffffff))) !important;
    border-left: 2px solid var(--text, #000000) !important;
    border-right: 2px solid var(--text, #000000) !important;
    border-top: 1px solid var(--pp-line, rgba(var(--color-foreground, 0, 0, 0), 0.12)) !important;
    border-bottom: 1px solid var(--pp-line, rgba(var(--color-foreground, 0, 0, 0), 0.12)) !important;
    border-radius: var(--card-radius, 0px) !important;
  }
  .about-quote-text {
    margin: 0 auto;
    max-width: 680px;
    font-size: clamp(17px, 2.2vw, 22px);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.6;
    color: var(--text, #000000) !important;
    font-style: italic;
  }
  .about-quote-author {
    margin: 18px 0 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pp-muted, rgba(var(--color-foreground, 0, 0, 0), 0.65)) !important;
  }

  /* Theme Layout & Radius Overrides for About Us */
  .sl-hero__media,
  .ab-story__media {
    border-radius: var(--media-radius, 0px) !important;
    border: 1px solid var(--pp-line, rgba(var(--color-foreground, 0, 0, 0), 0.12)) !important;
    background: var(--pp-soft, color-mix(in srgb, var(--text, #000) 3%, var(--bg, #fff))) !important;
  }
  .sl-hero__media img,
  .ab-story__media img {
    border-radius: var(--media-radius, 0px) !important;
  }

  .ab-stats {
    border-top: 1px solid var(--pp-line, rgba(var(--color-foreground, 0, 0, 0), 0.12)) !important;
    border-bottom: 1px solid var(--pp-line, rgba(var(--color-foreground, 0, 0, 0), 0.12)) !important;
  }
  .ab-stat {
    border-left: 1px solid var(--pp-line, rgba(var(--color-foreground, 0, 0, 0), 0.12)) !important;
    color: var(--text, #000000) !important;
  }
  .ab-stat__num {
    color: var(--text, #000000) !important;
  }
  .ab-stat__label {
    color: var(--pp-muted, rgba(var(--color-foreground, 0, 0, 0), 0.62)) !important;
  }

  .sl-feature {
    border: 1px solid var(--pp-line, rgba(var(--color-foreground, 0, 0, 0), 0.12)) !important;
    border-radius: var(--card-radius, 0px) !important;
    background: var(--pp-soft, color-mix(in srgb, var(--text, #000) 4%, var(--bg, #fff))) !important;
  }
  .sl-feature__icon {
    border: 1px solid var(--pp-line, rgba(var(--color-foreground, 0, 0, 0), 0.12)) !important;
    border-radius: var(--card-radius, 0px) !important;
    background: var(--bg, #ffffff) !important;
    color: var(--text, #000000) !important;
  }
  .sl-feature__title {
    color: var(--text, #000000) !important;
  }
  .sl-feature__text {
    color: var(--pp-muted, rgba(var(--color-foreground, 0, 0, 0), 0.62)) !important;
  }

  /* Harmonized Luxury CTA Section (Full-Width Bleed with Theme Soft Tint) */
  .pg-page {
    padding-bottom: 0px !important;
  }
  .sl-cta,
  html body .pg-page .sl-cta,
  html body .sl-cta {
    display: block !important;
    text-align: center !important;
    padding: 56px var(--outer, 24px) 52px !important;
    margin: 0 calc(-1 * var(--outer, 24px)) 0px !important;
    width: calc(100% + (2 * var(--outer, 24px))) !important;
    max-width: none !important;
    box-sizing: border-box !important;
    background: var(--pp-soft, color-mix(in srgb, var(--text, #000) 4%, var(--bg, #fff))) !important;
    border-top: 1px solid var(--pp-line, rgba(var(--color-foreground, 0, 0, 0), 0.12)) !important;
    border-bottom: 1px solid var(--pp-line, rgba(var(--color-foreground, 0, 0, 0), 0.12)) !important;
    border-left: none !important;
    border-right: none !important;
    border-radius: 0px !important;
    color: var(--text, #000000) !important;
    box-shadow: none !important;
  }
  @media (max-width: 640px) {
    .sl-cta,
    html body .pg-page .sl-cta,
    html body .sl-cta {
      padding: 42px var(--outer, 16px) 38px !important;
      margin: 0 calc(-1 * var(--outer, 16px)) 0px !important;
      width: calc(100% + (2 * var(--outer, 16px))) !important;
    }
  }
  .sl-cta__inner,
  html body .pg-page .sl-cta .sl-cta__inner {
    max-width: 620px !important;
    margin: 0 auto !important;
    text-align: center !important;
  }
  .sl-cta__eyebrow,
  .sl-cta .sl-cta__eyebrow,
  html body .pg-page .sl-cta .sl-cta__eyebrow {
    margin: 0 0 12px !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    letter-spacing: 0.24em !important;
    text-transform: uppercase !important;
    color: var(--pp-muted, #777777) !important;
    display: block !important;
  }
  .sl-cta__title,
  .sl-cta .sl-cta__title,
  html body .pg-page .sl-cta .sl-cta__title {
    margin: 0 0 16px !important;
    font-size: clamp(24px, 3.4vw, 36px) !important;
    font-weight: 600 !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    line-height: 1.25 !important;
    color: var(--text, #000000) !important;
    opacity: 1 !important;
  }
  .sl-cta__text,
  .sl-cta .sl-cta__text,
  html body .pg-page .sl-cta .sl-cta__text {
    margin: 0 auto 32px !important;
    max-width: 520px !important;
    font-size: 15px !important;
    line-height: 1.8 !important;
    color: color-mix(in srgb, var(--text, #444444) 88%, transparent) !important;
    opacity: 1 !important;
  }
  .sl-cta__actions,
  html body .pg-page .sl-cta .sl-cta__actions {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-wrap: wrap !important;
    gap: 14px !important;
  }

  /* Base CTA Buttons */
  .sl-cta .sl-btn,
  html body .pg-page .sl-cta .sl-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-height: 48px !important;
    padding: 0 34px !important;
    border-radius: var(--btn-radius, 0px) !important;
    font-family: var(--TYPE-STACK-BUTTON, sans-serif) !important;
    font-size: 11.5px !important;
    font-weight: 700 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    cursor: pointer !important;
    transform: none !important;
    position: relative !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
  }
  .sl-cta .sl-btn .btn__text-content {
    position: relative !important;
    z-index: 3 !important;
    transition: color var(--btn-animation-duration, 450ms) var(--btn-ease, cubic-bezier(0.65, 0, 0.35, 1)) !important;
  }

  /* Primary Button: Explore Collection */
  .sl-cta__btn-primary,
  .sl-cta .sl-cta__btn-primary,
  html body .pg-page .sl-cta .sl-cta__btn-primary {
    background-color: var(--btn-regular-bg, #000000) !important;
    border: 1px solid var(--btn-regular-border, #000000) !important;
    color: var(--btn-regular-text, #ffffff) !important;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease !important;
  }
  .sl-cta__btn-primary .btn__text-content,
  .sl-cta__btn-primary span {
    color: var(--btn-regular-text, #ffffff) !important;
    transition: color 0.3s ease !important;
  }
  .sl-cta__btn-primary::before {
    display: none !important;
  }
  .sl-cta__btn-primary:hover,
  html body .pg-page .sl-cta .sl-cta__btn-primary:hover {
    border-color: var(--btn-regular-hover-border, #000000) !important;
    background-color: var(--btn-regular-hover-bg, #ffffff) !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12) !important;
  }
  .sl-cta__btn-primary:hover .btn__text-content,
  html body .pg-page .sl-cta .sl-cta__btn-primary:hover .btn__text-content,
  .sl-cta__btn-primary:hover span,
  html body .pg-page .sl-cta .sl-cta__btn-primary:hover span {
    color: var(--btn-regular-hover-text, #000000) !important;
  }

  /* Secondary Button: Get In Touch (Matches Global Border #D1D1D1) */
  .sl-cta__btn-secondary,
  .sl-cta .sl-cta__btn-secondary,
  html body .pg-page .sl-cta .sl-cta__btn-secondary {
    background-color: var(--bg, #ffffff) !important;
    border: 1px solid var(--border, var(--lv-border)) !important;
    color: var(--text, #000000) !important;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease !important;
  }
  .sl-cta__btn-secondary .btn__text-content,
  .sl-cta__btn-secondary span {
    color: var(--text, #000000) !important;
    transition: color 0.3s ease !important;
  }
  .sl-cta__btn-secondary::before {
    display: none !important;
  }
  .sl-cta__btn-secondary:hover,
  html body .pg-page .sl-cta .sl-cta__btn-secondary:hover {
    border-color: var(--btn-regular-hover-border, #000000) !important;
    background-color: var(--btn-regular-hover-bg, #000000) !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12) !important;
  }
  .sl-cta__btn-secondary:hover .btn__text-content,
  html body .pg-page .sl-cta .sl-cta__btn-secondary:hover .btn__text-content,
  .sl-cta__btn-secondary:hover span,
  html body .pg-page .sl-cta .sl-cta__btn-secondary:hover span {
    color: var(--btn-regular-hover-text, #ffffff) !important;
  }

  .sl-btn, .btn {
    border-radius: var(--btn-radius, 0px) !important;
  }
</style>

<!-- HERO SECTION: STORY ON LEFT, ROTATING 2ND PRODUCT IMAGES ON RIGHT -->
<section class="sl-hero">
  <div class="sl-hero__copy">
    <p class="sl-hero__eyebrow">{{ ab_eyebrow }}</p>
    <h1 class="sl-hero__title">{{ ab_heading }}</h1>
    <p class="sl-hero__lead">
      {{ ab_lead }}
    </p>
    <div class="sl-hero__btns">
      <a href="{{ shop_link }}" class="btn btn--primary btn-sliding-hover sl-btn"><span class="btn__text-content">{{ ab_btn_label }}</span></a>
      <a href="{{ contact_page_url }}" class="btn btn-sliding-hover sl-btn"><span class="btn__text-content">{{ 'pages.about.contact_atelier' | t }}</span></a>
    </div>
  </div>

  <div class="sl-hero__media">
    <div class="about-media-rotator" id="aboutMediaRotator">
      {%- if cfg.about_image != blank -%}
        <!-- Custom Hero Slide 1 configured by merchant in Theme Settings -->
        <div class="about-slide is-active" data-slide-index="0">
          <img src="{{ cfg.about_image | image_url: width: 1200 }}"
               alt="{{ cfg.about_image.alt | default: cfg.about_heading | default: ab_brand_fallback | escape }}"
               width="1200" height="1200"
               loading="eager">
          <div class="about-slide__overlay"></div>
          <div class="about-slide__card">
            <div>
              <span class="about-slide__badge">{{ 'pages.about.spotlight_badge' | t }}</span>
              <span class="about-slide__title">{{ cfg.about_heading | default: ab_brand_fallback }}</span>
            </div>
            <a href="{{ shop_link }}" class="about-slide__btn"><span class="about-slide__btn-text">{{ 'pages.about.shop_collection' | t }}</span></a>
          </div>
        </div>

        {%- if cfg.about_image_slide_2 != blank -%}
          <!-- Custom Hero Slide 2 configured by merchant in Theme Settings -->
          <div class="about-slide" data-slide-index="1">
            {%- assign ab_slide2_title = 'pages.about.slide_2_title' | t -%}
            <img src="{{ cfg.about_image_slide_2 | image_url: width: 1200 }}"
                 alt="{{ cfg.about_image_slide_2.alt | default: ab_slide2_title | escape }}"
                 width="1200" height="1200"
                 loading="lazy">
            <div class="about-slide__overlay"></div>
            <div class="about-slide__card">
              <div>
                <span class="about-slide__badge">{{ 'pages.about.spotlight_badge' | t }}</span>
                <span class="about-slide__title">{{ ab_slide2_title }}</span>
              </div>
              <a href="{{ shop_link }}" class="about-slide__btn"><span class="about-slide__btn-text">{{ 'pages.about.explore_pieces' | t }}</span></a>
            </div>
          </div>
          <div class="about-slide-nav" id="aboutSlideDots">
            <span class="about-slide-dot is-active" data-dot-idx="0"></span>
            <span class="about-slide-dot" data-dot-idx="1"></span>
          </div>
        {%- endif -%}
      {%- else -%}
        <!-- Dynamic Product Slides from Store Catalog -->
        {%- assign found_slides = 0 -%}
        {%- for prod in collections.all.products -%}
          {%- assign current_img = nil -%}
          {%- if prod.images.size > 1 -%}
            {%- assign current_img = prod.images[1] -%}
          {%- elsif prod.featured_image != blank -%}
            {%- assign current_img = prod.featured_image -%}
          {%- endif -%}

          {%- if current_img != blank -%}
            <div class="about-slide{% if found_slides == 0 %} is-active{% endif %}" data-slide-index="{{ found_slides }}">
              <img src="{{ current_img | image_url: width: 1200 }}"
                   srcset="{{ current_img | image_url: width: 600 }} 600w, {{ current_img | image_url: width: 900 }} 900w, {{ current_img | image_url: width: 1200 }} 1200w"
                   sizes="(min-width: 901px) 46vw, 100vw"
                   alt="{{ prod.title | escape }}"
                   width="{{ current_img.width }}"
                   height="{{ current_img.height }}"
                   loading="{% if found_slides == 0 %}eager{% else %}lazy{% endif %}">
              <div class="about-slide__overlay"></div>
              <div class="about-slide__card">
                <div>
                  <span class="about-slide__badge">{{ 'pages.about.spotlight_badge' | t }}</span>
                  <a href="{{ prod.url }}" class="about-slide__title">{{ prod.title }}</a>
                </div>
                <a href="{{ prod.url }}" class="about-slide__btn"><span class="about-slide__btn-text">{{ 'pages.about.view_piece' | t }}</span></a>
              </div>
            </div>
            {%- assign found_slides = found_slides | plus: 1 -%}
            {%- if found_slides >= 8 -%}{%- break -%}{%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if found_slides == 0 -%}
          <div class="about-slide is-active">
