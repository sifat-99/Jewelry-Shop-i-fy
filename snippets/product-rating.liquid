{% doc %}
  Small "★★★★★ 4.8 (12)" line for a product (under the title). Links to #product-reviews. Accepts: product

  @param {product} [product] - Optional product passed by the parent file
{% enddoc %}
{%- comment -%}
  Small "★★★★★ 4.8 (12)" line for a product (under the title). Links to #product-reviews.
  Accepts: product
{%- endcomment -%}
{%- capture rs -%}{%- render 'product-review-stats', product_id: product.id -%}{%- endcapture -%}
{%- assign rp = rs | split: '~~' -%}
<a class="lv-prating" href="#product-reviews" aria-label="{{ rp[1] }} reviews, average {{ rp[0] }} out of 5">
  {%- render 'rating-stars', rating: rp[0], class_name: 'lv-stars' -%}
  {%- if rp[1] == '0' -%}
    <span class="lv-prating__text">No reviews yet</span>
  {%- else -%}
    <strong>{{ rp[0] }}</strong><span class="lv-prating__text">({{ rp[1] }})</span>
  {%- endif -%}
</a>
<style>
  .lv-stars { font-size: 18px; }
  .lv-prating { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 14px; font-size: 13px; color: inherit; text-decoration: none; }
  .lv-prating strong { font-weight: 700; }
  .lv-prating__text { opacity: .65; font-size: 12.5px; }
  .lv-prating:hover .lv-prating__text { text-decoration: underline; text-underline-offset: 3px; }
</style>
