{% doc %}
  JSON list of variants used by the product page JS. Accepts: product

  @param {product} [product] - Optional product passed by the parent file
{% enddoc %}
{%- comment -%} JSON list of variants used by the product page JS. Accepts: product {%- endcomment -%}
[
  {%- for v in product.variants -%}
    {%- liquid
      assign inv = -1
      if v.inventory_management == 'shopify'
        assign inv = v.inventory_quantity
      endif
      assign save_pct = 0
      if v.compare_at_price > v.price
        assign save_pct = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round
      endif
    -%}
    {
      "id": {{ v.id }},
      "options": {{ v.options | json }},
      "available": {{ v.available | json }},
      "price": {{ v.price | money | json }},
      "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}""{% endif %},
      "save": {{ save_pct }},
      "sku": {{ v.sku | json }},
      "media_id": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %},
      "inventory": {{ inv }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]
