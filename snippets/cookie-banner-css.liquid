{% doc %}
  Styles Shopify's native Customer Privacy cookie consent banner (#shopify-pc__banner)
  and preferences dialog (#shopify-pc__prefs) to match the storefront's luxury design system.

  @example
  {% render 'cookie-banner-css' %}
{% enddoc %}
{%- liquid
  assign cb_btn_style = settings.palette_button_style | default: 'gold'
  assign cb_btn_radius = settings.button_border_radius | default: 0
  assign cb_btn_border_width = settings.button_border_thickness | default: 1
  assign cb_card_radius = settings.card_border_radius | default: 0
  assign cb_btn_font_size = settings.button_font_size | default: 12 | at_most: 12
  assign cb_btn_font_weight = settings.button_font_weight | default: 600
  assign cb_btn_ls = settings.button_letter_spacing | default: 14 | divided_by: 100.0
-%}
<style>
  /* Aurelle Luxury Theme — Native Shopify Cookie Banner & Preferences Center */
  :root {
    --lv-cookie-bg: var(--lv-ivory, #ffffff);
    --lv-cookie-surface: var(--lv-cream, #f7f5f0);
    --lv-cookie-ink: var(--lv-ink, #1a1a1a);
    --lv-cookie-muted: rgba(26, 26, 26, 0.78);
    --lv-cookie-border: var(--lv-line, #e6e2d8);
    --lv-cookie-accent: var(--lv-accent-deep, #785c37);
    --lv-cookie-radius: {{ cb_card_radius }}px;
    --lv-cookie-btn-radius: {{ cb_btn_radius }}px;
    --lv-cookie-btn-bw: {{ cb_btn_border_width }}px;
    {%- case cb_btn_style -%}
      {%- when 'ink' -%}
        --lv-cookie-btn-primary-bg: var(--lv-ink, #1a1a1a);
        --lv-cookie-btn-primary-text: var(--lv-ivory, #ffffff);
        --lv-cookie-btn-primary-border: var(--lv-ink, #1a1a1a);
        --lv-cookie-btn-primary-hover-bg: var(--lv-accent-deep, #785c37);
        --lv-cookie-btn-primary-hover-text: var(--lv-ivory, #ffffff);
      {%- when 'outline' -%}
        --lv-cookie-btn-primary-bg: transparent;
        --lv-cookie-btn-primary-text: var(--lv-ink, #1a1a1a);
        --lv-cookie-btn-primary-border: var(--lv-ink, #1a1a1a);
        --lv-cookie-btn-primary-hover-bg: var(--lv-ink, #1a1a1a);
        --lv-cookie-btn-primary-hover-text: var(--lv-ivory, #ffffff);
      {%- else -%}
        --lv-cookie-btn-primary-bg: var(--lv-accent-deep, #785c37);
        --lv-cookie-btn-primary-text: var(--lv-ivory, #ffffff);
        --lv-cookie-btn-primary-border: var(--lv-accent-deep, #785c37);
        --lv-cookie-btn-primary-hover-bg: var(--lv-ink, #1a1a1a);
        --lv-cookie-btn-primary-hover-text: var(--lv-ivory, #ffffff);
    {%- endcase -%}
  }

  /* ---------- Bottom Banner Dialog ---------- */
  html body #shopify-pc__banner.shopify-pc__banner__dialog {
    background-color: var(--lv-cookie-bg) !important;
    color: var(--lv-cookie-ink) !important;
    border-top: 1px solid var(--lv-cookie-border) !important;
    border-radius: var(--lv-cookie-radius) !important;
    box-shadow: 0 -12px 36px rgba(26, 26, 26, 0.09) !important;
    padding: clamp(18px, 2.4vw, 26px) clamp(18px, 4vw, 48px) !important;
    font-family: var(--FONT-STACK-BODY) !important;
    box-sizing: border-box !important;
  }

  html body #shopify-pc__banner .shopify-pc__banner__wrapper {
    max-width: var(--LAYOUT-WIDTH, 1600px) !important;
    width: 100% !important;
    margin: 0 auto !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: clamp(16px, 3vw, 42px) !important;
  }

  html body #shopify-pc__banner .shopify-pc__banner__body {
    flex: 1 1 auto !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  html body #shopify-pc__banner #shopify-pc__banner__body-title,
  html body #shopify-pc__banner .shopify-pc__banner__body h2 {
    font-family: var(--FONT-STACK-HEADING) !important;
    font-size: clamp(16px, 1.35vw, 19px) !important;
    font-weight: var(--FONT-WEIGHT-HEADING, 500) !important;
    letter-spacing: var(--FONT-HEADING-LETTER-SPACING, 0.06em) !important;
    text-transform: var(--FONT-HEADING-TRANSFORM, uppercase) !important;
    line-height: 1.25 !important;
    color: var(--lv-cookie-ink) !important;
    margin: 0 0 6px 0 !important;
    padding: 0 !important;
  }

  html body #shopify-pc__banner .shopify-pc__banner__body p {
    font-family: var(--FONT-STACK-BODY) !important;
    font-size: 13.5px !important;
    font-weight: var(--FONT-WEIGHT-BODY, 400) !important;
    line-height: 1.65 !important;
    color: var(--lv-cookie-muted) !important;
    margin: 0 !important;
    padding: 0 !important;
    max-width: 76ch !important;
  }

  html body #shopify-pc__banner .shopify-pc__banner__body a,
  html body #shopify-pc__banner #shopify-pc__banner__body-policy-link {
    color: var(--lv-cookie-ink) !important;
    font-weight: 500 !important;
    text-decoration: underline !important;
    text-underline-offset: 3px !important;
    text-decoration-thickness: 1px !important;
    transition: opacity 0.25s ease !important;
  }

  html body #shopify-pc__banner .shopify-pc__banner__body a:hover,
  html body #shopify-pc__banner #shopify-pc__banner__body-policy-link:hover {
    opacity: 0.65 !important;
  }

  /* ---------- Banner Action Buttons ---------- */
  html body #shopify-pc__banner .shopify-pc__banner__btns {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 10px !important;
    flex: 0 0 auto !important;
    min-width: 0 !important;
    width: auto !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  html body #shopify-pc__banner .shopify-pc__banner__btns button,
  html body #shopify-pc__prefs .shopify-pc__prefs__header-actions button {
    font-family: var(--TYPE-STACK-BUTTON) !important;
    font-size: {{ cb_btn_font_size }}px !important;
    font-weight: {{ cb_btn_font_weight }} !important;
    letter-spacing: {{ cb_btn_ls }}em !important;
    text-transform: {% if settings.button_uppercase == false %}none{% else %}uppercase{% endif %} !important;
    border-radius: var(--lv-cookie-btn-radius) !important;
    line-height: 1.2 !important;
    min-height: 44px !important;
    padding: 12px 22px !important;
    margin: 0 !important;
    flex: 0 0 auto !important;
    flex-basis: auto !important;
    white-space: nowrap !important;
    text-align: center !important;
    cursor: pointer !important;
    box-shadow: none !important;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, opacity 0.25s ease !important;
  }

  /* Primary: Accept All */
  html body #shopify-pc__banner button#shopify-pc__banner__btn-accept,
  html body #shopify-pc__prefs button#shopify-pc__prefs__header-accept {
    background: var(--lv-cookie-btn-primary-bg) !important;
    color: var(--lv-cookie-btn-primary-text) !important;
    border: var(--lv-cookie-btn-bw) solid var(--lv-cookie-btn-primary-border) !important;
  }

  html body #shopify-pc__banner button#shopify-pc__banner__btn-accept:hover,
  html body #shopify-pc__prefs button#shopify-pc__prefs__header-accept:hover {
    background: var(--lv-cookie-btn-primary-hover-bg) !important;
    color: var(--lv-cookie-btn-primary-hover-text) !important;
    border-color: var(--lv-cookie-btn-primary-hover-bg) !important;
  }

  /* Secondary: Decline & Save */
  html body #shopify-pc__banner button#shopify-pc__banner__btn-decline,
  html body #shopify-pc__prefs button#shopify-pc__prefs__header-decline,
  html body #shopify-pc__prefs button#shopify-pc__prefs__header-save {
    background: var(--lv-cookie-bg) !important;
    color: var(--lv-cookie-ink) !important;
    border: var(--lv-cookie-btn-bw) solid var(--lv-border, #d1d1d1) !important;
  }

  html body #shopify-pc__banner button#shopify-pc__banner__btn-decline:hover,
  html body #shopify-pc__prefs button#shopify-pc__prefs__header-decline:hover,
  html body #shopify-pc__prefs button#shopify-pc__prefs__header-save:hover {
    background: var(--lv-cookie-surface) !important;
    border-color: var(--lv-cookie-ink) !important;
    color: var(--lv-cookie-ink) !important;
  }

  /* Editorial Link Action: Manage Preferences */
  html body #shopify-pc__banner button#shopify-pc__banner__btn-manage-prefs {
    background: transparent !important;
    color: var(--lv-cookie-ink) !important;
    border: var(--lv-cookie-btn-bw) solid transparent !important;
    padding: 12px 14px !important;
    text-decoration: underline !important;
    text-underline-offset: 4px !important;
    text-decoration-thickness: 1px !important;
  }

  html body #shopify-pc__banner button#shopify-pc__banner__btn-manage-prefs:hover {
    color: var(--lv-cookie-accent) !important;
    opacity: 0.85 !important;
  }

  html body #shopify-pc__banner button:focus-visible,
  html body #shopify-pc__banner a:focus-visible,
  html body #shopify-pc__prefs button:focus-visible {
    outline: 2px solid var(--lv-cookie-accent) !important;
    outline-offset: 2px !important;
    box-shadow: none !important;
  }

  /* ---------- Preferences Overlay & Modal ---------- */
  html body #shopify-pc__prefs .shopify-pc__prefs__overlay {
    background-color: rgba(26, 26, 26, 0.48) !important;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  html body #shopify-pc__prefs #shopify-pc__prefs__dialog.shopify-pc__prefs__dialog {
    background-color: var(--lv-cookie-bg) !important;
    color: var(--lv-cookie-ink) !important;
    border: 1px solid var(--lv-cookie-border) !important;
    border-radius: var(--lv-cookie-radius) !important;
    box-shadow: 0 24px 64px rgba(26, 26, 26, 0.16) !important;
    width: min(820px, calc(100vw - 32px)) !important;
    max-width: 820px !important;
    max-height: min(86vh, 780px) !important;
    left: 50% !important;
    right: auto !important;
    top: 50% !important;
    transform: translate(-50%, -50%) !important;
    font-family: var(--FONT-STACK-BODY) !important;
    overflow: hidden !important;
  }

  html body #shopify-pc__prefs .shopify-pc__prefs__dialog header {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    justify-content: flex-start !important;
    gap: 16px !important;
    padding: 26px 32px 22px 32px !important;
    background: var(--lv-cookie-surface) !important;
    border-bottom: 1px solid var(--lv-cookie-border) !important;
  }

  html body #shopify-pc__prefs #shopify-pc__prefs__header-title,
  html body #shopify-pc__prefs .shopify-pc__prefs__dialog header h2 {
    font-family: var(--FONT-STACK-HEADING) !important;
    font-size: clamp(20px, 2vw, 24px) !important;
    font-weight: var(--FONT-WEIGHT-HEADING, 500) !important;
    letter-spacing: var(--FONT-HEADING-LETTER-SPACING, 0.06em) !important;
    text-transform: var(--FONT-HEADING-TRANSFORM, uppercase) !important;
    color: var(--lv-cookie-ink) !important;
    line-height: 1.25 !important;
    text-align: start !important;
    margin: 0 !important;
    padding: 0 40px 0 0 !important;
  }

  html body #shopify-pc__prefs .shopify-pc__prefs__header-actions {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: wrap !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: 10px !important;
    width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  html body #shopify-pc__prefs button#shopify-pc__prefs__header-close {
    top: 22px !important;
    right: 22px !important;
    width: 34px !important;
    height: 34px !important;
    min-width: 34px !important;
    border-radius: var(--lv-cookie-btn-radius) !important;
    border: 1px solid transparent !important;
    background: transparent !important;
    transition: background-color 0.2s ease, border-color 0.2s ease !important;
  }

  html body #shopify-pc__prefs[dir="rtl"] button#shopify-pc__prefs__header-close {
    right: auto !important;
    left: 22px !important;
  }

  html body #shopify-pc__prefs button#shopify-pc__prefs__header-close:hover {
    background: var(--lv-cookie-bg) !important;
    border-color: var(--lv-cookie-border) !important;
  }

  html body #shopify-pc__prefs button#shopify-pc__prefs__header-close svg {
    width: 13px !important;
    height: 13px !important;
  }

  html body #shopify-pc__prefs button#shopify-pc__prefs__header-close svg path {
    fill: var(--lv-cookie-ink) !important;
  }

  html body #shopify-pc__prefs .shopify-pc__prefs__scrollable {
    background: var(--lv-cookie-bg) !important;
    scrollbar-width: thin !important;
  }

  html body #shopify-pc__prefs .shopify-pc__prefs__intro-main {
    padding: 26px 32px 0 32px !important;
  }

  html body #shopify-pc__prefs .shopify-pc__prefs__intro-explain {
    padding: 20px 32px 0 32px !important;
    gap: 24px !important;
    color: var(--lv-cookie-muted) !important;
  }

  html body #shopify-pc__prefs .shopify-pc__prefs__intro h3 {
    font-family: var(--FONT-STACK-HEADING) !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    color: var(--lv-cookie-ink) !important;
    margin: 0 0 10px 0 !important;
  }

  html body #shopify-pc__prefs .shopify-pc__prefs__intro p,
  html body #shopify-pc__prefs .shopify-pc__prefs__intro li {
    font-family: var(--FONT-STACK-BODY) !important;
    font-size: 13.5px !important;
    line-height: 1.65 !important;
    color: var(--lv-cookie-muted) !important;
  }

  html body #shopify-pc__prefs .shopify-pc__prefs__options {
    padding: 6px 32px 30px 32px !important;
  }

  html body #shopify-pc__prefs .shopify-pc__prefs__option {
    padding: 18px 0 0 0 !important;
    margin: 18px 0 0 0 !important;
    border-top: 1px solid var(--lv-cookie-border) !important;
  }

  html body #shopify-pc__prefs .shopify-pc__prefs__option label {
    display: flex !important;
    align-items: center !important;
    gap: 14px !important;
    font-family: var(--FONT-STACK-HEADING) !important;
    font-size: 15px !important;
    font-weight: 600 !important;
    letter-spacing: 0.03em !important;
    color: var(--lv-cookie-ink) !important;
    margin: 0 0 6px 0 !important;
  }

  html body #shopify-pc__prefs .shopify-pc__prefs__option label span {
    background: var(--lv-cookie-bg) !important;
    width: 22px !important;
    height: 22px !important;
    flex: 0 0 22px !important;
  }

  html body #shopify-pc__prefs .shopify-pc__prefs__option label span svg {
    background: var(--lv-cookie-bg) !important;
    border-radius: var(--lv-cookie-btn-radius) !important;
    width: 22px !important;
    height: 22px !important;
    color: var(--lv-cookie-accent) !important;
  }

  html body #shopify-pc__prefs .shopify-pc__prefs__option label input:focus ~ span {
    background: transparent !important;
  }

  html body #shopify-pc__prefs .shopify-pc__prefs__option label input:focus ~ span svg {
    border-radius: var(--lv-cookie-btn-radius) !important;
    box-shadow: 0 0 0 2px var(--lv-cookie-accent) !important;
  }

  html body #shopify-pc__prefs .shopify-pc__prefs__option p {
    font-family: var(--FONT-STACK-BODY) !important;
    font-size: 13px !important;
    line-height: 1.65 !important;
    color: var(--lv-cookie-muted) !important;
    padding: 0 0 0 36px !important;
  }

  html body #shopify-pc__prefs[dir="rtl"] .shopify-pc__prefs__option p {
    padding: 0 36px 0 0 !important;
  }

  /* ---------- Responsive Breakpoints ---------- */
  @media only screen and (max-width: 1120px) {
    html body #shopify-pc__banner .shopify-pc__banner__wrapper {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 16px !important;
    }

    html body #shopify-pc__banner .shopify-pc__banner__btns {
      width: 100% !important;
      justify-content: flex-start !important;
      flex-wrap: wrap !important;
    }
  }

  @media only screen and (max-width: 560px) {
    html body #shopify-pc__banner.shopify-pc__banner__dialog {
      padding: 18px 18px 20px !important;
    }

    html body #shopify-pc__banner .shopify-pc__banner__btns {
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 8px !important;
    }

    html body #shopify-pc__banner .shopify-pc__banner__btns button {
      width: 100% !important;
      min-height: 44px !important;
    }

    html body #shopify-pc__banner .shopify-pc__banner__btns-granular button#shopify-pc__banner__btn-accept {
      order: 1 !important;
    }

    html body #shopify-pc__banner .shopify-pc__banner__btns-granular button#shopify-pc__banner__btn-decline {
      order: 2 !important;
    }

    html body #shopify-pc__banner .shopify-pc__banner__btns-granular button#shopify-pc__banner__btn-manage-prefs {
      order: 3 !important;
    }

    html body #shopify-pc__prefs .shopify-pc__prefs__dialog header,
    html body #shopify-pc__prefs .shopify-pc__prefs__intro-main,
    html body #shopify-pc__prefs .shopify-pc__prefs__intro-explain {
      padding-left: 20px !important;
      padding-right: 20px !important;
    }

    html body #shopify-pc__prefs .shopify-pc__prefs__options {
      padding: 6px 20px 24px 20px !important;
    }

    html body #shopify-pc__prefs .shopify-pc__prefs__header-actions {
      flex-direction: column !important;
      align-items: stretch !important;
    }

    html body #shopify-pc__prefs .shopify-pc__prefs__header-actions button {
      width: 100% !important;
      margin: 0 !important;
    }
  }
</style>
