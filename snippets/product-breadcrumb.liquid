{% doc %}
  Breadcrumb for the product page: Home / (collection or All products) / product. Accepts: product, collection

  @param {product} [product] - Optional product passed by the parent file
  @param {collection} [collection] - Optional collection passed by the parent file
{% enddoc %}
{%- comment -%} Breadcrumb for the product page: Home / (collection or All products) / product. Accepts: product, collection {%- endcomment -%}
{%- liquid
  assign bc_parent = collection
  if bc_parent == blank
    assign bc_parent = product.collections.first
  endif
-%}
{%- if bc_parent != blank -%}
  {% render 'breadcrumb', current: product.title, parent_title: bc_parent.title, parent_url: bc_parent.url %}
{%- else -%}
  {%- assign all_products_title = 'breadcrumbs.all_products' | t -%}
  {% render 'breadcrumb', current: product.title, parent_title: all_products_title, parent_url: routes.all_products_collection_url %}
{%- endif -%}
