<script>
  (function() {
    var modal = document.getElementById('QuickViewModal');
    var underlay = document.getElementById('QuickViewUnderlay');
    var closeBtn = document.getElementById('QuickViewClose');
    var contentEl = document.getElementById('QuickViewContent');
    var toast = document.getElementById('WishlistToast');
    var toastMsg = document.getElementById('WishlistToastMsg');
    var toastTimer = null;

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function formatMoney(cents) {
      if (!cents && cents !== 0) return '';
      var num = cents / 100;
      var formatted = num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (window.theme && window.theme.moneyFormat) {
        var fmt = window.theme.moneyFormat;
        return fmt
          .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/, formatted.replace('.', ','))
          .replace(/\{\{\s*amount_no_decimals_with_comma_separator\s*\}\}/, Math.round(num).toLocaleString('en-US').replace('.', ','))
          .replace(/\{\{\s*amount_no_decimals\s*\}\}/, Math.round(num).toLocaleString('en-US'))
          .replace(/\{\{\s*amount\s*\}\}/, formatted);
      }
      return '€' + formatted;
    }

    function showToast(msg) {
      if (!toast) return;
      if (toastTimer) clearTimeout(toastTimer);
      if (toastMsg) toastMsg.textContent = msg;
      toast.classList.add('is-visible');
      toastTimer = setTimeout(function() {
        toast.classList.remove('is-visible');
      }, 2600);
    }

    // === Wishlist Storage Manager ===
    window.toggleWishlist = function(productId, btn) {
      productId = String(productId);
      var wishlist = [];
      try {
        wishlist = JSON.parse(localStorage.getItem('le_velair_wishlist') || '[]');
      } catch(e) {
        wishlist = [];
      }

      var index = wishlist.indexOf(productId);
      var isAdded = false;
      if (index > -1) {
        wishlist.splice(index, 1);
        isAdded = false;
      } else {
        wishlist.push(productId);
        isAdded = true;
      }

      try {
        localStorage.setItem('le_velair_wishlist', JSON.stringify(wishlist));
      } catch(e) {}

      // Update buttons on page
      document.querySelectorAll('[data-wishlist-id="' + productId + '"]').forEach(function(el) {
        if (isAdded) {
          el.classList.add('is-active');
          el.setAttribute('title', 'In wishlist');
        } else {
          el.classList.remove('is-active');
          el.setAttribute('title', 'Add to wishlist');
        }
      });

      showToast(isAdded ? 'Added to wishlist' : 'Removed from wishlist');
    };

    function syncWishlistIcons() {
      var wishlist = [];
      try {
        wishlist = JSON.parse(localStorage.getItem('le_velair_wishlist') || '[]');
      } catch(e) {
        wishlist = [];
      }
      wishlist.forEach(function(id) {
        document.querySelectorAll('[data-wishlist-id="' + id + '"]').forEach(function(el) {
          el.classList.add('is-active');
          el.setAttribute('title', 'In wishlist');
        });
      });
    }

    // === Quick View Modal Open / Close Logic ===
    function openQuickView(handle) {
      if (!modal || !underlay || !handle) return;
      modal.classList.add('is-open');
      underlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';

      contentEl.innerHTML = '<div class="qv-loading"><div class="qv-spinner"></div></div>';

      fetch('/products/' + handle + '.js')
        .then(function(res) { return res.json(); })
        .then(function(product) {
          renderQuickView(product);
        })
        .catch(function(err) {
          console.error('Quick view error:', err);
          contentEl.innerHTML = '<p style="text-align: center; padding: 40px; font-weight: 600;">Could not load product details.</p>';
        });
    }

    function closeQuickView() {
      if (!modal || !underlay) return;
      modal.classList.remove('is-open');
      underlay.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    // === Quick View Modal Content Renderer ===
    function renderQuickView(product) {
      var currentVariant = product.variants[0];
      var hasDiscount = currentVariant.compare_at_price && currentVariant.compare_at_price > currentVariant.price;
      var discountPercent = 0;
      if (hasDiscount) {
        discountPercent = Math.round(((currentVariant.compare_at_price - currentVariant.price) / currentVariant.compare_at_price) * 100);
      }

      var html = '<div class="qv-grid">';

      // -------------------------------------------------------------
      // 1. LEFT COLUMN: Fixed / Sticky Image Gallery
      // -------------------------------------------------------------
      html += '<div class="qv-gallery">';
      var rawMainImg = (currentVariant.featured_image && currentVariant.featured_image.src) || product.featured_image || (product.images && product.images[0]) || '';
      var mainImg = rawMainImg ? (rawMainImg.indexOf('?') > -1 ? rawMainImg + '&width=1200' : rawMainImg + '?width=1200') : '';
      html += '  <div class="qv-main-image-wrap">';
      html += '    <img id="QvMainImg" src="' + mainImg + '" alt="' + escapeHtml(product.title || '') + '" loading="eager">';
      html += '  </div>';

      if (product.images && product.images.length > 1) {
        html += '<div class="qv-thumbs-row">';
        product.images.forEach(function(img, idx) {
          html += '<button type="button" class="qv-thumb ' + (idx === 0 ? 'is-active' : '') + '" data-img-src="' + img + '" aria-label="Thumbnail ' + (idx + 1) + '">';
          html += '  <img src="' + img + '" alt="" loading="lazy">';
          html += '</button>';
        });
        html += '</div>';
      }
      html += '</div>'; // End qv-gallery

      // -------------------------------------------------------------
      // 2. RIGHT COLUMN: Scrollable Full Product Details
      // -------------------------------------------------------------
      html += '<div class="qv-details">';

      // Breadcrumb / Category Meta
      html += '  <div class="qv-meta-row">';
      html += '    <span class="qv-vendor">Jewelry Shop</span>';
      html += '    <span class="qv-meta-dot">•</span>';
      html += '    <span class="qv-type">' + escapeHtml(product.type || 'LUXURY JEWELRY') + '</span>';
      html += '  </div>';

      // Title
      html += '  <h2 class="qv-title">' + escapeHtml(product.title) + '</h2>';

      // Price Row
      html += '  <div class="qv-price-row">';
      html += '    <span class="qv-price" id="QvPrice">' + formatMoney(currentVariant.price) + '</span>';
      html += '    <span class="qv-compare-price" id="QvComparePrice" style="' + (hasDiscount ? '' : 'display:none;') + '">' + formatMoney(currentVariant.compare_at_price) + '</span>';
      html += '    <span class="qv-discount-badge" id="QvDiscountBadge" style="' + (hasDiscount && discountPercent > 0 ? '' : 'display:none;') + '">' + discountPercent + '% OFF</span>';
      html += '  </div>';
      html += '  <div class="qv-tax-note">Tax included. Free shipping on qualifying orders.</div>';

      html += '  <div class="qv-divider"></div>';

      // Variant / Category Option Selectors
      if (product.options && product.options.length > 0 && product.options[0].name !== 'Title') {
        html += '<div class="qv-options-wrap">';
        product.options.forEach(function(opt, optIdx) {
          html += '<div class="qv-option-group" data-option-index="' + optIdx + '">';
          html += '  <div class="qv-option-header">';
          html += '    <span class="qv-option-label">' + escapeHtml(opt.name) + ':</span>';
          html += '    <span class="qv-option-current" id="QvOptVal_' + optIdx + '">' + escapeHtml(opt.values[0]) + '</span>';
          html += '  </div>';
          html += '  <div class="qv-option-values">';
          opt.values.forEach(function(val, valIdx) {
            html += '<button type="button" class="qv-pill-btn ' + (valIdx === 0 ? 'is-selected' : '') + '" data-opt-idx="' + optIdx + '" data-val="' + escapeHtml(val) + '">' + escapeHtml(val) + '</button>';
          });
          html += '  </div>';
          html += '</div>';
        });
        html += '</div>';
      }

      // Quantity Selector & Add to Cart Button (Identical 48px Height & Sliding Fill)
      html += '<div class="qv-action-row">';
      html += '  <div class="qv-qty-selector">';
      html += '    <button type="button" class="qv-qty-btn" id="QvQtyMinus" aria-label="Decrease quantity">−</button>';
      html += '    <input type="number" class="qv-qty-input" id="QvQtyInput" value="1" min="1" readonly aria-label="Quantity">';
      html += '    <button type="button" class="qv-qty-btn" id="QvQtyPlus" aria-label="Increase quantity">+</button>';
      html += '  </div>';
      html += '  <button type="button" class="qv-add-btn btn-sliding-hover" id="QvAddToCartBtn" data-variant-id="' + currentVariant.id + '" ' + (!currentVariant.available ? 'disabled' : '') + '>';
      html += '    <span class="btn__text-content"><span id="QvBtnText">' + (currentVariant.available ? 'Add to Cart' : 'Sold Out') + '</span></span>';
      html += '    <span class="qv-btn-spinner" id="QvBtnSpinner" style="display: none;">';
      html += '      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>';
      html += '    </span>';
      html += '  </button>';
      html += '</div>';

      // Key Trust Highlights
      html += '<div class="qv-highlights">';
      html += '  <div class="qv-highlight-item">';
      html += '    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>';
      html += '    <span>100% Waterproof</span>';
      html += '  </div>';
      html += '  <div class="qv-highlight-item">';
      html += '    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>';
      html += '    <span>Lifetime Color Warranty</span>';
      html += '  </div>';
      html += '  <div class="qv-highlight-item">';
      html += '    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>';
      html += '    <span>Hypoallergenic & Nickel-Free</span>';
      html += '  </div>';
      html += '  <div class="qv-highlight-item">';
      html += '    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>';
      html += '    <span>Fast Tracked Dispatch</span>';
      html += '  </div>';
      html += '</div>';

      // Full Product Details Accordions
      var cleanDescription = product.description ? product.description.trim() : '';
      if (!cleanDescription || cleanDescription === '<p></p>' || cleanDescription === '<div></div>') {
        cleanDescription = '<p>Crafted to perfection, the <strong>' + escapeHtml(product.title) + '</strong> embodies timeless modern elegance. Designed for comfortable everyday wear and effortless stacking.</p>' +
          '<p><strong>• Material:</strong> Premium 316L Stainless Steel with 18K PVD Gold Plating<br>' +
          '<strong>• Water Resistance:</strong> 100% Waterproof, Heat & Sweat Resistant<br>' +
          '<strong>• Skin Friendly:</strong> Hypoallergenic, Lead & Nickel Free<br>' +
          '<strong>• Warranty:</strong> Guaranteed never to fade, tarnish, or turn green</p>';
      }

      html += '<div class="qv-accordions">';
      
      // Tab 1: Product Description (Open by default)
      html += '  <div class="qv-accordion-item is-open">';
      html += '    <button type="button" class="qv-accordion-trigger" aria-expanded="true">';
      html += '      <span>Product Description</span>';
      html += '      <span class="qv-accordion-icon">−</span>';
      html += '    </button>';
      html += '    <div class="qv-accordion-panel">';
      html += '      ' + cleanDescription;
      html += '    </div>';
      html += '  </div>';

      // Tab 2: Shipping & Returns
      html += '  <div class="qv-accordion-item">';
      html += '    <button type="button" class="qv-accordion-trigger" aria-expanded="false">';
      html += '      <span>Shipping & Returns</span>';
      html += '      <span class="qv-accordion-icon">+</span>';
      html += '    </button>';
      html += '    <div class="qv-accordion-panel" style="display: none;">';
      html += '      <p>• Orders are carefully packaged and dispatched within 24 to 48 hours.<br>';
      html += '      • <strong>Free standard shipping</strong> is available on qualifying orders.<br>';
      html += '      • Real-time parcel tracking provided immediately via email and SMS.<br>';
      html += '      • 14 days easy returns and full satisfaction guarantee.</p>';
      html += '    </div>';
      html += '  </div>';

      // Tab 3: Material & Guarantee
      html += '  <div class="qv-accordion-item">';
      html += '    <button type="button" class="qv-accordion-trigger" aria-expanded="false">';
      html += '      <span>Material & Guarantee</span>';
      html += '      <span class="qv-accordion-icon">+</span>';
      html += '    </button>';
      html += '    <div class="qv-accordion-panel" style="display: none;">';
      html += '      <p>Our jewelry is crafted from surgical-grade 316L waterproof stainless steel with durable 18K PVD gold coating. 100% waterproof, nickel-free, and retains its radiant shine for a lifetime—even in water, sweat, or perfumes.</p>';
      html += '    </div>';
      html += '  </div>';

      html += '</div>'; // End qv-accordions

      // View Full Details Link
      html += '<a href="' + (product.url || '#') + '" class="qv-view-product">';
      html += '  <span>View Full Product Details</span>';
      html += '  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>';
      html += '</a>';

      html += '</div>'; // End qv-details
      html += '</div>'; // End qv-grid

      contentEl.innerHTML = html;

      // -------------------------------------------------------------
      // 3. EVENT BINDINGS
      // -------------------------------------------------------------

      // Thumbnail clicks
      contentEl.querySelectorAll('.qv-thumb').forEach(function(thumb) {
        thumb.addEventListener('click', function() {
          contentEl.querySelectorAll('.qv-thumb').forEach(function(t) { t.classList.remove('is-active'); });
          this.classList.add('is-active');
          var src = this.getAttribute('data-img-src');
          var mainImgEl = document.getElementById('QvMainImg');
          if (mainImgEl && src) mainImgEl.src = src;
        });
      });

      // Accordion trigger toggling
      contentEl.querySelectorAll('.qv-accordion-trigger').forEach(function(trigger) {
        trigger.addEventListener('click', function() {
          var item = this.closest('.qv-accordion-item');
          var panel = item.querySelector('.qv-accordion-panel');
          var icon = this.querySelector('.qv-accordion-icon');
          var isOpen = panel.style.display !== 'none';

          if (isOpen) {
            panel.style.display = 'none';
            icon.textContent = '+';
            item.classList.remove('is-open');
            this.setAttribute('aria-expanded', 'false');
          } else {
            panel.style.display = 'block';
            icon.textContent = '−';
            item.classList.add('is-open');
            this.setAttribute('aria-expanded', 'true');
          }
        });
      });

      // Option Pill clicks (Variant & Category selection)
      var selectedOptions = product.options.map(function(opt) { return opt.values[0]; });

      contentEl.querySelectorAll('.qv-pill-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var optIdx = parseInt(this.getAttribute('data-opt-idx'), 10);
          var val = this.getAttribute('data-val');
          selectedOptions[optIdx] = val;

          var group = this.closest('.qv-option-group');
          group.querySelectorAll('.qv-pill-btn').forEach(function(b) { b.classList.remove('is-selected'); });
          this.classList.add('is-selected');

          var labelVal = document.getElementById('QvOptVal_' + optIdx);
          if (labelVal) labelVal.textContent = val;

          // Find matching variant
          var matchedVariant = product.variants.find(function(v) {
            return v.options.every(function(o, i) { return o === selectedOptions[i]; });
          });

          if (matchedVariant) {
            var addBtn = document.getElementById('QvAddToCartBtn');
            var btnText = document.getElementById('QvBtnText');
            var priceEl = document.getElementById('QvPrice');
            var compPriceEl = document.getElementById('QvComparePrice');
            var discBadge = document.getElementById('QvDiscountBadge');

            if (priceEl) priceEl.textContent = formatMoney(matchedVariant.price);
            var isSale = matchedVariant.compare_at_price && matchedVariant.compare_at_price > matchedVariant.price;
            if (compPriceEl) {
              compPriceEl.textContent = formatMoney(matchedVariant.compare_at_price);
              compPriceEl.style.display = isSale ? '' : 'none';
            }
            if (discBadge) {
              if (isSale) {
                var pct = Math.round(((matchedVariant.compare_at_price - matchedVariant.price) / matchedVariant.compare_at_price) * 100);
                discBadge.textContent = pct + '% OFF';
                discBadge.style.display = '';
              } else {
                discBadge.style.display = 'none';
              }
            }

            if (addBtn && btnText) {
              addBtn.setAttribute('data-variant-id', matchedVariant.id);
              if (matchedVariant.available) {
                addBtn.disabled = false;
                btnText.textContent = 'Add to Cart';
              } else {
                addBtn.disabled = true;
                btnText.textContent = 'Sold Out';
              }
            }

            if (matchedVariant.featured_image && matchedVariant.featured_image.src) {
              var mainImgEl = document.getElementById('QvMainImg');
              if (mainImgEl) mainImgEl.src = matchedVariant.featured_image.src;
              // update active thumb
              contentEl.querySelectorAll('.qv-thumb').forEach(function(t) {
                if (t.getAttribute('data-img-src') === matchedVariant.featured_image.src) {
                  t.classList.add('is-active');
                } else {
                  t.classList.remove('is-active');
                }
              });
            }
          }
        });
      });

      // Quantity Plus & Minus
      var qtyInput = document.getElementById('QvQtyInput');
      var minusBtn = document.getElementById('QvQtyMinus');
      var plusBtn = document.getElementById('QvQtyPlus');
      if (minusBtn && qtyInput) {
        minusBtn.addEventListener('click', function() {
          var val = parseInt(qtyInput.value, 10) || 1;
          if (val > 1) qtyInput.value = val - 1;
        });
      }
      if (plusBtn && qtyInput) {
        plusBtn.addEventListener('click', function() {
          var val = parseInt(qtyInput.value, 10) || 1;
          qtyInput.value = val + 1;
        });
      }

      // Add to Cart
      var addBtn = document.getElementById('QvAddToCartBtn');
      if (addBtn) {
        addBtn.addEventListener('click', function() {
          var vId = this.getAttribute('data-variant-id');
          var qty = parseInt((qtyInput ? qtyInput.value : 1), 10) || 1;
          var btnText = document.getElementById('QvBtnText');
          var spinner = document.getElementById('QvBtnSpinner');

          if (!vId) return;

          addBtn.disabled = true;
          if (spinner) spinner.style.display = 'inline-flex';
          if (btnText) btnText.style.display = 'none';

          function resetBtn() {
            addBtn.disabled = false;
            if (spinner) spinner.style.display = 'none';
            if (btnText) {
              btnText.style.display = 'inline';
              btnText.textContent = 'Add to Cart';
            }
          }

          if (typeof window.addToCartAjax === 'function') {
            window.addToCartAjax(vId, qty)
              .then(function() {
                resetBtn();
                closeQuickView();
              })
              .catch(function(err) {
                console.error('AJAX add error:', err);
                resetBtn();
              });
          } else {
            fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: vId, quantity: qty })
            })
            .then(function(res) { return res.json(); })
            .then(function(item) {
              resetBtn();
              closeQuickView();
              if (typeof window.openCartDrawer === 'function') {
                window.openCartDrawer();
              }
              document.dispatchEvent(new CustomEvent('theme:cart:reload', { bubbles: true }));
            })
            .catch(function(err) {
              console.error('Direct add error:', err);
              resetBtn();
            });
          }
        });
      }
    }

    // === Global Click Delegations ===
    document.addEventListener('click', function(e) {
      // Wishlist Button click
      var wishlistBtn = e.target.closest('.card-wishlist-btn');
      if (wishlistBtn) {
        e.preventDefault();
        e.stopPropagation();
        var pId = wishlistBtn.getAttribute('data-wishlist-id');
        if (pId) window.toggleWishlist(pId, wishlistBtn);
        return;
      }

      // Quick View open click
      var qvBtn = e.target.closest('[data-quickview-handle]');
      if (qvBtn) {
        e.preventDefault();
        e.stopPropagation();
        var handle = qvBtn.getAttribute('data-quickview-handle');
        if (handle) openQuickView(handle);
        return;
      }

      // Floating Circular Quick Add Button
      var quickAddBtn = e.target.closest('.card-quick-add-btn');
      if (quickAddBtn) {
        e.preventDefault();
        e.stopPropagation();
        var vId = quickAddBtn.getAttribute('data-variant-id');
        if (vId) {
          quickAddBtn.classList.add('is-loading');
          if (window.addToCartAjax) {
            window.addToCartAjax(vId, 1).then(function() {
              quickAddBtn.classList.remove('is-loading');
            }).catch(function() {
              quickAddBtn.classList.remove('is-loading');
            });
          }
        }
        return;
      }
    });

    if (closeBtn) closeBtn.addEventListener('click', closeQuickView);
    if (underlay) underlay.addEventListener('click', closeQuickView);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal && modal.classList.contains('is-open')) {
        closeQuickView();
      }
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncWishlistIcons);
    } else {
      syncWishlistIcons();
    }
  })();
</script>
