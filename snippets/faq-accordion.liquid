{% doc %}
  FAQ layout: category list + search on the left, animated accordion on the right, contact CTA. Accepts: blocks (section.blocks of type 'faq'), cfg (section.settings)

  @param [blocks] - Optional blocks passed by the parent file
  @param [cfg] - Optional cfg passed by the parent file
{% enddoc %}
{%- comment -%}
  FAQ layout: category list + search on the left, animated accordion on the right, contact CTA.
  Accepts: blocks (section.blocks of type 'faq'), cfg (section.settings)
{%- endcomment -%}
{%- liquid
  assign cats = ''
  assign total = 0
  for block in blocks
    if block.type == 'faq'
      assign total = total | plus: 1
    endif
    assign c = block.settings.category | strip
    if block.type == 'faq' and c != blank
      assign marker = '||' | append: c | append: '||'
      unless cats contains marker
        assign cats = cats | append: marker
      endunless
    endif
  endfor
  assign cat_list = cats | split: '||'
  assign root_prefix = routes.root_url
  unless root_prefix == '/'
    assign root_prefix = root_prefix | append: '/'
  endunless
  assign contact_link = cfg.faq_cta_link
  if contact_link == blank
    assign contact_link = root_prefix | append: 'pages/contact'
  endif
  assign faq_search_ph = cfg.faq_search_placeholder
  if faq_search_ph == blank
    assign faq_search_ph = 'pages.faq.search_placeholder' | t
  endif
  assign faq_cta_title = cfg.faq_cta_title
  if faq_cta_title == blank
    assign faq_cta_title = 'pages.faq.cta_title' | t
  endif
  assign faq_cta_text = cfg.faq_cta_text
  if faq_cta_text == blank
    assign faq_cta_text = 'pages.faq.cta_text' | t
  endif
  assign faq_cta_label = cfg.faq_cta_label
  if faq_cta_label == blank
    assign faq_cta_label = 'pages.faq.cta_label' | t
  endif
-%}
<style>
  .faq { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 48px; align-items: start; }
  @media (max-width: 900px) { .faq { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
  .faq__side { position: sticky; top: 24px; display: grid; gap: 18px; }
  @media (max-width: 900px) { .faq__side { position: static; } }
  .faq__search { position: relative; }
  .faq__search svg { position: absolute; left: 14px; top: 50%; width: 18px; height: 18px; margin-top: -9px; opacity: .55; pointer-events: none; }
  .faq__search input {
    width: 100%; box-sizing: border-box; height: 50px; margin: 0 !important; padding: 0 14px 0 42px; font: inherit; font-size: 14px; color: var(--text, #111);
    background: var(--pp-soft); border: 1px solid var(--pp-line); border-radius: var(--input-radius, var(--btn-radius, 0px)); outline: none; box-shadow: none; transition: border-color .2s ease, background-color .2s ease;
  }
  .faq__search input:focus { background: var(--bg, #fff); border-color: var(--text, #111); }
  .faq__cats { display: grid; gap: 2px; padding: 8px; background: var(--pp-soft); border: 1px solid var(--pp-line); border-radius: var(--ct-radius, 4px); }
  .faq__cat { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; padding: 12px 12px; margin: 0; font: inherit; font-size: 13px; font-weight: 600; letter-spacing: .06em; text-align: left; color: var(--pp-muted); background: transparent; border: 0; border-radius: calc(var(--ct-radius, 4px) - 1px); cursor: pointer; transition: background-color .2s ease, color .2s ease; }
  .faq__cat:hover { color: var(--text, #111); background: color-mix(in srgb, var(--text, #111) 5%, transparent); }
  .faq__cat.is-active { color: var(--btn-selected-text, #fff); background: var(--btn-selected-bg, #111); }
  .faq__cat small { font-size: 11px; font-weight: 700; opacity: .65; }
  @media (max-width: 900px) {
    .faq__cats { display: flex; gap: 8px; padding: 0; background: transparent; border: 0; overflow-x: auto; scrollbar-width: none; margin: 0 calc(var(--outer, 16px) * -1); padding: 0 var(--outer, 16px); }
    .faq__cats::-webkit-scrollbar { display: none; }
    .faq__cat { width: auto; flex: none; white-space: nowrap; border: 1px solid var(--pp-line); border-radius: 99px; padding: 9px 16px; }
    .faq__cat.is-active { border-color: var(--text, #111); }
  }
  .faq__help { padding: 22px; text-align: center; background: var(--pp-soft); border: 1px solid var(--pp-line); border-radius: var(--ct-radius, 4px); }
  @media (max-width: 900px) { .faq__help { display: none; } }
  .faq__help-title { margin: 0 0 6px; font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .faq__help-text { margin: 0 0 16px; font-size: 13px; color: var(--pp-muted); line-height: 1.55; }

  .faq__list { border-top: 1px solid var(--pp-line); }
  .faq-item { border-bottom: 1px solid var(--pp-line); }
  .faq-item[hidden] { display: none; }
  .faq-item__q {
    display: flex; align-items: center; justify-content: space-between; gap: 20px; width: 100%; margin: 0; padding: 22px 0; font: inherit; font-size: 15px; font-weight: 700; letter-spacing: .05em; line-height: 1.45; text-align: left;
    color: inherit; background: transparent; border: 0; cursor: pointer;
  }
  .faq-item__q:hover { opacity: .75; }
  .faq-item__icon { position: relative; flex: none; width: 30px; height: 30px; border: 1px solid var(--pp-line); border-radius: 50%; transition: background-color .3s ease, border-color .3s ease, transform .35s ease; }
  .faq-item__icon::before, .faq-item__icon::after { content: ""; position: absolute; left: 50%; top: 50%; width: 10px; height: 1.5px; margin: -0.75px 0 0 -5px; background: currentColor; transition: transform .35s ease, background-color .3s ease; }
  .faq-item__icon::after { transform: rotate(90deg); }
  .faq-item.is-open .faq-item__icon { background: var(--text, #111); border-color: var(--text, #111); color: var(--bg, #fff); }
  .faq-item.is-open .faq-item__icon::after { transform: rotate(0deg); }
  .faq-item__a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .4s cubic-bezier(.22, .8, .3, 1); }
  .faq-item.is-open .faq-item__a { grid-template-rows: 1fr; }
  .faq-item__a-inner { overflow: hidden; min-height: 0; }
  .faq-item__a-inner > .rte { padding: 0 52px 24px 0; font-size: 15px; line-height: 1.8; color: var(--pp-muted); }
  .faq-item__a-inner > .rte p { margin: 0 0 .9em; }
  .faq-item__a-inner > .rte p:last-child { margin-bottom: 0; }
  .faq-item__a-inner a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 640px) { .faq-item__a-inner > .rte { padding-right: 0; } .faq-item__q { font-size: 14px; padding: 18px 0; } }
  .faq__empty { margin: 28px 0 0; padding: 28px 16px; text-align: center; font-size: 14px; color: var(--pp-muted); background: var(--pp-soft); border: 1px dashed var(--pp-line); border-radius: var(--ct-radius, 4px); }
  .faq__empty[hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) { .faq-item__a, .faq-item__icon, .faq-item__icon::before, .faq-item__icon::after { transition: none; } }
</style>

<div class="faq" data-faq>
  <aside class="faq__side">
    <div class="faq__search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" placeholder="{{ faq_search_ph }}" aria-label="{{ 'pages.faq.search_label' | t }}" data-faq-search autocomplete="off">
    </div>

    {%- if cat_list.size > 0 -%}
      <div class="faq__cats" role="tablist" aria-label="{{ 'pages.faq.categories_label' | t }}" data-faq-cats>
        <button type="button" class="faq__cat is-active" data-faq-cat="" role="tab" aria-selected="true">{{ 'pages.faq.all_questions' | t }} <small>{{ total }}</small></button>
        {%- for c in cat_list -%}
          {%- if c != blank -%}
            <button type="button" class="faq__cat" data-faq-cat="{{ c | escape }}" role="tab" aria-selected="false">{{ c }} <small data-faq-count></small></button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="faq__help">
      <p class="faq__help-title">{{ faq_cta_title }}</p>
      <p class="faq__help-text">{{ faq_cta_text }}</p>
      <a href="{{ contact_link }}" class="btn btn--primary btn-sliding-hover" style="display: flex; align-items: center; justify-content: center; min-height: var(--ctl-h, 46px);"><span class="btn__text-content">{{ faq_cta_label }}</span></a>
    </div>
  </aside>

  <div class="faq__main">
    <div class="faq__list" data-faq-list>
      {%- for block in blocks -%}
        {%- if block.type == 'faq' -%}
        <div class="faq-item" data-faq-item data-cat="{{ block.settings.category | strip | escape }}" {{ block.shopify_attributes }}>
          <button type="button" class="faq-item__q" aria-expanded="false" aria-controls="faq-a-{{ block.id }}" id="faq-q-{{ block.id }}">
            <span data-faq-q>{{ block.settings.question }}</span>
            <span class="faq-item__icon" aria-hidden="true"></span>
          </button>
          <div class="faq-item__a" id="faq-a-{{ block.id }}" role="region" aria-labelledby="faq-q-{{ block.id }}">
            <div class="faq-item__a-inner"><div class="rte">{{ block.settings.answer }}</div></div>
          </div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <p class="faq__empty" data-faq-empty hidden>{{ 'pages.faq.no_results_html' | t: contact_url: contact_link }}</p>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-faq]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    var items = Array.prototype.slice.call(root.querySelectorAll('[data-faq-item]'));
    var cats = Array.prototype.slice.call(root.querySelectorAll('[data-faq-cat]'));
    var search = root.querySelector('[data-faq-search]');
    var empty = root.querySelector('[data-faq-empty]');
    var activeCat = '';

    items.forEach(function (it) {
      var q = it.querySelector('.faq-item__q');
      q.addEventListener('click', function () {
        var open = !it.classList.contains('is-open');
        it.classList.toggle('is-open', open);
        q.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    });

    cats.forEach(function (b) {
      var name = b.getAttribute('data-faq-cat');
      var count = b.querySelector('[data-faq-count]');
      if (count) count.textContent = items.filter(function (i) { return i.getAttribute('data-cat') === name; }).length;
      b.addEventListener('click', function () {
        activeCat = name;
        cats.forEach(function (x) {
          var on = x === b;
          x.classList.toggle('is-active', on);
          x.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        apply();
      });
    });

    function apply() {
      var term = (search && search.value || '').trim().toLowerCase();
      var shown = 0;
      items.forEach(function (it) {
        var okCat = !activeCat || it.getAttribute('data-cat') === activeCat;
        var okTerm = !term || it.textContent.toLowerCase().indexOf(term) > -1;
        var show = okCat && okTerm;
        it.hidden = !show;
        if (show) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    }
    if (search) search.addEventListener('input', apply);
  })();
</script>
