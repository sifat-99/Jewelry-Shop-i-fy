<!-- ROTATING HERO SLIDER SCRIPT -->
<script>
  (function() {
    var rotator = document.getElementById('permMediaRotator');
    if (!rotator) return;

    var slides = Array.prototype.slice.call(rotator.querySelectorAll('.perm-slide'));
    var dotsContainer = document.getElementById('permSlideDots');
    if (slides.length <= 1) {
      if (dotsContainer) dotsContainer.style.display = 'none';
      return;
    }

    // Random shuffle product slides on every page visit so varied product 2nd images are featured
    {%- if cfg.perm_image == blank -%}
      for (var s = slides.length - 1; s > 0; s--) {
        var rand = Math.floor(Math.random() * (s + 1));
        var temp = slides[s];
        slides[s] = slides[rand];
        slides[rand] = temp;
      }
      slides.forEach(function(slide, idx) {
        slide.setAttribute('data-slide-index', idx);
        if (idx === 0) {
          slide.classList.add('is-active');
        } else {
          slide.classList.remove('is-active');
        }
        if (dotsContainer) {
          rotator.insertBefore(slide, dotsContainer);
        } else {
          rotator.appendChild(slide);
        }
      });
    {%- endif -%}

    // Generate dots navigation to match slides
    if (dotsContainer) {
      dotsContainer.innerHTML = '';
      slides.forEach(function(_, idx) {
        var dot = document.createElement('span');
        dot.className = 'perm-slide-dot' + (idx === 0 ? ' is-active' : '');
        dot.setAttribute('data-dot-idx', idx);
        dotsContainer.appendChild(dot);
      });
    }

    var dots = dotsContainer ? dotsContainer.querySelectorAll('.perm-slide-dot') : [];
    var currentIndex = 0;
    var timer = null;
    var intervalMs = 3800; // change every 3.8s

    function showSlide(index) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      currentIndex = index;

      for (var i = 0; i < slides.length; i++) {
        if (i === currentIndex) {
          slides[i].classList.add('is-active');
        } else {
          slides[i].classList.remove('is-active');
        }
      }

      for (var j = 0; j < dots.length; j++) {
        if (j === currentIndex) {
          dots[j].classList.add('is-active');
        } else {
          dots[j].classList.remove('is-active');
        }
      }
    }

    function startTimer() {
      stopTimer();
      timer = setInterval(function() {
        showSlide(currentIndex + 1);
      }, intervalMs);
    }

    function stopTimer() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    rotator.addEventListener('mouseenter', stopTimer);
    rotator.addEventListener('mouseleave', startTimer);
    rotator.addEventListener('touchstart', stopTimer, { passive: true });
    rotator.addEventListener('touchend', startTimer, { passive: true });

    if (dotsContainer) {
      dotsContainer.addEventListener('click', function(e) {
        var dot = e.target.closest('.perm-slide-dot');
        if (!dot) return;
        var idx = parseInt(dot.getAttribute('data-dot-idx'), 10);
        if (!isNaN(idx)) {
          showSlide(idx);
          startTimer();
        }
      });
    }

    startTimer();
  })();
</script>
