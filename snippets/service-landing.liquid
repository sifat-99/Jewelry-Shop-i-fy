{% doc %}
  Permanent Jewelry On-Site Landing Layout with Auto-Rotating Atelier Showcase. Accepts: blocks, cfg (section.settings), page_title, page_content

  @param [cfg] - Optional cfg passed by the parent file
  @param [page_title] - Optional page title passed by the parent file
  @param [page_content] - Optional page content passed by the parent file
{% enddoc %}
{%- comment -%}
  Permanent Jewelry On-Site Landing Layout with Auto-Rotating Atelier Showcase.
  Accepts: blocks, cfg (section.settings), page_title, page_content
{%- endcomment -%}
{%- liquid
  assign root_prefix = routes.root_url
  unless root_prefix == '/'
    assign root_prefix = root_prefix | append: '/'
  endunless
  assign contact_page_url = root_prefix | append: 'pages/contact'
  assign book_link = cfg.perm_button_link
  if book_link == blank
    assign book_link = contact_page_url
  endif
  assign cta_link = cfg.perm_cta_link
  if cta_link == blank
    assign cta_link = book_link
  endif
  assign shop_link = routes.all_products_collection_url

  assign perm_eyebrow = cfg.perm_eyebrow
  if perm_eyebrow == blank
    assign perm_eyebrow = 'pages.permanent.eyebrow' | t
  endif
  assign perm_default_heading = 'pages.permanent.heading' | t
  assign perm_slide1_title = cfg.perm_slide_1_title
  if perm_slide1_title == blank
    assign perm_slide1_title = 'pages.permanent.slide_1_title' | t
  endif
  assign perm_slide2_title = cfg.perm_slide_2_title
  if perm_slide2_title == blank
    assign perm_slide2_title = 'pages.permanent.slide_2_title' | t
  endif
  assign perm_slide3_title = cfg.perm_slide_3_title
  if perm_slide3_title == blank
    assign perm_slide3_title = 'pages.permanent.slide_3_title' | t
  endif
  assign perm_slide4_title = cfg.perm_slide_4_title
  if perm_slide4_title == blank
    assign perm_slide4_title = 'pages.permanent.slide_4_title' | t
  endif
  assign perm_story_title = cfg.perm_story_title
  if perm_story_title == blank
    assign perm_story_title = 'pages.permanent.story_title' | t
  endif
  assign perm_steps_eyebrow = cfg.perm_steps_eyebrow
  if perm_steps_eyebrow == blank
    assign perm_steps_eyebrow = 'pages.permanent.steps_eyebrow' | t
  endif
  assign perm_steps_title = cfg.perm_steps_title
  if perm_steps_title == blank
    assign perm_steps_title = 'pages.permanent.steps_title' | t
  endif
-%}
{% render 'landing-css' %}

<style>
  /* === Theme Design System Synchronization for Permanent Jewelry === */
  :root, .pg-page {
    --ct-radius: var(--card-radius, 0px);
    --pp-line: var(--lv-border);
    --pp-muted: rgba(var(--color-foreground, 0, 0, 0), 0.62);
    --pp-soft: color-mix(in srgb, var(--text, #000) 4%, var(--bg, #fff));
  }

  /* Dynamic Permanent Jewelry Rotating Slider Styles */
  .perm-media-rotator {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 580px;
    width: 100%;
    overflow: hidden;
    border-radius: var(--media-radius, 0px) !important;
    background: var(--pp-soft);
    border: 1px solid var(--pp-line);
    box-shadow: none !important;
  }
  .perm-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transform: scale(1.02);
    transition: opacity 0.85s cubic-bezier(0.4, 0, 0.2, 1), transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0.85s;
    pointer-events: none;
    border-radius: var(--media-radius, 0px) !important;
  }
  .perm-slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    pointer-events: auto;
    z-index: 2;
  }
  .perm-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: var(--media-radius, 0px) !important;
  }
  .perm-slide__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.02) 0%, rgba(0,0,0,0.08) 55%, rgba(0,0,0,0.6) 100%);
    pointer-events: none;
  }
  .perm-slide__card {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    background: var(--bg, #ffffff);
    border: 1px solid var(--pp-line);
    border-radius: var(--card-radius, 0px) !important;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    z-index: 4;
  }
  .perm-slide__badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pp-muted);
    margin-bottom: 3px;
  }
  .perm-slide__title {
    display: block;
    margin: 0;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text, #000000);
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 230px;
    transition: opacity 0.2s ease;
  }
  .perm-slide__title:hover {
    opacity: 0.7;
  }
  .perm-slide__btn {
    flex: none;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-family: var(--TYPE-STACK-BUTTON, sans-serif) !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    line-height: 1 !important;
    white-space: nowrap !important;
    color: var(--btn-regular-text, #ffffff) !important;
    background: var(--btn-regular-bg, #000000) !important;
    border: 1px solid var(--btn-regular-border, #000000) !important;
    border-radius: var(--btn-radius, 0px) !important;
    padding: 10px 18px !important;
    text-decoration: none !important;
    cursor: pointer !important;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease !important;
  }
  .perm-slide__btn span,
  .perm-slide__btn .perm-slide__btn-text {
    color: var(--btn-regular-text, #ffffff) !important;
    display: inline-block !important;
    line-height: 1 !important;
    position: relative !important;
    z-index: 2 !important;
  }
  .perm-slide__btn:hover {
    background: var(--btn-regular-hover-bg, #ffffff) !important;
    color: var(--btn-regular-hover-text, #000000) !important;
    border-color: var(--btn-regular-hover-border, #000000) !important;
  }
  .perm-slide__btn:hover span,
  .perm-slide__btn:hover .perm-slide__btn-text {
    color: var(--btn-regular-hover-text, #000000) !important;
  }
  .perm-slide-nav {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 5;
    background: rgba(var(--color-background, 255, 255, 255), 0.92);
    padding: 6px 10px;
    border: 1px solid var(--pp-line);
    border-radius: var(--card-radius, 0px) !important;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .perm-slide-dot {
    width: 14px;
    height: 2px;
    border-radius: 0 !important;
    background: rgba(var(--color-foreground, 0, 0, 0), 0.25);
    cursor: pointer;
    transition: width 0.3s ease, background-color 0.3s ease;
  }
  .perm-slide-dot.is-active {
    background: var(--text, #000000);
    width: 24px;
  }

  /* Quote Box Theme Styling */
  .perm-quote-box {
    margin: 64px 0 76px;
    padding: 44px 36px;
    text-align: center;
    background: var(--pp-soft) !important;
    border-left: 2px solid var(--text, #000000) !important;
    border-right: 2px solid var(--text, #000000) !important;
    border-top: 1px solid var(--pp-line) !important;
    border-bottom: 1px solid var(--pp-line) !important;
    border-radius: var(--card-radius, 0px) !important;
  }
  .perm-quote-text {
    margin: 0 auto;
    max-width: 720px;
    font-size: clamp(17px, 2.2vw, 22px);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.6;
    color: var(--text, #000000) !important;
    font-style: italic;
  }
  .perm-quote-author {
    margin: 18px 0 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pp-muted) !important;
  }

  /* Theme Layout & Radius Overrides */
  .sl-hero__media,
  .ab-story__media {
    border-radius: var(--media-radius, 0px) !important;
    border: 1px solid var(--pp-line) !important;
    background: var(--pp-soft) !important;
  }
  .sl-hero__media img,
  .ab-story__media img {
    border-radius: var(--media-radius, 0px) !important;
  }

  /* Trust Stats */
  .ab-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0 0 76px;
    border-top: 1px solid var(--pp-line) !important;
    border-bottom: 1px solid var(--pp-line) !important;
  }
  @media (max-width: 800px) {
    .ab-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-bottom: 56px;
    }
  }
  .ab-stat {
    padding: 34px 18px;
    text-align: center;
    border-left: 1px solid var(--pp-line) !important;
    color: var(--text, #000000) !important;
  }
  .ab-stat:first-child {
    border-left: 0 !important;
  }
  @media (max-width: 800px) {
    .ab-stat:nth-child(odd) {
      border-left: 0 !important;
    }
    .ab-stat:nth-child(n+3) {
      border-top: 1px solid var(--pp-line) !important;
    }
  }
  .ab-stat__num {
    margin: 0 0 6px;
    font-size: clamp(26px, 3.4vw, 42px);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.1;
    color: var(--text, #000000) !important;
  }
  .ab-stat__label {
    margin: 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pp-muted) !important;
  }

  /* Story & Metallurgy Section */
  .ab-story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
    margin: 0 0 76px;
  }
  @media (max-width: 900px) {
    .ab-story {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      margin-bottom: 56px;
    }
  }
  .ab-story__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--pp-soft);
  }
  .ab-story__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ab-story__title {
    margin: 0 0 20px;
    font-size: clamp(22px, 2.8vw, 32px);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.25;
    color: var(--text, #000000);
  }
  .ab-story__body {
    font-size: 15px;
    line-height: 1.85;
    color: var(--pp-muted);
  }
  .ab-story__body p {
    margin: 0 0 1.2em;
  }

  /* Steps Section: Luxury Step Cards */
  .sl-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 20px;
    counter-reset: sl;
  }
  .sl-step {
    position: relative;
    padding: 30px 24px 26px;
    border: 1px solid var(--pp-line) !important;
    border-radius: var(--card-radius, 0px) !important;
    background: var(--bg, #ffffff) !important;
    counter-increment: sl;
    transition: transform 0.35s cubic-bezier(0.22, 0.8, 0.3, 1), box-shadow 0.35s ease;
  }
  @media (hover: hover) {
    .sl-step:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 28px -16px rgba(0, 0, 0, 0.18);
    }
  }
  .sl-step::before {
    content: counter(sl, decimal-leading-zero);
    display: block;
    margin: 0 0 14px;
    font-size: 28px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.06em;
    color: var(--text, #000000);
    opacity: 0.35;
  }
  .sl-step__title {
    margin: 0 0 10px;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text, #000000);
  }
  .sl-step__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--pp-muted);
  }

  /* Features Grid */
  .sl-features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 800px) {
    .sl-features {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .sl-feature {
    padding: 32px 26px;
    text-align: center;
    border: 1px solid var(--pp-line) !important;
    border-radius: var(--card-radius, 0px) !important;
    background: var(--pp-soft) !important;
  }
  .sl-feature__icon {
    width: 52px;
    height: 52px;
    margin: 0 auto 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--pp-line) !important;
    border-radius: var(--card-radius, 0px) !important;
    background: var(--bg, #ffffff) !important;
    color: var(--text, #000000) !important;
  }
  .sl-feature__icon svg {
    width: 22px;
    height: 22px;
  }
  .sl-feature__title {
    margin: 0 0 10px;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text, #000000) !important;
  }
  .sl-feature__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--pp-muted) !important;
  }

  /* Harmonized Luxury CTA Section (Full-Width Bleed with Theme Soft Tint) */
  .pg-page {
    padding-bottom: 0px !important;
  }
  .sl-cta,
  html body .pg-page .sl-cta,
  html body .sl-cta {
    display: block !important;
    text-align: center !important;
    padding: 56px var(--outer, 24px) 52px !important;
    margin: 0 calc(-1 * var(--outer, 24px)) 0px !important;
    width: calc(100% + (2 * var(--outer, 24px))) !important;
    max-width: none !important;
    box-sizing: border-box !important;
    background: var(--pp-soft) !important;
    border-top: 1px solid var(--pp-line) !important;
    border-bottom: 1px solid var(--pp-line) !important;
    border-left: none !important;
    border-right: none !important;
    border-radius: 0px !important;
    color: var(--text, #000000) !important;
    box-shadow: none !important;
  }
  @media (max-width: 640px) {
    .sl-cta,
    html body .pg-page .sl-cta,
    html body .sl-cta {
      padding: 42px var(--outer, 16px) 38px !important;
      margin: 0 calc(-1 * var(--outer, 16px)) 0px !important;
      width: calc(100% + (2 * var(--outer, 16px))) !important;
    }
  }
  .sl-cta__inner,
  html body .pg-page .sl-cta .sl-cta__inner {
    max-width: 640px !important;
    margin: 0 auto !important;
    text-align: center !important;
  }
  .sl-cta__eyebrow,
  .sl-cta .sl-cta__eyebrow,
  html body .pg-page .sl-cta .sl-cta__eyebrow {
    margin: 0 0 12px !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    letter-spacing: 0.24em !important;
    text-transform: uppercase !important;
    color: var(--pp-muted, #777777) !important;
    display: block !important;
  }
  .sl-cta__title,
  .sl-cta .sl-cta__title,
  html body .pg-page .sl-cta .sl-cta__title {
    margin: 0 0 16px !important;
    font-size: clamp(24px, 3.4vw, 36px) !important;
    font-weight: 600 !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    line-height: 1.25 !important;
    color: var(--text, #000000) !important;
    opacity: 1 !important;
  }
  .sl-cta__text,
  .sl-cta .sl-cta__text,
  html body .pg-page .sl-cta .sl-cta__text {
    margin: 0 auto 32px !important;
    max-width: 540px !important;
    font-size: 15px !important;
    line-height: 1.8 !important;
    color: color-mix(in srgb, var(--text, #444444) 88%, transparent) !important;
    opacity: 1 !important;
  }
  .sl-cta__actions,
  html body .pg-page .sl-cta .sl-cta__actions {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-wrap: wrap !important;
    gap: 14px !important;
  }

  /* Base CTA Buttons */
  .sl-cta .sl-btn,
  html body .pg-page .sl-cta .sl-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-height: 48px !important;
    padding: 0 34px !important;
    border-radius: var(--btn-radius, 0px) !important;
    font-family: var(--TYPE-STACK-BUTTON, sans-serif) !important;
    font-size: 11.5px !important;
    font-weight: 700 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    cursor: pointer !important;
    transform: none !important;
    position: relative !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
  }
  .sl-cta .sl-btn .btn__text-content {
    position: relative !important;
    z-index: 3 !important;
    transition: color var(--btn-animation-duration, 450ms) var(--btn-ease, cubic-bezier(0.65, 0, 0.35, 1)) !important;
  }

  /* Primary Button: Book Atelier Session */
  .sl-cta__btn-primary,
  .sl-cta .sl-cta__btn-primary,
  html body .pg-page .sl-cta .sl-cta__btn-primary {
    background-color: var(--btn-regular-bg, #000000) !important;
    border: 1px solid var(--btn-regular-border, #000000) !important;
    color: var(--btn-regular-text, #ffffff) !important;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease !important;
  }
  .sl-cta__btn-primary .btn__text-content,
  .sl-cta__btn-primary span {
    color: var(--btn-regular-text, #ffffff) !important;
    transition: color 0.3s ease !important;
  }
  .sl-cta__btn-primary::before {
    display: none !important;
  }
  .sl-cta__btn-primary:hover,
  html body .pg-page .sl-cta .sl-cta__btn-primary:hover {
    border-color: var(--btn-regular-hover-border, #000000) !important;
    background-color: var(--btn-regular-hover-bg, #ffffff) !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12) !important;
  }
  .sl-cta__btn-primary:hover .btn__text-content,
  html body .pg-page .sl-cta .sl-cta__btn-primary:hover .btn__text-content,
  .sl-cta__btn-primary:hover span,
  html body .pg-page .sl-cta .sl-cta__btn-primary:hover span {
    color: var(--btn-regular-hover-text, #000000) !important;
  }

  /* Secondary Button: Inquire Private Event (Matches Global Border #D1D1D1) */
  .sl-cta__btn-secondary,
  .sl-cta .sl-cta__btn-secondary,
  html body .pg-page .sl-cta .sl-cta__btn-secondary {
    background-color: var(--bg, #ffffff) !important;
    border: 1px solid var(--border, var(--lv-border)) !important;
    color: var(--text, #000000) !important;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease !important;
  }
  .sl-cta__btn-secondary .btn__text-content,
  .sl-cta__btn-secondary span {
    color: var(--text, #000000) !important;
    transition: color 0.3s ease !important;
  }
  .sl-cta__btn-secondary::before {
    display: none !important;
  }
  .sl-cta__btn-secondary:hover,
  html body .pg-page .sl-cta .sl-cta__btn-secondary:hover {
    border-color: var(--btn-regular-hover-border, #000000) !important;
    background-color: var(--btn-regular-hover-bg, #000000) !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12) !important;
  }
  .sl-cta__btn-secondary:hover .btn__text-content,
  html body .pg-page .sl-cta .sl-cta__btn-secondary:hover .btn__text-content,
  .sl-cta__btn-secondary:hover span,
  html body .pg-page .sl-cta .sl-cta__btn-secondary:hover span {
    color: var(--btn-regular-hover-text, #ffffff) !important;
  }

  .sl-btn, .btn {
    border-radius: var(--btn-radius, 0px) !important;
  }
</style>

<!-- HERO SECTION: COPY ON LEFT, ROTATING SHOWCASE ON RIGHT -->
<section class="sl-hero">
  <div class="sl-hero__copy">
    <p class="sl-hero__eyebrow">{{ perm_eyebrow }}</p>
    <h1 class="sl-hero__title">{% if cfg.perm_heading != blank %}{{ cfg.perm_heading }}{% else %}{{ page_title | default: perm_default_heading }}{% endif %}</h1>
    <p class="sl-hero__lead">
      {%- if cfg.perm_lead != blank and cfg.perm_lead != 'A bracelet, anklet or necklace fitted to you and welded closed, with no clasp. Made to be worn every day, in the shower, at the beach, always.' -%}
        {{ cfg.perm_lead }}
      {%- else -%}
        {{ 'pages.permanent.lead_fallback' | t }}
      {%- endif -%}
    </p>
    <div class="sl-hero__btns">
      <a href="{{ book_link }}" class="btn btn--primary btn-sliding-hover sl-btn">
        <span class="btn__text-content">
          {%- if cfg.perm_button_label != blank and cfg.perm_button_label != 'Book a session' -%}
            {{ cfg.perm_button_label }}
          {%- else -%}
            {{ 'pages.permanent.book_btn' | t }}
          {%- endif -%}
        </span>
      </a>
      <a href="#how-it-works" class="btn btn-sliding-hover sl-btn">
        <span class="btn__text-content">{{ 'pages.permanent.welding_process_btn' | t }}</span>
      </a>
    </div>
  </div>

  <div class="sl-hero__media">
    <div class="perm-media-rotator" id="permMediaRotator">
