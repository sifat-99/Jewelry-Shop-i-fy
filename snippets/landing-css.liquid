{%- comment -%} Shared CSS for landing-style pages (permanent jewelry, about us). {%- endcomment -%}
<style>
  .sl-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: center; margin: 0 0 72px; }
  @media (max-width: 900px) { .sl-hero { grid-template-columns: minmax(0, 1fr); gap: 28px; margin-bottom: 52px; } }
  .sl-hero__eyebrow { margin: 0 0 14px; font-size: 11px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; color: var(--pp-muted); }
  .sl-hero__title { margin: 0 0 18px; font-size: clamp(30px, 4.4vw, 54px); font-weight: 600; letter-spacing: .1em; text-transform: uppercase; line-height: 1.12; }
  .sl-hero__lead { margin: 0 0 30px; max-width: 520px; font-size: 16px; line-height: 1.75; color: var(--pp-muted); }
  .sl-hero__btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .sl-btn { display: inline-flex; align-items: center; justify-content: center; min-height: var(--ctl-h-lg, 52px); padding: 0 32px; }
  .sl-hero__media { position: relative; aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--ct-radius, 4px); background: linear-gradient(135deg, #ece5da, #d9ccb9); }
  .sl-hero__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sl-hero__ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .sl-hero__ph svg { width: 36%; height: auto; opacity: .55; }
  @media (max-width: 900px) { .sl-hero__media { aspect-ratio: 4 / 3; order: -1; } }

  .sl-sec { margin: 0 0 76px; }
  @media (max-width: 900px) { .sl-sec { margin-bottom: 56px; } }
  .sl-sec__head { text-align: center; max-width: 640px; margin: 0 auto 36px; }
  .sl-sec__eyebrow { margin: 0 0 8px; font-size: 11px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; color: var(--pp-muted); }
  .sl-sec__title { margin: 0; font-size: clamp(22px, 2.8vw, 30px); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }

  .sl-features { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 800px) { .sl-features { grid-template-columns: minmax(0, 1fr); } }
  .sl-feature { padding: 28px 26px; text-align: center; background: var(--pp-soft); border: 1px solid var(--pp-line); border-radius: var(--ct-radius, 4px); }
  .sl-feature__icon { width: 54px; height: 54px; margin: 0 auto 16px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--pp-line); border-radius: 50%; background: var(--bg, #fff); }
  .sl-feature__icon svg { width: 24px; height: 24px; }
  .sl-feature__title { margin: 0 0 8px; font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .sl-feature__text { margin: 0; font-size: 14px; line-height: 1.7; color: var(--pp-muted); }

  .sl-steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; counter-reset: sl; }
  @media (max-width: 1000px) { .sl-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .sl-steps { grid-template-columns: minmax(0, 1fr); } }
  .sl-step { position: relative; padding: 26px 22px 24px; border: 1px solid var(--pp-line); border-radius: var(--ct-radius, 4px); background: var(--bg, #fff); counter-increment: sl; transition: transform .45s cubic-bezier(.22, .8, .3, 1), box-shadow .45s ease; }
  @media (hover: hover) { .sl-step:hover { transform: translateY(-4px); box-shadow: 0 18px 30px -20px rgba(0, 0, 0, .28); } }
  .sl-step::before { content: counter(sl, decimal-leading-zero); display: block; margin: 0 0 14px; font-size: 34px; font-weight: 600; line-height: 1; letter-spacing: .04em; opacity: .22; }
  .sl-step__title { margin: 0 0 8px; font-size: 14px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .sl-step__text { margin: 0; font-size: 14px; line-height: 1.7; color: var(--pp-muted); }

  .sl-content { max-width: 820px; margin: 0 auto 76px; }

  .sl-cta { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 28px; align-items: center; padding: 40px 44px; background: var(--text, #111); color: var(--bg, #fff); border-radius: var(--ct-radius, 4px); }
  @media (max-width: 800px) { .sl-cta { grid-template-columns: minmax(0, 1fr); padding: 30px 22px; text-align: center; } }
  .sl-cta__title { margin: 0 0 8px; font-size: clamp(20px, 2.6vw, 28px); font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .sl-cta__text { margin: 0; font-size: 14.5px; line-height: 1.7; opacity: .8; max-width: 560px; }
  @media (max-width: 800px) { .sl-cta__text { margin: 0 auto; } }
  .sl-cta__btn { display: inline-flex; align-items: center; justify-content: center; min-height: var(--ctl-h-lg, 52px); padding: 0 36px; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; color: var(--text, #111); background: var(--bg, #fff); border: 1px solid var(--bg, #fff); border-radius: var(--btn-radius, 0px); transition: background-color .3s ease, color .3s ease; white-space: nowrap; }
  .sl-cta__btn:hover { background: transparent; color: var(--bg, #fff); }
</style>
<style>
  .ab-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 0 0 76px; border-top: 1px solid var(--pp-line); border-bottom: 1px solid var(--pp-line); }
  @media (max-width: 800px) { .ab-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-bottom: 56px; } }
  .ab-stat { padding: 32px 16px; text-align: center; border-left: 1px solid var(--pp-line); }
  .ab-stat:first-child { border-left: 0; }
  @media (max-width: 800px) { .ab-stat:nth-child(odd) { border-left: 0; } .ab-stat:nth-child(n+3) { border-top: 1px solid var(--pp-line); } }
  .ab-stat__num { margin: 0 0 6px; font-size: clamp(28px, 3.6vw, 44px); font-weight: 600; letter-spacing: .06em; line-height: 1.1; }
  .ab-stat__label { margin: 0; font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--pp-muted); }
  .ab-story { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: center; margin: 0 0 76px; }
  .ab-story--single { grid-template-columns: minmax(0, 760px); justify-content: center; text-align: center; }
  @media (max-width: 900px) { .ab-story { grid-template-columns: minmax(0, 1fr); gap: 28px; margin-bottom: 56px; } }
  .ab-story__media { aspect-ratio: 1 / 1; overflow: hidden; border-radius: var(--ct-radius, 4px); background: linear-gradient(135deg, #ece5da, #d9ccb9); }
  .ab-story__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ab-story__title { margin: 0 0 18px; font-size: clamp(22px, 2.8vw, 32px); font-weight: 600; letter-spacing: .1em; text-transform: uppercase; line-height: 1.25; }
  .ab-story__body { font-size: 15.5px; line-height: 1.85; color: var(--pp-muted); }
  .ab-story__body p { margin: 0 0 1.1em; }
</style>
<style>
  /* Landing page refinements */
  .pg-page .lv-crumbs { justify-content: flex-start; margin-bottom: 22px; }
  .sl-hero__media { aspect-ratio: 5 / 4; max-height: 580px; }
  @media (max-width: 900px) { .sl-hero__media { aspect-ratio: 4 / 3; max-height: 420px; } }
  .sl-hero { margin-bottom: 64px; }
  .ab-stat__num { font-size: clamp(22px, 2.6vw, 34px); overflow-wrap: anywhere; }
  .sl-cta .sl-cta__title { color: var(--text, #000000) !important; }
  .sl-cta .sl-cta__text { color: #444444 !important; opacity: 1; }
  .ab-story__body, .ab-story__body p { color: var(--pp-muted); }
  .ab-story:not(.ab-story--single) .ab-story__body { max-width: 560px; }
</style>
